{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./.claude/settings.local.json)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/id_rsa)"
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "HOOK_TELEMETRY_SINK": ".claude/hooks/hook-telemetry-sink.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/cloud-bootstrap.sh\""
          }
        ]
      }
    ]
  },
  "skillListingBudgetFraction": 0.05,
  "enabledPlugins": {
    "ai-slop@melodic-software": true,
    "animation@melodic-software": false,
    "docs-naming@melodic-software": true,
    "dometrain-mcp@melodic-software": false,
    "evals@melodic-software": true,
    "explainer-video@melodic-software": false,
    "gaming@melodic-software": false,
    "harness-config@melodic-software": true,
    "harness-ops@melodic-software": true,
    "instruction-placement@melodic-software": true,
    "pixel-art@melodic-software": false,
    "playgrounds@melodic-software": false,
    "plugin-quality@melodic-software": true,
    "retro-audio@melodic-software": false,
    "skill-quality@melodic-software": true,
    "speech@melodic-software": false
  },
  "extraKnownMarketplaces": {
    "melodic-software": {
      "source": {
        "source": "directory",
        "path": "./"
      }
    }
  }
}
