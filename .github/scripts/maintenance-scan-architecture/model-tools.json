{
  "allowed": [
    "Skill",
    "Agent",
    "Edit(./.work/**)",
    "Bash(git rev-parse --is-shallow-repository)",
    "Bash(git rev-parse HEAD)",
    "Bash(git rev-parse --show-toplevel)",
    "Bash(git branch --show-current)",
    "Bash(git status --porcelain)",
    "Bash(git log --oneline -15)",
    "Bash(git log --oneline -20)",
    "Bash(git log --name-only --format='%h %an: %s' -100)",
    "Bash(git log --name-only --format='%h %an: %s' -200)",
    "Bash(git ls-files)",
    "Bash(git log --reverse --format=%cs)",
    "Bash(git log --since='90 days ago' --pretty=format: --name-only)",
    "Bash(grep -v '^$')",
    "Bash(sort)",
    "Bash(sort -n)",
    "Bash(sort -rn)",
    "Bash(uniq -c)",
    "Bash(head -n 1)",
    "Bash(head -10)",
    "Bash(head -50)",
    "Bash(wc -l)",
    "Bash(bash WORKSPACE/.lane/plugins/improvement/lib/state-key.sh)",
    "Bash(bash \"WORKSPACE/.lane/plugins/improvement/lib/state-key.sh\")",
    "Bash(bash WORKSPACE/.lane/plugins/architecture/lib/resolve-convention-home.sh)",
    "Bash(bash \"WORKSPACE/.lane/plugins/architecture/lib/resolve-convention-home.sh\")",
    "Bash(bash WORKSPACE/.lane/plugins/architecture/lib/read-verification.sh --plugin architecture --skill improve)",
    "Bash(bash \"WORKSPACE/.lane/plugins/architecture/lib/read-verification.sh\" --plugin architecture --skill improve)",
    "Bash(node WORKSPACE/.lane/plugins/architecture/skills/improve/scripts/improve-settings.mjs --home docs/conventions)",
    "Bash(node \"WORKSPACE/.lane/plugins/architecture/skills/improve/scripts/improve-settings.mjs\" --home docs/conventions)",
    "Bash(node WORKSPACE/.lane/plugins/architecture/skills/improve/scripts/improve-settings.mjs --no-config)",
    "Bash(node \"WORKSPACE/.lane/plugins/architecture/skills/improve/scripts/improve-settings.mjs\" --no-config)"
  ],
  "disallowed": [
    "Bash(git push *)",
    "Bash(gh *)",
    "Bash(curl *)",
    "Bash(wget *)",
    "Bash(env*)",
    "Bash(printenv*)",
    "Bash(node -e *)",
    "Bash(node --eval *)",
    "Bash(python* -c *)",
    "Bash(bash -c *)",
    "Bash(*/proc/*)",
    "Bash(*../*)",
    "Bash(git *--ou*)",
    "Bash(sort *-*o*)",
    "Read(//proc/**)",
    "WebFetch",
    "WebSearch",
    "mcp__*"
  ]
}
