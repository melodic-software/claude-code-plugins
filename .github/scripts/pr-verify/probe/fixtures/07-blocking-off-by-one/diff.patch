 import { readFileSync, writeFileSync } from "node:fs";

+export const MAX_HISTORY = 5;
+
+// The newest MAX_HISTORY entries, oldest first.
+export function trimHistory(entries) {
+  return entries.slice(entries.length - MAX_HISTORY + 1);
+}
+
 export function appendHistory(file, entry) {
