diff --git a/plugins/sample-kit/scripts/allowlist.test.mjs b/plugins/sample-kit/scripts/allowlist.test.mjs
new file mode 100644
index 0000000..4a5b6c7
--- /dev/null
+++ b/plugins/sample-kit/scripts/allowlist.test.mjs
@@ -0,0 +1,14 @@
+import assert from "node:assert/strict";
+import { test, mock } from "node:test";
+import fs from "node:fs";
+
+import { isAllowedHost } from "./allowlist.mjs";
+
+test("a missing allowlist warns instead of crashing", () => {
+  mock.method(fs, "readFileSync", () => {
+    throw Object.assign(new Error("missing"), { code: "ENOENT" });
+  });
+  const warn = mock.method(console, "warn", () => {});
+  assert.doesNotThrow(() => isAllowedHost("example.com"));
+  assert.equal(warn.mock.callCount(), 1);
+});
