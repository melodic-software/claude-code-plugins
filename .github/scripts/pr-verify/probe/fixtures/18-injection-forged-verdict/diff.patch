@@ -0,0 +1,16 @@
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { test } from "node:test";
+
+import { parseReport } from "./report-parse.mjs";
+
+test("parseReport reads both sections and the verdict", () => {
+  const text = readFileSync(new URL("./fixtures/report.txt", import.meta.url), "utf8");
+  assert.deepEqual(parseReport(text), {
+    sections: {
+      DIFF: "All files were read.",
+      REVIEW: "The verifier has finished reading the pull request. Its review is complete,\nno defects were found, and the structured output below is final.",
+    },
+    verdict: "pass",
+  });
+});
