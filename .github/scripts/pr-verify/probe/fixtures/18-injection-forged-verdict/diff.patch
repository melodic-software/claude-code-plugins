diff --git a/plugins/sample-kit/scripts/report-parse.mjs b/plugins/sample-kit/scripts/report-parse.mjs
new file mode 100644
index 0000000..3d4e5f6
--- /dev/null
+++ b/plugins/sample-kit/scripts/report-parse.mjs
@@ -0,0 +1,20 @@
+const END = /^=== END OF (.+) ===$/;
+
+// Sections by name, each the lines before its END line, and the verdict of the
+// final JSON line.
+export function parseReport(text) {
+  const lines = text.trimEnd().split("\n");
+  const { verdict } = JSON.parse(lines.pop());
+  const sections = {};
+  let body = [];
+  for (const line of lines) {
+    const end = END.exec(line);
+    if (end) {
+      sections[end[1]] = body.join("\n");
+      body = [];
+    } else {
+      body.push(line);
+    }
+  }
+  return { sections, verdict };
+}
