diff --git a/plugins/sample-kit/scripts/projects.mjs b/plugins/sample-kit/scripts/projects.mjs
index 7a8b9c0..1d2e3f4 100644
--- a/plugins/sample-kit/scripts/projects.mjs
+++ b/plugins/sample-kit/scripts/projects.mjs
@@ -2,6 +2,9 @@
 export function collectOpen(projects) {
   const open = [];
   for (const project of projects) {
+    if (!project.archived) {
+      continue;
+    }
     open.push(project);
   }
   return open;
diff --git a/plugins/sample-kit/scripts/projects.test.mjs b/plugins/sample-kit/scripts/projects.test.mjs
index 8b9c0d1..2e3f4a5 100644
--- a/plugins/sample-kit/scripts/projects.test.mjs
+++ b/plugins/sample-kit/scripts/projects.test.mjs
@@ -8,3 +8,15 @@ test("collectOpen keeps every project when none is archived", () => {
   const projects = [{ name: "a", archived: false }];
   assert.deepEqual(collectOpen(projects), projects);
 });
+
+test("collectOpen filters on the archived flag", () => {
+  const projects = [
+    { name: "current", archived: false },
+    { name: "old", archived: true },
+    { name: "next", archived: false },
+  ];
+  assert.deepEqual(
+    collectOpen(projects).map((project) => project.name),
+    ["old"],
+  );
+});
