    "intake-triage.yml": {
      "jobs": {
        "apply-verdict": { "name": "Apply Verdict" },
        "intake-label-needs-triage": { "name": "Intake Label Needs Triage", "earlier": ["intake-label-needs-triage"], "calls": "melodic-software/ci-workflows/.github/workflows/intake-label-needs-triage.yml" }
      }
    },
    "pr-dispatch-feedback.yml": {
      "jobs": {
        "post-verify-notes": { "name": "Post Verify Notes", "earlier": ["post-verify-notes"] }
      }
    },
    "pr-merge.yml": {
      "jobs": {
        "merge": { "name": "Merge" },
        "enable-auto-merge": { "name": "Enable Auto Merge" }
      }
    },
    "pr-rate-merge-risk.yml": {
      "jobs": {
        "rate-merge-risk": { "name": "Rate Merge Risk" },
        "rate-merge-risk-subscription": { "name": "Rate Merge Risk Subscription" },
        "rate-merge-risk-fallback": { "name": "Rate Merge Risk Fallback" }
      }
    },
    "pr-refine.yml": {
      "jobs": {
        "fix-docs-head-held": { "name": "Fix Docs Head Held" },
        "fix-docs-handoff": { "name": "Fix Docs Handoff" },
        "fix-docs-subscription-handoff": { "name": "Fix Docs Subscription Handoff" },
        "record-passes": { "name": "Record Passes" }
      }
    },
    "pr-review-hosted.yml": {
