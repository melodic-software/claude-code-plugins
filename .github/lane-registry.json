      "jobs": {
        "check-intent": { "name": "Check Intent" },
        "check-intent-subscription": { "name": "Check Intent Subscription" },
        "check-intent-fallback": { "name": "Check Intent Fallback" }
      }
    },
    "work-resolve-issue.yml": {
      "jobs": {
        "pick-slot": { "name": "Pick Slot" },
        "report-skip": { "name": "Report Skip", "calls": "./.github/workflows/pr-run-activity-write.yml" },
        "apply-issue-patch": { "name": "Apply Issue Patch", "calls": "./.github/workflows/pr-run-activity-write.yml" },
        "report-outcome": { "name": "Report Outcome", "calls": "./.github/workflows/pr-run-activity-write.yml" }
      }
    },
    "work-unblock.yml": {
      "jobs": {
        "label-unblocked": { "name": "Label Unblocked" }
      }
    }
