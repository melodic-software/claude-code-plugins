      "jobs": {
        "check-kill-switch": { "name": "Check Kill Switch", "earlier": ["Kill Switch", "kill-switch"] },
        "pr-review": {
          "name": "PR Review",
          "earlier": ["pr-review"],
          "calls": "melodic-software/ci-workflows/.github/workflows/pr-review-cli.yml",
          "status": ["review-status", "Status", "Publish Review"]
        }
      }
    },
    "pr-review-main.yml": {
      "jobs": {
        "check-trigger": { "name": "Check Trigger", "earlier": ["Trigger", "trigger"] },
        "review": { "name": "Review" },
        "review-subscription": { "name": "Review Subscription" },
        "review-fallback": { "name": "Review Fallback" }
      }
    },
    "pr-review-security-hosted.yml": {
      "lane": "claude-security-review",
      "jobs": {
        "check-kill-switch": { "name": "Check Kill Switch", "earlier": ["Kill Switch", "kill-switch"] },
        "pr-review-security": {
          "name": "PR Review Security",
          "earlier": ["pr-review-security"],
          "calls": "melodic-software/ci-workflows/.github/workflows/pr-review-cli.yml",
          "status": ["review-status", "Status", "Publish Review"]
        }
      }
    },
    "pr-run-activity-write.yml": {
      "jobs": {
        "run": { "name": "Run" }
      }
    },
    "pr-unblock.yml": {
      "jobs": {
        "apply-conflict-patch": { "name": "Apply Conflict Patch", "calls": "./.github/workflows/pr-run-activity-write.yml" },
        "apply-feedback-patch": { "name": "Apply Feedback Patch", "calls": "./.github/workflows/pr-run-activity-write.yml" },
        "publish-feedback": { "name": "Publish Feedback", "calls": "./.github/workflows/pr-run-activity-write.yml" },
        "resolve-feedback-threads": { "name": "Resolve Feedback Threads", "calls": "./.github/workflows/pr-run-activity-write.yml" },
        "apply-dependency-patch": { "name": "Apply Dependency Patch", "calls": "./.github/workflows/pr-run-activity-write.yml" },
        "apply-dependency-verdict": { "name": "Apply Dependency Verdict", "calls": "./.github/workflows/pr-run-activity-write.yml" },
        "apply-dependency-pin": { "name": "Apply Dependency Pin", "calls": "./.github/workflows/pr-run-activity-write.yml" },
        "apply-dependency-relock": { "name": "Apply Dependency Relock", "calls": "./.github/workflows/pr-run-activity-write.yml" },
        "apply-cdn-pins-sync": { "name": "Apply CDN Pins Sync", "calls": "./.github/workflows/pr-run-activity-write.yml" },
        "apply-patch": { "name": "Apply Patch", "calls": "./.github/workflows/pr-run-activity-write.yml" },
        "apply-patch-rung-up": { "name": "Apply Patch Rung Up", "calls": "./.github/workflows/pr-run-activity-write.yml" },
        "apply-shared-copies": { "name": "Apply Shared Copies", "calls": "./.github/workflows/pr-run-activity-write.yml" },
        "report-escalation": { "name": "Report Escalation", "calls": "./.github/workflows/pr-run-activity-write.yml" }
