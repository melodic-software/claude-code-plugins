{
  "ci-context": {
    "refuse": ["github", "claude", "mcp-config", "gitmodules", "settings", "symlink", "gitlink", "new-executable", "rename-into-refused", "instruction-path"],
    "allow": ["any"],
    "max-files": 300,
    "requires": [],
    "commit": { "parents": ["head"], "message": "Fix failing CI checks on {ref}", "trailer": "Lane-Activity: {lane}/{activity}" },
    "reads-report": "ci-escalations",
    "skip-moved-head": true,
    "empty-at-push": "invalid",
    "escalations": ["ci-fix-empty", "ci-fix-escalated", "ci-fix-invalid", "ci-fix-not-applied", "ci-fix-protected-path"]
  },
  "review-threads": {
    "refuse": ["github", "claude", "mcp-config", "gitmodules", "settings", "symlink", "gitlink", "new-executable", "rename-into-refused"],
    "allow": ["kept-threads"],
    "max-files": 300,
    "requires": [],
    "commit": { "parents": ["head"], "message": "Address review feedback on {ref}", "trailer": "Lane-Activity: {lane}/{activity}" },
    "reads-report": null,
    "escalations": ["feedback-not-landed", "patch-invalid", "patch-not-applied", "patch-protected-path"]
  },
  "dependency-review": {
    "refuse": ["github", "claude", "mcp-config", "gitmodules", "settings", "symlink", "gitlink", "new-executable", "rename-into-refused"],
    "allow": ["dependency-manifests"],
    "max-files": 300,
    "requires": ["dependency-verdict: fix"],
    "commit": { "parents": ["head"], "message": "Fix the dependency update on {ref} [dependabot skip]", "trailer": "Lane-Activity: {lane}/{activity}" },
    "reads-report": null,
    "escalations": ["dependency-fix-not-landed", "patch-invalid", "patch-not-applied", "patch-protected-path"]
  },
  "merge-base": {
    "refuse": ["github", "claude", "mcp-config", "gitmodules", "settings", "symlink", "gitlink", "new-executable", "rename-into-refused"],
    "allow": ["merge-result"],
    "max-files": null,
    "requires": [],
    "commit": { "parents": ["head", "base"], "message": "Merge {base} into {ref}", "trailer": "Lane-Activity: {lane}/{activity}" },
    "reads-report": null,
    "escalations": ["unresolved-conflict", "unexpected-path-staged", "patch-invalid", "patch-not-applied", "patch-protected-path"]
  },
  "default": {
    "refuse": ["github", "claude", "mcp-config", "gitmodules", "settings", "symlink", "gitlink", "new-executable", "rename-into-refused", "instruction-path"],
    "allow": ["any"],
    "max-files": 300,
    "requires": [],
    "commit": { "parents": ["head"], "message": "Apply {activity} on {ref}", "trailer": "Lane-Activity: {lane}/{activity}" },
    "reads-report": null,
    "skip-moved-head": false,
    "escalations": ["patch-empty", "patch-invalid", "patch-not-applied", "patch-protected-path"]
  },
  "issue": {
    "refuse": ["github", "claude", "mcp-config", "gitmodules", "settings", "symlink", "gitlink", "new-executable", "rename-into-refused"],
    "allow": ["any"],
    "max-files": 300,
    "requires": [],
    "commit": { "parents": ["head"], "message": "Resolve issue #{issue}", "trailer": "Lane-Activity: {lane}/{activity}" },
    "reads-report": null,
    "escalations": ["patch-empty", "patch-invalid", "patch-not-applied", "patch-protected-path"]
  }
}
