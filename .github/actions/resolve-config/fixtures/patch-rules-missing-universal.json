{
  "default": {
    "refuse": [
      "github-workflows",
      "settings",
      "agent-instructions",
      "gitattributes",
      "symlink",
      "gitlink",
      "rename-into-refused"
    ],
    "allow": [
      "any"
    ],
    "max-files": null,
    "requires": [],
    "commit": {
      "parents": [
        "head"
      ],
      "message": "Apply {activity} on {ref}",
      "trailer": "Lane-Activity: {lane}/{activity}"
    },
    "reads-report": null,
    "escalations": [
      "patch-empty",
      "patch-invalid",
      "patch-not-applied",
      "patch-protected-path"
    ]
  },
  "issue": {
    "refuse": [
      "github-workflows",
      "agent-instructions",
      "gitattributes",
      "symlink",
      "gitlink",
      "rename-into-refused"
    ],
    "allow": [
      "any"
    ],
    "max-files": null,
    "requires": [],
    "commit": {
      "parents": [
        "head"
      ],
      "message": "Resolve issue #{issue}",
      "trailer": "Lane-Activity: {lane}/{activity}"
    },
    "reads-report": null,
    "escalations": [
      "patch-empty",
      "patch-invalid",
      "patch-not-applied",
      "patch-protected-path"
    ]
  }
}
