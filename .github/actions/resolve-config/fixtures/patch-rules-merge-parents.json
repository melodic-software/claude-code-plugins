{
  "default": {
    "refuse": [
      "github",
      "claude",
      "mcp-config",
      "gitmodules",
      "settings",
      "symlink",
      "gitlink",
      "new-executable",
      "rename-into-refused"
    ],
    "allow": [
      "any"
    ],
    "max-files": null,
    "requires": [],
    "commit": {
      "parents": [
        "head"
      ],
      "message": "Apply {activity} on {ref}",
      "trailer": "Lane-Activity: {lane}/{activity}"
    },
    "reads-report": null,
    "escalations": [
      "patch-empty",
      "patch-invalid",
      "patch-not-applied",
      "patch-protected-path"
    ]
  },
  "issue": {
    "refuse": [
      "github",
      "claude",
      "mcp-config",
      "gitmodules",
      "settings",
      "symlink",
      "gitlink",
      "new-executable",
      "rename-into-refused"
    ],
    "allow": [
      "any"
    ],
    "max-files": null,
    "requires": [],
    "commit": {
      "parents": [
        "head"
      ],
      "message": "Resolve issue #{issue}",
      "trailer": "Lane-Activity: {lane}/{activity}"
    },
    "reads-report": null,
    "escalations": [
      "patch-empty",
      "patch-invalid",
      "patch-not-applied",
      "patch-protected-path"
    ]
  },
  "merge-base": {
    "refuse": [
      "github",
      "claude",
      "mcp-config",
      "gitmodules",
      "settings",
      "symlink",
      "gitlink",
      "new-executable",
      "rename-into-refused"
    ],
    "allow": [
      "any"
    ],
    "max-files": null,
    "requires": [],
    "commit": {
      "parents": [
        "head",
        "base"
      ],
      "message": "Merge {base} into {ref}",
      "trailer": "Lane-Activity: {lane}/{activity}"
    },
    "reads-report": null,
    "escalations": [
      "unresolved-conflict",
      "unexpected-path-staged",
      "patch-invalid",
      "patch-not-applied",
      "patch-protected-path"
    ]
  }
}
