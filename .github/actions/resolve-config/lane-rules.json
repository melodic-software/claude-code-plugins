{
  "work-resolve-issue": {
    "stage": "work",
    "forbidden-effects": ["mutate-pr", "merge"],
    "never": "Merges, or marks its pull request ready"
  },
  "pr-refine": {
    "stage": "refine",
    "forbidden-effects": ["mutate-pr", "merge"],
    "never": "Changes behavior"
  },
  "pr-run-checks": {
    "stage": "verify",
    "forbidden-effects": ["mutate-branch", "mutate-pr", "merge"],
    "never": "Writes to the branch"
  },
  "pr-review": {
    "stage": "verify",
    "forbidden-effects": ["mutate-branch", "mutate-pr", "merge"],
    "never": "Pushes fixes"
  },
  "pr-review-security": {
    "stage": "verify",
    "forbidden-effects": ["mutate-branch", "mutate-pr", "merge"],
    "never": "Pushes fixes"
  },
  "pr-verify": {
    "stage": "verify",
    "forbidden-effects": ["mutate-branch", "mutate-pr", "merge"],
    "never": "Pushes fixes"
  },
  "pr-explain": {
    "stage": "verify",
    "forbidden-effects": ["mutate-pr", "merge"],
    "forbidden-gating": ["gate"],
    "never": "Gates"
  },
  "pr-require-checks": {
    "stage": "verify",
    "forbidden-effects": [
      "mutate-branch",
      "mutate-pr",
      "mutate-tracker",
      "publish-artifact",
      "merge"
    ],
    "never": "Runs work; it only produces `ci-status`"
  },
  "pr-unblock": {
    "stage": "unblock",
    "forbidden-effects": ["merge"],
    "never": "Merges"
  },
  "pr-merge": {
    "stage": "merge",
    "forbidden-effects": [],
    "never": "Merges above the rung, past a hold, or a PR that touches a trust-root path"
  },
  "post-merge-verify": {
    "stage": "post-merge",
    "forbidden-effects": ["mutate-branch", "mutate-pr", "merge"],
    "never": "Edits PRs"
  },
  "post-merge-sweep-comments": {
    "stage": "post-merge",
    "forbidden-effects": ["mutate-pr", "merge"],
    "never": "Reopens merged PRs"
  }
}
