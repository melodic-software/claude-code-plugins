{
  "work-resolve-issue": {
    "stage": "work",
    "forbidden-effects": ["merge"],
    "never": "Merges, or marks its pull request ready"
  },
  "intake-triage": {
    "stage": "intake",
    "forbidden-effects": ["mutate-branch", "publish-artifact", "merge"],
    "never": "Writes to a branch"
  },
  "work-unblock": {
    "stage": "work",
    "forbidden-effects": ["mutate-branch", "publish-artifact", "merge"],
    "activity-grants": { "publish-lane-level": { "actions-variables": "write" } },
    "never": "Writes to a branch, labels an issue that carries a hold label, or writes any repository variable but the lane level"
  },
  "pr-refine": {
    "stage": "refine",
    "forbidden-effects": ["merge"],
    "never": "Changes behavior"
  },
  "pr-run-checks": {
    "stage": "verify",
    "forbidden-effects": ["mutate-branch", "merge"],
    "never": "Writes to the branch"
  },
  "pr-review": {
    "stage": "verify",
    "forbidden-effects": ["mutate-branch", "merge"],
    "never": "Pushes fixes"
  },
  "pr-review-security": {
    "stage": "verify",
    "forbidden-effects": ["mutate-branch", "merge"],
    "never": "Pushes fixes"
  },
  "pr-verify": {
    "stage": "verify",
    "forbidden-effects": ["mutate-branch", "merge"],
    "never": "Pushes fixes"
  },
  "pr-explain": {
    "stage": "verify",
    "forbidden-effects": ["merge"],
    "forbidden-gating": ["gate"],
    "never": "Gates"
  },
  "pr-require-checks": {
    "stage": "verify",
    "forbidden-effects": [
      "mutate-branch",
      "mutate-tracker",
      "publish-artifact",
      "merge"
    ],
    "never": "Runs work; it only produces `ci-status`"
  },
  "pr-unblock": {
    "stage": "unblock",
    "forbidden-effects": ["merge"],
    "never": "Merges"
  },
  "pr-merge": {
    "stage": "merge",
    "forbidden-effects": [],
    "never": "Merges above the rung, past a hold, or a PR that touches a denied path"
  },
  "post-merge-verify": {
    "stage": "post-merge",
    "forbidden-effects": ["mutate-branch", "merge"],
    "never": "Edits PRs"
  },
  "post-merge-sweep-comments": {
    "stage": "post-merge",
    "forbidden-effects": ["merge"],
    "never": "Reopens merged PRs"
  },
  "upstream-apply-changelog": {
    "stage": "upstream",
    "forbidden-effects": ["mutate-tracker", "merge"],
    "never": "Merges, or writes to main or a branch outside changelog/<plugin>/v<release>"
  },
  "maintenance-tidy-code-upkeep": {
    "stage": "maintenance",
    "forbidden-effects": ["mutate-tracker", "merge"],
    "never": "Merges, or writes to main or a branch outside chore/tidy-adhoc-<slug>-<date>"
  },
  "maintenance-measure-skill-edit": {
    "stage": "maintenance",
    "forbidden-effects": ["mutate-tracker", "merge"],
    "never": "Merges, marks a pull request ready, or writes to main or a branch outside chore/hill-climb-<plugin>-<skill>-<run id>, which holds only the skill's markdown and one .changes/<plugin>/ fragment"
  }
}
