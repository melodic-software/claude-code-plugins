{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.melodic.software/pr-convention-policy/policy.schema.json",
  "title": "PR convention policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "body"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedTypes", "requireScope"],
      "properties": {
        "allowedTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*$"
          }
        },
        "requireScope": { "type": "boolean" }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredSections", "closingKeywords", "noIssueMarkers"],
      "properties": {
        "requiredSections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "closingKeywords": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z]*$"
          }
        },
        "noIssueMarkers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
