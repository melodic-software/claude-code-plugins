    "Ruff",
    "WinGet",
    "WinGet Configuration",
    "Windows"
  ],
  "displayNameLevel": "error",
  "jobNameExceptions": [],
  "exemptions": [
    {
      "path": ".github/workflows/pr-feedback-dispatch.yml",
      "repository": "melodic-software/claude-code-plugins",
      "rules": ["workflow-filename"],
      "reason": "The file name is not verb-first after its stage; its rename is tracked in melodic-software/claude-code-plugins#15394, which removes this entry."
    },
    {
      "path": ".github/workflows/release-deploy.yml",
      "repository": "melodic-software/github-iac",
      "rules": ["workflow-name"],
      "expectedName": "release-deploy",
      "reason": "The Pulumi issuer policy trusts this exact workflow name in the OIDC `workflow` claim, so renaming it would fail production deploys."
    },
    {
      "path": ".github/workflows/release-deploy-oidc-negative-test.yml",
      "repository": "melodic-software/github-iac",
      "rules": ["workflow-name"],
      "expectedName": "release-deployx",
      "reason": "OIDC negative test: its name is the deploy workflow's name plus one character, so the Pulumi issuer policy that trusts `release-deploy` must reject it."
    }
  ],
  "apps": {
    "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
    "names": [
      {
        "name": "melodic-automation-lanes",
        "purpose": "Mints short-lived, per-job scoped tokens for agent lanes."
      }
    ]
  }
}
