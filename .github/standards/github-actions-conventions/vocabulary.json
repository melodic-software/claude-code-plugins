    "delete",
    "deploy",
    "detect",
    "dispatch",
    "download",
    "enable",
    "explain",
    "file",
    "fix",
    "format",
    "fuzz",
    "generate",
    "install",
    "label",
    "lint",
    "log",
    "measure",
    "merge",
    "monitor",
    "notify",
    "open",
    "prune",
    "publish",
    "rate",
    "reconcile",
    "reenter",
    "refine",
    "regenerate",
    "repin",
    "report",
    "request",
    "require",
    "resolve",
    "respond",
    "review",
    "run",
    "scan",
    "seal",
    "select",
    "setup",
    "sign",
    "simplify",
    "sweep",
    "sync",
    "tag",
    "test",
    "tidy",
    "triage",
    "unblock",
    "update",
    "upload",
    "validate",
    "verify"
  ],
  "toolNames": [
    "actionlint",
    "biome",
    "check-jsonschema",
    "dotnet-build",
    "dotnet-format",
    "editorconfig-checker",
    "gitleaks",
    "golangci-lint",
    "govulncheck",
    "hadolint",
    "jsonschema",
    "lychee",
    "lychee-offline",
    "markdownlint",
    "osv-scanner",
    "psscriptanalyzer",
    "pyright",
    "ruff",
    "shellcheck",
    "shfmt",
    "tsc",
    "typos",
    "zizmor"
  ],
  "engines": ["bugbot", "claude", "codex"],
  "reservedJobIds": ["ci-status"],
  "activityGrammar": {
    "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(#[a-z]+)?$",
    "modes": [["diff", "tree"], ["report", "fix"], ["baseline", "compare"]],
    "rules": [
      "Verb-first and literal: the name says what the activity does.",
      "No stage word at the start of an activity name: the slot already carries the stage.",
      "Exception: a review-engine unit is named for the engine only (`engines`), with no slot word."
    ],
    "examples": [
      "simplify",
      "tidy",
      "fix-docs",
      "check-intent",
      "test-e2e",
      "explain",
      "measure-coverage",
      "measure-complexity",
      "test-mutation",
      "simplify#diff",
      "fix-docs#report"
    ]
  },
  "displayWords": {
    "acl": "ACL",
    "api": "API",
    "ci": "CI",
    "cli": "CLI",
    "dotnet": ".NET",
    "editorconfig": "EditorConfig",
    "markdownlint": "markdownlint",
    "nuget": "NuGet",
    "oidc": "OIDC",
    "pr": "PR",
    "psscriptanalyzer": "PSScriptAnalyzer",
    "wip": "WIP",
    "yq": "yq"
  },
  "properNouns": [
    "App",
    "Bash",
    "Biome",
    "Bun",
    "Buildx",
    "Chromium",
    "Claude",
    "Claude Code",
    "Codex",
    "Dependabot",
