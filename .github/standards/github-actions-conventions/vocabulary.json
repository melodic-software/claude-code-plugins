{
  "$schema": "./vocabulary.schema.json",
  "schemaVersion": 1,
  "stages": [
    { "name": "intake", "purpose": "Classify and label incoming issues and requests." },
    { "name": "plan", "purpose": "Turn accepted work into a plan before implementation starts." },
    {
      "name": "work",
      "purpose": "Do the work outside a pull request, such as answering a mention."
    },
    { "name": "pr", "purpose": "Run on a pull request until it merges." },
    { "name": "post-merge", "purpose": "Check the default branch after a merge." },
    { "name": "release", "purpose": "Tag, publish and deploy." },
    { "name": "maintenance", "purpose": "Scheduled upkeep: sync, repin, audits and scans." },
    { "name": "upstream", "purpose": "Track and take in changes from upstream sources." }
  ],
  "functions": {
    "intake": [
      { "name": "label", "status": "in-use" },
      { "name": "label-needs-triage", "status": "in-use" },
      { "name": "reenter", "status": "in-use" },
      { "name": "triage", "status": "in-use" }
    ],
    "plan": [],
    "work": [
      {
        "name": "resolve-issue",
        "status": "reserved",
        "purpose": "Work one labeled issue to a draft pull request, or push it back to a human."
      },
      { "name": "respond-mention", "status": "in-use" },
      {
        "name": "unblock",
        "status": "reserved",
        "purpose": "Promote issues whose last blocker closed."
      }
    ],
    "pr": [
      { "name": "audit-workflows", "status": "in-use" },
      { "name": "automerge", "status": "in-use" },
      { "name": "bump-plugin-version", "status": "in-use" },
      { "name": "check-managed-files", "status": "in-use" },
      { "name": "check-spelling", "status": "in-use" },
      { "name": "dispatch-feedback", "status": "in-use" },
      {
        "name": "explain",
        "status": "reserved",
        "purpose": "Explain the pull request for human readers; runs alongside verify."
      },
      { "name": "lint-dockerfile", "status": "in-use" },
      { "name": "merge", "status": "reserved", "purpose": "Merge the pull request." },
      { "name": "rate-merge-risk", "status": "in-use" },
      {
        "name": "refine",
        "status": "reserved",
        "purpose": "Make behavior-preserving changes that leave a ready pull request review-ready, then dispatch the review lanes."
      },
      { "name": "regenerate-nuget-lockfiles", "status": "in-use" },
      { "name": "require-checks", "status": "in-use" },
      { "name": "review", "status": "in-use" },
      { "name": "review-security", "status": "in-use" },
      { "name": "run-activity", "status": "in-use" },
      { "name": "run-checks", "status": "in-use" },
      { "name": "run-plugin-evals", "status": "in-use" },
      { "name": "scan-dependencies", "status": "in-use" },
      {
        "name": "test-platforms",
        "status": "reserved",
        "purpose": "Select and run the tests that need a Windows or macOS runner."
      },
      { "name": "test-windows", "status": "in-use" },
      { "name": "unblock", "status": "in-use" },
      { "name": "validate-onboard-catalog", "status": "in-use" },
      {
        "name": "verify",
        "status": "reserved",
        "purpose": "Host the non-review verify activities: check-intent, test-e2e and release-readiness."
      }
    ],
    "post-merge": [
      { "name": "detect-silent-revert", "status": "in-use" },
      { "name": "file-demotion-issues", "status": "in-use" },
      { "name": "select-mutation-range", "status": "in-use" },
      {
        "name": "sweep-comments",
        "status": "reserved",
        "purpose": "File late review comments as issues."
      },
      { "name": "test-mutation", "status": "in-use" },
      {
        "name": "verify",
        "status": "reserved",
        "purpose": "Check the default branch after a lane merges."
      }
    ],
    "release": [
      { "name": "deploy", "status": "in-use" },
      { "name": "generate-dependabot-changelog-fragments", "status": "in-use" },
      { "name": "publish-binaries", "status": "in-use" },
      { "name": "publish-image", "status": "in-use" },
      {
        "name": "publish-plugins",
        "status": "reserved",
        "purpose": "Publish Claude Code plugins to their marketplace."
      },
      { "name": "tag", "status": "in-use" }
    ],
    "maintenance": [
      { "name": "audit-code-review-rules", "status": "in-use" },
      { "name": "audit-lane-runs", "status": "in-use" },
      { "name": "audit-link-check-excludes", "status": "in-use" },
      { "name": "audit-org-architecture-pointer", "status": "in-use" },
      { "name": "audit-pr-convention-pins", "status": "in-use" },
      { "name": "audit-test-selection", "status": "in-use" },
      { "name": "bump-pinned-versions", "status": "in-use" },
      { "name": "check-dependency-freshness", "status": "in-use" },
      {
        "name": "check-links",
        "status": "in-use",
        "purpose": "Check every Markdown link with the network on."
      },
      { "name": "check-upstream-drift", "status": "in-use" },
      { "name": "delete-stale-branches", "status": "in-use" },
      { "name": "file-dead-links", "status": "in-use" },
      { "name": "file-recurring-issues", "status": "in-use" },
      { "name": "file-upstream-drift-issues", "status": "in-use" },
      {
        "name": "measure-skill-edit",
        "status": "in-use",
        "purpose": "Measure one proposed skill edit against the merged skill on a person's dispatch, and open a draft pull request when it wins."
      },
      { "name": "monitor-signals", "status": "in-use" },
      { "name": "reconcile-lost-runs", "status": "in-use" },
      { "name": "reconcile-pr-creation-policy", "status": "in-use" },
      { "name": "repin-account-rotation", "status": "in-use" },
      { "name": "repin-ci-workflows", "status": "in-use" },
      { "name": "scan-secrets", "status": "in-use" },
      { "name": "sweep-closed-pr-branches", "status": "in-use" },
      { "name": "sync-standards", "status": "in-use" },
      {
        "name": "tidy-code-upkeep",
        "status": "reserved",
        "purpose": "Detect churn per merge and open code-tidying pull requests as a daily batch."
      },
      { "name": "verify-governance", "status": "in-use" },
      { "name": "verify-ruleset-drift", "status": "in-use" }
    ],
    "upstream": [
      {
        "name": "apply-changelog",
        "status": "reserved",
        "purpose": "Apply an upstream release's changelog: a branch and pull request per owner plugin, and handoff issues for the rest."
      }
    ]
  },
  "verbs": [
    "address",
    "aggregate",
    "apply",
    "assess",
    "attest",
    "audit",
    "automerge",
    "build",
    "bump",
