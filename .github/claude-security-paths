# Repo-owned security-review scope: this repo's security-sensitive surfaces.
# Read by the LOCAL security review, on the operator's own session, through the
# `security` rule of the `pr_skill_evidence` key in .claude/source-control.md,
# which cites this file as `@file:.github/claude-security-paths`. No CI lane
# reads it. The breadth below is what makes that review fire on nearly every
# non-docs pull request, which is deliberate.
# Format: gitignore patterns (one per line), matched via `git check-ignore`
# from the repo root; `!`, `?`, and `+` are forbidden. `#` comments and blank
# lines are ignored.
.github/**
.claude/**
scripts/**
plugins/*/hooks/**
plugins/*/bin/**
plugins/*/tools/**
plugins/*/skills/**
plugins/*/agents/**
plugins/*/commands/**
.claude-plugin/**
REVIEW.md
CLAUDE.md
AGENTS.md
plugins/*/src/**
plugins/*/dist/**
**/*.sh
**/*.ps1
**/*.mjs
**/*.ts
**/*.js
**/*.cjs
**/.mcp.json
**/mcp.json
**/package.json
**/package-lock.json
