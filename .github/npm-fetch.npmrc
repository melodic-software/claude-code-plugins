# The fetch bound for every CI `npm ci` on a GitHub-hosted runner: each
# workflow that installs points npm_config_globalconfig at this file, the one
# place the values are written. npm's defaults are fetch-timeout 300000 (5
# minutes) and fetch-retries 2, so a stalled registry request held a job for
# up to three 5-minute attempts. https://docs.npmjs.com/cli/v11/using-npm/config
fetch-timeout=60000
fetch-retries=1
