      "claude-in-chrome": {"aliases":[],"class":"bundled-skill","description":"Automates your Chrome browser to interact with web pages - clicking elements, filling forms, capturing screenshots, reading console logs, and navigating sites. Opens pages in new tabs within your existing Chrome session. Requires site-level permissions before executing (configured in the extension).","invocable_by":"model+user","markers":["gated"],"model_invocable":true},
      "code-review": {"aliases":["review"],"class":"bundled-skill","description":"Review the current diff, or a PR number/branch/path target, for correctness bugs (plus broken CLAUDE.md rules and cleanups where the model's recipe covers them; see /simplify) at the effort level given first, before any target (…: from few high-confidence findings to many, some uncertain); with no l","invocable_by":"model+user","markers":[],"model_invocable":true},
