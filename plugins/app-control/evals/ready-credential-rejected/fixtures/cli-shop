#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  ready)
    [[ -n "${2:-}" ]] || { printf '%s\n' '{"error": "usage: cli/shop ready <run dir>"}' >&2; exit 2; }
    printf '%s\n' '{"health": {"url": "http://127.0.0.1:18080/health", "status": 200, "body": {"status": "ok"}}, "port_owner": {"listener_pid": 5120, "launched_pid": 5120, "holds": true}, "credentials": {"buyer": {"url": "http://127.0.0.1:18080/api/me", "status": 401, "error": "token rejected"}}}'
    exit 3
    ;;
  *)
    printf '%s\n' '{"error": "usage: cli/shop ready <run dir>"}' >&2
    exit 2
    ;;
esac
