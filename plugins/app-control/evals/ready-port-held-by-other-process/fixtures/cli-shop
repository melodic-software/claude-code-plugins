#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  ready)
    [[ -n "${2:-}" ]] || { printf '%s\n' '{"error": "usage: cli/shop ready <run dir>"}' >&2; exit 2; }
    printf '%s\n' '{"health": {"url": "http://127.0.0.1:18080/health", "status": 200, "body": {"status": "ok"}}, "port_owner": {"listener_pid": 4242, "listener_command_line": "python3 shop/server.py --port 18080 --data /tmp/shop-earlier-run/data", "launched_pid": 5120, "holds": false}}'
    exit 4
    ;;
  *)
    printf '%s\n' '{"error": "usage: cli/shop ready <run dir>"}' >&2
    exit 2
    ;;
esac
