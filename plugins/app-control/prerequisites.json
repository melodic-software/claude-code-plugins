{
  "requires": [
    {
      "id": "node",
      "kind": "runtime",
      "need": "optional",
      "for": ["plugin"],
      "detect": { "any": ["node"] },
      "degrade": "Without node, the prerequisites checker cannot run and no dependency is verified; the plugin's own skills are unaffected.",
      "install": {
        "docs": "https://nodejs.org/en/download",
        "brew": "node",
        "winget": "OpenJS.NodeJS.LTS",
        "apt": "nodejs"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "python3",
      "kind": "runtime",
      "need": "optional",
      "for": ["skill:drive"],
      "detect": {
        "any": ["python3"],
        "reject_store_alias": true
      },
      "degrade": "Without python3, drive cannot run verify_pin.py, so every feature that includes an integrated app stops at its pin check; features with no include drive normally.",
      "install": {
        "docs": "https://www.python.org/downloads/",
        "brew": "python",
        "winget": "Python.Python.3.12",
        "apt": "python3"
      },
      "check": "/harness-ops:prerequisites"
    }
  ]
}
