{
  "requires": [
    {
      "id": "typos",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:typos-format.sh"
      ],
      "detect": {
        "any": [
          "typos"
        ]
      },
      "degrade": "Without typos, commits and the end-of-turn check go unchecked for typos, and an agent's commit fails until typos is installed.",
      "install": {
        "cargo": "cargo install typos-cli",
        "docs": "https://github.com/crate-ci/typos#install"
      },
      "check": "/typos-format:check"
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "optional",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, the end-of-turn row reads its hook input with the shared hook library's builtin JSON check alone.",
      "install": {
        "docs": "https://jqlang.org/download/"
      },
      "check": "/typos-format:check"
    },
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the typos-format hooks cannot launch, so they do nothing.",
      "install": {
        "docs": "https://nodejs.org/en/download"
      },
      "check": "/typos-format:check"
    }
  ]
}
