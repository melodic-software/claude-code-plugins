{
  "description": "Optionally checks the uncommitted changes for typos when a turn ends; harness-ops reports a missing typos or a drifted git-hook entry at session start, from this plugin's prerequisites.json; spelling findings otherwise arrive at commit time.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--run-if-unset-or-true",
              "TYPOS_FORMAT_ENABLED",
              "--require-true",
              "TYPOS_FORMAT_END_OF_TURN",
              "${CLAUDE_PLUGIN_ROOT}/hooks/typos-format.sh",
              "--end-of-turn"
            ],
            "timeout": 30,
            "statusMessage": "Checking spelling in uncommitted changes..."
          }
        ]
      }
    ]
  }
}
