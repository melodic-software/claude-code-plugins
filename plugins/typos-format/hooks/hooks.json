{
  "description": "Corrects spelling in prose and code after a write or edit, and reports a missing typos at session start.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--run-if-unset-or-true",
              "TYPOS_FORMAT_ENABLED",
              "${CLAUDE_PLUGIN_ROOT}/hooks/typos-format.sh"
            ],
            "timeout": 15,
            "statusMessage": "Checking spelling..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.sh\" node-notice /typos-format:check TYPOS_FORMAT_ENABLED; ${BASH_VERSION:+exit}; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.ps1\" node-notice /typos-format:check TYPOS_FORMAT_ENABLED",
            "timeout": 10,
            "statusMessage": "Checking that node is on PATH..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--run-if-unset-or-true",
              "TYPOS_FORMAT_ENABLED",
              "${CLAUDE_PLUGIN_ROOT}/hooks/probe-prerequisite.sh"
            ],
            "timeout": 10,
            "statusMessage": "Checking typos..."
          }
        ]
      }
    ]
  }
}
