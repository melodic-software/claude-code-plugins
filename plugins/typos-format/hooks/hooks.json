{
  "description": "Corrects spelling in prose and code after a write or edit, optionally checks the uncommitted changes when a turn ends, and reports a missing typos or a drifted git-hook entry at session start.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--run-if-unset-or-true",
              "TYPOS_FORMAT_ENABLED",
              "${CLAUDE_PLUGIN_ROOT}/hooks/typos-format.sh"
            ],
            "timeout": 15,
            "statusMessage": "Checking spelling..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--run-if-unset-or-true",
              "TYPOS_FORMAT_ENABLED",
              "--require-true",
              "TYPOS_FORMAT_END_OF_TURN",
              "${CLAUDE_PLUGIN_ROOT}/hooks/typos-format.sh",
              "--end-of-turn"
            ],
            "timeout": 30,
            "statusMessage": "Checking spelling in uncommitted changes..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.mjs",
              "probe",
              "${CLAUDE_PLUGIN_ROOT}",
              "--run-if-unset-or-true",
              "TYPOS_FORMAT_ENABLED"
            ],
            "timeout": 10,
            "statusMessage": "Checking typos..."
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.sh\" node-notice /typos-format:check TYPOS_FORMAT_ENABLED; ${PPID:+exit}; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.ps1\" node-notice /typos-format:check TYPOS_FORMAT_ENABLED",
            "timeout": 10,
            "statusMessage": "Checking that node is on PATH..."
          }
        ]
      },
      {
        "matcher": "compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/typos-format.sh",
              "--reset-digests"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
