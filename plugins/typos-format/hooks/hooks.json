{
  "description": "Corrects spelling in prose and code after a write or edit.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "set +u; [ \"$CLAUDE_PLUGIN_OPTION_TYPOS_FORMAT_ENABLED\" = true ] || [ -z \"$CLAUDE_PLUGIN_OPTION_TYPOS_FORMAT_ENABLED\" ] || exit 0; exec bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/typos-format.sh",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Checking spelling..."
          }
        ]
      }
    ]
  }
}
