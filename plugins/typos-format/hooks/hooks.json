{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/typos-format.sh",
            "timeout": 15,
            "statusMessage": "Checking spelling..."
          }
        ]
      }
    ]
  }
}
