{
  "remote": {
    "git_url": "https://github.com/melodic-software/claude-code-plugins",
    "ref": "main",
    "config": "plugins/spelling/git-hooks/lefthook-remote.yml",
    "aggregate": "lefthook-remote.yml"
  },
  "earlierNames": ["typos-format"],
  "earlierEntries": [{ "from": "typos-check", "to": ["lint"] }],
  "ecosystems": ["spelling"],
  "entries": [
    {
      "name": "lint",
      "event": "pre-commit",
      "script": "lint.sh",
      "tools": ["typos"],
      "rewrites": false,
      "resolved": true,
      "assets": ["config/default-typos.toml", "lib/git-hooks/resolve-tool.sh", "git-hooks/adapters.sh"]
    }
  ]
}
