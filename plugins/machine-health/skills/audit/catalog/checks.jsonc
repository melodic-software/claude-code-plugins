// machine-health check catalog
//
// Self-maintained by the skill. Entries are OS-tagged so a single catalog serves
// all hosts; the orchestrator filters to the current OS. Never silently remove an
// entry -- set "deprecated": true with a rationale instead.
//
// Field reference:
//   id                    - stable identifier used in reports and history
//   category              - high-level grouping (storage, security, updates, ...)
//   os                    - array of OS labels this check applies to
//   script                - path (relative to skill root) of the check implementation
//   severity_rules        - pointer to the human-readable rubric in references/
//   needs_admin           - whether elevation is required (hint, not enforced)
//   enabled               - false disables without deprecating
//   deprecated            - true keeps the entry for history continuity but skips execution
//   deprecation_reason    - required when deprecated is true
//   added_on              - ISO date when the entry was added
//   crash_count           - consecutive unhandled failures (3 triggers removal proposal)
//   identical_streak      - consecutive identical outputs (4 triggers demotion proposal)
{
  "checks": [
    {
      "id": "windows-update",
      "category": "updates",
      "os": ["windows"],
      "script": "scripts/windows/checks/Test-WindowsUpdate.ps1",
      "severity_rules": "references/windows/check-catalog.md#1-windows-update--pending-reboot",
      "needs_admin": false,
      "enabled": true,
      "deprecated": false,
      "added_on": "2026-04-22",
      "crash_count": 0,
      "identical_streak": 0
    },
    {
