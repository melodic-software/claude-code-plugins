{
  "description": "Gates the Stop event so a Ralph-loop lane continues or halts on its own recorded state.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--run-if-any-set",
              "LANE_STOP_GATE_ARM_ID,LANE_STOP_GATE_ENABLED",
              "--run-if-settings-mention",
              "lane_stop_gate",
              "${CLAUDE_PLUGIN_ROOT}/hooks/lane-stop-gate.sh"
            ],
            "timeout": 15,
            "statusMessage": "Checking lane-stop gate..."
          }
        ]
      }
    ]
  }
}
