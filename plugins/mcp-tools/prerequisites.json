{
  "requires": [
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "skill:audit-posture"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, /mcp-tools:audit-posture's inventory script exits 2 and reports no inventory. /mcp-tools:audit still works.",
      "install": {
        "docs": "https://jqlang.org/download/",
        "brew": "jq",
        "winget": "jqlang.jq",
        "apt": "jq"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "node",
      "kind": "cli",
      "need": "optional",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the prerequisites checker cannot run, so a missing tool above goes unreported; the plugin's own skills are unaffected.",
      "install": {
        "docs": "https://nodejs.org/en/download",
        "brew": "node",
        "winget": "OpenJS.NodeJS.LTS",
        "apt": "nodejs"
      },
      "check": "/harness-ops:prerequisites"
    }
  ]
}
