{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/melodic-software/claude-code-plugins/main/plugins/sql-server/schemas/config.v1.schema.json",
  "title": "sql-server plugin config, version 1",
  "description": "One file names every environment a registration may bind. Credentials are named by reference, never written here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environments"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": {
      "description": "1 for this release. An additive change keeps it; a breaking change raises it.",
      "const": 1
    },
    "defaults": { "$ref": "#/$defs/limits" },
    "environments": {
      "description": "A consumer-chosen name for each environment, bound by the --environment launch argument.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/environment" }
    }
  },
  "$defs": {
    "limits": {
      "description": "Per-call limits. Values left out take the server's measured defaults (reference/read-safety-measurement.md).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestTimeoutMs": { "type": "integer", "minimum": 1 },
        "lockTimeoutMs": { "type": "integer", "minimum": 0 },
        "rowCap": { "type": "integer", "minimum": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server", "databases", "auth"],
      "properties": {
        "server": {
          "description": "Host name or address only; a connection string is refused.",
          "type": "string",
          "pattern": "^[A-Za-z0-9._\\\\-]+$"
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "databases": {
          "description": "The databases this environment may read. The first is the default.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "auth": { "$ref": "#/$defs/auth" },
        "limits": { "$ref": "#/$defs/limits" }
      }
    },
    "auth": {
      "oneOf": [{ "$ref": "#/$defs/sqlLogin" }, { "$ref": "#/$defs/entraDefault" }]
    },
    "sqlLogin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "user", "password"],
      "properties": {
        "type": { "const": "sql-login" },
        "user": { "$ref": "#/$defs/secretRef" },
        "password": { "$ref": "#/$defs/secretRef" }
      }
    },
    "entraDefault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "entra-default" },
        "clientId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      }
    },
    "secretRef": {
      "description": "Names where a credential lives; the value itself never appears in the config.",
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "env": {
          "description": "The environment variable that holds the value.",
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      }
    }
  }
}
