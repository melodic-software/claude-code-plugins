{
  "requires": [
    {
      "id": "curl",
      "kind": "cli",
      "need": "required",
      "for": [
        "skill:audit"
      ],
      "detect": {
        "any": [
          "curl"
        ]
      },
      "degrade": "Without curl, the audit update action cannot fetch a docs page and records it unread with reason curl-missing; a cached entry still within --max-age is served without a request.",
      "install": {
        "docs": "https://curl.se/download.html",
        "brew": "curl",
        "winget": "cURL.cURL",
        "apt": "curl"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "skill:audit"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, fetch-docs.sh and docs-cache.sh exit before reading anything, so the audit update action cannot read the docs pages.",
      "install": {
        "docs": "https://jqlang.org/download/",
        "brew": "jq",
        "winget": "jqlang.jq",
        "apt": "jq"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "python3",
      "kind": "runtime",
      "need": "optional",
      "for": [
        "skill:audit"
      ],
      "detect": {
        "any": [
          "python3",
          "python"
        ],
        "reject_store_alias": true
      },
      "degrade": "Without Python 3, a page that serves only HTML cannot be converted and is recorded unread with reason no-python; pages served as markdown read normally.",
      "install": {
        "docs": "https://www.python.org/downloads/",
        "brew": "python",
        "winget": "Python.Python.3.12",
        "apt": "python3"
      },
      "check": "/harness-ops:prerequisites"
    }
  ]
}
