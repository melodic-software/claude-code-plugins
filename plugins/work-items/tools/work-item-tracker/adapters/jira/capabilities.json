{
  "schema_version": "1.0",
  "provider": "jira",
  "verbs": {
    "create-item": false,
    "get-item": true,
    "claim": false,
    "renew-lease": false,
    "release": false,
    "reclaim": false,
    "link-blocks": false,
    "add-sub-item": false,
    "list-items": true,
    "list-sub-items": false,
    "capabilities": true,
    "change-link": true
  },
  "features": {
    "cross_repo_edges": false,
    "sub_items": false,
    "leases": false,
    "labels": true
  },
  "limits": {
    "sub_items_per_parent": 0,
    "sub_item_depth": 0,
    "dependencies_per_type": 0,
    "list_items_max": 1000
  },
  "change_link": {
    "branch_pattern": "^([^/]+/)?([A-Z][A-Z0-9_]*-[0-9]+)"
  }
}
