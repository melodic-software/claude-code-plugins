@@SHEBANG@@
# capabilities — @@DISPLAY_NAME@@ adapter (provider `@@PROVIDER@@`).
# GENERATED by /work-items:onboard-adapter, and complete: the manifest IS the answer,
# so this verb emits it verbatim. Deliberately pre-network and config-free — the core
# reads capabilities to decide whether a verb is even attempted, so it must succeed
# before any credential or host is configured.
#
# Contract: tools/work-item-tracker/CONTRACT.md "Capabilities manifest".
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ "${1:-}" == "--help" ]]; then
  echo "usage: capabilities.sh  (emits this adapter's capabilities.json manifest)"
  exit 0
fi
if [[ $# -gt 0 ]]; then
  echo "capabilities.sh: unexpected argument: $1" >&2
  exit 2
fi

MANIFEST="$SCRIPT_DIR/capabilities.json"
if [[ ! -f "$MANIFEST" ]]; then
  echo "capabilities.sh: manifest not found: $MANIFEST" >&2
  exit 3
fi

# Re-serialize through jq rather than cat: a hand-edited manifest that is no longer
# valid JSON must fail HERE with a clear message, not downstream as a shape error in
# whatever consumed the malformed stdout.
jq -c . "$MANIFEST" || {
  echo "capabilities.sh: manifest is not valid JSON: $MANIFEST" >&2
  exit 3
}
