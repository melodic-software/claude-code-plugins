@@SHEBANG@@
# shellcheck disable=SC2154  # FAILED/CASE_NUM initialized by the sourced lib
# capabilities — offline contract tests for the @@DISPLAY_NAME@@ adapter's manifest and
# the verb that emits it. GENERATED by /work-items:onboard-adapter, and COMPLETE: every
# case is real and passes at generation time.
#
# The load-bearing case is the last one — that the manifest AGREES WITH THE FILESYSTEM.
# The manifest is what the core routes on, so a verb declared `true` with no script
# behind it fails at dispatch with a confusing not-found, and a script left behind for a
# verb later set to `false` invites someone to fill it in without flipping the manifest
# back. Neither shows up in any other test.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

TESTS_LIB=""
for candidate in \
  "${WIT_SEAM_TESTS_DIR:-}/lib.sh" \
  "${WIT_SEAM_LIB_DIR:-}/../tests/lib.sh" \
  "$SCRIPT_DIR/../../tests/lib.sh"; do
  if [[ -f "$candidate" ]]; then
    TESTS_LIB="$candidate"
    break
  fi
done
if [[ -z "$TESTS_LIB" ]]; then
  echo "SKIP: seam test helper not found — set WIT_SEAM_TESTS_DIR to the work-item-tracker tests/ directory" >&2
  exit 0
fi
# shellcheck source=/dev/null
source "$TESTS_LIB"

S="$SCRIPT_DIR/capabilities.sh"
MANIFEST="$SCRIPT_DIR/capabilities.json"

# --- the verb ---
# capabilities is deliberately pre-network and config-free: the core reads it to decide
# whether any other verb is attempted, so it must succeed before a credential or host
# is configured. These cases run with no binding in sight and must still pass.
out="$(bash "$S" --help 2>/dev/null)"
assert_eq "--help exit 0" "0" "$?"
assert_contains "--help mentions the manifest" "$out" "capabilities.json"

bash "$S" --nope >/dev/null 2>&1
assert_eq "unexpected argument → exit 2" "2" "$?"

out="$(bash "$S" 2>/dev/null)"
assert_eq "capabilities exit 0 with no binding configured" "0" "$?"
case "$out" in
*$'\r'*) fail "stdout is CR-free" "no CR" "CR present" ;;
*) pass "stdout is CR-free" ;;
esac

# --- the manifest ---
assert_eq "manifest is valid JSON" "0" "$(
  jq -e . "$MANIFEST" >/dev/null 2>&1
  echo $?
)"
assert_eq "the verb emits the manifest's provider" "@@PROVIDER@@" "$(jq -r '.provider' <<<"$out")"
assert_eq "declares a MAJOR.MINOR schema_version" "true" \
  "$(jq -r '.schema_version | test("^[0-9]+\\.[0-9]+$")' <<<"$out")"

# capabilities itself must be true, or the core could not read the manifest to learn
# anything about this adapter at all.
assert_eq "capabilities is declared true" "true" "$(jq -r '.verbs["capabilities"]' <<<"$out")"

# Every verb of the adapter surface is present and boolean — a missing key reads as
# false at the gate, silently disabling a verb the adapter may actually implement.
for v in create-item get-item claim renew-lease reclaim link-blocks add-sub-item \
  list-items list-sub-items capabilities; do
  assert_eq "verbs[\"$v\"] is boolean" "boolean" "$(jq -r --arg v "$v" '.verbs[$v] | type' <<<"$out")"
done

# Limits are non-negative integers or null (null = supported, no provider-enforced
# ceiling; 0 = the capability is unsupported).
for k in sub_items_per_parent sub_item_depth dependencies_per_type list_items_max; do
  assert_eq "limits[\"$k\"] is an integer or null" "ok" \
    "$(jq -r --arg k "$k" '.limits[$k] | if . == null then "ok" elif (type == "number" and . >= 0 and floor == .) then "ok" else "bad" end' <<<"$out")"
done

# --- the manifest agrees with the filesystem ---
while IFS= read -r v; do
  [[ "$v" == "capabilities" ]] && continue
  declared="$(jq -r --arg v "$v" '.verbs[$v]' <<<"$out")"
  if [[ "$declared" == "true" ]]; then
    if [[ -f "$SCRIPT_DIR/$v.sh" ]]; then
      pass "declared verb $v has a script"
    else
      fail "declared verb $v has a script" "$v.sh present" "missing"
    fi
  else
    # A declared-false verb is answered by the core's capability gate (exit 6) before
    # any script would run, so a leftover file is dead code that looks live.
    if [[ -e "$SCRIPT_DIR/$v.sh" ]]; then
      fail "undeclared verb $v has no script" "$v.sh absent" "present"
    else
      pass "undeclared verb $v has no script"
    fi
  fi
done < <(jq -r '.verbs | keys[]' <<<"$out")

[[ $FAILED -eq 0 ]] || exit 1
