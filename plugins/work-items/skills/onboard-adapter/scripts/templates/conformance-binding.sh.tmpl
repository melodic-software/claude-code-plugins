# shellcheck shell=bash
# shellcheck disable=SC2034  # CB_REPO is the binding contract's output — read by run-conformance.sh, which sources this file
# @@DISPLAY_NAME@@ conformance binding — GENERATED by /work-items:onboard-adapter.
# Contract: tools/work-item-tracker/CONTRACT.md "Conformance". Provides cb_setup
# (exports WORK_ITEM_TRACKER_BINDING, sets CB_REPO, cleans at start) and cb_teardown.
#
# Run it with:  run-conformance.sh --binding @@PROVIDER@@
# The runner resolves this file consumer-local-first, so it works from the consuming
# repo without vendoring the seam.
#
# The target is REQUIRED and has no default: conformance creates, claims, and closes
# items, so it must never be pointed at a coordination instance. Set:
#   WIT_CONFORMANCE_@@PROVIDER_UPPER@@_HOST   throwaway @@DISPLAY_NAME@@ host
#   WIT_CONFORMANCE_@@PROVIDER_UPPER@@_SCOPE  throwaway scope, in this provider's own
#                                             shape (e.g. @@SAMPLE_SCOPE@@)
#   @@SAMPLE_ENV@@                            credential for that instance
# Until those name a disposable target, this binding refuses to run.

CB_BINDING_TMP=""

_cb_clean_at_start() {
  # ┌─ PROVIDER MAPPING — fill this in ─────────────────────────────────────────┐
  # │ Close (or delete) every open item in the throwaway scope so each run       │
  # │ starts clean. The suite asserts on counts it creates itself; leftovers     │
  # │ from a previous run make those assertions flap.                            │
  # │ Do this through the PROVIDER's own tooling, not through the seam — the     │
  # │ seam is what is under test.                                                │
  # └────────────────────────────────────────────────────────────────────────────┘
  :
}

cb_setup() {
  local host scope
  host="${WIT_CONFORMANCE_@@PROVIDER_UPPER@@_HOST:?set WIT_CONFORMANCE_@@PROVIDER_UPPER@@_HOST to a throwaway @@DISPLAY_NAME@@ host; NEVER a coordination instance}"
  scope="${WIT_CONFORMANCE_@@PROVIDER_UPPER@@_SCOPE:?set WIT_CONFORMANCE_@@PROVIDER_UPPER@@_SCOPE to a throwaway scope; NEVER a coordination scope}"
@@AUTH_CONFORMANCE_REQUIRE@@  CB_REPO="$scope"
  CB_BINDING_TMP="$(mktemp)"
  jq -cn --arg h "$host" --arg s "$scope"@@AUTH_CONFORMANCE_JQARG@@ \
    '{schema_version:"1.0", provider:"@@PROVIDER@@",
      config:{lease_ttl_hours:24,
        "@@CONFIG_KEY@@":{host:$h, scopes:[$s], auth_env:"@@SAMPLE_ENV@@"@@CONFORMANCE_AUTH_EXTRA@@}}}' \
    >"$CB_BINDING_TMP"
  export WORK_ITEM_TRACKER_BINDING="$CB_BINDING_TMP"
  _cb_clean_at_start
}

cb_teardown() {
  _cb_clean_at_start
  [[ -n "$CB_BINDING_TMP" ]] && rm -f "$CB_BINDING_TMP"
}
