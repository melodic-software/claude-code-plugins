#!/usr/bin/env bash
# shellcheck disable=SC2154  # FAILED/CASE_NUM initialized by the sourced lib
# common.sh — offline contract tests for the @@DISPLAY_NAME@@ adapter's security
# skeleton. GENERATED by /work-items:onboard-adapter, and COMPLETE: unlike the verb
# scaffolds, every case here is real and passes the moment the adapter is generated.
# That is the point — the guards are generated, so their proof is generated with
# them, and a consumer who edits a guard finds out here rather than in production.
#
# Everything runs offline: the credential-egress cases never leave
# wit_need_@@PROVIDER_FUNC@@_config, and the transport cases use a mock curl injected
# through WIT_@@PROVIDER_UPPER@@_CURL.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The seam's test helper lives with the engine, which for a consumer-local adapter is
# the read-only plugin directory. Resolve it the same way common.sh resolves lib/,
# and say so plainly rather than failing with a bare "file not found".
TESTS_LIB=""
for candidate in \
  "${WIT_SEAM_TESTS_DIR:-}/lib.sh" \
  "${WIT_SEAM_LIB_DIR:-}/../tests/lib.sh" \
  "$SCRIPT_DIR/../../tests/lib.sh"; do
  if [[ -f "$candidate" ]]; then
    TESTS_LIB="$candidate"
    break
  fi
done
if [[ -z "$TESTS_LIB" ]]; then
  echo "SKIP: seam test helper not found — set WIT_SEAM_TESTS_DIR to the work-item-tracker tests/ directory" >&2
  exit 0
fi
# shellcheck source=/dev/null
source "$TESTS_LIB"
# shellcheck source=common.sh
source "$SCRIPT_DIR/common.sh"

FIX="$(mktemp -d)"
trap 'rm -rf "$FIX"' EXIT

# --- the public surface exists ---

for fn in wit_require_@@PROVIDER_FUNC@@_id wit_need_@@PROVIDER_FUNC@@_config \
  wit_@@PROVIDER_FUNC@@_scope_in_scope wit_@@PROVIDER_FUNC@@_token \
  wit_@@PROVIDER_FUNC@@_auth_header wit_@@PROVIDER_FUNC@@_http \
  wit_@@PROVIDER_FUNC@@_require_ok wit_@@PROVIDER_FUNC@@_unimplemented \
  wit_help_if_requested; do
  if declare -F "$fn" >/dev/null; then
    pass "common.sh exposes $fn"
  else
    fail "common.sh exposes $fn" "declared" "missing"
  fi
done

# --- id grammar: foreign providers are refused before any I/O ---

if wit_require_@@PROVIDER_FUNC@@_id "github:o/r#1"; then
  fail "rejects foreign-provider id" "reject" "accepted"
else
  pass "rejects foreign-provider id"
fi
if wit_require_@@PROVIDER_FUNC@@_id "@@SAMPLE_ID@@"; then
  pass "accepts a @@PROVIDER@@ id and sets the WIT_ID_* globals"
  assert_eq "id number" "12" "$WIT_ID_NUMBER"
else
  fail "accepts a @@PROVIDER@@ id" "accept" "rejected"
fi

# --- scope membership is the authorization boundary ---

WIT_@@PROVIDER_UPPER@@_SCOPES='["@@SAMPLE_SCOPE@@"]'
if wit_@@PROVIDER_FUNC@@_scope_in_scope "@@SAMPLE_SCOPE@@"; then
  pass "declared scope accepted"
else
  fail "declared scope accepted" "in" "out"
fi
if wit_@@PROVIDER_FUNC@@_scope_in_scope "undeclared/elsewhere"; then
  fail "undeclared scope refused" "out" "in"
else
  pass "undeclared scope refused"
fi

# --- HTTP status → contract exit code ---

check_map() {
  local label="$1" status="$2" want="$3"
  (
    WIT_@@PROVIDER_UPPER@@_STATUS="$status"
    WIT_@@PROVIDER_UPPER@@_BODY=""
    wit_@@PROVIDER_FUNC@@_require_ok "test" 2>/dev/null
  )
  assert_eq "$label" "$want" "$?"
}
check_map "200 → ok (0)" "200" "0"
check_map "401 → auth (4)" "401" "4"
check_map "403 → auth (4)" "403" "4"
check_map "404 → not-found (5)" "404" "5"
check_map "409 → conflict (7)" "409" "7"
check_map "429 → unavailable (8)" "429" "8"
check_map "503 → unavailable (8)" "503" "8"

# --- credential-egress guards (all exit 3, all pre-network) ---

# write_binding <json-of-the-@@CONFIG_KEY@@-subtree> — a binding whose provider
# subtree is exactly what the case under test wants to assert on.
write_binding() {
  jq -cn --argjson sub "$1" \
    '{schema_version:"1.0", provider:"@@PROVIDER@@", config:({lease_ttl_hours:24} + {"@@CONFIG_KEY@@": $sub})}' \
    >"$FIX/binding.json"
}

# config_rc <subtree-json> — run wit_need_@@PROVIDER_FUNC@@_config in a fresh shell
# against that binding and echo its exit code. A fresh `bash -c` (not a subshell) is
# used because the function exits, and because common.sh's readonly constants cannot
# be re-sourced into this one.
config_rc() {
  write_binding "$1"
  WORK_ITEM_TRACKER_BINDING="$FIX/binding.json" \
    bash -c 'source "$1/common.sh"; wit_need_@@PROVIDER_FUNC@@_config' _ "$SCRIPT_DIR" >/dev/null 2>&1
  printf '%s' "$?"
}

# config_err <subtree-json> — the same, capturing STDERR only (stdout is discarded
# inside the group so the 2>&1 that follows redirects only what is left).
config_err() {
  write_binding "$1"
  { WORK_ITEM_TRACKER_BINDING="$FIX/binding.json" \
    bash -c 'source "$1/common.sh"; wit_need_@@PROVIDER_FUNC@@_config' _ "$SCRIPT_DIR" >/dev/null; } 2>&1
}

GOOD='{"host":"@@SAMPLE_HOST@@","auth_env":"@@SAMPLE_ENV@@","scopes":["@@SAMPLE_SCOPE@@"]@@SAMPLE_AUTH_EXTRA@@}'

assert_eq "a well-formed binding is accepted" "0" "$(config_rc "$GOOD")"

# Required keys.
assert_eq "missing host → exit 3" "3" \
  "$(config_rc "$(jq -c 'del(.host)' <<<"$GOOD")")"
assert_eq "missing auth_env → exit 3" "3" \
  "$(config_rc "$(jq -c 'del(.auth_env)' <<<"$GOOD")")"
assert_eq "missing scopes → exit 3" "3" \
  "$(config_rc "$(jq -c 'del(.scopes)' <<<"$GOOD")")"
# A scalar passes a naive `length > 0`; it must not pass here.
assert_eq "scopes as a scalar string → exit 3" "3" \
  "$(config_rc "$(jq -c '.scopes = "@@SAMPLE_SCOPE@@"' <<<"$GOOD")")"
assert_eq "empty scopes array → exit 3" "3" \
  "$(config_rc "$(jq -c '.scopes = []' <<<"$GOOD")")"

# Host must be a BARE hostname — every URL-structure smuggle is refused.
for bad_host in "https://@@SAMPLE_HOST@@" "@@SAMPLE_HOST@@/path" "evil.example.com@@@SAMPLE_HOST@@" \
  "@@SAMPLE_HOST@@:8443" "@@SAMPLE_HOST@@ " "-@@SAMPLE_HOST@@"; do
  assert_eq "host '$bad_host' refused as not-bare → exit 3" "3" \
    "$(config_rc "$(jq -c --arg h "$bad_host" '.host = $h' <<<"$GOOD")")"
done

bare_err="$(config_err "$(jq -c '.host = "https://@@SAMPLE_HOST@@"' <<<"$GOOD")")"
assert_contains "not-bare host names the reason" "$bare_err" "not a bare hostname"

# Suffix pinning: deny by default, with an explicit diffable opt-out. The binding's
# own host_suffix is the consumer's pin even when the generated default is empty, so
# this case holds for vendor-cloud and self-hosted providers alike.
PINNED="$(jq -c '.host_suffix = ".pinned.example"' <<<"$GOOD")"
assert_eq "host outside the binding's pin → exit 3" "3" "$(config_rc "$PINNED")"
pin_err="$(config_err "$PINNED")"
assert_contains "off-pin host names the pin and the opt-out" "$pin_err" "allow_custom_domain"
assert_eq "allow_custom_domain=true is the opt-out" "0" \
  "$(config_rc "$(jq -c '.allow_custom_domain = true' <<<"$PINNED")")"
assert_eq "a host matching the pin is accepted" "0" \
  "$(config_rc "$(jq -c '.host = "instance.pinned.example"' <<<"$PINNED")")"

# The pin is a DOMAIN boundary, not a string suffix. Nothing tells a consumer that the
# leading dot is load-bearing, so a natural dot-less pin must still deny a host that
# merely ends with those characters — otherwise the credential goes to the attacker
# host without tripping the loud allow_custom_domain opt-out.
DOTLESS="$(jq -c '.host_suffix = "mycompany.com"' <<<"$GOOD")"
assert_eq "dot-less pin still denies suffix confusion" "3" \
  "$(config_rc "$(jq -c '.host = "evilmycompany.com"' <<<"$DOTLESS")")"
assert_eq "and denies a hyphenated lookalike" "3" \
  "$(config_rc "$(jq -c '.host = "attacker-mycompany.com"' <<<"$DOTLESS")")"
assert_eq "a real subdomain under a dot-less pin is accepted" "0" \
  "$(config_rc "$(jq -c '.host = "git.mycompany.com"' <<<"$DOTLESS")")"
# The apex IS the pinned domain: rejecting it would break a single-host deployment.
assert_eq "the apex itself is accepted" "0" \
  "$(config_rc "$(jq -c '.host = "mycompany.com"' <<<"$DOTLESS")")"

# auth_env is dereferenced via ${!name}: an invalid identifier would abort bash on
# first read, so it is refused here with a message instead.
for bad_env in "FOO-BAR" "1FOO" "FOO BAR" "FOO;id" ""; do
  assert_eq "auth_env '${bad_env:-<empty>}' refused → exit 3" "3" \
    "$(config_rc "$(jq -c --arg e "$bad_env" '.auth_env = $e' <<<"$GOOD")")"
done

# Scope entries reach request paths/queries, so non-conforming elements are refused
# before interpolation — including ones a bash line-loop would lose.
for bad_scope in '""' '"a b"' '"../../etc/passwd"' '"x;id"' '123' 'null'; do
  assert_eq "scope element $bad_scope refused → exit 3" "3" \
    "$(config_rc "$(jq -c --argjson s "[$bad_scope]" '.scopes = $s' <<<"$GOOD")")"
done

# --- the credential itself ---

# Unset env var → exit 4 (auth), never a request with an empty credential.
write_binding "$GOOD"
WORK_ITEM_TRACKER_BINDING="$FIX/binding.json" \
  bash -c 'unset @@SAMPLE_ENV@@; source "$1/common.sh"; wit_need_@@PROVIDER_FUNC@@_config; wit_@@PROVIDER_FUNC@@_token' \
  _ "$SCRIPT_DIR" >/dev/null 2>&1
assert_eq "unset credential env var → exit 4" "4" "$?"

# --- transport: the credential never reaches argv ---

MOCKDIR="$FIX/mock"
mkdir -p "$MOCKDIR"
cat >"$MOCKDIR/curl" <<'MOCK'
#!/usr/bin/env bash
# Record argv and the stdin config separately, then answer 200 with an empty object.
d="$(cd "$(dirname "$0")" && pwd)"
printf '%s\n' "$@" >"$d/argv.txt"
cat >"$d/stdin.txt" 2>/dev/null
printf '%s\n%s' '{}' '200'
MOCK
chmod +x "$MOCKDIR/curl"

write_binding "$GOOD"
SECRET="s3cr3t-@@PROVIDER@@-token-do-not-leak"
WORK_ITEM_TRACKER_BINDING="$FIX/binding.json" \
  WIT_@@PROVIDER_UPPER@@_CURL="$MOCKDIR/curl" \
  @@SAMPLE_ENV@@="$SECRET" \
  bash -c 'source "$1/common.sh"; wit_need_@@PROVIDER_FUNC@@_config; wit_@@PROVIDER_FUNC@@_http GET /probe' \
  _ "$SCRIPT_DIR" >/dev/null 2>&1
transport_rc=$?

assert_eq "mocked transport call succeeds" "0" "$transport_rc"
ARGV="$(cat "$MOCKDIR/argv.txt" 2>/dev/null)"
STDIN_CFG="$(cat "$MOCKDIR/stdin.txt" 2>/dev/null)"

# The exact header this scheme builds. Asserting on it rather than on the raw token
# keeps the case honest for schemes that ENCODE the credential (Basic), where the raw
# secret legitimately never appears in either place — and where an assertion looking
# only for the raw secret would pass even if the encoded form leaked into argv.
EXPECT_HEADER=@@AUTH_HEADER_EXPECT@@

# The load-bearing assertion of this whole file: argv is world-readable via /proc and
# `ps`, so a credential there is disclosed to every local process.
assert_not_contains "raw credential absent from curl argv" "$ARGV" "$SECRET"
assert_not_contains "built credential header absent from curl argv" "$ARGV" "$EXPECT_HEADER"
assert_contains "credential travels in the stdin config instead" "$STDIN_CFG" "$EXPECT_HEADER"
assert_contains "stdin config carries the Authorization header" "$STDIN_CFG" "Authorization"
# HTTPS is enforced by curl itself, not merely by the URL string we happened to build.
assert_contains "curl is restricted to https" "$ARGV" "--proto"
# Redirects are NOT followed: a 30x to another host would otherwise replay the
# Authorization header to a host the binding never authorized.
assert_not_contains "redirects are not followed (-L)" "$ARGV" "-L"
assert_not_contains "redirects are not followed (--location)" "$ARGV" "--location"
assert_contains "request URL is https" "$STDIN_CFG" "https://@@SAMPLE_HOST@@@@BASE_PATH@@/probe"

# A transport failure (curl exits non-zero, no status) is provider-unavailable (8),
# never a silent success with an empty body.
cat >"$MOCKDIR/curl" <<'MOCK'
#!/usr/bin/env bash
cat >/dev/null 2>&1
exit 7
MOCK
chmod +x "$MOCKDIR/curl"
WORK_ITEM_TRACKER_BINDING="$FIX/binding.json" \
  WIT_@@PROVIDER_UPPER@@_CURL="$MOCKDIR/curl" \
  @@SAMPLE_ENV@@="$SECRET" \
  bash -c 'source "$1/common.sh"; wit_need_@@PROVIDER_FUNC@@_config; wit_@@PROVIDER_FUNC@@_http GET /probe' \
  _ "$SCRIPT_DIR" >/dev/null 2>&1
assert_eq "curl transport failure → exit 8" "8" "$?"

[[ $FAILED -eq 0 ]] || exit 1
