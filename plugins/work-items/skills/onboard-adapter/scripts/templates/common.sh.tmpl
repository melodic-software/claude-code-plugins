# shellcheck shell=bash
# Shared helpers for the @@DISPLAY_NAME@@ adapter — sourced by every verb script.
# GENERATED by /work-items:onboard-adapter from templates/common.sh.tmpl. This file
# is yours now: it lands in your repo, under your review and CI. Regenerating
# overwrites it, so keep provider-specific logic in the verb scripts.
#
# Contract: tools/work-item-tracker/CONTRACT.md ("Adapter contract", "JSON output
# contract", "Exit codes"). Auth: @@AUTH_DESCRIPTION@@ — the credential is read from
# the env var NAMED BY config.@@CONFIG_KEY@@.auth_env, never stored in the tracked
# binding, and passed to curl through a stdin config (-K -) so it never appears in
# argv (visible to every other process on the machine via /proc and `ps`).
# HTTP goes through ${WIT_@@PROVIDER_UPPER@@_CURL:-curl}; tests inject a mock binary
# there to exercise the read path offline.

[[ -n "${_WIT_@@PROVIDER_UPPER@@_COMMON_LOADED:-}" ]] && return 0
readonly _WIT_@@PROVIDER_UPPER@@_COMMON_LOADED=1

WIT_@@PROVIDER_UPPER@@_ADAPTER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly WIT_@@PROVIDER_UPPER@@_ADAPTER_DIR

# Seam libraries. This adapter lives in the CONSUMING repo while the engine
# dispatching it lives in the read-only plugin directory, so its own ../../lib may
# not exist at all. The dispatcher exports WIT_SEAM_LIB_DIR (CONTRACT.md "Adapter
# resolution") naming the lib/ of the engine actually dispatching — and the engine
# whose contract version this adapter's manifest just handshook against. Fall back
# to the relative path for a vendored seam or a direct (non-dispatched) run. A
# missing lib is a hard failure with a clear diagnostic (exit 3 — setup/config),
# never a silent sourcing failure leaving a verb emitting a malformed record. Runs
# before the EX_* constants below exist, so it uses the literal.
WIT_@@PROVIDER_UPPER@@_SEAM_LIB="${WIT_SEAM_LIB_DIR:-$WIT_@@PROVIDER_UPPER@@_ADAPTER_DIR/../../lib}"
readonly WIT_@@PROVIDER_UPPER@@_SEAM_LIB

wit_@@PROVIDER_FUNC@@_require_seam_lib() {
  [[ -f "$1" ]] && return 0
  printf 'work-item-tracker @@PROVIDER@@ adapter: required seam library not found: %s\n' "$1" >&2
  printf '  set WIT_SEAM_LIB_DIR to the work-item-tracker lib/ directory, or vendor the seam\n' >&2
  exit 3
}

# The `shellcheck source=` hints name the RELATIVE seam path rather than /dev/null:
# where a vendored or bundled seam sits there, ShellCheck follows it and every
# WIT_ID_* / WIT_SCHEMA_VERSION reference in this adapter's verb scripts resolves.
# Where it does not (a consumer-local adapter beside no vendored seam), ShellCheck
# resolves. Where it does not, SC1091 is disabled so the absence is quiet rather than
# an info per source line — the runtime check above is what actually enforces presence.
wit_@@PROVIDER_FUNC@@_require_seam_lib "$WIT_@@PROVIDER_UPPER@@_SEAM_LIB/id.sh"
# shellcheck source=../../lib/id.sh disable=SC1091
source "$WIT_@@PROVIDER_UPPER@@_SEAM_LIB/id.sh"
wit_@@PROVIDER_FUNC@@_require_seam_lib "$WIT_@@PROVIDER_UPPER@@_SEAM_LIB/json.sh"
# shellcheck source=../../lib/json.sh disable=SC1091
source "$WIT_@@PROVIDER_UPPER@@_SEAM_LIB/json.sh"
# binding.sh is sourced, not inherited: the dispatcher runs each verb as a fresh
# `bash <verb>.sh` subprocess, so only exported env vars cross — not wit_find_binding.
# The adapter re-locates the binding itself to read its own config subtree.
wit_@@PROVIDER_FUNC@@_require_seam_lib "$WIT_@@PROVIDER_UPPER@@_SEAM_LIB/binding.sh"
# shellcheck source=../../lib/binding.sh disable=SC1091
source "$WIT_@@PROVIDER_UPPER@@_SEAM_LIB/binding.sh"

readonly EX_INTERNAL=1
readonly EX_USAGE=2
readonly EX_CONFIG=3
readonly EX_AUTH=4
readonly EX_NOT_FOUND=5
readonly EX_CONFLICT=7
readonly EX_UNAVAILABLE=8

# HTTP command indirection: the sole testability seam. Tests point
# WIT_@@PROVIDER_UPPER@@_CURL at a mock returning canned responses, keeping every
# verb path offline. Absent → real curl.
readonly WIT_@@PROVIDER_UPPER@@_CURL_BIN="${WIT_@@PROVIDER_UPPER@@_CURL:-curl}"

# config.@@CONFIG_KEY@@.host becomes the request host that RECEIVES the credential,
# so it must be a BARE hostname — no scheme, path, userinfo (`@`), port, or control
# characters — lest a binding smuggle URL structure that redirects the token off the
# intended tenant. A tracked binding is PR-modifiable and the token may be present in
# CI, so host is additionally pinned by SUFFIX where a pin exists.
#
# The effective pin is, in order: config.@@CONFIG_KEY@@.host_suffix from the binding
# (the consumer's own pin — the override seam), else the generated default below. A
# non-empty pin denies by default; config.@@CONFIG_KEY@@.allow_custom_domain=true is
# the explicit, diffable opt-out. An EMPTY generated default means this provider is
# self-hosted and has no vendor domain to pin against — the consumer can still pin
# their own instance via the binding key, and the adapter README records that as a
# stated posture rather than leaving it implied.
readonly WIT_@@PROVIDER_UPPER@@_HOSTNAME_RE='^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$'
readonly WIT_@@PROVIDER_UPPER@@_DEFAULT_HOST_SUFFIX='@@HOST_SUFFIX@@'

# wit_@@PROVIDER_FUNC@@_host_under_pin <host> <suffix> — is <host> genuinely under the pin?
#
# A bare `*"$suffix"` glob is a plain "ends with", which is NOT a domain boundary: a pin
# of `mycompany.com` is satisfied by `evilmycompany.com`, sending the credential to an
# attacker host without tripping the loud allow_custom_domain opt-out. The pin is
# consumer-supplied free text, and nothing tells a consumer the leading dot is
# load-bearing — so normalize it here rather than documenting a footgun.
#
# The apex is accepted separately: under a pin of `mycompany.com`, the host
# `mycompany.com` IS the pinned domain even though it does not end in `.mycompany.com`.
wit_@@PROVIDER_FUNC@@_host_under_pin() {
  local host="$1" pin="$2"
  [[ "$pin" == .* ]] || pin=".$pin"
  [[ "$host" == *"$pin" || "$host" == "${pin#.}" ]]
}
# auth_env is dereferenced via ${!name}; an invalid identifier aborts bash, so it
# must be a valid shell variable name.
readonly WIT_@@PROVIDER_UPPER@@_ENV_NAME_RE='^[A-Za-z_][A-Za-z0-9_]*$'
# Scope entries are interpolated into request paths and/or query strings, so they are
# constrained to an allowlist BEFORE interpolation. Allowlisting (reject the
# unexpected) is safer than escaping: an escaping bug is silent, a rejection is loud.
readonly WIT_@@PROVIDER_UPPER@@_SCOPE_RE='@@SCOPE_PATTERN@@'

# Set by wit_@@PROVIDER_FUNC@@_http; declared here so a read before the first call
# does not trip `set -u`.
WIT_@@PROVIDER_UPPER@@_BODY=""
WIT_@@PROVIDER_UPPER@@_STATUS=""

wit_usage_error() {
  printf '%s: %s\n' "$(basename "${BASH_SOURCE[1]}")" "$1" >&2
  exit "$EX_USAGE"
}

# wit_@@PROVIDER_FUNC@@_unimplemented <verb> — the marker a freshly generated verb
# script carries until its provider mapping is filled in. Exit 1 (internal), NOT 6:
# exit 6 means "this provider cannot do it and the manifest says so", which is a
# permanent, honest degradation the caller may route around. An unfilled scaffold is
# neither — declaring it 6 would launder unfinished work as a provider limitation, and
# the conformance suite would pass on a verb that does nothing. Any verb still
# reaching this line either needs its mapping written or needs `false` in
# capabilities.json.
wit_@@PROVIDER_FUNC@@_unimplemented() {
  printf '%s: @@PROVIDER@@ adapter verb %s is a generated scaffold with no provider mapping yet\n' \
    "$(basename "${BASH_SOURCE[1]}")" "$1" >&2
  printf '  fill in its PROVIDER MAPPING block, or set verbs["%s"]=false in capabilities.json\n' "$1" >&2
  exit "$EX_INTERNAL"
}

# wit_help_if_requested <usage-text> <args…> — print usage + exit 0 on --help.
wit_help_if_requested() {
  local usage="$1"
  shift
  if [[ "${1:-}" == "--help" ]]; then
    printf '%s\n' "$usage"
    exit 0
  fi
}

# wit_@@PROVIDER_FUNC@@_nonempty_array <json-text> — 0 when the text is a non-empty
# JSON array. Type is checked before length so a scalar such as "scopes":"abc" cannot
# pass on its string length; jq's `and` short-circuits, so `length` never runs on a
# non-array.
wit_@@PROVIDER_FUNC@@_nonempty_array() {
  [[ "$(jq -r 'if (type == "array" and length > 0) then "yes" else "no" end' <<<"$1")" == "yes" ]]
}

# wit_@@PROVIDER_FUNC@@_bad_elements <anchored-regex> <json-array> — the array's
# elements that are not strings matching the allowlist, as a JSON array (`[]` when all
# are valid). The type guard sits left of the `or` so test() never runs on a
# non-string. Checked IN jq rather than a bash line-loop: command substitution strips
# trailing newlines, so `[""]` would evade a loop.
wit_@@PROVIDER_FUNC@@_bad_elements() {
  jq -rc --arg re "$1" '[.[] | select((type != "string") or (test($re) | not))]' <<<"$2"
}

# wit_require_@@PROVIDER_FUNC@@_id <id> — parse an ID and require its provider be
# `@@PROVIDER@@`. The shared grammar accepts any provider; this adapter rejects
# foreign-provider IDs so a `github:…#N` never operates on a @@DISPLAY_NAME@@ item.
# Sets the WIT_ID_* globals.
# shellcheck disable=SC2154  # WIT_ID_PROVIDER is exported by wit_parse_id in the seam's id.sh, sourced above through a runtime-resolved path ShellCheck cannot follow
wit_require_@@PROVIDER_FUNC@@_id() {
  wit_parse_id "$1" || return 1
  [[ "$WIT_ID_PROVIDER" == "@@PROVIDER@@" ]] || return 1
}

# wit_need_@@PROVIDER_FUNC@@_config — load and validate the @@CONFIG_KEY@@ config
# subtree from the binding. Call AFTER arg parsing, so --help and usage errors stay
# offline and config-free. Exits 3 on any missing or invalid key.
# Exports WIT_@@PROVIDER_UPPER@@_HOST, WIT_@@PROVIDER_UPPER@@_SCOPES (JSON array),
# WIT_@@PROVIDER_UPPER@@_AUTH_ENV@@AUTH_EXPORT_EXTRA@@.
wit_need_@@PROVIDER_FUNC@@_config() {
  local name binding ejson
  name="$(basename "${BASH_SOURCE[1]}")"
  binding="$(wit_find_binding)" ||
    {
      printf '%s: no binding found (.work-item-tracker.json) — see CONTRACT.md Setup\n' "$name" >&2
      exit "$EX_CONFIG"
    }
  ejson="$(wit_effective_binding_json "$binding")" ||
    {
      printf '%s: invalid binding at %s — see CONTRACT.md Setup\n' "$name" "$binding" >&2
      exit "$EX_CONFIG"
    }
  WIT_@@PROVIDER_UPPER@@_HOST="$(jq -r '.config.@@CONFIG_KEY@@.host // empty' <<<"$ejson")"
  WIT_@@PROVIDER_UPPER@@_AUTH_ENV="$(jq -r '.config.@@CONFIG_KEY@@.auth_env // empty' <<<"$ejson")"
  WIT_@@PROVIDER_UPPER@@_SCOPES="$(jq -c '.config.@@CONFIG_KEY@@.scopes // []' <<<"$ejson")"
@@AUTH_CONFIG_READ@@
  local allow_custom_domain host_suffix
  allow_custom_domain="$(jq -r '.config.@@CONFIG_KEY@@.allow_custom_domain // false' <<<"$ejson")"
  host_suffix="$(jq -r --arg d "$WIT_@@PROVIDER_UPPER@@_DEFAULT_HOST_SUFFIX" '.config.@@CONFIG_KEY@@.host_suffix // $d' <<<"$ejson")"

  local missing=""
  [[ -n "$WIT_@@PROVIDER_UPPER@@_HOST" ]] || missing+=" config.@@CONFIG_KEY@@.host"
  [[ -n "$WIT_@@PROVIDER_UPPER@@_AUTH_ENV" ]] || missing+=" config.@@CONFIG_KEY@@.auth_env"
@@AUTH_CONFIG_REQUIRE@@
  # scopes must be a non-empty ARRAY, not merely truthy: a scalar such as
  # "scopes":"acme/webapp" would satisfy a bare `length > 0` on its string length,
  # then `.[]`/`map(...)` would jq-error into an empty clause this non-`set -e`
  # script would otherwise ignore.
  wit_@@PROVIDER_FUNC@@_nonempty_array "$WIT_@@PROVIDER_UPPER@@_SCOPES" ||
    missing+=" config.@@CONFIG_KEY@@.scopes[](non-empty array)"
  if [[ -n "$missing" ]]; then
    printf '%s: @@PROVIDER@@ binding missing/invalid required config:%s — see the adapter README\n' "$name" "$missing" >&2
    exit "$EX_CONFIG"
  fi

  # Value-level validation (all exit 3): the credential-bearing host, the token env
  # var name, and every interpolated scope entry against its allowlist charset.
  local bad=""
  if ! [[ "$WIT_@@PROVIDER_UPPER@@_HOST" =~ $WIT_@@PROVIDER_UPPER@@_HOSTNAME_RE ]]; then
    bad+=" host:'$WIT_@@PROVIDER_UPPER@@_HOST'(not a bare hostname)"
  elif [[ -n "$host_suffix" && "$allow_custom_domain" != "true" ]] &&
    ! wit_@@PROVIDER_FUNC@@_host_under_pin "$WIT_@@PROVIDER_UPPER@@_HOST" "$host_suffix"; then
    bad+=" host:'$WIT_@@PROVIDER_UPPER@@_HOST'(not under $host_suffix; set config.@@CONFIG_KEY@@.allow_custom_domain=true to allow)"
  fi
  [[ "$WIT_@@PROVIDER_UPPER@@_AUTH_ENV" =~ $WIT_@@PROVIDER_UPPER@@_ENV_NAME_RE ]] ||
    bad+=" auth_env:'$WIT_@@PROVIDER_UPPER@@_AUTH_ENV'(not a valid env var name)"
  local bad_scopes
  bad_scopes="$(wit_@@PROVIDER_FUNC@@_bad_elements "$WIT_@@PROVIDER_UPPER@@_SCOPE_RE" "$WIT_@@PROVIDER_UPPER@@_SCOPES")"
  [[ "$bad_scopes" == "[]" ]] || bad+=" scopes:$bad_scopes"
  if [[ -n "$bad" ]]; then
    printf '%s: invalid @@PROVIDER@@ config value(s):%s — see the adapter README\n' "$name" "$bad" >&2
    exit "$EX_CONFIG"
  fi

  # curl is the only prerequisite binary; gate here (exit 3, actionable) rather than
  # let the first request fail obscurely. The bin is the real curl by default or a
  # test-injected mock — either way it must resolve.
  command -v "$WIT_@@PROVIDER_UPPER@@_CURL_BIN" >/dev/null 2>&1 ||
    {
      printf '%s: prerequisite missing: curl (@@DISPLAY_NAME@@ REST over HTTPS) — see CONTRACT.md Prerequisites\n' "$name" >&2
      exit "$EX_CONFIG"
    }
  export WIT_@@PROVIDER_UPPER@@_HOST WIT_@@PROVIDER_UPPER@@_AUTH_ENV WIT_@@PROVIDER_UPPER@@_SCOPES@@AUTH_EXPORT_EXTRA@@
}

# wit_@@PROVIDER_FUNC@@_scope_in_scope <entry> — 0 when the entry is in the binding's
# config.@@CONFIG_KEY@@.scopes. That list is the declared read scope AND the
# authorization boundary: a bound workflow must not read items from a scope it did not
# declare, even when the token can see them. Each verb enforces it BEFORE any request,
# mapping a miss to its own usage error (exit 2) so the diagnostic names the verb.
wit_@@PROVIDER_FUNC@@_scope_in_scope() {
  [[ "$(jq -r --arg k "$1" 'if (index($k) != null) then "in" else "out" end' <<<"$WIT_@@PROVIDER_UPPER@@_SCOPES")" == "in" ]]
}

# wit_@@PROVIDER_FUNC@@_token — echo the credential from the env var NAMED BY
# config.@@CONFIG_KEY@@.auth_env. Exits 4 (auth) when that env var is unset or empty:
# the token is never stored in the tracked binding, only referenced by name. Call
# after wit_need_@@PROVIDER_FUNC@@_config.
wit_@@PROVIDER_FUNC@@_token() {
  local token="${!WIT_@@PROVIDER_UPPER@@_AUTH_ENV:-}"
  if [[ -z "$token" ]]; then
    printf '%s: @@PROVIDER@@ credential env var %s is unset or empty (config.@@CONFIG_KEY@@.auth_env)\n' \
      "$(basename "${BASH_SOURCE[1]}")" "$WIT_@@PROVIDER_UPPER@@_AUTH_ENV" >&2
    exit "$EX_AUTH"
  fi
  printf '%s' "$token"
}
@@AUTH_HELPERS@@
# wit_@@PROVIDER_FUNC@@_http <method> <path> [<json-body>] — call
# https://<host>@@BASE_PATH@@<path>. The Authorization header is fed through curl's
# stdin config (-K -) so the credential never appears in argv. `--proto '=https'`
# refuses any non-HTTPS scheme, and redirects are NOT followed (no -L), so the header
# can never be replayed to a host the binding did not authorize. Captures the response
# body to WIT_@@PROVIDER_UPPER@@_BODY and the HTTP status to
# WIT_@@PROVIDER_UPPER@@_STATUS; on a curl transport failure (no status) exits 8.
# HTTP-status→exit-code mapping is left to the caller via
# wit_@@PROVIDER_FUNC@@_require_ok so it can attach verb-specific context.
wit_@@PROVIDER_FUNC@@_http() {
  local method="$1" path="$2" body="${3:-}"
  local url="https://$WIT_@@PROVIDER_UPPER@@_HOST@@BASE_PATH@@$path"
  local auth raw rc
  auth="$(wit_@@PROVIDER_FUNC@@_auth_header)" || exit "$?"
  local curl_args=(-sS -X "$method" -H "Accept: application/json" --proto '=https' -w $'\n%{http_code}' -K -)
  if [[ -n "$body" ]]; then
    curl_args+=(-H "Content-Type: application/json" --data "$body")
  fi
  raw="$(printf 'header = "%s"\nurl = "%s"\n' "$auth" "$url" |
    "$WIT_@@PROVIDER_UPPER@@_CURL_BIN" "${curl_args[@]}" 2>/dev/null)"
  rc=$?
  if ((rc != 0)); then
    printf '@@PROVIDER@@: request to %s failed (curl exit %s) — network or endpoint unavailable\n' "$path" "$rc" >&2
    exit "$EX_UNAVAILABLE"
  fi
  WIT_@@PROVIDER_UPPER@@_STATUS="${raw##*$'\n'}"
  WIT_@@PROVIDER_UPPER@@_BODY="$(printf '%s' "${raw%$'\n'*}" | wit_strip_cr)"
}

# wit_@@PROVIDER_FUNC@@_require_ok <context> — map WIT_@@PROVIDER_UPPER@@_STATUS to a
# contract exit code, printing the provider's error text to stderr on failure. 2xx
# returns 0.
wit_@@PROVIDER_FUNC@@_require_ok() {
  local ctx="$1" code="$WIT_@@PROVIDER_UPPER@@_STATUS"
  case "$code" in
  2*) return 0 ;;
  401 | 403)
    printf '@@PROVIDER@@: %s — authentication/authorization failed (HTTP %s)\n' "$ctx" "$code" >&2
    exit "$EX_AUTH"
    ;;
  404)
    printf '@@PROVIDER@@: %s — not found (HTTP 404)\n' "$ctx" >&2
    exit "$EX_NOT_FOUND"
    ;;
  409 | 412 | 422)
    printf '@@PROVIDER@@: %s — conflict/precondition (HTTP %s)\n' "$ctx" "$code" >&2
    exit "$EX_CONFLICT"
    ;;
  429)
    printf '@@PROVIDER@@: %s — rate limited (HTTP 429); retry later\n' "$ctx" >&2
    exit "$EX_UNAVAILABLE"
    ;;
  5*)
    printf '@@PROVIDER@@: %s — server error (HTTP %s)\n' "$ctx" "$code" >&2
    exit "$EX_UNAVAILABLE"
    ;;
  *)
    printf '@@PROVIDER@@: %s — unexpected response (HTTP %s): %s\n' "$ctx" "$code" "$WIT_@@PROVIDER_UPPER@@_BODY" >&2
    exit "$EX_INTERNAL"
    ;;
  esac
}

# wit_@@PROVIDER_FUNC@@_normalize_program — a jq program mapping ONE raw
# @@DISPLAY_NAME@@ item into the seam's normalized item object (CONTRACT.md "JSON
# output contract"). Expects jq args $sv (schema version) and $host.
#
# ┌─ PROVIDER MAPPING — fill this in ───────────────────────────────────────────┐
# │ The generator cannot know your provider's field names. Every branch below   │
# │ is a placeholder reading a plausible field; replace each with the real one, │
# │ verified against YOUR instance (see the skill's live-exploration step).     │
# │ Load-bearing rules the contract fixes, whatever the field names:            │
# │   • state is normalized lowercase "open" | "closed" — nothing else.         │
# │   • blocked_by_count counts OPEN blockers only. Counting closed ones breaks │
# │     frontier graduation: the item never becomes eligible.                   │
# │   • id and parent_id are FULLY QUALIFIED (<provider>:<owner>/<repo>#<n>).   │
# │     A bare number in either field is a contract violation.                  │
# │   • type is the native type NAME or null — never invented.                  │
# └─────────────────────────────────────────────────────────────────────────────┘
# shellcheck disable=SC2016,SC2034  # jq program — $sv/$host are jq args, not bash; used by verb scripts
readonly WIT_@@PROVIDER_UPPER@@_NORMALIZE_PROGRAM='
  def qualify(n): "@@PROVIDER@@:" + $host + "/" + (.repository.full_name // "") + "#" + (n | tostring);
  {
    schema_version: $sv,
    id: qualify(.number),
    title: (.title // ""),
    state: (if (.state) == "closed" then "closed" else "open" end),
    assignees: [ (.assignees // [])[] | .login // empty ],
    labels: [ (.labels // [])[] | .name // empty ],
    type: null,
    blocked_by_count: 0,
    parent_id: null,
    url: (.html_url // "")
  }'
