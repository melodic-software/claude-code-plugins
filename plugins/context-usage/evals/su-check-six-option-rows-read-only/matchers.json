{
  "claude-version-probe": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?claude(?:\\.exe)?(?:\\\\\\\"|')?(?:\\s+-[^\\s\\\"\\\\]+)*?\\s+(?:--version|-v)\\b"
  ],
  "no-jq-node-reprobe": [
    {
      "use": "command_position_multishell"
    },
    "(?:command\\s+-[vV]\\s+|which\\s+|type\\s+(?:-\\w+\\s+)*|hash\\s+)(?:[^\\s\\\"&;|]+\\s+)*?(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?(?:jq|node)(?![\\w./-])"
  ],
  "no-state-shell-write": [
    "\\\"command\\\":\\\"(?:(?!<<)(?:'[^']*'|[^\\\"\\\\']|\\\\.))*?(?:>{1,2}\\s*|\\btee\\s+(?:-a\\s+)?|\\bsed\\s+-i\\S*\\s+(?:'[^']*'|(?!\\\\n)[^\\\"\\\\;&|']|\\\\[^n\\\"])*?|\\b(?:mv|cp)\\s+(?:-\\S+\\s+)*(?!-)(?:[^\\s;&|<>\\\\]|\\\\.)+\\s+)(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|<>']*/)?(?:\\.claude/plugins/|(?:settings(?:\\.local)?|\\.claude|zones)\\.json(?![\\w.-])|context-usage/context/|cache-line\\.mjs(?![\\w.-]))"
  ],
  "no-plugin-cli-write": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "plugin_cli_write"
    }
  ],
  "no-install": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "install_command"
    }
  ]
}
