{
  "requires": [
    {
      "id": "python3",
      "kind": "runtime",
      "need": "required",
      "for": ["skill:analyze-profile"],
      "detect": {
        "any": ["python3", "python", "py"],
        "version": { "args": ["--version"], "pattern": "Python ([0-9.]+)", "min": "3.10" }
      },
      "degrade": "Without Python 3.10 or later, analyze-profile cannot convert or query a profile, so it stops and says so; debug is unaffected.",
      "install": {
        "docs": "https://www.python.org/downloads/",
        "brew": "python",
        "winget": "Python.Python.3.12",
        "apt": "python3"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "node",
      "kind": "runtime",
      "need": "optional",
      "for": ["plugin", "skill:debug"],
      "detect": { "any": ["node"] },
      "degrade": "Without node, the prerequisites checker and debug's post-mortem view do not run.",
      "install": {
        "docs": "https://nodejs.org/en/download",
        "brew": "node",
        "winget": "OpenJS.NodeJS.LTS",
        "apt": "nodejs"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "memray",
      "kind": "cli",
      "need": "optional",
      "for": ["skill:analyze-profile"],
      "detect": { "any": ["memray"] },
      "degrade": "Without memray, analyze-profile cannot summarize a memray capture file; it reports the file and stops.",
      "install": { "docs": "https://bloomberg.github.io/memray/", "pip": "memray" },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "jfr",
      "kind": "cli",
      "need": "optional",
      "for": ["skill:analyze-profile"],
      "detect": { "any": ["jfr"] },
      "degrade": "Without jfr, analyze-profile cannot print a JVM flight recording; it reports the file and stops.",
      "install": { "docs": "https://docs.oracle.com/en/java/javase/21/docs/specs/man/jfr.html" },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "dotnet-trace",
      "kind": "cli",
      "need": "optional",
      "for": ["skill:analyze-profile"],
      "detect": { "any": ["dotnet-trace"] },
      "degrade": "Without dotnet-trace, analyze-profile cannot convert a .NET trace file; it reports the file and stops.",
      "install": {
        "docs": "https://learn.microsoft.com/en-us/dotnet/core/diagnostics/dotnet-trace",
        "dotnet-tool": "dotnet-trace"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "dotnet-gcdump",
      "kind": "cli",
      "need": "optional",
      "for": ["skill:analyze-profile"],
      "detect": { "any": ["dotnet-gcdump"] },
      "degrade": "Without dotnet-gcdump, analyze-profile cannot report a .NET heap dump file; it reports the file and stops.",
      "install": {
        "docs": "https://learn.microsoft.com/en-us/dotnet/core/diagnostics/dotnet-gcdump",
        "dotnet-tool": "dotnet-gcdump"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "go",
      "kind": "cli",
      "need": "optional",
      "for": ["skill:analyze-profile"],
      "detect": { "any": ["go"] },
      "degrade": "Without go, analyze-profile cannot read a pprof profile with go tool pprof; it reports the file and stops.",
      "install": { "docs": "https://go.dev/dl/", "brew": "go", "winget": "GoLang.Go", "apt": "golang-go" },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "perf",
      "kind": "cli",
      "need": "optional",
      "for": ["skill:analyze-profile"],
      "detect": { "any": ["perf"] },
      "degrade": "Without perf, analyze-profile cannot report a native Linux perf.data file; it reports the file and stops.",
      "install": { "docs": "https://man7.org/linux/man-pages/man1/perf-record.1.html", "apt": "linux-tools-generic" },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "addr2line",
      "kind": "cli",
      "need": "optional",
      "for": ["skill:analyze-profile"],
      "detect": { "any": ["addr2line"] },
      "degrade": "Without addr2line, analyze-profile cannot map a native address to a file and line; it reports the address as unresolved.",
      "install": { "docs": "https://sourceware.org/binutils/docs/binutils/addr2line.html", "apt": "binutils", "brew": "binutils" },
      "check": "/harness-ops:prerequisites"
    }
  ]
}
