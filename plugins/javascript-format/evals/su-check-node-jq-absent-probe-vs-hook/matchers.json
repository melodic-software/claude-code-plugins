{
  "node-probe-ran": [
    {
      "use": "command_position_multishell"
    },
    "command\\s+-v\\s+(?:[\\w.-]+\\s+)*node(?![\\w.-])"
  ],
  "no-install": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "install_command"
    }
  ],
  "no-biome-run": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?biome(?:\\.exe)?(?:\\\\\\\"|')?(?![\\w./-])(?!(?:\\s|\\\\\\\\\\\\n)+(?:--?version|--?help|-h|version)\\b)"
  ],
  "no-apply-step": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "apply_step"
    }
  ]
}
