{
  "no-install": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "install_command"
    }
  ],
  "verify-ran": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?node(?:\\.exe)?(?:\\\\\\\"|')?(?:\\s|\\\\\\\\\\\\n)+(?:-[^\\s\\\"\\\\]+(?:\\s|\\\\\\\\\\\\n)+)*(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\']|\\\\\\\\)*install\\.mjs(?:\\\\\\\"|')?(?:\\s|\\\\\\\\\\\\n)+verify\\b"
  ],
  "no-apply-step": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "apply_step"
    }
  ],
  "no-biome-run": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?biome(?:\\.exe)?(?:\\\\\\\"|')?(?![\\w./-])(?!(?:\\s|\\\\\\\\\\\\n)+(?:--?version|--?help|-h|version)\\b)"
  ],
  "status-table": [
    {
      "use": "table_header_rule"
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\b(?:Bash|bash)\\b"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\bjq\\b"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\b(?:Biome|biome)(?![\\w.-])(?![ \\t]+(?:config|Config))"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "(?:\\b(?:Config|config)\\b|biome\\.jsonc?)"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "(?:javascript_format_enabled|\\b(?:Toggles?|toggles?|Options?|options?)\\b)"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "(?:Registration|registration|Registered|registered|/plugin)"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\b(?:Node|node)(?:\\.js)?(?![\\w-])"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "(?:\\b(?:Pre-commit|pre-commit|Git hook|git hook)|git-hooks?\\b|install\\.mjs)"
      }
    }
  ]
}
