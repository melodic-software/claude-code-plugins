{
  "yarn-probe-ran": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?yarn(?:\\.(?:exe|cmd))?(?:\\\\\\\"|')?(?:\\s+-{1,2}[^\\s\\\"\\\\]+(?:\\s+[^\\s\\\"\\\\-][^\\s\\\"\\\\]*)?)*?\\s+config\\s+get\\s+nodeLinker\\b"
  ],
  "no-install": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "install_command"
    }
  ],
  "no-corepack-fetch": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?corepack(?:\\.(?:exe|cmd))?(?:\\\\\\\"|')?(?:\\s+-{1,2}[^\\s\\\"\\\\]+)*\\s+(?:enable|prepare|install|use|up|yarn|pnpm|npm)\\b"
  ],
  "no-apply-step": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "apply_step"
    }
  ],
  "no-plugin-cli-write": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "plugin_cli_write"
    }
  ]
}
