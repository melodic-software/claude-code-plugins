{
  "requires": [
    {
      "id": "node",
      "kind": "runtime",
      "need": "optional",
      "for": [
        "plugin",
        "skill:check",
        "skill:lint"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, /toolchain:check and /toolchain:lint cannot record their result and the turn-end result gate cannot launch, so no turn-end warning is shown. Build, test and lint runs are unaffected.",
      "install": {
        "docs": "https://nodejs.org/en/download",
        "brew": "node",
        "winget": "OpenJS.NodeJS.LTS",
        "apt": "nodejs"
      },
      "check": "/toolchain:check-prerequisites"
    },
    {
      "id": "python3",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:ratchet"
      ],
      "detect": {
        "any": [
          "python3",
          "python"
        ],
        "version": {
          "args": [
            "--version"
          ],
          "pattern": "Python ([0-9.]+)",
          "min": "3"
        }
      },
      "degrade": "Without Python 3, the count ratchet cannot measure or record a ceiling. The other toolchain skills are unaffected.",
      "install": {
        "docs": "https://www.python.org/downloads/",
        "brew": "python",
        "winget": "Python.Python.3.12",
        "apt": "python3"
      },
      "check": "/toolchain:check-prerequisites"
    }
  ]
}
