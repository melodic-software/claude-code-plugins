{
  "description": "Rewrites JavaScript, TypeScript and JSON with Biome once per batch of tool calls, optionally checks the uncommitted changes when a turn ends, and reports a missing biome or a drifted git-hook entry at session start.",
  "hooks": {
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--run-if-unset-or-true",
              "BIOME_FORMAT_ENABLED",
              "${CLAUDE_PLUGIN_ROOT}/hooks/biome-format.sh"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--run-if-unset-or-true",
              "BIOME_FORMAT_ENABLED",
              "--require-true",
              "BIOME_FORMAT_END_OF_TURN",
              "${CLAUDE_PLUGIN_ROOT}/hooks/biome-format.sh",
              "--end-of-turn"
            ],
            "timeout": 30,
            "statusMessage": "Checking JavaScript, TypeScript and JSON in uncommitted changes..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.mjs",
              "probe",
              "${CLAUDE_PLUGIN_ROOT}",
              "--run-if-unset-or-true",
              "BIOME_FORMAT_ENABLED"
            ],
            "timeout": 10,
            "statusMessage": "Checking biome..."
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.sh\" node-notice /biome-format:check BIOME_FORMAT_ENABLED; ${PPID:+exit}; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.ps1\" node-notice /biome-format:check BIOME_FORMAT_ENABLED",
            "timeout": 10,
            "statusMessage": "Checking that node is on PATH..."
          }
        ]
      }
    ]
  }
}
