{
  "requires": [
    {
      "id": "biome",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:biome-format.sh"
      ],
      "detect": {
        "any": [
          "biome"
        ],
        "local_bin": [
          "node_modules/.bin/biome"
        ]
      },
      "degrade": "Without biome, the hook cannot format or lint edited JavaScript, TypeScript, JSON and CSS files; edits still go through.",
      "install": {
        "npm": "npm i -D @biomejs/biome"
      },
      "check": "/biome-format:check"
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:biome-format.sh"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, the biome-format hooks skip their work for the session and say so once.",
      "install": {
        "docs": "https://jqlang.org/download/"
      },
      "check": "/biome-format:check"
    },
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the biome-format hooks cannot launch, so they do nothing.",
      "install": {
        "docs": "https://nodejs.org/en/download"
      },
      "check": "/biome-format:check"
    }
  ]
}
