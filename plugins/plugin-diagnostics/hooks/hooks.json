{
  "description": "Reports why installed plugins cannot run. At the end of each turn it warns once per session per hook when the transcript records a hook launch or exec failure Claude Code never surfaced. At session start it reports a missing node, and runs the prerequisites probe of each enabled plugin whose prerequisites.json declares session_probe, as one notice.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/hook-failure-audit.sh\"",
            "async": true,
            "timeout": 10,
            "statusMessage": "Checking for unsurfaced hook failures..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.sh\" node-notice /harness-ops:prerequisites; ${PPID:+exit}; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.ps1\" node-notice /harness-ops:prerequisites",
            "timeout": 10,
            "statusMessage": "Checking that node is on PATH..."
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/lib/node-or-skip.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/prerequisites-fleet.mjs\"; ${PPID:+exit}; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/lib/node-or-skip.ps1\" \"${CLAUDE_PLUGIN_ROOT}/hooks/prerequisites-fleet.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking the enabled plugins' prerequisites..."
          }
        ]
      }
    ]
  }
}
