specification {
  element container
  deploymentNode environment
  deploymentNode node
}
model {
  c2_web = container 'web' {
    technology 'ghcr.io/acme/web:2'
    description 'replicas 2'
  }
}
deployment {
  env2_prod = environment 'prod' {
    n2_web = node 'web' 'ingress web.example.com'
    n3_web_svc = node 'web-svc' 'network'
    cn4_web = node 'web' 'compute Deployment' {
      instanceOf c2_web
    }
  }
  env2_prod.n2_web -> env2_prod.cn4_web.c2_web 'routes web.example.com'
  env2_prod.n3_web_svc -> env2_prod.cn4_web.c2_web 'selects app=web'
}
views {
  deployment view view2_prod {
    title 'prod'
    include env2_prod.**
  }
}
