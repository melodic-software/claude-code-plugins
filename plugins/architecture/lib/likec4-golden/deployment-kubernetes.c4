specification {
  element container
  deploymentNode environment
  deploymentNode node
}
model {
  c2_api = container 'api' {
    technology 'ghcr.io/acme/api:2'
    description 'replicas 2'
  }
}
deployment {
  env2_prod = environment 'prod' {
    n2_api = node 'api' 'ingress api.example.com'
    n3_api_svc = node 'api-svc' 'network'
    cn4_api = node 'api' 'compute Deployment' {
      instanceOf c2_api
    }
  }
  env2_prod.n2_api -> env2_prod.cn4_api.c2_api 'routes api.example.com'
  env2_prod.n3_api_svc -> env2_prod.cn4_api.c2_api 'selects app=api'
}
views {
  deployment view view2_prod {
    title 'prod'
    include env2_prod.**
  }
}
