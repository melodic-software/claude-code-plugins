{
  "requires": [
    {
      "id": "python3",
      "kind": "cli",
      "need": "required",
      "for": [
        "skill:audit",
        "skill:apply"
      ],
      "detect": {
        "any": [
          "python3"
        ]
      },
      "degrade": "Without Python 3, the audit script cannot build its report and /repo-fleet-hygiene:apply cannot read an action plan.",
      "install": {
        "docs": "https://www.python.org/downloads/",
        "brew": "python",
        "winget": "Python.Python.3.12",
        "apt": "python3"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "skill:audit"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, /repo-fleet-hygiene:audit cannot parse the GitHub data it collects and stops.",
      "install": {
        "docs": "https://jqlang.org/download/",
        "brew": "jq",
        "winget": "jqlang.jq",
        "apt": "jq"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "gh",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:audit"
      ],
      "detect": {
        "any": [
          "gh"
        ]
      },
      "degrade": "Without gh or an authenticated session, the audit skips the GitHub checks (moved or renamed repositories, default branch lookup) and reports local evidence only.",
      "install": {
        "docs": "https://cli.github.com/",
        "brew": "gh",
        "winget": "GitHub.cli",
        "apt": "gh"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "node",
      "kind": "cli",
      "need": "optional",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the prerequisites checker cannot run, so a missing tool above goes unreported; the plugin's own skills are unaffected.",
      "install": {
        "docs": "https://nodejs.org/en/download",
        "brew": "node",
        "winget": "OpenJS.NodeJS.LTS",
        "apt": "nodejs"
      },
      "check": "/harness-ops:prerequisites"
    }
  ]
}
