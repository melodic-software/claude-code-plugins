{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "note", "rows"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "note": {"type": "string", "minLength": 1},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["job", "rank", "id", "kind", "detect", "account", "status", "as_of"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"required": ["kind"], "properties": {"kind": {"const": "skill"}}},
            "then": {"properties": {"id": {"type": "string", "pattern": "^/[a-z0-9-]+(:[a-z0-9-]+)?$"}}}
          },
          {
            "if": {
              "required": ["kind", "detect", "id"],
              "properties": {
                "kind": {"const": "skill"},
                "detect": {"type": "string", "pattern": "^[^@]+$"},
                "id": {"type": "string", "pattern": "^/[a-z0-9-]+:[a-z0-9-]+$"}
              }
            },
            "then": {"not": {"required": ["pointer"]}},
            "else": {"required": ["pointer"]}
          }
        ],
        "properties": {
          "job": {
            "enum": ["research-instruments", "synthesis", "flows-ia", "evaluation", "heuristics", "journeys", "measurement", "analytics", "handoff-ui"]
          },
          "rank": {"type": "integer", "minimum": 1},
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["skill", "plugin", "mcp", "tool"]},
          "detect": {"type": "string", "minLength": 1},
          "account": {"enum": ["none", "key", "login", "paid"]},
          "status": {"enum": ["confirmed", "unconfirmed", "deferred"]},
          "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "pointer": {"type": "string", "pattern": "^https://"}
        }
      }
    }
  }
}
