{
  "description": "Formats shell scripts with shfmt once per batch of tool calls, optionally checks the uncommitted changes when a turn ends, and reports a missing shfmt or shellcheck or a drifted git-hook entry at session start.",
  "hooks": {
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--run-if-unset-or-true",
              "BASH_FORMAT_ENABLED",
              "--skip-unless-stdin-contains",
              "sh\"",
              "${CLAUDE_PLUGIN_ROOT}/hooks/bash-format.sh"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--run-if-unset-or-true",
              "BASH_FORMAT_ENABLED",
              "--require-true",
              "BASH_FORMAT_END_OF_TURN",
              "${CLAUDE_PLUGIN_ROOT}/hooks/bash-format.sh",
              "--end-of-turn"
            ],
            "timeout": 30,
            "statusMessage": "Checking shell scripts in uncommitted changes..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.mjs",
              "probe",
              "${CLAUDE_PLUGIN_ROOT}",
              "--run-if-unset-or-true",
              "BASH_FORMAT_ENABLED"
            ],
            "timeout": 10,
            "statusMessage": "Checking shfmt and shellcheck..."
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.sh\" node-notice /bash-format:check BASH_FORMAT_ENABLED; ${PPID:+exit}; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.ps1\" node-notice /bash-format:check BASH_FORMAT_ENABLED",
            "timeout": 10,
            "statusMessage": "Checking that node is on PATH..."
          }
        ]
      }
    ]
  }
}
