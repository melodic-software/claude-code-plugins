{
  "description": "Formats a shell script with shfmt and reports ShellCheck findings after a write or edit, and reports a missing shfmt or shellcheck at session start.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/bash-format.sh"
            ],
            "if": "Edit(*.sh)",
            "timeout": 15,
            "statusMessage": "Formatting shell script..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/bash-format.sh"
            ],
            "if": "Edit(*.bash)",
            "timeout": 15,
            "statusMessage": "Formatting shell script..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.mjs",
              "probe",
              "${CLAUDE_PLUGIN_ROOT}",
              "--run-if-unset-or-true",
              "BASH_FORMAT_ENABLED"
            ],
            "timeout": 10,
            "statusMessage": "Checking shfmt and shellcheck..."
          }
        ]
      }
    ]
  }
}
