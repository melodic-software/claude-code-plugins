{
  "description": "Formats a shell script with shfmt and reports ShellCheck findings after a write or edit, and reports a missing shfmt or shellcheck at session start.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/bash-format.sh"
            ],
            "if": "Edit(*.sh)",
            "timeout": 15,
            "statusMessage": "Formatting shell script..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/bash-format.sh"
            ],
            "if": "Edit(*.bash)",
            "timeout": 15,
            "statusMessage": "Formatting shell script..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.mjs",
              "probe",
              "${CLAUDE_PLUGIN_ROOT}",
              "--run-if-unset-or-true",
              "BASH_FORMAT_ENABLED"
            ],
            "timeout": 10,
            "statusMessage": "Checking shfmt and shellcheck..."
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.sh\" node-notice /bash-format:check BASH_FORMAT_ENABLED; ${PPID:+exit}; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.ps1\" node-notice /bash-format:check BASH_FORMAT_ENABLED",
            "timeout": 10,
            "statusMessage": "Checking that node is on PATH..."
          }
        ]
      }
    ]
  }
}
