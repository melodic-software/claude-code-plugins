{
  "remote": {
    "git_url": "https://github.com/melodic-software/claude-code-plugins",
    "ref": "main",
    "config": "plugins/bash-format/git-hooks/lefthook-remote.yml",
    "aggregate": "lefthook-remote.yml"
  },
  "earlierEntries": [{ "from": "shell-check", "to": ["format", "lint"] }],
  "ecosystems": ["bash"],
  "entries": [
    {
      "name": "format",
      "event": "pre-commit",
      "script": "format.sh",
      "tools": ["shfmt", "jq"],
      "rewrites": true,
      "resolved": true,
      "assets": ["lib/git-hooks/resolve-tool.sh", "git-hooks/adapters.sh", "git-hooks/shfmt-rewrite.sh"]
    },
    {
      "name": "lint",
      "event": "pre-commit",
      "script": "lint.sh",
      "tools": ["shellcheck"],
      "rewrites": false,
      "resolved": true,
      "assets": ["lib/git-hooks/resolve-tool.sh", "git-hooks/adapters.sh"]
    },
    {
      "name": "lint-full",
      "event": "pre-push",
      "script": "lint-full.sh",
      "tools": ["shellcheck"],
      "rewrites": false,
      "resolved": true,
      "assets": ["lib/git-hooks/resolve-tool.sh", "git-hooks/adapters.sh"]
    }
  ]
}
