{
  "verify-ran": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?node(?:\\.exe)?(?:\\\\\\\"|')?(?:\\s|\\\\\\\\\\\\n)+(?:-[^\\s\\\"\\\\]+(?:\\s|\\\\\\\\\\\\n)+)*(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\']|\\\\\\\\)*install\\.mjs(?:\\\\\\\"|')?(?:\\s|\\\\\\\\\\\\n)+verify\\b"
  ],
  "status-table": [
    {
      "use": "table_header_rule"
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\b(?:Bash|bash)\\b(?!-format)"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\b(?:Node|node)(?:\\.js)?(?![\\w-])"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\bjq\\b"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "(?:bash_format_\\w+|\\b(?:Hook options?|hook options?|Options?|options?|Toggles?|toggles?)\\b)"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "(?:Registration|registration|Registered|registered)"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "(?:Project scope|project scope|CLAUDE_PROJECT_DIR)"
      }
    }
  ],
  "lint-format-separate-rows": [
    {
      "use": "table_header_rule"
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "(?<![.\\w])(?:ShellCheck|Shellcheck|shellcheck)(?!rc)(?![^|\\n]*shfmt)"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\bshfmt\\b(?![^|\\n]*(?:ShellCheck|Shellcheck|shellcheck|editorconfig))"
      }
    }
  ],
  "no-install": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "install_command"
    }
  ],
  "no-formatter-run": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?(?:shfmt|shellcheck)(?:\\.exe)?(?:\\\\\\\"|')?(?![\\w.-])(?!(?:\\s|\\\\\\\\\\\\n)+(?:--?version|-V|--help|-h)\\b)"
  ],
  "no-apply-step": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?node(?:\\.exe)?(?:\\\\\\\"|')?(?:\\s|\\\\\\\\\\\\n)+(?:-[^\\s\\\"\\\\]+(?:\\s|\\\\\\\\\\\\n)+)*(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\']|\\\\\\\\)*install\\.mjs(?:\\\\\\\"|')?(?:\\s|\\\\\\\\\\\\n)+(?:plan|copy|decline|config-hook)\\b"
  ]
}
