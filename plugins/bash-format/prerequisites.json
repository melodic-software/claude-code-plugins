{
  "requires": [
    {
      "id": "shfmt",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:bash-format.sh"
      ],
      "detect": {
        "any": [
          "shfmt"
        ]
      },
      "degrade": "Without shfmt, the hook cannot format edited shell scripts.",
      "install": {
        "docs": "https://github.com/mvdan/sh#shfmt"
      },
      "check": "/bash-format:check"
    },
    {
      "id": "shellcheck",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:bash-format.sh"
      ],
      "detect": {
        "any": [
          "shellcheck"
        ]
      },
      "degrade": "Without shellcheck, the hook cannot lint edited shell scripts.",
      "install": {
        "docs": "https://github.com/koalaman/shellcheck#installing"
      },
      "check": "/bash-format:check"
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:bash-format.sh"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, the bash-format hooks skip their work.",
      "install": {
        "docs": "https://jqlang.org/download/"
      },
      "check": "/bash-format:check"
    },
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the bash-format hooks cannot launch, so they do nothing.",
      "install": {
        "docs": "https://nodejs.org/en/download"
      },
      "check": "/bash-format:check"
    }
  ]
}
