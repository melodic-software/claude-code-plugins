{
  "session_probe": {
    "run_if_unset_or_true": "BASH_FORMAT_ENABLED"
  },
  "requires": [
    {
      "id": "shfmt",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:bash-format.sh"
      ],
      "detect": {
        "any": [
          "shfmt"
        ]
      },
      "when": {
        "config_any": [{ "file": ".editorconfig", "pattern": "^\\s*\\[[^\\]\\n]*(\\*\\.(sh|bash)([^A-Za-z0-9]|$)|[{,](sh|bash)[,}])" }]
      },
      "degrade": "Without shfmt, the shfmt adapter cannot format edited shell scripts.",
      "install": {
        "docs": "https://github.com/mvdan/sh#shfmt"
      }
    },
    {
      "id": "shellcheck",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:bash-format.sh"
      ],
      "detect": {
        "any": [
          "shellcheck"
        ]
      },
      "when": {
        "config_any": [".shellcheckrc", "shellcheckrc"]
      },
      "degrade": "Without shellcheck, the ShellCheck adapter cannot lint staged shell scripts.",
      "install": {
        "docs": "https://github.com/koalaman/shellcheck#installing"
      }
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:bash-format.sh"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, the bash-format hooks skip their work.",
      "install": {
        "docs": "https://jqlang.org/download/"
      }
    },
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the bash-format hooks cannot launch, so they do nothing.",
      "install": {
        "docs": "https://nodejs.org/en/download"
      }
    }
  ]
}
