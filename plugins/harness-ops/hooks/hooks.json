{
  "description": "Records session observability telemetry: nine audit rows (API errors, config changes, instruction loads, permission denials, compactions, skill usage, tool failures, unsurfaced hook failures) that emit the hook-telemetry envelope, seven of them dispatched by event from one emitter and two in their own scripts, plus the default-off per-session hook event log on every documented event that neither changes behavior nor fires per tool call, and its SessionEnd retention.",
  "hooks": {
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/audit-event-emitter.sh"
            ],
            "timeout": 5,
            "statusMessage": "Recording API-error telemetry..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--require-true",
              "SESSION_EVENT_LOG_ENABLED",
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-event-log.sh"
            ],
            "timeout": 5,
            "statusMessage": "Logging the StopFailure event...",
            "async": true
          }
        ]
      }
    ],
