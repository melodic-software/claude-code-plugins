{
  "requires": [
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the harness-ops hooks cannot launch, so they do nothing.",
      "install": {
        "docs": "https://nodejs.org/en/download"
      },
      "check": "/harness-ops:check"
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:audit-event-emitter.sh",
        "hook:hook-failure-audit.sh",
        "hook:session-event-log.sh",
        "hook:session-retention.sh",
        "hook:skill-usage-audit.sh"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, the harness-ops hooks skip their work.",
      "install": {
        "docs": "https://jqlang.org/download/"
      },
      "check": "/harness-ops:check"
    },
    {
      "id": "curl",
      "kind": "cli",
      "need": "required",
      "for": [
        "skill:changelog",
        "skill:inventory",
        "skill:audit-native-overlap"
      ],
      "detect": {
        "any": [
          "curl"
        ]
      },
      "degrade": "Without curl, fetch-docs.sh cannot fetch a docs page and records it unread with reason curl-missing, so /harness-ops:changelog reports its range as not computed and an upstream claim in /harness-ops:inventory or /harness-ops:audit-native-overlap has no page to rest on; a cached entry still within --max-age is served without a request.",
      "install": {
        "docs": "https://curl.se/download.html",
        "brew": "curl",
        "winget": "cURL.cURL",
        "apt": "curl"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "python3",
      "kind": "runtime",
      "need": "optional",
      "for": [
        "skill:changelog",
        "skill:inventory",
        "skill:audit-native-overlap"
      ],
      "detect": {
        "any": [
          "python3",
          "python"
        ],
        "reject_store_alias": true
      },
      "degrade": "Without Python 3, a docs page that serves only HTML cannot be converted and is recorded unread with reason no-python; pages served as markdown read normally.",
      "install": {
        "docs": "https://www.python.org/downloads/",
        "brew": "python",
        "winget": "Python.Python.3.12",
        "apt": "python3"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "az",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:morning-brief"
      ],
      "detect": {
        "any": [
          "az"
        ]
      },
      "degrade": "Without az, every Azure line in the morning brief's Cost section prints UNREADABLE and says to install az; with az logged out, each prints UNREADABLE and says to run az login. The GitHub lines and every other section still render, and the brief exits 6.",
      "install": {
        "docs": "https://learn.microsoft.com/en-us/cli/azure/install-azure-cli#install",
        "brew": "azure-cli",
        "winget": "Microsoft.AzureCLI"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "noto-sans-symbols-2",
      "kind": "system-lib",
      "need": "optional",
      "for": [
        "skill:control-claude-code"
      ],
      "detect": {
        "probe": {
          "args": [
            "fc-list",
            ":",
            "family"
          ],
          "pattern": "Noto Sans Symbols 2"
        }
      },
      "degrade": "Without the Noto Sans Symbols 2 font, some Claude Code status glyphs draw as boxes in control-claude-code screenshots and recordings; capture still runs. macOS and Windows have no fc-list, so the driver's doctor verb reports the font as unverified and capture proceeds.",
      "install": {
        "docs": "https://fonts.google.com/noto/specimen/Noto+Sans+Symbols+2",
        "apt": "fonts-noto-core"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "claude",
      "kind": "cli",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "claude"
        ],
        "version": {
          "args": [
            "--version"
          ],
          "pattern": "^([0-9.]+)",
          "min": "2.1.287"
        }
      },
      "degrade": "Claude Code older than 2.1.287 is unsupported: the module that writes the per-session hook event log and runs its SessionEnd retention does not load there, so the log stays empty even when switched on. The audit hooks in settings still run.",
      "install": {
        "docs": "https://code.claude.com/docs/en/setup#update-claude-code"
      },
      "check": "/harness-ops:prerequisites"
    }
  ]
}
