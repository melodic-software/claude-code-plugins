{
  "requires": [
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the harness-ops hooks cannot launch, so they do nothing.",
      "install": {
        "docs": "https://nodejs.org/en/download"
      },
      "check": "/harness-ops:check"
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:audit-event-emitter.sh",
        "hook:hook-failure-audit.sh",
        "hook:session-event-log.sh",
        "hook:session-retention.sh",
        "hook:skill-usage-audit.sh"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, the harness-ops hooks skip their work.",
      "install": {
        "docs": "https://jqlang.org/download/"
      },
      "check": "/harness-ops:check"
    },
    {
      "id": "curl",
      "kind": "cli",
      "need": "required",
      "for": [
        "skill:changelog",
        "skill:inventory",
        "skill:audit-native-overlap"
      ],
      "detect": {
        "any": [
          "curl"
        ]
      },
      "degrade": "Without curl, fetch-docs.sh cannot fetch a docs page and records it unread with reason curl-missing, so /harness-ops:changelog reports its range as not computed and an upstream claim in /harness-ops:inventory or /harness-ops:audit-native-overlap has no page to rest on; a cached entry still within --max-age is served without a request.",
      "install": {
        "docs": "https://curl.se/download.html",
        "brew": "curl",
        "winget": "cURL.cURL",
        "apt": "curl"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "python3",
      "kind": "runtime",
      "need": "optional",
      "for": [
        "skill:changelog",
        "skill:inventory",
        "skill:audit-native-overlap"
      ],
      "detect": {
        "any": [
          "python3",
          "python"
        ],
        "reject_store_alias": true
      },
      "degrade": "Without Python 3, a docs page that serves only HTML cannot be converted and is recorded unread with reason no-python; pages served as markdown read normally.",
      "install": {
        "docs": "https://www.python.org/downloads/",
        "brew": "python",
        "winget": "Python.Python.3.12",
        "apt": "python3"
      },
      "check": "/harness-ops:prerequisites"
    }
  ]
}
