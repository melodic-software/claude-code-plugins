{
  "claim": "Under an unmeetable goal, a fixed reply with no tool call to each evaluator re-prompt ends the re-prompts at the Stop-hook block cap, and the goal is never marked met or cleared.",
  "tags": ["/goal", "goal evaluator", "Stop hook", "CLAUDE_CODE_STOP_HOOK_BLOCK_CAP"],
  "permission_mode": "default",
  "model": "claude-haiku-5-5",
  "max_turns": 20,
  "max_budget_usd": 1.0,
  "timeout": 400,
  "target": {
    "patterns": [
      "^(?!\\{\"type\":\"api-request)(?=.*\"role\":\\s*\"assistant\")(?=.*Handoff written; waiting for /clear\\.)",
      "blocked the turn from ending \\d+ consecutive times"
    ],
    "absent": [
      "\"type\":\\s*\"tool_use\"",
      "\"type\":\\s*\"goal_status\",\\s*\"met\":\\s*true"
    ],
    "example": [
      "{\"type\":\"assistant\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Handoff written; waiting for /clear.\"}]}}",
      "{\"type\":\"attachment\",\"attachment\":{\"type\":\"goal_status\",\"met\":false}}",
      "{\"type\":\"system\",\"subtype\":\"informational\",\"content\":\"A hook blocked the turn from ending 9 consecutive times\"}"
    ]
  },
  "outcome": "transcript-grep",
  "control": "hooks/handoff-goal-reaches-prompt-hook"
}
