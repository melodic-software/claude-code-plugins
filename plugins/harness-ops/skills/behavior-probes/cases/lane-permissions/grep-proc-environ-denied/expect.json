{
  "claim": "Under dontAsk with the write lane's tool lists, Read(//proc/**) denies a Grep of /proc/self/environ.",
  "tags": ["Read rule", "deny rule", "Grep", "disallowedTools", "allowedTools", "dontAsk", "/proc"],
  "permission_mode": "dontAsk",
  "tool_rules": "lane-write-tools.json",
  "verdict_only": true,
  "platforms": ["linux"],
  "requires": ["git"],
  "target": {
    "tool": "Grep",
    "input_match": "\"path\": \"/proc/self/environ\"",
    "example": { "pattern": "PATH=", "path": "/proc/self/environ", "output_mode": "files_with_matches" }
  },
  "outcome": "deny",
  "control": "lane-permissions/grep-in-checkout-runs"
}
