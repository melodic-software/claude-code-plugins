{
  "claim": "Control: under dontAsk with the write lane's tool lists, a Grep of a file inside the checkout runs.",
  "tags": ["Read rule", "deny rule", "Grep", "disallowedTools", "allowedTools", "dontAsk"],
  "permission_mode": "dontAsk",
  "tool_rules": "lane-write-tools.json",
  "verdict_only": true,
  "platforms": ["linux"],
  "requires": ["git"],
  "target": {
    "tool": "Grep",
    "input_match": "\"pattern\": \"lane-probe-marker\"",
    "example": { "pattern": "lane-probe-marker", "path": "notes.txt", "output_mode": "files_with_matches" }
  },
  "outcome": "ran",
  "match": "notes.txt"
}
