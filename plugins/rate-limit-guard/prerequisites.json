{
  "requires": [
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the StopFailure hook cannot launch and records nothing, and the module cannot write the snapshot file; its lines and band row still work.",
      "install": {
        "docs": "https://nodejs.org/en/download"
      },
      "check": "/rate-limit-guard:check"
    },
    {
      "id": "claude",
      "kind": "cli",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "claude"
        ],
        "version": {
          "args": [
            "--version"
          ],
          "pattern": "^([0-9.]+)",
          "min": "2.1.287"
        }
      },
      "degrade": "Claude Code older than 2.1.287 is unsupported: the module that sends rate-limit lines, draws the band row, serves the status tool and writes the snapshot does not load there.",
      "install": {
        "docs": "https://code.claude.com/docs/en/setup#update-claude-code"
      },
      "check": "/rate-limit-guard:check"
    }
  ]
}
