{
  "description": "Records a stop caused by an API rate limit, so the pause is visible rather than looking like a finished turn.",
  "hooks": {
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/record-rate-limit-stop.sh"
            ],
            "timeout": 10,
            "statusMessage": "Recording rate-limit stop..."
          }
        ]
      }
    ]
  }
}
