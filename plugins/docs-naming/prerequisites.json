{
  "requires": [
    {
      "id": "node",
      "kind": "runtime",
      "need": "optional",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the prerequisites checker cannot run and no dependency is verified; the plugin's own skills are unaffected.",
      "install": {
        "docs": "https://nodejs.org/en/download",
        "brew": "node",
        "winget": "OpenJS.NodeJS.LTS",
        "apt": "nodejs"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, the docs-naming scripts cannot read their config, so audit, realign, gate generation and setup all stop.",
      "install": {
        "docs": "https://jqlang.org/download/",
        "brew": "jq",
        "winget": "jqlang.jq",
        "apt": "jq"
      },
      "check": "/harness-ops:prerequisites"
    }
  ]
}
