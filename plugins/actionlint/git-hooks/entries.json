{
  "remote": {
    "git_url": "https://github.com/melodic-software/claude-code-plugins",
    "ref": "main",
    "config": "plugins/actionlint/git-hooks/lefthook-remote.yml",
    "aggregate": "lefthook-remote.yml"
  },
  "earlierEntries": [{ "from": "actionlint-check", "to": ["lint"] }],
  "ecosystems": ["github-actions"],
  "entries": [
    {
      "name": "lint",
      "event": "pre-commit",
      "script": "lint.sh",
      "tools": ["actionlint"],
      "rewrites": false,
      "resolved": true,
      "assets": ["lib/git-hooks/resolve-tool.sh", "git-hooks/adapters.sh"]
    }
  ]
}
