{
  "verify-ran": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?node(?:\\.exe)?(?:\\\\\\\"|')?(?:\\s|\\\\\\\\\\\\n)+(?:-[^\\s\\\"\\\\]+(?:\\s|\\\\\\\\\\\\n)+)*(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\']|\\\\\\\\)*install\\.mjs(?:\\\\\\\"|')?(?:\\s|\\\\\\\\\\\\n)+(?:verify)\\b"
  ],
  "no-install": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "install_command"
    }
  ],
  "no-apply-step": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "apply_step"
    }
  ],
  "no-linter-run": [
    {
      "use": "command_position_multishell"
    },
    "(?:(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?actionlint(?:\\.exe)?(?![\\w.\\-/])(?!(?:\\\\\\\"|')?\\s+-{1,2}version\\b)(?:\\\\\\\"|')?|(?:(?:bash|dash|zsh|sh)\\s+(?:-\\w+\\s+)*)?(?:\\\\\\\"|')?[^\\s\\\"\\\\;&|=']*(?:git-)?hooks/actionlint-check\\.sh|(?:(?:bash|dash|zsh|sh)\\s+(?:-\\w+\\s+)*)?(?:\\\\\\\"|')?[^\\s\\\"\\\\;&|=']*git-hooks/(?:lint|adapters)\\.sh(?!(?:\\\\\\\"|')?\\s+--resolve\\b))"
  ],
  "status-table": [
    {
      "use": "table_header_rule"
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "actionlint(?![\\w.\\-/])"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\b[Nn]ode(?:\\.js)?(?![\\w.\\-/])"
      }
    }
  ],
  "covers-check-steps": [
    {
      "use": "table_header_rule"
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\b(?:Bash|bash)\\b"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "(?:actionlint\\.ya?ml|\\b(?:Config|config|Resolution|resolution|Resolves?|resolves?)\\b)"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "(?:actionlint_enabled|\\b(?:Toggles?|toggles?)\\b)"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\b(?:Registration|registration|Registered|registered|Plugin enabled|plugin enabled)\\b"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "(?:\\b(?:Pre-commit|pre-commit|Git hook|git hook)|git-hooks?\\b|install\\.mjs)"
      }
    }
  ]
}
