{
  "description": "Lints a GitHub Actions workflow with actionlint after Claude writes or edits one, and reports a missing actionlint at session start.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/actionlint-check.sh"
            ],
            "if": "Edit(**/.github/workflows/*.yml)",
            "timeout": 15,
            "statusMessage": "Checking workflow with actionlint..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/actionlint-check.sh"
            ],
            "if": "Edit(**/.github/workflows/*.yaml)",
            "timeout": 15,
            "statusMessage": "Checking workflow with actionlint..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.mjs",
              "probe",
              "${CLAUDE_PLUGIN_ROOT}",
              "--run-if-unset-or-true",
              "ACTIONLINT_ENABLED"
            ],
            "timeout": 10,
            "statusMessage": "Checking actionlint..."
          }
        ]
      }
    ]
  }
}
