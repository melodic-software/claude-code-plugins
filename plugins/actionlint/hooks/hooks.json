{
  "description": "Optionally checks the uncommitted GitHub Actions workflow changes with actionlint when a turn ends, and reports a missing actionlint or a drifted git-hook entry at session start.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--run-if-unset-or-true",
              "ACTIONLINT_ENABLED",
              "--require-true",
              "ACTIONLINT_END_OF_TURN",
              "${CLAUDE_PLUGIN_ROOT}/hooks/actionlint-check.sh",
              "--end-of-turn"
            ],
            "timeout": 30,
            "statusMessage": "Checking workflows in uncommitted changes..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.mjs",
              "probe",
              "${CLAUDE_PLUGIN_ROOT}",
              "--run-if-unset-or-true",
              "ACTIONLINT_ENABLED"
            ],
            "timeout": 10,
            "statusMessage": "Checking actionlint..."
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.sh\" node-notice /actionlint:check ACTIONLINT_ENABLED; ${PPID:+exit}; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.ps1\" node-notice /actionlint:check ACTIONLINT_ENABLED",
            "timeout": 10,
            "statusMessage": "Checking that node is on PATH..."
          }
        ]
      }
    ]
  }
}
