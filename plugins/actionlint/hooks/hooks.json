{
  "description": "Optionally checks the uncommitted GitHub Actions workflow changes with actionlint when a turn ends; harness-ops reports a missing actionlint or a drifted git-hook entry at session start, from this plugin's prerequisites.json.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--run-if-unset-or-true",
              "ACTIONLINT_ENABLED",
              "--require-true",
              "ACTIONLINT_END_OF_TURN",
              "${CLAUDE_PLUGIN_ROOT}/hooks/actionlint-check.sh",
              "--end-of-turn"
            ],
            "timeout": 30,
            "statusMessage": "Checking workflows in uncommitted changes..."
          }
        ]
      }
    ]
  }
}
