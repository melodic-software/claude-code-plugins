{
  "session_probe": {
    "run_if_unset_or_true": "ACTIONLINT_ENABLED"
  },
  "requires": [
    {
      "id": "actionlint",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:actionlint-check.sh"
      ],
      "detect": {
        "any": [
          "actionlint"
        ]
      },
      "degrade": "Without actionlint, the git pre-commit entry and the end-of-turn check cannot lint GitHub Actions workflows.",
      "install": {
        "docs": "https://github.com/kjanat/actionlint/blob/v1.17.0/docs/install.md"
      }
    },
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the actionlint hooks cannot launch, so they do nothing.",
      "install": {
        "docs": "https://nodejs.org/en/download"
      }
    }
  ]
}
