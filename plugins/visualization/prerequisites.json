{
  "requires": [
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": ["skill:mermaid-gate"],
      "detect": {
        "any": ["node"]
      },
      "degrade": "Without node, /visualization:mermaid-gate cannot parse a Mermaid block; visualize still renders, unchecked.",
      "install": { "docs": "https://nodejs.org/en/download" },
      "check": "/visualization:mermaid-gate check"
    },
    {
      "id": "mmdc",
      "kind": "cli",
      "need": "optional",
      "for": ["skill:mermaid-gate"],
      "detect": {
        "any": ["mmdc"],
        "local_bin": ["node_modules/.bin/mmdc"],
        "version": { "args": ["--version"], "pattern": "([0-9]+\\.[0-9]+\\.[0-9]+)", "min": "11.17.0" }
      },
      "degrade": "Without mmdc 11.17.0, the gate runs its structural check only and a local page carries the Mermaid source with a note saying why instead of an SVG. A published Artifact renders Mermaid natively either way.",
      "install": { "docs": "https://github.com/mermaid-js/mermaid-cli", "npm": "npm install -g @mermaid-js/mermaid-cli@11.17.0" },
      "check": "/visualization:mermaid-gate check"
    }
  ]
}
