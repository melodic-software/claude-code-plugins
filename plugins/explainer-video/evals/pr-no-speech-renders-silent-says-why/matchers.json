{
  "renders-silent": [
    {
      "use": "command_position_multishell"
    },
    "(?:python[\\d.]*(?:\\.exe)?(?:\\s+-\\w+)*(?:\\s|\\\\\\\\\\\\n)+)?(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?pydeps\\.py(?:\\\\\\\"|')?(?![\\w.-])",
    {
      "use": "token_argument"
    },
    "render\\.py\\b"
  ],
  "no-narration-flag": [
    {
      "use": "command_position_multishell"
    },
    "(?:python[\\d.]*(?:\\.exe)?(?:\\s+-\\w+)*(?:\\s|\\\\\\\\\\\\n)+)?(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?(?:pydeps|render)\\.py(?:\\\\\\\"|')?(?![\\w.-])",
    {
      "use": "token_argument"
    },
    "--narration\\b"
  ]
}
