       {"n": 41, "kind": " ", "text": "def upload(path, url):"},
       {"n": 42, "kind": "-", "text": "    return post(path, url)"},
       {"n": 42, "kind": "+", "text": "    for delay in (1, 2, 4):"},
       {"n": 43, "kind": "+", "text": "        if (r := post(path, url)).ok or r.status < 500:"},
       {"n": 44, "kind": "+", "text": "            return r"},
       {"n": 45, "kind": "+", "text": "        sleep(delay)"},
       {"n": 46, "kind": "+", "text": "    return post(path, url)"}]},
     "narration": "The upload now tries up to four times. It waits one, two and four seconds between tries, and only retries server errors.",
     "covers": ["scripts/upload.py"]},
