#!/usr/bin/env bash
# delegate <codex|antigravity> [--model <id>] [--effort <level>] < prompt
# Runs one auto-delegated task: external-agents run <product> --use task --mode write
# --prompt-file <a temp file holding stdin>. No other external-agents flag can be passed.
set -euo pipefail

die() {
  printf 'delegate: %s\n' "$1" >&2
  exit 2
}

[[ $# -ge 1 ]] || die "usage: delegate <codex|antigravity> [--model <id>] [--effort <level>] < prompt"
product="$1"
shift
case "$product" in
codex | antigravity) ;;
*) die "product must be codex or antigravity, got '${product//[^[:print:]]/?}'" ;;
esac

extra=()
while [[ $# -gt 0 ]]; do
  case "$1" in
  --model)
    [[ $# -ge 2 && "$2" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$ ]] || die "--model needs an id of letters, digits, '.', '_', ':' or '-'"
    extra+=(--model "$2")
    shift 2
    ;;
  --effort)
    [[ $# -ge 2 && "$2" =~ ^[a-z]{1,16}$ ]] || die "--effort needs a lower-case level"
    extra+=(--effort "$2")
    shift 2
    ;;
  *) die "unsupported argument '${1//[^[:print:]]/?}': only --model and --effort are accepted" ;;
  esac
done

[[ ! -t 0 ]] || die "the prompt is read from stdin"
dir="$(mktemp -d)"
trap 'rm -rf "$dir"' EXIT
cat >"$dir/prompt.md"
[[ -s "$dir/prompt.md" ]] || die "the prompt on stdin is empty"

external-agents run "$product" --use task --mode write --prompt-file "$dir/prompt.md" "${extra[@]+"${extra[@]}"}"
