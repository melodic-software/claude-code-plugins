#!/usr/bin/env bash
# delegate --user-file <role_map_file> <codex|antigravity> [--use task|investigate] [--model <id>] [--effort <level>] < prompt
# Runs one auto-delegated run: external-agents run <product> --use task --mode write, or with
# --use investigate, --use investigate --mode read-only; --prompt-file is a temp file holding
# stdin. No other external-agents flag can be passed.
# Refuses unless vendors.auto_delegation resolves true from the user layer, and refuses a
# --user-file inside a git work tree, so no repository can supply the setting.
set -euo pipefail

die() {
  printf 'delegate: %s\n' "$1" >&2
  exit 2
}

USAGE="usage: delegate --user-file <role_map_file> <codex|antigravity> [--use task|investigate] [--model <id>] [--effort <level>] < prompt"
[[ $# -ge 3 && "$1" == --user-file ]] || die "$USAGE"
user_file="$2"
product="$3"
shift 3

resolve_args=(worker --session-model opus)
if [[ -n "$user_file" ]]; then
  [[ "$user_file" == /* || "$user_file" =~ ^[A-Za-z]:[/\\] ]] || die "--user-file must be an absolute path"
  [[ -f "$user_file" ]] || die "auto-delegation is off: no user layer file at the --user-file path"
  if git -C "$(dirname "$user_file")" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    die "the --user-file is inside a git work tree; only a user layer outside any repository can turn on auto-delegation"
  fi
  resolve_args+=(--user-file "$user_file")
fi
resolved="$("$(dirname "${BASH_SOURCE[0]}")/../../../scripts/resolve-roles.sh" "${resolve_args[@]}" 2>/dev/null)" || die "could not resolve vendors.auto_delegation"
[[ "$resolved" == *'"auto_delegation":true,'* ]] || die "auto-delegation is off (vendors.auto_delegation is not true)"
[[ "$resolved" =~ \"auto_delegation\":\"user-(config|global)\" ]] || die "auto-delegation is off: only the user layer sets it"
case "$product" in
codex | antigravity) ;;
*) die "product must be codex or antigravity, got '${product//[^[:print:]]/?}'" ;;
esac

use=""
extra=()
while [[ $# -gt 0 ]]; do
  case "$1" in
  --use)
    [[ -z "$use" ]] || die "--use is given once"
    [[ $# -ge 2 && ( "$2" == task || "$2" == investigate ) ]] || die "--use needs task or investigate"
    use="$2"
    shift 2
    ;;
  --model)
    [[ $# -ge 2 && "$2" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$ ]] || die "--model needs an id of letters, digits, '.', '_', ':' or '-'"
    extra+=(--model "$2")
    shift 2
    ;;
  --effort)
    [[ $# -ge 2 && "$2" =~ ^[a-z]{1,16}$ ]] || die "--effort needs a lower-case level"
    extra+=(--effort "$2")
    shift 2
    ;;
  *) die "unsupported argument '${1//[^[:print:]]/?}': only --use, --model and --effort are accepted" ;;
  esac
done

[[ ! -t 0 ]] || die "the prompt is read from stdin"
dir="$(mktemp -d)"
trap 'rm -rf "$dir"' EXIT
cat >"$dir/prompt.md"
[[ -s "$dir/prompt.md" ]] || die "the prompt on stdin is empty"

case "${use:-task}" in
task) run_args=(--use task --mode write) ;;
investigate) run_args=(--use investigate --mode read-only) ;;
esac
external-agents run "$product" "${run_args[@]}" --prompt-file "$dir/prompt.md" "${extra[@]+"${extra[@]}"}"
