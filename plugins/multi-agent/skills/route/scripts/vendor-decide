#!/usr/bin/env node
'use strict'

const fs = require('node:fs')
const path = require('node:path')
const { spawnSync } = require('node:child_process')

const WORK_TYPES = new Set(['coding', 'web-ui', 'knowledge', 'image'])
const VERDICTS = new Set(['lead', 'tie', 'behind', 'abstain'])
const READ_STATES = new Set(['live', 'cached-stale', 'unread'])
const ROW_STATUSES = new Set(['permanent', 'support-only'])
const TIEBREAK_STEPS = new Set(['vendor-order', 'fewest-tokens', 'most-usage-left'])
const TASK_CLASSES = new Set(['everyday', 'heavy'])
const EFFORT_LADDER = ['low', 'medium', 'high', 'xhigh', 'max']

const ID_RE = /^[a-z0-9][a-z0-9-]*$/
const DATE_RE = /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/

const REGISTRY_TOP_KEYS = new Set(['version', 'note', 'rows'])
const REGISTRY_ROW_KEYS = new Set([
  'id',
  'workloads',
  'link',
  'publisher',
  'provider_own',
  'status',
  'task_set',
  'expect',
  'freshness_seconds',
  'enabled',
])
const VERDICT_RECORD_KEYS = new Set([
  'source_id',
  'workload',
  'vendor',
  'model',
  'version',
  'effort',
  'verdict',
  'error_range',
  'page_date',
  'read',
  'tokens',
])
const VERDICT_REQUIRED_KEYS = [
  'source_id',
  'workload',
  'vendor',
  'model',
  'version',
  'effort',
  'verdict',
  'error_range',
  'page_date',
  'read',
]
const TOKENS_KEYS = new Set(['value', 'unit', 'source'])
const WRAPPER_KEYS = new Set(['records', 'findings'])
const SETTINGS_KEYS = new Set([
  'routing',
  'trials',
  'auto_delegation',
  'tiebreak',
  'trials_prove',
  'trials_fail',
  'claude',
  'codex',
  'antigravity',
  'sources',
  'source',
])
const VENDOR_ENTRY_KEYS = new Set(['in_use', 'rank'])
const SOURCE_ENTRY_KEYS = new Set(['enabled'])

function die(msg) {
  process.stderr.write(`vendor-decide: ${msg}\n`)
  process.exit(2)
}

function usage() {
  process.stdout.write(
    [
      'Usage: vendor-decide --task-type <coding|web-ui|knowledge|image> [--settings <file>]',
      '                     --manifest <file> --records <[source_id=]file> [--records ...]',
      '                     --models <file> [--registry <file>] [--defaults <file>]',
      '                     [--task-class <everyday|heavy>] [--tiebreak <steps>]',
      '                     [--vendor-order <vendors>] [--now <YYYY-MM-DD>]',
      '',
    ].join('\n'),
  )
}

function parseArgs(argv) {
  const opts = {
    taskType: null,
    taskClass: 'everyday',
    manifest: null,
    records: [],
    models: null,
    settings: null,
    registry: path.join(__dirname, '..', '..', '..', 'reference', 'benchmarks.json'),
    defaults: path.join(__dirname, '..', '..', '..', 'reference', 'defaults.yaml'),
    tiebreak: [],
    tiebreakSet: false,
    vendorOrder: ['claude', 'codex', 'gemini'],
    vendorOrderSet: false,
    now: null,
  }

  for (let i = 0; i < argv.length; i++) {
    const a = argv[i]
    if (a === '-h' || a === '--help') {
      usage()
      process.exit(0)
    }
    const needVal = () => {
      if (i + 1 >= argv.length) die(`${a} requires a value`)
      return argv[++i]
    }
    switch (a) {
      case '--task-type':
        opts.taskType = needVal()
        break
      case '--task-class':
        opts.taskClass = needVal()
        break
      case '--manifest':
        opts.manifest = needVal()
        break
      case '--records':
        opts.records.push(needVal())
        break
      case '--models':
        opts.models = needVal()
        break
      case '--settings':
        opts.settings = needVal()
        break
      case '--registry':
        opts.registry = needVal()
        break
      case '--defaults':
        opts.defaults = needVal()
        break
      case '--tiebreak': {
        const raw = needVal()
        opts.tiebreakSet = true
        opts.tiebreak = raw
          ? raw
              .split(',')
              .map((s) => s.trim())
              .filter(Boolean)
          : []
        break
      }
      case '--vendor-order': {
        const raw = needVal()
        opts.vendorOrderSet = true
        opts.vendorOrder = raw
          ? raw
              .split(',')
              .map((s) => s.trim().toLowerCase())
              .filter(Boolean)
          : []
        break
      }
      case '--now':
        opts.now = needVal()
        break
      default:
        die(`unknown argument: ${a}`)
    }
  }

  if (!opts.taskType || !WORK_TYPES.has(opts.taskType)) {
    die(`--task-type must be one of ${[...WORK_TYPES].join(', ')}`)
  }
  if (!TASK_CLASSES.has(opts.taskClass)) {
    die(`--task-class must be one of ${[...TASK_CLASSES].join(', ')}`)
  }
  for (const step of opts.tiebreak) {
    if (!TIEBREAK_STEPS.has(step)) {
      die(`unknown tiebreak step '${step}' (allowed: ${[...TIEBREAK_STEPS].join(', ')})`)
    }
  }
  return opts
}

function readJson(filePath, label) {
  let raw
  try {
    raw = fs.readFileSync(filePath, 'utf8')
  } catch (err) {
    die(`cannot read ${label} (${filePath}): ${err.message}`)
  }
  try {
    return JSON.parse(raw)
  } catch (err) {
    die(`invalid JSON in ${label} (${filePath}): ${err.message}`)
  }
}

function readDefaults(filePath) {
  const out = {
    model: 'inherit',
    effort: 'medium',
    vendors: { routing: true, trials: false, auto_delegation: false },
  }
  let raw
  try {
    raw = fs.readFileSync(filePath, 'utf8')
  } catch (err) {
    die(`cannot read defaults (${filePath}): ${err.message}`)
  }
  const stack = []
  for (const line of raw.split(/\r?\n/)) {
    if (!line.trim() || /^\s*#/.test(line)) continue
    const m = line.match(/^(\s*)([A-Za-z0-9_-]+):\s*(.*)$/)
    if (!m) continue
    const indent = m[1].length
    const key = m[2]
    let val = m[3].trim()
    while (stack.length > 0 && stack[stack.length - 1].indent >= indent) stack.pop()
    if (val === '') {
      stack.push({ indent, key })
      continue
    }
    const commentIdx = val.indexOf(' #')
    if (commentIdx >= 0) val = val.slice(0, commentIdx).trim()
    val = val.replace(/^['"]|['"]$/g, '')
    const dotted = [...stack.map((s) => s.key), key].join('.')
    if (dotted === 'roles.worker.model') out.model = val
    if (dotted === 'roles.worker.effort') out.effort = val
    if (dotted === 'vendors.routing' && (val === 'true' || val === 'false')) {
      out.vendors.routing = val === 'true'
    }
    if (dotted === 'vendors.trials' && (val === 'true' || val === 'false')) {
      out.vendors.trials = val === 'true'
    }
    if (dotted === 'vendors.auto_delegation' && (val === 'true' || val === 'false')) {
      out.vendors.auto_delegation = val === 'true'
    }
  }
  return out
}

function loadSettings(filePath, defaults) {
  const base = {
    routing: defaults.vendors.routing,
    trials: defaults.vendors.trials,
    auto_delegation: defaults.vendors.auto_delegation,
    tiebreak: [],
    trials_prove: null,
    trials_fail: null,
    vendors: {
      claude: { in_use: null, rank: null },
      codex: { in_use: null, rank: null },
      gemini: { in_use: null, rank: null },
    },
    sources: {},
  }
  if (!filePath) return base

  const raw = readJson(filePath, 'settings')
  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) {
    die('settings must be a JSON object')
  }
  const doc =
    'vendors' in raw && raw.vendors && typeof raw.vendors === 'object' && !Array.isArray(raw.vendors)
      ? raw.vendors
      : raw

  for (const k of Object.keys(doc)) {
    if (!SETTINGS_KEYS.has(k)) die(`settings has unknown field '${k}'`)
  }
  for (const b of ['routing', 'trials', 'auto_delegation']) {
    if (b in doc && doc[b] !== null) {
      if (typeof doc[b] !== 'boolean') die(`settings.${b} must be a boolean`)
      base[b] = doc[b]
    }
  }
  if ('tiebreak' in doc && doc.tiebreak !== null) {
    if (!Array.isArray(doc.tiebreak)) die('settings.tiebreak must be an array')
    const seen = new Set()
    for (const step of doc.tiebreak) {
      if (typeof step !== 'string' || !TIEBREAK_STEPS.has(step)) {
        die(`settings.tiebreak has unknown step '${step}'`)
      }
      if (seen.has(step)) die(`settings.tiebreak has duplicate step '${step}'`)
      seen.add(step)
    }
    base.tiebreak = [...doc.tiebreak]
  }
  if ('trials_prove' in doc && doc.trials_prove !== null) {
    if (!Number.isInteger(doc.trials_prove) || doc.trials_prove < 1) {
      die('settings.trials_prove must be an integer >= 1')
    }
    base.trials_prove = doc.trials_prove
  }
  if ('trials_fail' in doc && doc.trials_fail !== null) {
    if (!Number.isInteger(doc.trials_fail) || doc.trials_fail < 2) {
      die('settings.trials_fail must be an integer >= 2')
    }
    base.trials_fail = doc.trials_fail
  }
  const vendorKeyMap = [
    ['claude', 'claude'],
    ['codex', 'codex'],
    ['antigravity', 'gemini'],
  ]
  for (const [cfgKey, vName] of vendorKeyMap) {
    if (!(cfgKey in doc) || doc[cfgKey] === null) continue
    const entry = doc[cfgKey]
    if (!entry || typeof entry !== 'object' || Array.isArray(entry)) {
      die(`settings.${cfgKey} must be an object`)
    }
    for (const k of Object.keys(entry)) {
      if (!VENDOR_ENTRY_KEYS.has(k)) die(`settings.${cfgKey} has unknown field '${k}'`)
    }
    if ('in_use' in entry && entry.in_use !== null) {
      if (typeof entry.in_use !== 'boolean') die(`settings.${cfgKey}.in_use must be a boolean`)
      base.vendors[vName].in_use = entry.in_use
    }
    if ('rank' in entry && entry.rank !== null) {
      if (!Number.isInteger(entry.rank)) die(`settings.${cfgKey}.rank must be an integer`)
      base.vendors[vName].rank = entry.rank
    }
  }
  if ('sources' in doc && doc.sources !== null) {
    if (!doc.sources || typeof doc.sources !== 'object' || Array.isArray(doc.sources)) {
      die('settings.sources must be an object')
    }
    for (const [sid, entry] of Object.entries(doc.sources)) {
      if (!ID_RE.test(sid)) die(`settings.sources has invalid id '${sid}'`)
      if (!entry || typeof entry !== 'object' || Array.isArray(entry)) {
        die(`settings.sources.${sid} must be an object`)
      }
      for (const k of Object.keys(entry)) {
        if (!SOURCE_ENTRY_KEYS.has(k)) die(`settings.sources.${sid} has unknown field '${k}'`)
      }
      if ('enabled' in entry && entry.enabled !== null) {
        if (typeof entry.enabled !== 'boolean') {
          die(`settings.sources.${sid}.enabled must be a boolean`)
        }
        base.sources[sid] = { enabled: entry.enabled }
      }
    }
  }
  return base
}

function resolveRepoRoot() {
  const res = spawnSync('git', ['rev-parse', '--show-toplevel'], { encoding: 'utf8' })
  if (res.status !== 0 || !res.stdout) return null
  const root = res.stdout.trim()
  return root || null
}

function validateRegistry(doc) {
  if (!doc || typeof doc !== 'object' || Array.isArray(doc)) {
    die('registry must be a JSON object')
  }
  for (const k of Object.keys(doc)) {
    if (!REGISTRY_TOP_KEYS.has(k)) die(`registry has unknown field '${k}'`)
  }
  if (doc.version !== 1) die(`registry version must be 1, got ${JSON.stringify(doc.version)}`)
  if ('note' in doc && (typeof doc.note !== 'string' || doc.note.length === 0)) {
    die('registry note must be a non-empty string')
  }
  if (!Array.isArray(doc.rows)) die('registry rows must be an array')

  const seenIds = new Set()
  for (let i = 0; i < doc.rows.length; i++) {
    const r = doc.rows[i]
    const ctx = `registry.rows[${i}]`
    if (!r || typeof r !== 'object' || Array.isArray(r)) die(`${ctx} must be an object`)
    for (const k of Object.keys(r)) {
      if (!REGISTRY_ROW_KEYS.has(k)) die(`${ctx} has unknown field '${k}'`)
    }
    if (typeof r.id !== 'string' || !ID_RE.test(r.id)) die(`${ctx}.id is invalid`)
    if (seenIds.has(r.id)) die(`duplicate registry row id '${r.id}'`)
    seenIds.add(r.id)
    if (!Array.isArray(r.workloads) || r.workloads.length === 0) die(`${ctx}.workloads must be a non-empty array`)
    const wlSeen = new Set()
    for (const w of r.workloads) {
      if (!WORK_TYPES.has(w) || wlSeen.has(w)) die(`${ctx}.workloads has invalid or duplicate entry '${w}'`)
      wlSeen.add(w)
    }
    if (typeof r.link !== 'string' || !r.link.startsWith('https://')) die(`${ctx}.link must be an https URL`)
    if (typeof r.publisher !== 'string' || r.publisher.length === 0) die(`${ctx}.publisher must be a non-empty string`)
    if (typeof r.provider_own !== 'boolean') die(`${ctx}.provider_own must be a boolean`)
    if (!ROW_STATUSES.has(r.status)) die(`${ctx}.status must be permanent or support-only`)
    if (typeof r.task_set !== 'string' || r.task_set.length === 0) die(`${ctx}.task_set must be a non-empty string`)
    if (typeof r.expect !== 'string' || r.expect.length === 0) die(`${ctx}.expect must be a non-empty string`)
    if ('freshness_seconds' in r && (!Number.isInteger(r.freshness_seconds) || r.freshness_seconds < 1)) {
      die(`${ctx}.freshness_seconds must be a positive integer`)
    }
    if ('enabled' in r && typeof r.enabled !== 'boolean') die(`${ctx}.enabled must be a boolean`)
  }
  return doc
}

function validateVerdictRecord(rec, ctx) {
  if (!rec || typeof rec !== 'object' || Array.isArray(rec)) die(`${ctx} must be an object`)
  for (const k of Object.keys(rec)) {
    if (!VERDICT_RECORD_KEYS.has(k)) die(`${ctx} has unknown field '${k}'`)
  }
  for (const k of VERDICT_REQUIRED_KEYS) {
    if (!(k in rec)) die(`${ctx} is missing required field '${k}'`)
  }
  if (typeof rec.source_id !== 'string' || !ID_RE.test(rec.source_id)) die(`${ctx}.source_id is invalid`)
  if (!WORK_TYPES.has(rec.workload)) die(`${ctx}.workload is invalid`)
  if (typeof rec.vendor !== 'string' || !ID_RE.test(rec.vendor)) die(`${ctx}.vendor is invalid`)
  if (rec.model !== null && typeof rec.model !== 'string') die(`${ctx}.model must be string or null`)
  if (rec.version !== null && typeof rec.version !== 'string') die(`${ctx}.version must be string or null`)
  if (rec.effort !== null && typeof rec.effort !== 'string') die(`${ctx}.effort must be string or null`)
  if (!VERDICTS.has(rec.verdict)) die(`${ctx}.verdict is invalid`)
  if (typeof rec.error_range !== 'boolean') die(`${ctx}.error_range must be boolean`)
  if (rec.page_date !== null && (typeof rec.page_date !== 'string' || !DATE_RE.test(rec.page_date))) {
    die(`${ctx}.page_date must be YYYY-MM-DD or null`)
  }
  if (!READ_STATES.has(rec.read)) die(`${ctx}.read is invalid`)
  if ('tokens' in rec) {
    const t = rec.tokens
    if (!t || typeof t !== 'object' || Array.isArray(t)) die(`${ctx}.tokens must be an object`)
    for (const k of Object.keys(t)) {
      if (!TOKENS_KEYS.has(k)) die(`${ctx}.tokens has unknown field '${k}'`)
    }
    if (typeof t.value !== 'number' || !Number.isFinite(t.value) || t.value < 0) {
      die(`${ctx}.tokens.value must be a non-negative number`)
    }
    if (typeof t.unit !== 'string' || t.unit.length === 0) die(`${ctx}.tokens.unit must be a non-empty string`)
    if (typeof t.source !== 'string' || t.source.length === 0) die(`${ctx}.tokens.source must be a non-empty string`)
  }
}

function loadRecordsArg(spec) {
  let boundSourceId = null
  let filePath = spec
  const eq = spec.indexOf('=')
  if (eq > 0 && ID_RE.test(spec.slice(0, eq))) {
    boundSourceId = spec.slice(0, eq)
    filePath = spec.slice(eq + 1)
  }
  const raw = readJson(filePath, `records (${filePath})`)
  let records
  let findings = []
  if (Array.isArray(raw)) {
    records = raw
  } else if (raw && typeof raw === 'object') {
    for (const k of Object.keys(raw)) {
      if (!WRAPPER_KEYS.has(k)) die(`records wrapper (${filePath}) has unknown field '${k}'`)
    }
    if (!Array.isArray(raw.records)) die(`records wrapper (${filePath}) must contain a 'records' array`)
    records = raw.records
    if ('findings' in raw) {
      if (!Array.isArray(raw.findings) || !raw.findings.every((f) => typeof f === 'string')) {
        die(`records wrapper (${filePath}) 'findings' must be an array of strings`)
      }
      findings = raw.findings
    }
  } else {
    die(`records (${filePath}) must be an array or {records, findings} object`)
  }
  records.forEach((r, idx) => validateVerdictRecord(r, `${filePath}[${idx}]`))
  return { boundSourceId, records, findings }
}

function normalizeModels(doc) {
  if (!doc || typeof doc !== 'object' || Array.isArray(doc)) die('--models must be a JSON object')
  const byVendor = new Map()
  for (const [rawKey, entry] of Object.entries(doc)) {
    const vendor = rawKey.toLowerCase() === 'antigravity' ? 'gemini' : rawKey.toLowerCase()
    if (Array.isArray(entry)) {
      const ids = entry.filter((x) => typeof x === 'string' && x.length > 0)
      byVendor.set(vendor, {
        status: ids.length > 0 ? 'ok' : 'unavailable',
        ids,
        idSet: new Set(ids.map((s) => s.toLowerCase())),
        idCanonical: new Map(ids.map((s) => [s.toLowerCase(), s])),
        effortsByModel: new Map(),
        topEfforts: null,
        defaultModel: null,
        defaultEffort: null,
        image: null,
      })
      continue
    }
    if (!entry || typeof entry !== 'object') continue
    const status = entry.status ?? 'ok'
    const modelsArr = Array.isArray(entry.models) ? entry.models : []
    const ids = []
    const effortsByModel = new Map()
    for (const m of modelsArr) {
      const id = typeof m === 'string' ? m : m && typeof m.id === 'string' ? m.id : null
      if (!id) continue
      ids.push(id)
      if (m && typeof m === 'object' && Array.isArray(m.efforts)) {
        effortsByModel.set(id.toLowerCase(), m.efforts)
      }
    }
    byVendor.set(vendor, {
      status,
      reason: typeof entry.reason === 'string' ? entry.reason : null,
      ids,
      idSet: new Set(ids.map((s) => s.toLowerCase())),
      idCanonical: new Map(ids.map((s) => [s.toLowerCase(), s])),
      effortsByModel,
      topEfforts: Array.isArray(entry.efforts) ? entry.efforts : null,
      defaultModel: typeof entry.default_model === 'string' ? entry.default_model : null,
      defaultEffort: typeof entry.default_effort === 'string' ? entry.default_effort : null,
      image: typeof entry.image === 'boolean' ? entry.image : null,
    })
  }
  return byVendor
}

function publisherToVendor(publisher) {
  const p = publisher.trim().toLowerCase()
  if (p === 'anthropic' || p === 'claude') return 'claude'
  if (p === 'openai' || p === 'codex') return 'codex'
  if (p === 'google' || p === 'google deepmind' || p === 'deepmind' || p === 'gemini' || p === 'antigravity') {
    return 'gemini'
  }
  return p
}

function parseUtcDate(str) {
  if (typeof str !== 'string' || !DATE_RE.test(str)) return null
  const [y, m, d] = str.split('-').map(Number)
  const dt = new Date(Date.UTC(y, m - 1, d))
  if (dt.getUTCFullYear() !== y || dt.getUTCMonth() !== m - 1 || dt.getUTCDate() !== d) return null
  return dt
}

function isWithinSixMonths(pageDateStr, nowDate) {
  const dt = parseUtcDate(pageDateStr)
  if (!dt) return false
  const cutoffYear = nowDate.getUTCFullYear()
  const cutoffMonth = nowDate.getUTCMonth() - 6
  const cutoffDay = nowDate.getUTCDate()
  const targetYear = cutoffYear + Math.floor(cutoffMonth / 12)
  const targetMonth = ((cutoffMonth % 12) + 12) % 12
  const lastDay = new Date(Date.UTC(targetYear, targetMonth + 1, 0)).getUTCDate()
  const cutoff = new Date(Date.UTC(targetYear, targetMonth, Math.min(cutoffDay, lastDay)))
  const maxAllowed = new Date(nowDate.getTime() + 24 * 60 * 60 * 1000)
  return dt >= cutoff && dt <= maxAllowed
}

function raiseEffort(effort) {
  const idx = EFFORT_LADDER.indexOf(effort)
  if (idx < 0) return 'high'
  return EFFORT_LADDER[Math.min(idx + 1, EFFORT_LADDER.length - 1)]
}

function resolveEffort(vendorInfo, modelId, requested) {
  if (!requested) return 'default'
  if (!vendorInfo) return requested
  const allowed =
    (modelId && vendorInfo.effortsByModel.get(modelId.toLowerCase())) || vendorInfo.topEfforts
  if (!allowed || allowed.length === 0) return requested
  return allowed.includes(requested) ? requested : 'default'
}

function pickMode(values) {
  const counts = new Map()
  for (const v of values) {
    if (v == null) continue
    counts.set(v, (counts.get(v) || 0) + 1)
  }
  let best = null
  let bestCount = -1
  for (const [k, c] of counts.entries()) {
    if (c > bestCount) {
      best = k
      bestCount = c
    }
  }
  return best
}

function clusterSources(leadingSources, notes) {
  const n = leadingSources.length
  const parent = Array.from({ length: n }, (_, i) => i)
  const find = (x) => (parent[x] === x ? x : (parent[x] = find(parent[x])))
  const unite = (a, b) => {
    const ra = find(a)
    const rb = find(b)
    if (ra !== rb) parent[rb] = ra
  }

  for (let i = 0; i < n; i++) {
    for (let j = i + 1; j < n; j++) {
      const a = leadingSources[i]
      const b = leadingSources[j]
      const samePub = a.row.publisher.trim().toLowerCase() === b.row.publisher.trim().toLowerCase()
      const sameSet = a.row.task_set.trim().toLowerCase() === b.row.task_set.trim().toLowerCase()
      if (samePub || sameSet) {
        unite(i, j)
        const reasons = []
        if (samePub) reasons.push(`shared publisher '${a.row.publisher}'`)
        if (sameSet) reasons.push(`shared task_set '${a.row.task_set}'`)
        notes.push(`${a.row.id} and ${b.row.id} count as one source (${reasons.join(' and ')})`)
      }
    }
  }

  const groups = new Map()
  for (let i = 0; i < n; i++) {
    const root = find(i)
    if (!groups.has(root)) groups.set(root, [])
    groups.get(root).push(leadingSources[i])
  }
  return [...groups.values()]
}

function main() {
  const opts = parseArgs(process.argv.slice(2))
  const nowDate = opts.now
    ? parseUtcDate(opts.now.slice(0, 10)) || die(`--now must be YYYY-MM-DD, got '${opts.now}'`)
    : parseUtcDate(new Date().toISOString().slice(0, 10))

  const defaults = readDefaults(opts.defaults)
  const settings = loadSettings(opts.settings, defaults)
  if (!settings.routing) {
    const offDecision = {
      work_type: opts.taskType,
      vendor: null,
      model: null,
      effort: null,
      basis: 'routing-off',
      sources: [],
      ties: [],
      notes: ['routing is off; no recommendation made (trials paused, trial data kept)'],
    }
    process.stdout.write(`${JSON.stringify(offDecision, null, 2)}\n`)
    return
  }

  if (!opts.manifest) die('--manifest is required')
  if (!opts.models) die('--models is required')
  if (opts.records.length === 0) die('at least one --records <file> is required')

  const registry = validateRegistry(readJson(opts.registry, 'registry'))
  const manifestDoc = readJson(opts.manifest, 'manifest')
  const manifestBoards = Array.isArray(manifestDoc.boards)
    ? manifestDoc.boards
    : Array.isArray(manifestDoc.pages)
      ? manifestDoc.pages
      : die('manifest must contain a boards array')
  const modelsByVendor = normalizeModels(readJson(opts.models, 'models'))

  const manifestById = new Map()
  for (const entry of manifestBoards) {
    if (entry && typeof entry.source_id === 'string') {
      manifestById.set(entry.source_id, entry)
    }
  }

  const notes = []
  const mergedRows = [...registry.rows]
  const shippedIds = new Set(registry.rows.map((r) => r.id))
  const repoRoot = resolveRepoRoot()
  if (repoRoot) {
    const teamPath = path.join(repoRoot, 'docs', 'conventions', 'multi-agent', 'benchmarks.json')
    if (fs.existsSync(teamPath) && path.resolve(teamPath) !== path.resolve(opts.registry)) {
      const teamReg = validateRegistry(readJson(teamPath, 'team registry'))
      for (const teamRow of teamReg.rows) {
        if (shippedIds.has(teamRow.id)) {
          notes.push(`team registry row '${teamRow.id}' refused: duplicates shipped row id`)
          continue
        }
        mergedRows.push(teamRow)
      }
    }
  }

  if (settings.trials && (settings.trials_prove === null || settings.trials_fail === null)) {
    notes.push('trials switch is on, but trials_prove and trials_fail must both be set; trials stay inactive')
  }

  const skippedSilentVendors = new Set()
  const unavailableInUseVendors = new Set()
  for (const [vName, cfg] of Object.entries(settings.vendors)) {
    if (cfg.in_use === false) {
      skippedSilentVendors.add(vName)
      continue
    }
    if (cfg.in_use === true) {
      const vInfo = modelsByVendor.get(vName)
      if (!vInfo || vInfo.status !== 'ok' || vInfo.ids.length === 0) {
        unavailableInUseVendors.add(vName)
        const why =
          vInfo && vInfo.reason
            ? vInfo.reason
            : vInfo && vInfo.status !== 'ok'
              ? `status ${vInfo.status}`
              : 'not listed in --models'
        notes.push(`${vName}: declared in use but unavailable (${why})`)
      }
    }
  }

  const rowById = new Map()
  const disabledRows = new Set()
  const activeRows = []
  for (const row of mergedRows) {
    rowById.set(row.id, row)
    const sourceOverride = settings.sources[row.id]
    const isEnabled =
      sourceOverride && typeof sourceOverride.enabled === 'boolean'
        ? sourceOverride.enabled
        : row.enabled !== false
    if (!isEnabled) {
      disabledRows.add(row.id)
      continue
    }
    if (row.workloads.includes(opts.taskType)) {
      activeRows.push(row)
    }
  }

  const recordsBySource = new Map()
  for (const spec of opts.records) {
    const { boundSourceId, records, findings } = loadRecordsArg(spec)
    for (const f of findings) {
      notes.push(`suspicious-content${boundSourceId ? ` (${boundSourceId})` : ''}: ${f}`)
    }
    for (const r of records) {
      if (boundSourceId && r.source_id !== boundSourceId) {
        notes.push(
          `dropped record claiming source_id '${r.source_id}' inside manifest-bound records for '${boundSourceId}'`,
        )
        continue
      }
      const sid = boundSourceId || r.source_id
      if (disabledRows.has(sid)) continue
      const mEntry = manifestById.get(sid)
      if (!mEntry) {
        notes.push(`dropped record for '${sid}': absent from fetch manifest`)
        continue
      }
      if (!rowById.has(sid)) {
        notes.push(`dropped record for '${sid}': absent from registry`)
        continue
      }
      const stampedRead =
        mEntry.state !== 'read' ? 'unread' : mEntry.stale === true ? 'cached-stale' : 'live'
      const stampedDate =
        typeof mEntry.page_date === 'string' && DATE_RE.test(mEntry.page_date)
          ? mEntry.page_date
          : null
      const stamped = {
        ...r,
        source_id: sid,
        page_date: stampedDate,
        read: stampedRead,
      }
      if (stamped.workload !== opts.taskType) continue
      if (!recordsBySource.has(sid)) recordsBySource.set(sid, [])
      recordsBySource.get(sid).push(stamped)
    }
  }

  const claudeModels = modelsByVendor.get('claude')
  const claudeDefaultModel = (claudeModels && claudeModels.defaultModel) || defaults.model
  const claudeBaseEffort = (claudeModels && claudeModels.defaultEffort) || defaults.effort
  const claudeEffort = opts.taskClass === 'heavy' ? raiseEffort(claudeBaseEffort) : claudeBaseEffort

  const sourcesOut = []
  const leadingEvaluations = []

  for (const row of activeRows) {
    const mEntry = manifestById.get(row.id)
    const readState = !mEntry || mEntry.state !== 'read'
      ? 'unread'
      : mEntry.stale === true
        ? 'cached-stale'
        : 'live'
    const pageDate =
      mEntry && typeof mEntry.page_date === 'string' && DATE_RE.test(mEntry.page_date)
        ? mEntry.page_date
        : null
    const ageSeconds = mEntry && typeof mEntry.age_seconds === 'number' ? mEntry.age_seconds : null
    const fetchReason = mEntry && typeof mEntry.reason === 'string' ? mEntry.reason : null

    if (readState === 'unread') {
      const reason = fetchReason || 'missing-from-manifest'
      notes.push(`${row.id}: unread (${reason})`)
      sourcesOut.push({
        source_id: row.id,
        link: row.link,
        publisher: row.publisher,
        task_set: row.task_set,
        status: row.status,
        provider_own: row.provider_own,
        read: 'unread',
        page_date: null,
        age_seconds: ageSeconds,
        role: 'unread',
        reason,
      })
      continue
    }

    let rawRecords = (recordsBySource.get(row.id) || []).map((r) => ({ ...r }))

    if (row.provider_own) {
      const ownVendor = publisherToVendor(row.publisher)
      const dropped = rawRecords.filter((r) => r.vendor !== ownVendor)
      rawRecords = rawRecords.filter((r) => r.vendor === ownVendor)
      if (dropped.length > 0) {
        notes.push(`${row.id}: provider-own results support only ${ownVendor} models (dropped ${dropped.length} other-vendor record(s))`)
      } else {
        notes.push(`${row.id}: provider-own source is support-only for ${ownVendor}`)
      }
    }

    for (const r of rawRecords) {
      if (r.verdict === 'abstain') continue
      if (skippedSilentVendors.has(r.vendor) || unavailableInUseVendors.has(r.vendor)) {
        r.verdict = 'abstain'
        continue
      }
      const vInfo = modelsByVendor.get(r.vendor)
      if (!vInfo) {
        notes.push(`${row.id}: abstains for ${r.vendor} (not a candidate vendor in --models)`)
        r.verdict = 'abstain'
        continue
      }
      if (vInfo.status !== 'ok' || vInfo.ids.length === 0) {
        r.verdict = 'abstain'
        continue
      }
      if (!r.model || !vInfo.idSet.has(r.model.toLowerCase())) {
        notes.push(
          `${row.id}: abstains for ${r.vendor} (model '${r.model ?? 'none'}' is not in current models)`,
        )
        r.verdict = 'abstain'
      }
    }

    const claudeTested =
      !claudeModels ||
      claudeModels.ids.length === 0 ||
      rawRecords.some((r) => r.vendor === 'claude' && r.verdict !== 'abstain')

    let role = 'support-only'
    let reason = null
    let outcome = null

    if (readState === 'cached-stale') {
      role = 'support-only'
      reason = `stale cache (age ${ageSeconds ?? 'unknown'}s${fetchReason ? `, ${fetchReason}` : ''})`
      notes.push(`${row.id}: cached copy is stale (${reason}); support-only`)
    } else if (!pageDate) {
      role = 'ineligible'
      reason = 'undated'
      notes.push(`${row.id}: no page_date found; ineligible`)
    } else if (!isWithinSixMonths(pageDate, nowDate)) {
      role = 'ineligible'
      reason = `outdated (${pageDate}, older than 6 months)`
      notes.push(`${row.id}: page_date ${pageDate} is older than 6 months; ineligible`)
    } else if (row.status === 'support-only') {
      role = 'support-only'
      reason = 'new source (status support-only)'
    } else if (row.provider_own) {
      role = 'support-only'
      reason = 'provider-own'
    } else if (!claudeTested) {
      role = 'abstains'
      reason = 'abstains for claude (current model not tested)'
      notes.push(`${row.id}: abstains for claude (current model not tested)`)
    } else {
      const leads = rawRecords.filter((r) => r.verdict === 'lead' && r.error_range === true)
      const ties = rawRecords.filter((r) => r.verdict === 'tie' && r.error_range === true)
      const noErrLeadOrTie = rawRecords.filter(
        (r) => (r.verdict === 'lead' || r.verdict === 'tie') && r.error_range === false,
      )
      if (leads.length === 1) {
        role = 'leading'
        outcome = { kind: 'lead', vendor: leads[0].vendor, record: leads[0], records: rawRecords }
      } else if (leads.length === 0 && ties.length >= 2) {
        const tieVendors = [...new Set(ties.map((r) => r.vendor))].sort()
        if (tieVendors.length >= 2) {
          role = 'leading'
          outcome = { kind: 'tie', vendors: tieVendors, records: rawRecords }
        } else {
          role = 'support-only'
          reason = 'no distinct tied vendors'
        }
      } else if (noErrLeadOrTie.length > 0) {
        role = 'support-only'
        reason = 'no error range'
        notes.push(`${row.id}: score has no error_range; support-only`)
      } else {
        role = 'abstains'
        reason = 'no qualifying lead or tie'
      }
    }

    sourcesOut.push({
      source_id: row.id,
      link: row.link,
      publisher: row.publisher,
      task_set: row.task_set,
      status: row.status,
      provider_own: row.provider_own,
      read: readState,
      page_date: pageDate,
      age_seconds: ageSeconds,
      role,
      reason,
    })

    if (role === 'leading' && outcome) {
      leadingEvaluations.push({ row, outcome })
    }
  }

  let vendor = 'claude'
  let model = claudeDefaultModel
  let effort = claudeEffort
  let basis = 'default'
  let tiesOut = []

  if (opts.taskType === 'image' && claudeModels && claudeModels.image === false) {
    const capable = [...modelsByVendor.entries()].find(
      ([v, info]) =>
        v !== 'claude' &&
        !skippedSilentVendors.has(v) &&
        info.status === 'ok' &&
        info.image === true,
    )
    if (capable) {
      vendor = capable[0]
      model = capable[1].defaultModel || capable[1].ids[0] || 'default'
      effort = capable[1].defaultEffort || 'default'
      basis = 'claude-cannot'
    }
  }

  const clusters = clusterSources(leadingEvaluations, notes)
  if (basis === 'default' && clusters.length >= 2) {
    const clusterOutcomes = clusters.map((group) => {
      const first = group[0].outcome
      if (first.kind === 'lead') {
        const allSame = group.every((g) => g.outcome.kind === 'lead' && g.outcome.vendor === first.vendor)
        return allSame ? { kind: 'lead', vendor: first.vendor, group } : { kind: 'split', group }
      }
      const key = first.vendors.join(',')
      const allSame = group.every((g) => g.outcome.kind === 'tie' && g.outcome.vendors.join(',') === key)
      return allSame ? { kind: 'tie', vendors: first.vendors, group } : { kind: 'split', group }
    })

    const allLeads = clusterOutcomes.every((c) => c.kind === 'lead')
    const allTies = clusterOutcomes.every((c) => c.kind === 'tie')

    if (allLeads) {
      const leadVendors = new Set(clusterOutcomes.map((c) => c.vendor))
      if (leadVendors.size === 1) {
        const winner = [...leadVendors][0]
        if (winner === 'claude') {
          vendor = 'claude'
          model = claudeDefaultModel
          effort = claudeEffort
          basis = 'consensus'
        } else {
          const winnerRecs = leadingEvaluations
            .map((e) => e.outcome.record)
            .filter((r) => r && r.vendor === winner)
          const vInfo = modelsByVendor.get(winner)
          const rawModel = pickMode(winnerRecs.map((r) => r.model))
          const canonicalModel =
            rawModel && vInfo && vInfo.idCanonical.get(rawModel.toLowerCase())
              ? vInfo.idCanonical.get(rawModel.toLowerCase())
              : rawModel || 'default'
          const rawEffort = pickMode(winnerRecs.map((r) => r.effort))
          vendor = winner
          model = canonicalModel
          effort = resolveEffort(vInfo, canonicalModel, rawEffort)
          basis = 'consensus'
        }
      } else {
        notes.push(
          `no consensus across ${clusters.length} independent sources (${[...leadVendors].join(' vs ')}); keeping default claude`,
        )
      }
    } else if (allTies) {
      let common = new Set(clusterOutcomes[0].vendors)
      for (const co of clusterOutcomes.slice(1)) {
        common = new Set([...common].filter((v) => co.vendors.includes(v)))
      }
      const tiedVendors = [...common].sort()
      if (tiedVendors.length >= 2) {
        tiesOut = tiedVendors.map((v) => {
          const vRecs = leadingEvaluations
            .flatMap((e) => e.outcome.records)
            .filter((r) => r.vendor === v && r.verdict === 'tie')
          const vInfo = modelsByVendor.get(v)
          const rawModel = pickMode(vRecs.map((r) => r.model))
          const canonicalModel =
            rawModel && vInfo && vInfo.idCanonical.get(rawModel.toLowerCase())
              ? vInfo.idCanonical.get(rawModel.toLowerCase())
              : rawModel || (v === 'claude' ? claudeDefaultModel : 'default')
          const rawEffort = pickMode(vRecs.map((r) => r.effort))
          const tokens = vRecs
            .filter((r) => r.tokens)
            .map((r) => ({ ...r.tokens, source_id: r.source_id }))
          return {
            vendor: v,
            model: canonicalModel,
            effort: v === 'claude' ? claudeEffort : resolveEffort(vInfo, canonicalModel, rawEffort),
            tokens,
          }
        })

        const effectiveTiebreak = opts.tiebreakSet ? opts.tiebreak : settings.tiebreak
        let effectiveVendorOrder = opts.vendorOrder
        if (!opts.vendorOrderSet) {
          const baseOrder = ['claude', 'codex', 'gemini']
          const ranked = baseOrder.map((v, idx) => ({
            v,
            rank: settings.vendors[v] ? settings.vendors[v].rank : null,
            idx,
          }))
          if (ranked.some((x) => x.rank !== null)) {
            ranked.sort((a, b) => {
              if (a.rank !== null && b.rank !== null) return a.rank - b.rank || a.idx - b.idx
              if (a.rank !== null) return -1
              if (b.rank !== null) return 1
              return a.idx - b.idx
            })
            effectiveVendorOrder = ranked.map((x) => x.v)
          }
        }

        let picked = null
        for (const step of effectiveTiebreak) {
          if (step === 'fewest-tokens') {
            const units = new Set(tiesOut.flatMap((t) => t.tokens.map((x) => x.unit)))
            const allHaveTokens = tiesOut.every((t) => t.tokens.length > 0)
            if (allHaveTokens && units.size === 1) {
              const scored = tiesOut
                .map((t) => ({
                  entry: t,
                  avg: t.tokens.reduce((s, x) => s + x.value, 0) / t.tokens.length,
                }))
                .sort((a, b) => a.avg - b.avg)
              if (scored[0].avg < scored[1].avg) {
                picked = scored[0].entry
                notes.push(`tiebreak fewest-tokens selected ${picked.vendor} (${scored[0].avg} ${[...units][0]})`)
                break
              }
            } else {
              notes.push('tiebreak fewest-tokens skipped: tied vendors lack comparable token counts')
            }
          } else if (step === 'most-usage-left') {
            notes.push('tiebreak most-usage-left unavailable: falling back to next tiebreak step')
          } else if (step === 'vendor-order') {
            const ordered = effectiveVendorOrder.find((v) => tiedVendors.includes(v))
            if (ordered) {
              picked = tiesOut.find((t) => t.vendor === ordered)
              notes.push(`tiebreak vendor-order selected ${picked.vendor}`)
              break
            }
          }
        }

        if (picked) {
          vendor = picked.vendor
          model = picked.vendor === 'claude' ? claudeDefaultModel : picked.model
          effort = picked.effort
          basis = 'consensus'
        } else {
          notes.push('tie across independent sources with no resolving tiebreak; caller keeps default vendor claude')
        }
      } else {
        notes.push('no overlapping tied vendors across independent sources; keeping default claude')
      }
    } else {
      notes.push('independent sources disagree (mixed lead/tie/split); keeping default claude')
    }
  } else if (basis === 'default') {
    notes.push(
      `fewer than 2 independent leading sources (${clusters.length}); keeping default claude`,
    )
  }

  const decision = {
    work_type: opts.taskType,
    vendor,
    model,
    effort,
    basis,
    sources: sourcesOut,
    ties: tiesOut,
    notes,
  }
  process.stdout.write(`${JSON.stringify(decision, null, 2)}\n`)
}

main()
