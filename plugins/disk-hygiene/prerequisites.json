{
  "requires": [
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the disk-hygiene hooks cannot launch, so they do nothing.",
      "install": {
        "docs": "https://nodejs.org/en/download"
      }
    },
    {
      "id": "python3",
      "kind": "runtime",
      "need": "required",
      "for": [
        "hook:run-python-hook.sh",
        "skill:audit",
        "skill:clean"
      ],
      "detect": {
        "any": [
          "python3",
          "python",
          "py"
        ],
        "reject_store_alias": true,
        "version": {
          "args": [
            "--version"
          ],
          "pattern": "Python ([0-9.]+)",
          "min": "3.11"
        }
      },
      "degrade": "Without Python 3.11 or newer, the guard denies hygiene.py calls, /disk-hygiene:clean cannot run, and /disk-hygiene:audit cannot scan.",
      "install": {
        "docs": "https://www.python.org/downloads/",
        "brew": "python",
        "winget": "Python.Python.3.13",
        "apt": "python3"
      }
    }
  ]
}
