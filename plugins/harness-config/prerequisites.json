{
  "requires": [
    {
      "id": "node",
      "kind": "runtime",
      "need": "optional",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the prerequisites checker cannot run and no dependency is verified; the plugin's own skills are unaffected.",
      "install": {
        "docs": "https://nodejs.org/en/download",
        "brew": "node",
        "winget": "OpenJS.NodeJS.LTS",
        "apt": "nodejs"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "skill:audit",
        "skill:audit-automation-gaps",
        "skill:audit-pass",
        "skill:audit-permission-grants",
        "skill:audit-permission-state",
        "skill:draft-auto-mode-rules",
        "skill:setup"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, these skills cannot read settings or manifests and stop; the audits that read prose only still run.",
      "install": {
        "docs": "https://jqlang.org/download/",
        "brew": "jq",
        "winget": "jqlang.jq",
        "apt": "jq"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "curl",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:audit",
        "skill:setup"
      ],
      "detect": {
        "any": [
          "curl"
        ]
      },
      "degrade": "Without curl, the docs fetch and the plugin drift check cannot reach upstream; the audit runs from the cached docs and says so.",
      "install": {
        "docs": "https://curl.se/download.html",
        "brew": "curl",
        "winget": "cURL.cURL",
        "apt": "curl"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "claude",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:audit",
        "skill:audit-permission-state"
      ],
      "detect": {
        "any": [
          "claude"
        ]
      },
      "degrade": "Without the claude CLI, the audits cannot read the effective plugin and permission state from it and report those checks as unknown.",
      "install": {
        "docs": "https://code.claude.com/docs/en/setup"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "python3",
      "kind": "runtime",
      "need": "required",
      "for": [
        "skill:audit-pass"
      ],
      "detect": {
        "any": [
          "python3",
          "python",
          "py"
        ]
      },
      "degrade": "Without Python 3, /harness-config:audit-pass cannot assemble its findings, compute finding identities or write run state, and stops.",
      "install": {
        "docs": "https://www.python.org/downloads/",
        "brew": "python",
        "winget": "Python.Python.3.12",
        "apt": "python3"
      },
      "check": "/harness-ops:prerequisites"
    }
  ]
}
