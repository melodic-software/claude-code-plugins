              "--require-true",
              "TEST_GUARDS_ENABLED",
              "${CLAUDE_PLUGIN_ROOT}/hooks/test-scan.sh"
            ],
            "if": "Edit(*.test.tsx)",
            "timeout": 10,
            "statusMessage": "Scanning the test file for tests that cannot fail..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--require-true",
              "TEST_GUARDS_ENABLED",
              "${CLAUDE_PLUGIN_ROOT}/hooks/test-scan.sh"
            ],
            "if": "Edit(*Test.cs)",
            "timeout": 10,
            "statusMessage": "Scanning the test file for tests that cannot fail..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--require-true",
              "TEST_GUARDS_ENABLED",
              "${CLAUDE_PLUGIN_ROOT}/hooks/test-scan.sh"
            ],
            "if": "Edit(*Tests.cs)",
            "timeout": 10,
            "statusMessage": "Scanning the test file for tests that cannot fail..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--require-true",
              "TEST_GUARDS_ENABLED",
              "${CLAUDE_PLUGIN_ROOT}/hooks/test-scan.sh"
            ],
            "if": "Edit(*_test.py)",
            "timeout": 10,
            "statusMessage": "Scanning the test file for tests that cannot fail..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--require-true",
              "TEST_GUARDS_ENABLED",
              "${CLAUDE_PLUGIN_ROOT}/hooks/test-scan.sh"
            ],
