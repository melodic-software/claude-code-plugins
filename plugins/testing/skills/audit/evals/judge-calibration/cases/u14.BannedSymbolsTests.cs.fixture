using System.Collections.Immutable;
using Microsoft.CodeAnalysis;
using Microsoft.CodeAnalysis.CSharp;

namespace Platform.Analyzers.Tests;

public sealed class BannedSymbolsTests
{
    private static readonly Dictionary<string, string> _bannedSymbolsPaths = FindBannedSymbolsFiles();

    private static readonly Dictionary<string, string[]> _fileLines =
        _bannedSymbolsPaths.ToDictionary(
            kv => kv.Key,
            kv => File.ReadAllLines(kv.Value),
            StringComparer.Ordinal);

    private static readonly Dictionary<string, IReadOnlyList<BannedEntry>> _fileEntries =
        _fileLines.ToDictionary(
            kv => kv.Key,
            kv => (IReadOnlyList<BannedEntry>)ParseBannedSymbols(kv.Value),
            StringComparer.Ordinal);

    private static readonly Lazy<CSharpCompilation> _bclCompilation = new(CreateBclCompilation);

    private static readonly HashSet<string> _validPrefixes =
        ["T:", "M:", "P:", "F:", "N:", "E:"];

    private static readonly Dictionary<string, string[]> _expectedCategoriesPerFile =
        new(StringComparer.Ordinal)
        {
            ["BannedSymbols.txt"] =
                ["Mapping", "Time", "HTTP", "JSON", "OpenAPI", "Identifiers", "Assertions", "Mocking",
                 "Logging", "Collections", "Async", "Threading", "GC", "Lifecycle"],
            ["BannedSymbols.ServiceLocator.txt"] =
                ["ServiceLocator", "ServiceLocator (keyed)", "Scope Creation", "Activator Utilities"],
        };

    public static IEnumerable<object[]> AllBannedFiles =>
        _expectedCategoriesPerFile.Keys.Select(filename => new object[] { filename });

    [Theory]
    [MemberData(nameof(AllBannedFiles))]
    public void BannedSymbolsFile_ShouldExist(string filename)
    {
        _bannedSymbolsPaths.ContainsKey(filename).ShouldBeTrue(
            $"{filename} not found. Searched from: {AppContext.BaseDirectory}");
        File.Exists(_bannedSymbolsPaths[filename]).ShouldBeTrue(
            $"{filename} resolved path does not exist: {_bannedSymbolsPaths[filename]}");
    }

    [Theory]
    [MemberData(nameof(AllBannedFiles))]
    public void File_ShouldHaveEntries(string filename)
    {
        _fileEntries[filename].ShouldNotBeEmpty($"{filename} contains no entries");
    }

    [Theory]
    [MemberData(nameof(AllBannedFiles))]
    public void AllEntries_ShouldHaveValidPrefix(string filename)
    {
        foreach (BannedEntry entry in _fileEntries[filename])
        {
            _validPrefixes.Contains(entry.Prefix).ShouldBeTrue(
                $"{filename} line {entry.LineNumber}: Invalid prefix '{entry.Prefix}' in '{entry.RawLine}'. " +
                $"Must be one of: {string.Join(", ", _validPrefixes)}");
        }
    }

    [Theory]
    [MemberData(nameof(AllBannedFiles))]
    public void AllEntries_ShouldHaveReasonText(string filename)
    {
        foreach (BannedEntry entry in _fileEntries[filename])
        {
            string.IsNullOrWhiteSpace(entry.Reason).ShouldBeFalse(
                $"{filename} line {entry.LineNumber}: Missing reason text after ';' in '{entry.RawLine}'");
        }
    }

    [Theory]
    [MemberData(nameof(AllBannedFiles))]
    public void AllEntries_ShouldHaveNoDuplicates(string filename)
    {
        HashSet<string> seen = [];
        List<string> duplicates = [];

        foreach (BannedEntry entry in _fileEntries[filename])
        {
            if (!seen.Add(entry.Symbol))
            {
                duplicates.Add($"{filename} line {entry.LineNumber}: Duplicate '{entry.Symbol}'");
            }
        }

        duplicates.ShouldBeEmpty(
            $"Duplicate entries found in {filename}:\n{string.Join("\n", duplicates)}");
    }

    [Theory]
    [MemberData(nameof(AllBannedFiles))]
    public void File_ShouldContainAllExpectedCategories(string filename)
    {
        string[] expectedCategories = _expectedCategoriesPerFile[filename];
        string[] lines = _fileLines[filename];

        List<string> missingCategories = [];
        foreach (string category in expectedCategories)
        {
            string header = $"// --- {category}";
            if (!lines.Any(line => line.Contains(header, StringComparison.Ordinal)))
            {
                missingCategories.Add(category);
            }
        }

        missingCategories.ShouldBeEmpty(
            $"Missing ban categories in {filename}: {string.Join(", ", missingCategories)}. " +
            "Each category must have a '// --- CategoryName' header comment.");
    }

    [Theory]
    [MemberData(nameof(AllBannedFiles))]
    public void TypeEntries_ShouldResolveAgainstBcl(string filename)
    {
        List<string> failures = [];
        foreach (BannedEntry entry in _fileEntries[filename].Where(e => e.Prefix == "T:"))
        {
            TryResolveBclType(entry.SymbolBody, entry, filename, failures);
        }

        failures.ShouldBeEmpty(
            $"BCL types in {filename} that failed to resolve:\n{string.Join("\n", failures)}");
    }

    [Theory]
    [MemberData(nameof(AllBannedFiles))]
    public void PropertyEntries_ShouldResolveAgainstBcl(string filename)
    {
        List<string> failures = [];
        foreach (BannedEntry entry in _fileEntries[filename].Where(e => e.Prefix == "P:"))
        {
            (string typeName, string memberName)? split = SplitQualifiedMember(entry.SymbolBody);
            if (split is null)
            {
                failures.Add($"{filename} line {entry.LineNumber}: Property '{entry.SymbolBody}' has no type qualifier");
                continue;
            }

            INamedTypeSymbol? type = TryResolveBclType(split.Value.typeName, entry, filename, failures);
            if (type is null)
            {
                continue;
            }

            bool propertyExists = type.GetMembers(split.Value.memberName)
                .OfType<IPropertySymbol>()
                .Any();

            if (!propertyExists)
            {
                failures.Add($"{filename} line {entry.LineNumber}: Property '{split.Value.memberName}' not found on type '{split.Value.typeName}'");
            }
        }

        failures.ShouldBeEmpty(
            $"Property entries in {filename} that failed to resolve:\n{string.Join("\n", failures)}");
    }

    [Theory]
    [MemberData(nameof(AllBannedFiles))]
    public void MethodEntries_ShouldResolveAgainstBcl(string filename)
    {
        List<string> failures = [];
        foreach (BannedEntry entry in _fileEntries[filename].Where(e => e.Prefix == "M:"))
        {
            int parenIndex = entry.SymbolBody.IndexOf('(');
            string qualifiedName = parenIndex >= 0 ? entry.SymbolBody[..parenIndex] : entry.SymbolBody;

            (string typeName, string memberName)? split = SplitQualifiedMember(qualifiedName);
            if (split is null)
            {
                continue;
            }

            string methodName = split.Value.memberName;
            bool isConstructor = methodName == "#ctor";

            INamedTypeSymbol? type = TryResolveBclType(split.Value.typeName, entry, filename, failures);
            if (type is null)
            {
                continue;
            }

            if (isConstructor)
            {
                if (!type.InstanceConstructors.Any())
                {
                    failures.Add($"{filename} line {entry.LineNumber}: No constructors found on type '{split.Value.typeName}'");
                }
            }
            else
            {
                // Strip generic-arity backtick suffix for Roslyn symbol lookup: GetKeyedService``1 → GetKeyedService.
                // BannedApiAnalyzers' XML doc-ID format uses Name``N for generic methods; IMethodSymbol.Name is bare.
                int backtickIndex = methodName.IndexOf('`');
                string lookupName = backtickIndex >= 0 ? methodName[..backtickIndex] : methodName;

                bool methodExists = type.GetMembers(lookupName)
                    .OfType<IMethodSymbol>()
                    .Any();

                if (!methodExists)
                {
                    failures.Add(
                        $"{filename} line {entry.LineNumber}: Method '{lookupName}' not found on type '{split.Value.typeName}'. " +
                        "If this is a property, use P: prefix instead of M:");
                }
            }
        }

        failures.ShouldBeEmpty(
            $"Method entries in {filename} that failed to resolve:\n{string.Join("\n", failures)}");
    }

    [Theory]
    [MemberData(nameof(AllBannedFiles))]
    public void PropertyEntries_ShouldUseCorrectPrefix(string filename)
    {
        List<string> wrongPrefix = [];
        foreach (BannedEntry entry in _fileEntries[filename].Where(e => e.Prefix == "M:"))
        {
            string symbolBody = entry.SymbolBody;

            if (symbolBody.Contains(".get_", StringComparison.Ordinal)
             || symbolBody.Contains(".set_", StringComparison.Ordinal))
            {
                wrongPrefix.Add(
                    $"{filename} line {entry.LineNumber}: '{entry.Symbol}' uses getter/setter pattern. " +
                    "Use P: prefix for properties instead of M:...get_/set_");
                continue;
            }

            if (symbolBody.Contains('('))
            {
                continue;
            }

            (string typeName, string memberName)? split = SplitQualifiedMember(symbolBody);
            if (split is null)
            {
                continue;
            }

            INamedTypeSymbol? type = _bclCompilation.Value.GetTypeByMetadataName(split.Value.typeName);
            if (type is null)
            {
                continue;
            }

            ImmutableArray<ISymbol> members = type.GetMembers(split.Value.memberName);
            bool isProperty = members.OfType<IPropertySymbol>().Any();
            bool isMethod = members.OfType<IMethodSymbol>().Any();

            if (isProperty && !isMethod)
            {
                wrongPrefix.Add(
                    $"{filename} line {entry.LineNumber}: '{entry.Symbol}' is a property, not a method. " +
                    $"Use 'P:{entry.SymbolBody}' instead");
            }
        }

        wrongPrefix.ShouldBeEmpty(
            $"Entries in {filename} with wrong prefix (should be P: for properties):\n{string.Join("\n", wrongPrefix)}");
    }

    [Theory]
    [MemberData(nameof(AllBannedFiles))]
    public void NamespaceEntries_ShouldResolveAgainstBcl(string filename)
    {
        List<string> failures = [];
        foreach (BannedEntry entry in _fileEntries[filename].Where(e => e.Prefix == "N:"))
        {
            string namespaceName = entry.SymbolBody;

            if (!IsBclNamespace(namespaceName))
            {
                continue;
            }

            INamespaceSymbol? ns = _bclCompilation.Value.GlobalNamespace;
            foreach (string part in namespaceName.Split('.'))
            {
                ns = ns?.GetNamespaceMembers().FirstOrDefault(n => n.Name == part);
            }

            if (ns is null)
            {
                failures.Add($"{filename} line {entry.LineNumber}: Namespace '{namespaceName}' not found in BCL");
            }
        }

        failures.ShouldBeEmpty(
            $"Namespace entries in {filename} that failed to resolve:\n{string.Join("\n", failures)}");
    }

    [Fact]
    public void BannedSymbolsFiles_AllDiscoveredFilesAreManifested()
    {
        HashSet<string> discovered = new(_bannedSymbolsPaths.Keys, StringComparer.Ordinal);
        HashSet<string> manifested = new(_expectedCategoriesPerFile.Keys, StringComparer.Ordinal);
        discovered.SymmetricExceptWith(manifested);
        discovered.ShouldBeEmpty(
            $"Files on disk vs manifest disagree (orphans on either side): {string.Join(", ", discovered)}. " +
            "Add the new BannedSymbols.*.txt to _expectedCategoriesPerFile, OR remove the file from the repo.");
    }

    [Fact]
    public void BannedSymbolsServiceLocator_AdditionalFilesConditionIsCorrect()
    {
        string targetsPath = FindTargetsFile();
        string content = File.ReadAllText(targetsPath);

        string excerpt = ExtractItemGroupForFile(content, "BannedSymbols.ServiceLocator.txt");

        excerpt.ShouldContain(".Core", Case.Sensitive);
        excerpt.ShouldContain(".Domain", Case.Sensitive);
        excerpt.ShouldContain(".Application", Case.Sensitive);
        excerpt.ShouldContain("IsTestProject", Case.Sensitive);
        excerpt.ShouldContain(".dcproj", Case.Sensitive);
    }

    private static INamedTypeSymbol? TryResolveBclType(string typeName, BannedEntry entry, string filename, List<string> failures)
    {
        if (!IsBclNamespace(typeName))
        {
            return null;
        }

        INamedTypeSymbol? type = _bclCompilation.Value.GetTypeByMetadataName(typeName);
        if (type is null)
        {
            failures.Add($"{filename} line {entry.LineNumber}: Type '{typeName}' not found in BCL");
        }

        return type;
    }

    private static bool IsBclNamespace(string name) =>
        name.StartsWith("System.", StringComparison.Ordinal)
     || name.StartsWith("Microsoft.", StringComparison.Ordinal);

    private static (string typeName, string memberName)? SplitQualifiedMember(string qualifiedName)
    {
        int lastDot = qualifiedName.LastIndexOf('.');
        return lastDot < 0 ? null : (qualifiedName[..lastDot], qualifiedName[(lastDot + 1)..]);
    }

    private static CSharpCompilation CreateBclCompilation()
    {
        HashSet<string> assemblyPaths = new(StringComparer.OrdinalIgnoreCase);

        // Prefer netcoreapp ref-assemblies over runtime DLLs. Ref-assemblies carry the
        // clean public-API metadata (including type forwarders) Roslyn's
        // `GetTypeByMetadataName` walks correctly; runtime DLLs split types across
        // forwarder facades and trip the lookup for surfaces like
        // `System.IServiceProvider`. Falls back to runtime DLLs when the ref pack is
        // not installed (unusual but possible on slim images).
        string? refDir = FindReferenceAssemblyDirectory();
        if (refDir is not null)
        {
            foreach (string path in Directory.EnumerateFiles(refDir, "*.dll"))
            {
                assemblyPaths.Add(path);
            }
        }
        else
        {
            string runtimeDir = Path.GetDirectoryName(typeof(object).Assembly.Location)!;
            assemblyPaths.Add(typeof(object).Assembly.Location);
#pragma warning disable RS0030 // typeof reference needed for BCL assembly resolution, not usage
            assemblyPaths.Add(typeof(Console).Assembly.Location);
#pragma warning restore RS0030
            assemblyPaths.Add(typeof(HttpClient).Assembly.Location);
            assemblyPaths.Add(typeof(DateTime).Assembly.Location);

            foreach (string name in new[] { "System.Runtime.dll", "System.Collections.NonGeneric.dll" })
            {
                string path = Path.Combine(runtimeDir, name);
                if (File.Exists(path))
                {
                    assemblyPaths.Add(path);
                }
            }
        }

        // MEDI.Abstractions — referenced via PackageReference (Platform.Analyzers.Tests.csproj)
        // so BannedSymbols.ServiceLocator.txt entries (IKeyedServiceProvider,
        // ServiceProviderKeyedServiceExtensions, ActivatorUtilities, ServiceProviderServiceExtensions)
        // resolve against a real Roslyn symbol. Not part of the netcoreapp ref pack.
        assemblyPaths.Add(typeof(Microsoft.Extensions.DependencyInjection.IKeyedServiceProvider).Assembly.Location);

        IEnumerable<MetadataReference> references = assemblyPaths
            .Select(path => MetadataReference.CreateFromFile(path));

        return CSharpCompilation.Create("BannedSymbolsValidation",
            references: references,
            options: new CSharpCompilationOptions(OutputKind.DynamicallyLinkedLibrary));
    }

    private static string? FindReferenceAssemblyDirectory()
    {
        // .NET host installs ref-assemblies under
        //   <dotnet-root>/packs/Microsoft.NETCore.App.Ref/<version>/ref/net<X.Y>/
        // Locate <dotnet-root> via DOTNET_ROOT env var when set; otherwise walk up from
        // the runtime DLL location (`shared/Microsoft.NETCore.App/<ver>/` → `..` → `..`).
        string? dotnetRoot = Environment.GetEnvironmentVariable("DOTNET_ROOT");
        if (string.IsNullOrEmpty(dotnetRoot))
        {
            string runtimeDir = Path.GetDirectoryName(typeof(object).Assembly.Location)!;
            // runtimeDir = <root>/shared/Microsoft.NETCore.App/<ver>
            DirectoryInfo? cursor = new DirectoryInfo(runtimeDir).Parent?.Parent?.Parent;
            dotnetRoot = cursor?.FullName;
        }

        if (string.IsNullOrEmpty(dotnetRoot))
        {
            return null;
        }

        string packRoot = Path.Combine(dotnetRoot, "packs", "Microsoft.NETCore.App.Ref");
        if (!Directory.Exists(packRoot))
        {
            return null;
        }

        Version runningVersion = Environment.Version;
        string tfm = $"net{runningVersion.Major}.{runningVersion.Minor}";

        // Pick the newest matching version that has a ref/<tfm>/ subdirectory.
        string? bestMatch = Directory.EnumerateDirectories(packRoot)
            .Where(dir => Version.TryParse(Path.GetFileName(dir), out Version? v)
                       && v.Major == runningVersion.Major
                       && v.Minor == runningVersion.Minor)
            .OrderByDescending(dir => Version.Parse(Path.GetFileName(dir)!))
            .Select(dir => Path.Combine(dir, "ref", tfm))
            .FirstOrDefault(Directory.Exists);

        return bestMatch;
    }

    private static Dictionary<string, string> FindBannedSymbolsFiles()
    {
        Dictionary<string, string> result = new(StringComparer.Ordinal);
        string? dir = AppContext.BaseDirectory;
        while (dir is not null)
        {
            foreach (string path in Directory.EnumerateFiles(dir, "BannedSymbols*.txt"))
            {
                result.TryAdd(Path.GetFileName(path), path);
            }

            if (result.Count > 0)
            {
                return result;
            }

            dir = Directory.GetParent(dir)?.FullName;
        }

        return result;
    }

    private static string FindTargetsFile()
    {
        string? dir = AppContext.BaseDirectory;
        while (dir is not null)
        {
            string candidate = Path.Combine(dir, "Directory.Build.targets");
            if (File.Exists(candidate))
            {
                return candidate;
            }

            dir = Directory.GetParent(dir)?.FullName;
        }

        throw new FileNotFoundException(
            $"Directory.Build.targets not found walking up from {AppContext.BaseDirectory}");
    }

    private static string ExtractItemGroupForFile(string targetsContent, string filename)
    {
        int includeIdx = targetsContent.IndexOf(filename, StringComparison.Ordinal);
        if (includeIdx < 0)
        {
            throw new InvalidOperationException(
                $"AdditionalFiles entry for '{filename}' not found in Directory.Build.targets");
        }

        int itemGroupStart = targetsContent.LastIndexOf("<ItemGroup", includeIdx, StringComparison.Ordinal);
        int itemGroupEnd = targetsContent.IndexOf("</ItemGroup>", includeIdx, StringComparison.Ordinal);
        if (itemGroupStart < 0 || itemGroupEnd < 0)
        {
            throw new InvalidOperationException(
                $"Could not locate enclosing <ItemGroup>...</ItemGroup> for '{filename}'");
        }

        return targetsContent[itemGroupStart..(itemGroupEnd + "</ItemGroup>".Length)];
    }

    private static List<BannedEntry> ParseBannedSymbols(string[] lines)
    {
        List<BannedEntry> entries = [];

        for (int i = 0; i < lines.Length; i++)
        {
            string line = lines[i].Trim();

            if (string.IsNullOrWhiteSpace(line) || line.StartsWith("//", StringComparison.Ordinal))
            {
                continue;
            }

            int semicolonIndex = line.IndexOf(';', StringComparison.Ordinal);
            string symbol = semicolonIndex >= 0 ? line[..semicolonIndex].Trim() : line.Trim();
            string reason = semicolonIndex >= 0 ? line[(semicolonIndex + 1)..].Trim() : "";

            entries.Add(new BannedEntry(
                LineNumber: i + 1,
                RawLine: line,
                Symbol: symbol,
                Reason: reason));
        }

        return entries;
    }

    internal sealed record BannedEntry(
        int LineNumber,
        string RawLine,
        string Symbol,
        string Reason)
    {
        public string Prefix => Symbol.Length >= 2 ? Symbol[..2] : "";
        public string SymbolBody => Symbol.Length > 2 ? Symbol[2..] : "";
    }
}
