#!/usr/bin/env bash
# Regression tests for .claude/hooks/nuget-pack-prep.sh.
# Black-box subprocess tests — pipe PreToolUse Bash JSON, stub `dotnet`.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOOK="$SCRIPT_DIR/nuget-pack-prep.sh"

if ! command -v jq >/dev/null 2>&1; then
  printf 'SKIP: jq not installed locally — run in CI for full coverage.\n'
  exit 0
fi

TEST_TMPDIR="$(mktemp -d)"
trap 'rm -rf "$TEST_TMPDIR"' EXIT

# Build a fixture git repo with Platform.* libs, optional changes, and
# a stubbed `dotnet pack` that returns the configured exit code.
make_fixture() {
  local pack_exit="$1"
  shift
  local repo="$TEST_TMPDIR/case-$$-$RANDOM"
  mkdir -p "$repo/bin" "$repo/libs/dotnet"
  for lib in "$@"; do
    mkdir -p "$repo/libs/dotnet/$lib"
    printf '<Project></Project>\n' >"$repo/libs/dotnet/$lib/$lib.csproj"
    printf 'public class Stub {}\n' >"$repo/libs/dotnet/$lib/Stub.cs"
  done
  cat >"$repo/bin/dotnet" <<EOF
#!/usr/bin/env bash
exit $pack_exit
EOF
  chmod +x "$repo/bin/dotnet"
  (
    cd "$repo" || exit 99
    git init --quiet . >/dev/null
    git config user.email "t@t"
    git config user.name "t"
    git add -A >/dev/null
    local tree commit
    tree=$(git write-tree)
    commit=$(GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t \
      git commit-tree "$tree" -m init)
    git update-ref refs/heads/main "$commit"
    git symbolic-ref HEAD refs/heads/main
    # Synthesize "origin/main" pointing at the same commit for merge-base.
    git update-ref refs/remotes/origin/main "$commit"
  ) >/dev/null 2>&1
  printf '%s' "$repo"
}

# Add an uncommitted change in a lib to make `git diff <base>...HEAD`
# show it as changed. Requires creating a new commit.
dirty_lib() {
  local repo="$1" lib="$2"
  (
    cd "$repo" || exit 99
    printf 'public class New {}\n' >"libs/dotnet/$lib/New.cs"
    git add -A
    local tree commit prev
    prev=$(git rev-parse HEAD)
    tree=$(git write-tree)
    commit=$(GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t \
      git commit-tree -p "$prev" "$tree" -m "edit-$lib")
    git update-ref refs/heads/main "$commit"
  ) >/dev/null 2>&1
}

run_hook() {
  local repo="$1" cmd="$2"
  shift 2
  local input
  input=$(jq -n --arg c "$cmd" '{tool_name:"Bash", tool_input:{command:$c}}')
  env -i \
    HOME="$HOME" \
    PATH="$repo/bin:$PATH" \
    CLAUDE_PROJECT_DIR="$repo" \
    "$@" \
    bash "$HOOK" <<<"$input"
}

# shellcheck source=../../tests/shell/lib.sh
source "${TEST_REPO_ROOT:-$(git rev-parse --show-toplevel)}/tests/shell/lib.sh"

# Case 1: gh pr create + Platform.Core dirty + pack succeeds → success line
REPO=$(make_fixture 0 Platform.Core Platform.Domain)
dirty_lib "$REPO" Platform.Core
out1=$(run_hook "$REPO" "gh pr create --fill" 2>&1)
assert_hook_context_contains "pass — Platform.Core packed" "$out1" "1 Platform.* lib(s) packed clean"
assert_hook_context_contains "pass — Platform.Core named" "$out1" "Platform.Core"

# Case 2: pack fails → failure surface
REPO=$(make_fixture 1 Platform.Core)
dirty_lib "$REPO" Platform.Core
out2=$(run_hook "$REPO" "gh pr create" 2>&1)
assert_hook_context_contains "fail — surfaces failure" "$out2" "1/1 Platform.* libs failed"

# Case 3: non-PR-create command → silent
REPO=$(make_fixture 0 Platform.Core)
dirty_lib "$REPO" Platform.Core
out3=$(run_hook "$REPO" "git status" 2>&1)
assert_silent "non-gh-pr-create command — silent" "$out3"

# Case 4: gh pr create but no Platform.* changes → silent
REPO=$(make_fixture 0 Platform.Core)
out4=$(run_hook "$REPO" "gh pr create --title test" 2>&1)
assert_silent "no Platform.* changes — silent" "$out4"

# Case 5: Roslyn-component lib filtered out
REPO=$(make_fixture 0 Platform.Analyzers Platform.Registration.Generators)
dirty_lib "$REPO" Platform.Analyzers
dirty_lib "$REPO" Platform.Registration.Generators
out5=$(run_hook "$REPO" "gh pr create" 2>&1)
assert_silent "Roslyn components excluded — silent" "$out5"

# Case 6: kill switch
REPO=$(make_fixture 0 Platform.Core)
dirty_lib "$REPO" Platform.Core
out6=$(run_hook "$REPO" "gh pr create" HOOK_NUGET_PACK_PREP_ENABLED=false 2>&1)
assert_silent "kill switch — silent" "$out6"

# Case 7: non-Bash tool → silent (different stdin shape — bypass run_hook)
REPO=$(make_fixture 0 Platform.Core)
dirty_lib "$REPO" Platform.Core
out7=$(env -i HOME="$HOME" PATH="$REPO/bin:$PATH" CLAUDE_PROJECT_DIR="$REPO" \
  bash "$HOOK" <<<"$(jq -n '{tool_name:"Write", tool_input:{file_path:"x"}}')" 2>&1)
assert_silent "non-Bash tool — silent" "$out7"

# Case 8: gh pr create-something (not a real subcommand) → silent
REPO=$(make_fixture 0 Platform.Core)
dirty_lib "$REPO" Platform.Core
out8=$(run_hook "$REPO" "gh pr create-template" 2>&1)
assert_silent "gh pr create-* (not the subcommand) — silent" "$out8"

printf '\n=== %d test case(s), %d failed ===\n' "$CASE_NUM" "$FAILED"
[[ $FAILED -eq 0 ]] || exit 1
exit 0
