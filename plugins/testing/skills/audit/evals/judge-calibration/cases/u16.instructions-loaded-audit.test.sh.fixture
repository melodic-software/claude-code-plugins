#!/usr/bin/env bash
# Regression tests for .claude/hooks/instructions-loaded-audit.sh.
# Asserts kill switch, advisory always-exit-0, subject is "<file_path>:<load_reason>".

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOOK="$SCRIPT_DIR/instructions-loaded-audit.sh"
TEST_TMPDIR="$(mktemp -d)"
trap 'rm -rf "$TEST_TMPDIR"' EXIT

FAILED=0
CASE_NUM=0

# shellcheck source=../../tests/shell/lib.sh
source "$(git rev-parse --show-toplevel)/tests/shell/lib.sh"

run_hook() {
  local case_dir="$1" enabled="$2" stdin="$3" log_session_start="${4:-false}"
  mkdir -p "$case_dir/.claude/observability"
  (
    export CLAUDE_PROJECT_DIR="$case_dir"
    export HOOK_OBSERVABILITY_LOG_ENABLED=true
    export HOOK_INSTRUCTIONS_LOADED_AUDIT_ENABLED="$enabled"
    export HOOK_INSTRUCTIONS_LOADED_AUDIT_LOG_SESSION_START="$log_session_start"
    cd "$case_dir" || exit 1
    bash "$HOOK" <<<"$stdin" 2>/dev/null
  )
}

# Case 1: kill switch off → no append
case1="$TEST_TMPDIR/case1"
fixture=$(jq -nc '{hook_event_name:"InstructionsLoaded", file_path:"/x.md", load_reason:"path_glob_match"}')
run_hook "$case1" false "$fixture"
assert_file_absent "kill switch off skips append" \
  "$case1/.claude/observability/hook-events.jsonl"

# Case 2: subject combines file_path + load_reason
case2="$TEST_TMPDIR/case2"
fixture=$(jq -nc '{
  hook_event_name:"InstructionsLoaded",
  file_path:"/repo/.claude/rules/dotnet-conventions.md",
  load_reason:"path_glob_match"
}')
run_hook "$case2" true "$fixture"
assert_jsonl_field "event field is InstructionsLoaded" \
  "$case2/.claude/observability/hook-events.jsonl" event "InstructionsLoaded"
assert_jsonl_field "subject combines path + reason" \
  "$case2/.claude/observability/hook-events.jsonl" subject \
  "/repo/.claude/rules/dotnet-conventions.md:path_glob_match"

# Case 3: session_start reason captured (opt-in via env var; default-filtered)
case3="$TEST_TMPDIR/case3"
fixture=$(jq -nc '{
  hook_event_name:"InstructionsLoaded",
  file_path:"/repo/CLAUDE.md",
  load_reason:"session_start"
}')
run_hook "$case3" true "$fixture" true
assert_jsonl_field "session_start reason recorded (opt-in)" \
  "$case3/.claude/observability/hook-events.jsonl" subject \
  "/repo/CLAUDE.md:session_start"

# Case 3b: session_start filtered by default (no log_session_start arg)
case3b="$TEST_TMPDIR/case3b"
fixture=$(jq -nc '{
  hook_event_name:"InstructionsLoaded",
  file_path:"/repo/CLAUDE.md",
  load_reason:"session_start"
}')
run_hook "$case3b" true "$fixture"
assert_file_absent "session_start dropped at write time by default" \
  "$case3b/.claude/observability/hook-events.jsonl"

# Case 3c: path_glob_match always logged regardless of opt-in flag
case3c="$TEST_TMPDIR/case3c"
fixture=$(jq -nc '{
  hook_event_name:"InstructionsLoaded",
  file_path:"/repo/.claude/rules/quirks-hooks.md",
  load_reason:"path_glob_match"
}')
run_hook "$case3c" true "$fixture"
assert_jsonl_field "path_glob_match logged unconditionally" \
  "$case3c/.claude/observability/hook-events.jsonl" subject \
  "/repo/.claude/rules/quirks-hooks.md:path_glob_match"

# Case 4: file_path only (no load_reason) still records (non-empty subject)
case4="$TEST_TMPDIR/case4"
fixture=$(jq -nc '{hook_event_name:"InstructionsLoaded", file_path:"/x.md"}')
run_hook "$case4" true "$fixture"
assert_jsonl_field "subject is file:empty when reason missing" \
  "$case4/.claude/observability/hook-events.jsonl" subject "/x.md:"

# Case 5: empty payload → silent skip (no append)
case5="$TEST_TMPDIR/case5"
run_hook "$case5" true ""
assert_file_absent "empty stdin skips append" \
  "$case5/.claude/observability/hook-events.jsonl"

# Case 6: payload with neither field → silent skip
case6="$TEST_TMPDIR/case6"
fixture=$(jq -nc '{hook_event_name:"InstructionsLoaded"}')
run_hook "$case6" true "$fixture"
assert_file_absent "no path/reason skips append" \
  "$case6/.claude/observability/hook-events.jsonl"

printf '\n=== %d test case(s), %d failed ===\n' "$CASE_NUM" "$FAILED"
[[ $FAILED -eq 0 ]] || exit 1
exit 0
