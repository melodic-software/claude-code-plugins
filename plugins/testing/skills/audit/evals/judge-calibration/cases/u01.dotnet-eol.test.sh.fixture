#!/usr/bin/env bash
# Regression tests for .claude/hooks/dotnet-eol.sh.
#
# Coverage:
#   - case glob matches .NET file types (.cs, .csproj, .props, ...)
#   - bare LF in .cs is converted to CRLF
#   - CRLF stays CRLF (idempotent)
#   - non-.NET extensions exit 0 unchanged
#   - kill switch (HOOK_DOTNET_EOL_ENABLED=false) bypasses
#
# Windows-only: hook self-skips on non-MINGW*/MSYS* uname. CI runners are
# Linux, so this test suite skip_suites there.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOOK="$SCRIPT_DIR/dotnet-eol.sh"

# shellcheck source=../../tests/shell/lib.sh
source "${TEST_REPO_ROOT:-$(git rev-parse --show-toplevel)}/tests/shell/lib.sh"

# Windows-only — hook short-circuits on non-MINGW/MSYS uname.
case "$(uname -s)" in
  MINGW* | MSYS*) ;;
  *) skip_suite "dotnet-eol is Windows-only (uname=$(uname -s)) — tests skipped" ;;
esac

REPO_ROOT="${TEST_REPO_ROOT:-$(git rev-parse --show-toplevel)}"

TEST_TMPDIR="$REPO_ROOT/.work/.tmp-dotnet-eol-test-$$"
mkdir -p "$TEST_TMPDIR"
trap 'rm -rf "$TEST_TMPDIR"' EXIT

run_hook() { posttool_hook_run "$HOOK" "$1" "$REPO_ROOT"; }

# Count raw CR bytes — direct proxy for CRLF count when the file's only
# line endings are LF or CRLF. `grep -c $'\r'` is unreliable on some grep
# builds (Git Bash strips trailing CR before matching). `tr -cd '\r'`
# preserves only CR bytes; `wc -c` counts them.
crlf_count() {
  local count
  count=$(tr -cd '\r' <"$1" | wc -c)
  # wc on some platforms pads with spaces — trim.
  printf '%s' "${count// /}"
}

# --- Case 1: .cs with LF → forced to CRLF ---
printf 'using System;\nnamespace Foo;\nclass Bar { }\n' >"$TEST_TMPDIR/lf.cs"
[[ "$(crlf_count "$TEST_TMPDIR/lf.cs")" == "0" ]] \
  || fail "pre-state: lf.cs should have 0 CR before hook" 0 "$(crlf_count "$TEST_TMPDIR/lf.cs")"

run_hook "$TEST_TMPDIR/lf.cs" >/dev/null 2>&1
RC=$?
assert_exit "LF .cs → exit 0" 0 "$RC"
assert_eq "LF .cs → 3 CRLF after hook" 3 "$(crlf_count "$TEST_TMPDIR/lf.cs")"

# --- Case 2: .cs with CRLF stays CRLF (idempotent) ---
printf 'using System;\r\nnamespace Foo;\r\nclass Bar { }\r\n' >"$TEST_TMPDIR/crlf.cs"
pre="$(crlf_count "$TEST_TMPDIR/crlf.cs")"
assert_eq "pre-state: crlf.cs has 3 CR" 3 "$pre"

run_hook "$TEST_TMPDIR/crlf.cs" >/dev/null 2>&1
RC=$?
assert_exit "CRLF .cs → exit 0" 0 "$RC"
assert_eq "CRLF .cs → still 3 CR (idempotent)" 3 "$(crlf_count "$TEST_TMPDIR/crlf.cs")"

# --- Case 3: non-.NET extension → no conversion ---
printf 'console.log("x")\n' >"$TEST_TMPDIR/foo.js"
run_hook "$TEST_TMPDIR/foo.js" >/dev/null 2>&1
RC=$?
assert_exit ".js → exit 0" 0 "$RC"
assert_eq ".js → 0 CR (not converted)" 0 "$(crlf_count "$TEST_TMPDIR/foo.js")"

# --- Case 4: kill switch bypasses conversion ---
printf 'using System;\n' >"$TEST_TMPDIR/disabled.cs"
HOOK_DOTNET_EOL_ENABLED=false run_hook "$TEST_TMPDIR/disabled.cs" >/dev/null 2>&1
RC=$?
assert_exit "kill switch off → exit 0" 0 "$RC"
assert_eq "kill switch off → 0 CR (not converted)" 0 "$(crlf_count "$TEST_TMPDIR/disabled.cs")"

# --- Case 5: .csproj extension also covered ---
printf '<Project Sdk="Microsoft.NET.Sdk">\n  <PropertyGroup />\n</Project>\n' >"$TEST_TMPDIR/Foo.csproj"
run_hook "$TEST_TMPDIR/Foo.csproj" >/dev/null 2>&1
RC=$?
assert_exit ".csproj → exit 0" 0 "$RC"
assert_eq ".csproj → 3 CR after hook" 3 "$(crlf_count "$TEST_TMPDIR/Foo.csproj")"

# --- Case 6: .ps1 extension also covered ---
printf "Get-ChildItem\n" >"$TEST_TMPDIR/sample.ps1"
run_hook "$TEST_TMPDIR/sample.ps1" >/dev/null 2>&1
RC=$?
assert_exit ".ps1 → exit 0" 0 "$RC"
assert_eq ".ps1 → 1 CR after hook" 1 "$(crlf_count "$TEST_TMPDIR/sample.ps1")"

[[ $FAILED -eq 0 ]] || exit 1
echo "All cases passed ($CASE_NUM)."
