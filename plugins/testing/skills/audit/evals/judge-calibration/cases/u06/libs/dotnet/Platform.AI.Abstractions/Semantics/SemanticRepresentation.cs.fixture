namespace Platform.AI.Abstractions.Semantics;

/// <summary>
/// Encoder-produced semantic vector plus the model identity that produced it.
/// Carried across the <c>ISemanticWriter{TContent}.StoreAsync</c> /
/// <c>ISemanticSearcher{TContent}</c> boundary — adapter assemblies persisting
/// or querying the vector MUST be able to read <see cref="Vector"/>.
/// </summary>
public sealed class SemanticRepresentation
{
    private readonly byte[] _vector;

    public ReadOnlyMemory<byte> Vector => _vector;

    public string ModelId { get; }

    public int Version { get; }

    public SemanticRepresentation(byte[] vector, string modelId, int version)
    {
        ArgumentNullException.ThrowIfNull(vector);
        ArgumentNullException.ThrowIfNull(modelId);

        // Defensive copy so external callers can't mutate the stored bytes
        // after handing them off. ReadOnlyMemory<byte> on top is read-only
        // by contract for consumers.
        _vector = (byte[])vector.Clone();
        ModelId = modelId;
        Version = version;
    }
}
