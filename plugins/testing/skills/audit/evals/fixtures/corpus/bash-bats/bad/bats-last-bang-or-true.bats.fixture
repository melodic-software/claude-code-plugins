#!/usr/bin/env bats
# expect: rule-zero-assertion
# The last line negates grep, but `|| true` makes the list succeed either way,
# so the test passes whether or not the greeting was removed.

setup() {
  PATH="$BATS_TEST_DIRNAME/../bin:$PATH"
  cd "$BATS_TEST_TMPDIR"
}

@test "reset removes the saved greeting" {
  greet --save world
  greet --reset
  ! grep -s world greet.conf || true
}
