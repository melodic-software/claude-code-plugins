#!/usr/bin/env bats
# expect: rule-source-text-read
# reads: src/page.tsx
# Counts a name in the page's source rather than rendering the page.

setup() {
  load 'test_helper/bats-assert/load'
}

@test "the page renders a content plan" {
  run grep -c ContentPlan "$BATS_TEST_DIRNAME/../src/page.tsx"
  assert_output 1
}
