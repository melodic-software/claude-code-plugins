# good-for: rule-zero-assertion
# The same check-like names, with bodies that assert, one of them on the
# def's own line.
import unittest

from config import load_config


class ConfigTests(unittest.TestCase):
    def test_validate_config_loads(self):
        self.assertEqual(load_config("app.toml").port, 8080)

    def test_ensure_defaults(self): self.assertEqual(load_config("defaults.toml").port, 80)


if __name__ == "__main__":
    unittest.main()
