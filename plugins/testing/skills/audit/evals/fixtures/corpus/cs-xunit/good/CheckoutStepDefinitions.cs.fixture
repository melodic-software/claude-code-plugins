// A Reqnroll step definitions file is claimed by the C# adapter. Only a
// [Then] step is a test start: it asserts on what the [When] step did. The
// [Given] and [When] steps arrange and act with no assertion, and report
// nothing.
using Reqnroll;
using Xunit;

[Binding]
public class CheckoutStepDefinitions
{
    private Cart _cart;
    private decimal _total;

    [Given(@"a sample cart")]
    public void GivenASampleCart()
    {
        _cart = Cart.Sample();
    }

    [When(@"the cart is checked out")]
    public void WhenTheCartIsCheckedOut()
    {
        _total = Checkout.Run(_cart);
    }

    [Then(@"the total is (.*)")]
    public void ThenTheTotalIs(decimal expected)
    {
        Assert.Equal(expected, _total);
    }
}
