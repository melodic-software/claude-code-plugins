// expect: rule-inert-assertion
// expect: rule-recomputed-expectation
// Two typeof operands are settled at compile time, so Equal on the same type twice cannot fail.
using Xunit;

public class WidgetTypeofEqualTests
{
    [Fact]
    public void Widget_IsItself()
    {
        Assert.Equal(typeof(Widget), typeof(Widget));
    }
}
