// expect: rule-inert-assertion
// expect: rule-recomputed-expectation
// Two typeof operands are settled at compile time, so Same on the same type twice cannot fail.
using Xunit;

public class WidgetTypeofSameTests
{
    [Fact]
    public void Widget_IsItself()
    {
        Assert.Same(typeof(Widget), typeof(Widget));
    }
}
