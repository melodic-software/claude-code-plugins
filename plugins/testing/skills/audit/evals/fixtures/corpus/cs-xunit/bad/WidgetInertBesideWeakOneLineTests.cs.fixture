// expect: rule-inert-assertion
// expect: rule-weak-oracle
// Two statements on one line: Assert.True(true) never fails, and the
// NotNull after it is the only oracle left, which any widget passes.
using Xunit;

public class WidgetInertBesideWeakOneLineTests
{
    [Fact]
    public void Create_ReturnsAWidget()
    {
        var widget = WidgetFactory.Create();
        Assert.True(true); Assert.NotNull(widget);
    }
}
