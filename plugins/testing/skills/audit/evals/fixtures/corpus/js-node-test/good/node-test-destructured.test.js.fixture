// good-for: rule-zero-assertion
// node:assert functions imported by name carry no "assert" token of their own.
const { test } = require('node:test');
const { strictEqual, throws } = require('node:assert/strict');
const { parsePort } = require('../src/config');

test('parses a numeric port', () => {
  strictEqual(parsePort('8080'), 8080);
  throws(() => parsePort('http'), RangeError);
});
