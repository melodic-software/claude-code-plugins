// expect: rule-source-text-read
// reads: src/page.tsx
// Checks component order in the source text rather than in rendered output.
import { test } from 'node:test';
import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';

test('the video section follows the content plan', () => {
  const src = readFileSync(new URL('../src/page.tsx', import.meta.url), 'utf8');
  assert.ok(src.indexOf('<Videos') > src.indexOf('<ContentPlan'));
});
