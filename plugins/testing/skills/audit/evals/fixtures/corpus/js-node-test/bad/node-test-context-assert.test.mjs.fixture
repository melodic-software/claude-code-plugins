// expect: rule-snapshot-only
// The test context's t.assert.snapshot is an assertion, so zero-assertion does
// not fire; it is the only oracle, so snapshot-only does.
import { test } from 'node:test';
import { renderInvoice } from '../src/invoice.mjs';

test('renders the invoice header', (t) => {
  t.assert.snapshot(renderInvoice({ id: 42, total: 1999 }));
});
