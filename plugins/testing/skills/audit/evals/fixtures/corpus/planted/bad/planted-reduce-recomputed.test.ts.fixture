// pending: rule-recomputed-derived
// Planted #2: the expected value is recomputed with reduce over the same input.
import { calculateTotal } from '../src/limits';

test('reduce recomputed', () => {
  const items = [1, 2, 3];
  const expected = items.reduce((a, b) => a + b, 0);
  expect(calculateTotal(items)).toBe(expected);
});
