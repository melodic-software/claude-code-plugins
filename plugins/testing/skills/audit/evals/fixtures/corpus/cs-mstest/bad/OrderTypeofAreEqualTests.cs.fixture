// expect: rule-inert-assertion
// expect: rule-recomputed-expectation
// Two typeof operands are settled at compile time, so AreEqual on the same type twice cannot fail.
using Microsoft.VisualStudio.TestTools.UnitTesting;

[TestClass]
public class OrderTypeofAreEqualTests
{
    [TestMethod]
    public void Order_IsItself()
    {
        Assert.AreEqual(typeof(Order), typeof(Order));
    }
}
