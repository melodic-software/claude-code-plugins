// expect: rule-source-text-read
// reads: src/Order.cs
// Searches the source file for a method instead of exercising Order.
using System.IO;
using Microsoft.VisualStudio.TestTools.UnitTesting;

[TestClass]
public class OrderSourceTextTests
{
    [TestMethod]
    public void Order_HasTotal()
    {
        var src = File.ReadAllText("../src/Order.cs");
        StringAssert.Contains(src, "public decimal Total");
    }
}
