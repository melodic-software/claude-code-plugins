// expect: rule-recomputed-expectation
// The expected side formats the same amount with the code under test, so the
// assertion passes whatever Money.Format returns.
using Microsoft.VisualStudio.TestTools.UnitTesting;

[TestClass]
public class OrderTotalFormatTests
{
    [TestMethod]
    public void Format_ShowsTwoDecimals()
    {
        Assert.AreEqual(Money.Format(12.5m, "USD"), Money.Format(12.5m, "USD"));
    }
}
