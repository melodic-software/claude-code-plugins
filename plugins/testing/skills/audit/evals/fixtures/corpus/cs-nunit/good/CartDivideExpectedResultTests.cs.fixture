// good-for: rule-zero-assertion
// ExpectedResult on each case makes NUnit assert the return value, so a body
// with no assertion token is still checked. No usings, as with a global
// using: the TestCase attribute claims the file.
public class CartDivideExpectedResultTests
{
    [TestCase(12, 3, ExpectedResult = 4)]
    [TestCase(12, 4, ExpectedResult = 3)]
    public int SplitEvenly_ReturnsTheShare(int total, int people)
    {
        return Cart.SplitEvenly(total, people);
    }
}
