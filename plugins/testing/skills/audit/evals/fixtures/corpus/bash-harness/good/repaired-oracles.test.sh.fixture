#!/usr/bin/env bash
# good-for: rule-inert-assertion
# good-for: rule-constant-restatement
# good-for: rule-source-text-read
# The repaired twins: every [ ] test ends in || fail or has its status read,
# the retry limit is observed after a run, and the deploy script is run with a
# failing stub instead of grepped. A [ ] closing a function body is the
# function's return status, not a dropped one.
set -uo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

is_sorted() {
  [ "$(printf '%s\n' "$@" | sort | head -1)" = "$1" ]
}

out="$(printf 'b\na\n' | sort | head -1)"
[ "$out" = a ] || fail "sort put $out first"
[ -n "$out" ]
rc=$?
is_sorted a b || fail "a b is sorted"

ATTEMPTS="$(retry false; echo "$?")"
assert_eq "$ATTEMPTS" 3 "retry stops after the limit"
# A message-first helper, and names assigned by read: neither is a constant.
read -r FIRST LAST <<<"$(retry_bounds)"
assert_eq "the retry range ends at the limit" "$LAST" 3
assert_eq "the retry range starts at one" "$FIRST" 1

cp "$REPO/scripts/deploy.sh" "$TMP/deploy.sh"
printf '#!/bin/sh\nexit 1\n' >"$TMP/kubectl"
if PATH="$TMP:$PATH" "$TMP/deploy.sh"; then fail "deploy ignored a failing step"; fi
grep -q 'exit' "$TMP/deploy.sh" || fail "copy is empty"
pass "deploy"
[ "$rc" -eq 0 ] || fail "out was empty"
