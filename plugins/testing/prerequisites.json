{
  "requires": [
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the testing hooks cannot launch, so they do nothing.",
      "install": {
        "docs": "https://nodejs.org/en/download"
      },
      "check": "/testing:check"
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:test-judge-bg.sh",
        "hook:test-judge-start.sh",
        "hook:test-judge.sh",
        "hook:test-scan-bash.sh",
        "hook:test-scan.sh",
        "hook:test-weaken.sh"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, the testing hooks skip their work.",
      "install": {
        "docs": "https://jqlang.org/download/"
      },
      "check": "/testing:check"
    },
    {
      "id": "npm",
      "kind": "cli",
      "need": "required",
      "for": [
        "skill:check-visual-parity"
      ],
      "detect": {
        "any": [
          "npm"
        ]
      },
      "degrade": "Without npm, /testing:check-visual-parity cannot install pixelmatch and pngjs, so compare stops with the repair line and counts nothing.",
      "install": {
        "docs": "https://nodejs.org/en/download"
      },
      "check": "/testing:check"
    }
  ]
}
