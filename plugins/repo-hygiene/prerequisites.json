{
  "requires": [
    {
      "id": "jq",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:clean",
        "hook:destructive-guard.sh"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, the destructive-command guard fails closed: it blocks every destructive pattern it can see, with no acknowledgement path, until jq is installed. The branch audit also skips pull-request evidence.",
      "install": {
        "docs": "https://jqlang.org/download/",
        "brew": "jq",
        "winget": "jqlang.jq",
        "apt": "jq"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "gh",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:clean"
      ],
      "detect": {
        "any": [
          "gh"
        ]
      },
      "degrade": "Without gh, the branch audit cannot detect squash-merged branches and reports PRDataUnavailable; the default-branch lookup falls back to the local remote head.",
      "install": {
        "docs": "https://cli.github.com/",
        "brew": "gh",
        "winget": "GitHub.cli",
        "apt": "gh"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "node",
      "kind": "cli",
      "need": "optional",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the prerequisites checker cannot run, so a missing tool above goes unreported; the plugin's own skills are unaffected.",
      "install": {
        "docs": "https://nodejs.org/en/download",
        "brew": "node",
        "winget": "OpenJS.NodeJS.LTS",
        "apt": "nodejs"
      },
      "check": "/harness-ops:prerequisites"
    }
  ]
}
