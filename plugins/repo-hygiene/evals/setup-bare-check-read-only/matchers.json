{
  "no-clean-tier": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?(?:(?:bash|sh)(?:\\s|\\\\\\\\\\\\n)+(?:-[^\\s\\\"\\\\]+(?:\\s|\\\\\\\\\\\\n)+)*(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?)?(?:scan|preflight|clean-caches|clean-build|git-prune|git-branch-audit|git-branch-delete|git-stash-audit|git-tree-reset|git-tree-reset-batch|remove-path|clean-batch|clean-run-marker)\\.sh(?![\\w.-])(?!(?:(?![;|]|&&|(?<!\\\\\\\\)\\\\n)(?:[^\"\\\\]|\\\\.))*?(?:\\s|\\\\\\\\\\\\n)--?h(?:elp)?(?![\\w-]))"
  ],
  "no-install": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "install_command"
    }
  ],
  "verdict-table": [
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\bgit\\b"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\bghq\\b"
      }
    },
    "[\\s\\S]*?",
    {
      "use": "table_header_rule"
    }
  ]
}
