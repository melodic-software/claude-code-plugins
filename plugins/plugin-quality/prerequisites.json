{
  "requires": [
    {
      "id": "gh",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:audit",
        "skill:setup"
      ],
      "detect": {
        "any": [
          "gh"
        ]
      },
      "degrade": "Without gh, /plugin-quality:setup cannot report the acting account and the audit cannot file its work item; the audit's findings are still reported.",
      "install": {
        "docs": "https://cli.github.com/",
        "brew": "gh",
        "winget": "GitHub.cli",
        "apt": "gh"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "curl",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:audit"
      ],
      "detect": {
        "any": [
          "curl"
        ]
      },
      "degrade": "Without curl, the auditor falls back to WebFetch for its documentation fetch, which is less exact.",
      "install": {
        "docs": "https://curl.se/download.html",
        "brew": "curl",
        "winget": "cURL.cURL",
        "apt": "curl"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "optional",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, the context-zone script reports unknown for the session and the audit continues without it.",
      "install": {
        "docs": "https://jqlang.org/download/",
        "brew": "jq",
        "winget": "jqlang.jq",
        "apt": "jq"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "node",
      "kind": "cli",
      "need": "optional",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the prerequisites checker cannot run, so a missing tool above goes unreported; the plugin's own skills are unaffected.",
      "install": {
        "docs": "https://nodejs.org/en/download",
        "brew": "node",
        "winget": "OpenJS.NodeJS.LTS",
        "apt": "nodejs"
      },
      "check": "/harness-ops:prerequisites"
    }
  ]
}
