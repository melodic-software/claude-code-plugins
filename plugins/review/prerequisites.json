{
  "requires": [
    {
      "id": "python3",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:audit-enforceability",
        "skill:explain-change"
      ],
      "detect": {
        "any": [
          "python3",
          "python"
        ],
        "version": {
          "args": [
            "--version"
          ],
          "pattern": "Python ([0-9.]+)",
          "min": "3"
        }
      },
      "degrade": "Without Python 3, the stub emitter skips Unicode normalization of file paths and proceeds with the raw path, and the change digest cannot reach the session, so the reader copies questions back instead.",
      "install": {
        "docs": "https://www.python.org/downloads/",
        "brew": "python",
        "winget": "Python.Python.3.12",
        "apt": "python3"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "gh",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:fanout",
        "skill:quality-gate"
      ],
      "detect": {
        "any": [
          "gh"
        ]
      },
      "degrade": "Without gh, the open-pull-request context shows unknown and a pull-request target cannot be fetched; reviews of the local diff still run.",
      "install": {
        "docs": "https://cli.github.com/",
        "brew": "gh",
        "winget": "GitHub.cli",
        "apt": "gh"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "curl",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:explain-change"
      ],
      "detect": {
        "any": [
          "curl"
        ]
      },
      "degrade": "Without curl, the change digest's view watcher does not start, so the reader copies questions back instead.",
      "install": {
        "docs": "https://curl.se/download.html",
        "brew": "curl",
        "winget": "cURL.cURL",
        "apt": "curl"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "node",
      "kind": "cli",
      "need": "optional",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the prerequisites checker cannot run, so a missing tool above goes unreported; the plugin's own skills are unaffected.",
      "install": {
        "docs": "https://nodejs.org/en/download",
        "brew": "node",
        "winget": "OpenJS.NodeJS.LTS",
        "apt": "nodejs"
      },
      "check": "/harness-ops:prerequisites"
    }
  ]
}
