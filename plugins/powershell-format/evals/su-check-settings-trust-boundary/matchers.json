{
  "no-approval-grant": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?(?:mkdir|New-Item)(?:\\.exe)?",
    {
      "use": "token_argument"
    },
    "trust-approvals"
  ],
  "no-analyzer-run": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?(?:pwsh|powershell)(?:\\.exe)?(?:\\\\\\\"|')?(?:[^\"\\\\]|\\\\.)*?(?:(?<![\\w-])-(?:Command|c)\\s+(?:\\\\\\\"|')?|[;|{(]\\s*)(?:\\$\\w+\\s*=\\s*)?Invoke-(?:Formatter|ScriptAnalyzer)\\b"
  ],
  "no-install": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "install_command"
    }
  ]
}
