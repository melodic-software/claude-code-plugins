{
  "verify-ran": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?node(?:\\.exe)?(?:\\\\\\\"|')?(?:\\s|\\\\\\\\\\\\n)+(?:-[^\\s\\\"\\\\]+(?:\\s|\\\\\\\\\\\\n)+)*(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\']|\\\\\\\\)*install\\.mjs(?:\\\\\\\"|')?(?:\\s|\\\\\\\\\\\\n)+verify\\b"
  ],
  "module-probe-readonly": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?pwsh(?:\\.exe)?(?:\\\\\\\"|')?(?=(?:\\s+-\\w+)*?\\s+-NoProfile\\b)(?=(?:\\s+-\\w+)*?\\s+-NonInteractive\\b)(?:\\s+-\\w+)*?\\s+-(?:Command|c)\\s+(?:[^\"\\\\]|\\\\.)*?Get-Module\\s+-ListAvailable\\b"
  ],
  "status-table": [
    {
      "use": "table_header_rule"
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\b(?:Bash|bash)\\b"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\b(?:Node|node)(?:\\.js)?(?![\\w-])"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\b(?:pwsh|PowerShell)\\b"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "PSScriptAnalyzer(?!Settings)"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "(?:PSScriptAnalyzerSettings|\\b(?:Settings|settings) file)"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "(?:powershell_format_enabled|\\b(?:Toggles?|toggles?)\\b)"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "(?:\\b(?:Pre-commit|pre-commit|Git hook|git hook)|git-hooks?\\b|install\\.mjs)"
      }
    }
  ],
  "no-install": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "install_command"
    }
  ],
  "no-analyzer-run": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?(?:pwsh|powershell)(?:\\.exe)?(?:\\\\\\\"|')?(?:[^\"\\\\]|\\\\.)*?(?:(?<![\\w-])-(?:Command|c)\\s+(?:\\\\\\\"|')?|[;|{(]\\s*)(?:\\$\\w+\\s*=\\s*)?Invoke-(?:Formatter|ScriptAnalyzer)\\b"
  ],
  "node-probe": [
    {
      "use": "command_position_multishell"
    },
    "(?:command(?:\\s+-p)?\\s+-v\\s+node\\b|node(?:\\.exe)?\\s+--version\\b)"
  ]
}
