{
  "earlierEntries": [{ "from": "powershell-check", "to": ["format", "lint"] }],
  "ecosystems": ["powershell"],
  "entries": [
    {
      "name": "format",
      "event": "pre-commit",
      "script": "format.sh",
      "tools": ["pwsh"],
      "rewrites": true,
      "resolved": true,
      "assets": ["lib/git-hooks/resolve-tool.sh", "git-hooks/adapters.sh", "git-hooks/psscriptanalyzer.ps1"]
    },
    {
      "name": "lint",
      "event": "pre-commit",
      "script": "lint.sh",
      "tools": ["pwsh"],
      "rewrites": false,
      "resolved": true,
      "assets": ["lib/git-hooks/resolve-tool.sh", "git-hooks/adapters.sh", "git-hooks/psscriptanalyzer.ps1"]
    }
  ]
}
