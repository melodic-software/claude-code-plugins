{
  "description": "Optionally checks the uncommitted PowerShell changes with PSScriptAnalyzer when a turn ends; harness-ops reports a missing pwsh or a drifted git-hook entry at session start, from this plugin's prerequisites.json.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--run-if-unset-or-true",
              "POWERSHELL_FORMAT_ENABLED",
              "--require-true",
              "POWERSHELL_FORMAT_END_OF_TURN",
              "${CLAUDE_PLUGIN_ROOT}/hooks/powershell-format.sh",
              "--end-of-turn"
            ],
            "timeout": 30,
            "statusMessage": "Checking PowerShell in uncommitted changes..."
          }
        ]
      }
    ]
  }
}
