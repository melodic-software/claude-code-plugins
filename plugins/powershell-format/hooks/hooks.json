{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/powershell-format.sh",
            "timeout": 30,
            "statusMessage": "Formatting PowerShell..."
          }
        ]
      }
    ]
  }
}
