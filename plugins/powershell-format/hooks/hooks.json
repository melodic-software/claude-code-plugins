{
  "description": "Optionally checks the uncommitted PowerShell changes with PSScriptAnalyzer when a turn ends, and reports a missing pwsh or a drifted git-hook entry at session start.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--run-if-unset-or-true",
              "POWERSHELL_FORMAT_ENABLED",
              "--require-true",
              "POWERSHELL_FORMAT_END_OF_TURN",
              "${CLAUDE_PLUGIN_ROOT}/hooks/powershell-format.sh",
              "--end-of-turn"
            ],
            "timeout": 30,
            "statusMessage": "Checking PowerShell in uncommitted changes..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.mjs",
              "probe",
              "${CLAUDE_PLUGIN_ROOT}",
              "--run-if-unset-or-true",
              "POWERSHELL_FORMAT_ENABLED"
            ],
            "timeout": 10,
            "statusMessage": "Checking pwsh..."
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.sh\" node-notice /powershell-format:check POWERSHELL_FORMAT_ENABLED; ${PPID:+exit}; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.ps1\" node-notice /powershell-format:check POWERSHELL_FORMAT_ENABLED",
            "timeout": 10,
            "statusMessage": "Checking that node is on PATH..."
          }
        ]
      }
    ]
  }
}
