{
  "description": "Formats PowerShell scripts, modules and manifests after a write or edit, and reports a missing pwsh at session start.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/powershell-format.sh"
            ],
            "if": "Edit(*.ps1)",
            "timeout": 30,
            "statusMessage": "Formatting PowerShell..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/powershell-format.sh"
            ],
            "if": "Edit(*.psm1)",
            "timeout": 30,
            "statusMessage": "Formatting PowerShell..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/powershell-format.sh"
            ],
            "if": "Edit(*.psd1)",
            "timeout": 30,
            "statusMessage": "Formatting PowerShell..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.sh\" node-notice /powershell-format:check POWERSHELL_FORMAT_ENABLED; ${BASH_VERSION:+exit}; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.ps1\" node-notice /powershell-format:check POWERSHELL_FORMAT_ENABLED",
            "timeout": 10,
            "statusMessage": "Checking that node is on PATH..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--run-if-unset-or-true",
              "POWERSHELL_FORMAT_ENABLED",
              "${CLAUDE_PLUGIN_ROOT}/hooks/probe-prerequisite.sh"
            ],
            "timeout": 10,
            "statusMessage": "Checking pwsh..."
          }
        ]
      }
    ]
  }
}
