{
  "requires": [
    {
      "id": "pwsh",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:powershell-format.sh"
      ],
      "detect": {
        "any": [
          "pwsh"
        ]
      },
      "degrade": "Without pwsh, the hook cannot format or lint edited PowerShell scripts.",
      "install": {
        "docs": "https://learn.microsoft.com/powershell/scripting/install/installing-powershell"
      },
      "check": "/powershell-format:check"
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:powershell-format.sh"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, the powershell-format hooks skip their work.",
      "install": {
        "docs": "https://jqlang.org/download/"
      },
      "check": "/powershell-format:check"
    },
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the powershell-format hooks cannot launch, so they do nothing.",
      "install": {
        "docs": "https://nodejs.org/en/download"
      },
      "check": "/powershell-format:check"
    }
  ]
}
