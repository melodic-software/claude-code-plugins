{
  "hooks": {
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/api-error-audit.sh",
            "timeout": 5,
            "statusMessage": "Recording API-error telemetry..."
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "user_settings|project_settings|local_settings|skills",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/config-change-audit.sh",
            "timeout": 5,
            "statusMessage": "Recording config-change telemetry..."
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/instructions-loaded-audit.sh",
            "timeout": 5,
            "statusMessage": "Recording instructions-loaded telemetry..."
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/permission-denied-audit.sh",
            "timeout": 5,
            "statusMessage": "Recording permission-denied telemetry..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/pre-compact-audit.sh",
            "timeout": 5,
            "statusMessage": "Recording pre-compact telemetry..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/skill-usage-audit.sh",
            "timeout": 5,
            "statusMessage": "Recording skill-usage telemetry..."
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/skill-usage-expansion-audit.sh",
            "timeout": 5,
            "statusMessage": "Recording skill-usage-expansion telemetry..."
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/tool-failure-audit.sh",
            "timeout": 5,
            "statusMessage": "Recording tool-failure telemetry..."
          }
        ]
      }
    ]
  }
}
