{
  "description": "Formats Go source and its imports after a write or edit.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/go-format.sh",
            "shell": "bash",
            "if": "Edit(*.go)",
            "timeout": 15,
            "statusMessage": "Formatting Go imports..."
          }
        ]
      }
    ]
  }
}
