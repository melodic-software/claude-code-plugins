{
  "description": "Formats Go source and its imports with goimports once per batch of tool calls, optionally checks the uncommitted changes when a turn ends; harness-ops reports a missing goimports or a drifted git-hook entry at session start, from this plugin's prerequisites.json.",
  "hooks": {
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--run-if-unset-or-true",
              "GO_FORMAT_ENABLED",
              "--skip-unless-stdin-contains",
              ".go",
              "${CLAUDE_PLUGIN_ROOT}/hooks/go-format.sh"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--run-if-unset-or-true",
              "GO_FORMAT_ENABLED",
              "--require-true",
              "GO_FORMAT_END_OF_TURN",
              "${CLAUDE_PLUGIN_ROOT}/hooks/go-format.sh",
              "--end-of-turn"
            ],
            "timeout": 30,
            "statusMessage": "Checking Go in uncommitted changes..."
          }
        ]
      }
    ]
  }
}
