{
  "description": "Formats Go source and its imports after a write or edit.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/go-format.sh"
            ],
            "if": "Edit(*.go)",
            "timeout": 15,
            "statusMessage": "Formatting Go imports..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/probe-prerequisite.sh"
            ],
            "timeout": 10,
            "statusMessage": "Checking goimports..."
          }
        ]
      }
    ]
  }
}
