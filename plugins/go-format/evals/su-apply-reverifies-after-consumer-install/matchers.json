{
  "live-goimports-probe": [
    {
      "use": "command_position_multishell"
    },
    "(?:if\\s+)?(?:(?:command\\s+-v|which|type)(?:\\s+-\\S+)*(?:\\s+[^\\s\\\"\\\\;&|]+)*?\\s+(?:\\\\\\\"|')?goimports(?![\\w.-])|for\\s+\\w+\\s+in\\s+[^;\\\"\\\\]*\\bgoimports\\b|(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?goimports(?:\\.exe)?(?:\\\\\\\"|')?(?:\\s|\\\\\\\\\\\\n)+(?:-h|--?help)\\b)"
  ],
  "no-install": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "install_command"
    }
  ],
  "no-formatter-run": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?goimports(?:\\.exe)?(?:\\\\\\\"|')?(?![\\w.-])(?!(?:\\s|\\\\\\\\\\\\n)+(?:--?version|--?help|-h)\\b)"
  ],
  "no-apply-step": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "apply_step"
    }
  ],
  "no-plugin-cli-write": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "plugin_cli_write"
    }
  ]
}
