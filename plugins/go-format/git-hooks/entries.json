{
  "remote": {
    "git_url": "https://github.com/melodic-software/claude-code-plugins",
    "ref": "main",
    "config": "plugins/go-format/git-hooks/lefthook-remote.yml",
    "aggregate": "lefthook-remote.yml"
  },
  "earlierEntries": [{ "from": "goimports-format", "to": ["format"] }],
  "ecosystems": ["go"],
  "entries": [
    {
      "name": "format",
      "event": "pre-commit",
      "script": "format.sh",
      "tools": ["goimports"],
      "rewrites": true,
      "resolved": true,
      "assets": ["lib/git-hooks/resolve-tool.sh", "git-hooks/adapters.sh"]
    }
  ]
}
