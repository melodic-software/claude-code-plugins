{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/ruff-format.sh",
            "if": "Edit(*.py)",
            "timeout": 15,
            "statusMessage": "Formatting Python with Ruff..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/ruff-format.sh",
            "if": "Edit(*.pyi)",
            "timeout": 15,
            "statusMessage": "Formatting Python with Ruff..."
          }
        ]
      }
    ]
  }
}
