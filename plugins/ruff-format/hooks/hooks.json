{
  "description": "Formats Python with the pinned Ruff after a write or edit.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/ruff-format.sh"
            ],
            "if": "Edit(*.py)",
            "timeout": 15,
            "statusMessage": "Formatting Python with Ruff..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/ruff-format.sh"
            ],
            "if": "Edit(*.pyi)",
            "timeout": 15,
            "statusMessage": "Formatting Python with Ruff..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--run-if-unset-or-true",
              "RUFF_FORMAT_ENABLED",
              "${CLAUDE_PLUGIN_ROOT}/hooks/probe-prerequisite.sh"
            ],
            "timeout": 10,
            "statusMessage": "Checking ruff..."
          }
        ]
      }
    ]
  }
}
