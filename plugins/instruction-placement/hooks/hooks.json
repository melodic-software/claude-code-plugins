{
  "description": "Detects a rules index drifting out of step with the rule files it indexes, after a write or edit.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/index-drift.sh",
            "shell": "bash",
            "if": "Edit(**/.claude/rules/*.md)",
            "timeout": 10,
            "statusMessage": "Checking rules index..."
          }
        ]
      }
    ]
  }
}
