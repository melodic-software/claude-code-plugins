{
  "requires": [
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the rules-index drift hook cannot start, so index drift goes unreported.",
      "install": {
        "docs": "https://nodejs.org/en/download",
        "brew": "node",
        "winget": "OpenJS.NodeJS.LTS",
        "apt": "nodejs"
      },
      "check": "/instruction-placement:check-prerequisites"
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:hook-utils.sh",
        "hook:index-drift.sh",
        "skill:migrate"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, the rules-index drift hook cannot read its JSON input and reports nothing, and /instruction-placement:migrate's remove-shims action refuses because it cannot read the installed plugin versions.",
      "install": {
        "docs": "https://jqlang.org/download/",
        "brew": "jq",
        "winget": "jqlang.jq",
        "apt": "jq"
      },
      "check": "/instruction-placement:check-prerequisites"
    },
    {
      "id": "curl",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:migrate"
      ],
      "detect": {
        "any": [
          "curl"
        ]
      },
      "degrade": "Without curl, /instruction-placement:migrate's cutover check cannot confirm a remote reference and reports it as unknown, and its docs read of the rules frontmatter format records the page unread with reason curl-missing unless a cached copy is still fresh.",
      "install": {
        "docs": "https://curl.se/download.html",
        "brew": "curl",
        "winget": "cURL.cURL",
        "apt": "curl"
      },
      "check": "/instruction-placement:check-prerequisites"
    },
    {
      "id": "python3",
      "kind": "runtime",
      "need": "optional",
      "for": [
        "skill:migrate"
      ],
      "detect": {
        "any": [
          "python3",
          "python"
        ],
        "reject_store_alias": true
      },
      "degrade": "Without Python 3, a docs page that serves only HTML cannot be converted, so /instruction-placement:migrate's docs read records it unread with reason no-python; pages served as markdown read normally.",
      "install": {
        "docs": "https://www.python.org/downloads/",
        "brew": "python",
        "winget": "Python.Python.3.12",
        "apt": "python3"
      },
      "check": "/instruction-placement:check-prerequisites"
    }
  ]
}
