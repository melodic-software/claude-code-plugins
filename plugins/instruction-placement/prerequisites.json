{
  "requires": [
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the rules-index drift hook cannot start, so index drift goes unreported.",
      "install": {
        "docs": "https://nodejs.org/en/download",
        "brew": "node",
        "winget": "OpenJS.NodeJS.LTS",
        "apt": "nodejs"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:index-drift.sh",
        "hook:hook-utils.sh"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, the rules-index drift hook cannot read its JSON input and reports nothing.",
      "install": {
        "docs": "https://jqlang.org/download/",
        "brew": "jq",
        "winget": "jqlang.jq",
        "apt": "jq"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "curl",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:migrate"
      ],
      "detect": {
        "any": [
          "curl"
        ]
      },
      "degrade": "Without curl, /instruction-placement:migrate's cutover check cannot confirm a remote reference and reports it as unknown.",
      "install": {
        "docs": "https://curl.se/download.html",
        "brew": "curl",
        "winget": "cURL.cURL",
        "apt": "curl"
      },
      "check": "/harness-ops:prerequisites"
    }
  ]
}
