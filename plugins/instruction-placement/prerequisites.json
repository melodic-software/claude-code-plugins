{
  "requires": [
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": ["plugin"],
      "detect": { "any": ["node"] },
      "degrade": "Without node, the rules index drift hook does not launch and nothing reports it. The skills still run.",
      "install": {
        "docs": "https://nodejs.org/en/download",
        "brew": "node",
        "winget": "OpenJS.NodeJS.LTS",
        "apt": "nodejs"
      },
      "check": "/instruction-placement:check-prerequisites"
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": ["skill:check", "skill:migrate"],
      "detect": { "any": ["jq"] },
      "degrade": "Without jq, /instruction-placement:check cannot read hook payloads for its load verification and /instruction-placement:migrate cannot read the installed plugin list. The other checks still run.",
      "install": { "docs": "https://jqlang.org/download/", "brew": "jq", "winget": "jqlang.jq", "apt": "jq" },
      "check": "/instruction-placement:check-prerequisites"
    }
  ]
}
