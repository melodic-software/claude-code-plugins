{
  "description": "Installs the demo-video skill's hash-locked Python packages (numpy, Pillow) into the plugin data directory at session start, and reports a failed install.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/lib/node-or-skip.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs\" \"${CLAUDE_PLUGIN_ROOT}/hooks/install-python-deps.sh\"; ${PPID:+exit}; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/lib/node-or-skip.ps1\" \"${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs\" \"${CLAUDE_PLUGIN_ROOT}/hooks/install-python-deps.sh\"",
            "timeout": 300,
            "statusMessage": "Installing playwright demo-video Python packages..."
          }
        ]
      }
    ]
  }
}
