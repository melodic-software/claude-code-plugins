{
  // Verbatim upstream baseline for drift detection (see the skill's update
  // action) — third-party content is never edited to satisfy local style, so
  // markdownlint is disabled for this directory. Nested directory configs
  // merge with the root config: "default": false silences default-on rules,
  // and the rules the root config sets explicitly must be turned off by name.
  "config": {
    "default": false,
    "MD003": false,
    "MD004": false,
    "MD024": false,
    "MD046": false,
    "MD048": false,
    "MD049": false,
    "MD050": false
  }
}
