{
  "requires": [
    {
      "id": "playwright-cli",
      "kind": "cli",
      "need": "required",
      "for": [
        "skill:playwright"
      ],
      "detect": {
        "any": [
          "playwright-cli"
        ]
      },
      "degrade": "Without playwright-cli, /playwright:playwright cannot drive a browser; it stops and asks for the install instead of substituting another surface.",
      "install": {
        "npm": "npm install -g @playwright/cli"
      },
      "check": "/playwright:check"
    },
    {
      "id": "python",
      "kind": "runtime",
      "need": "required",
      "for": ["hook:install-python-deps.sh", "skill:demo-video"],
      "detect": {
        "any": ["python3", "python"],
        "version": { "args": ["--version"], "pattern": "Python ([0-9.]+)", "min": "3.12" }
      },
      "degrade": "Without Python 3.12 or later the SessionStart hook cannot install numpy and Pillow, and /playwright:demo-video cannot build, render or QC a video.",
      "install": { "docs": "https://www.python.org/downloads/", "brew": "python@3.13", "winget": "Python.Python.3.13", "apt": "python3" },
      "check": "/playwright:check"
    },
    {
      "id": "ffmpeg",
      "kind": "cli",
      "need": "required",
      "for": ["skill:demo-video"],
      "detect": { "any": ["ffmpeg"] },
      "degrade": "Without ffmpeg /playwright:demo-video cannot encode the video or decode it for QC.",
      "install": { "docs": "https://ffmpeg.org/download.html", "apt": "ffmpeg", "brew": "ffmpeg", "winget": "Gyan.FFmpeg" },
      "check": "/playwright:check"
    },
    {
      "id": "ffprobe",
      "kind": "cli",
      "need": "required",
      "for": ["skill:demo-video"],
      "detect": { "any": ["ffprobe"] },
      "degrade": "Without ffprobe /playwright:demo-video cannot read narration clip durations or probe the rendered video.",
      "install": { "docs": "https://ffmpeg.org/download.html", "apt": "ffmpeg", "brew": "ffmpeg", "winget": "Gyan.FFmpeg" },
      "check": "/playwright:check"
    },
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, playwright-cli (an npm package) cannot run and the bundled prerequisites checker only reports that node is missing, so /playwright:playwright cannot drive a browser.",
      "install": {
        "docs": "https://nodejs.org/en/download"
      },
      "check": "/playwright:check"
    }
  ]
}
