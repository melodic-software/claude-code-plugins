{
  "status-table": [
    {
      "use": "table_header_rule"
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "(?<![.\\w/-])playwright-cli(?![\\w.\\-/])"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\b[Bb]rowser"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\.playwright-cli"
      }
    }
  ]
}
