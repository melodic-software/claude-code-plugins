{
  "description": "Installs the plugin's hash-locked Python packages (numpy, opencv) into the plugin data directory at session start, and reports a failed install.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/install-python-deps.sh"
            ],
            "timeout": 300,
            "statusMessage": "Installing animation Python packages..."
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.sh\" node-notice /animation:check-prerequisites; ${BASH_VERSION:+exit}; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.ps1\" node-notice /animation:check-prerequisites",
            "timeout": 10,
            "statusMessage": "Checking that node is on PATH..."
          }
        ]
      }
    ]
  }
}
