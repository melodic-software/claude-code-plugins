{
  "requires": [
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the SessionStart hook that installs the Python packages cannot start, and /animation:produce and /animation:rotoscope cannot render.",
      "install": {
        "docs": "https://nodejs.org/en/download",
        "brew": "node",
        "winget": "OpenJS.NodeJS.LTS",
        "apt": "nodejs"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "python3",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "python3",
          "python"
        ],
        "version": {
          "args": [
            "--version"
          ],
          "pattern": "Python ([0-9.]+)",
          "min": "3.12"
        }
      },
      "degrade": "Without Python 3.12 or newer, the SessionStart hook cannot install the animation packages and no animation script runs, so /animation:produce, /animation:rotoscope and /animation:setup stop.",
      "install": {
        "docs": "https://www.python.org/downloads/",
        "brew": "python",
        "winget": "Python.Python.3.12",
        "apt": "python3"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:hook-utils.sh"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, the plugin's hooks cannot read their JSON input.",
      "install": {
        "docs": "https://jqlang.org/download/",
        "brew": "jq",
        "winget": "jqlang.jq",
        "apt": "jq"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "ffmpeg",
      "kind": "cli",
      "need": "required",
      "for": [
        "skill:learn-style",
        "skill:produce",
        "skill:rotoscope"
      ],
      "detect": {
        "any": [
          "ffmpeg"
        ]
      },
      "degrade": "Without ffmpeg, /animation:produce and /animation:rotoscope stop before they encode or decode a film.",
      "install": {
        "docs": "https://ffmpeg.org/download.html",
        "brew": "ffmpeg",
        "winget": "Gyan.FFmpeg",
        "apt": "ffmpeg"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "ffprobe",
      "kind": "cli",
      "need": "required",
      "for": [
        "skill:learn-style",
        "skill:produce",
        "skill:rotoscope"
      ],
      "detect": {
        "any": [
          "ffprobe"
        ]
      },
      "degrade": "Without ffprobe, /animation:produce and /animation:rotoscope cannot read a clip's frame count and duration, and stop.",
      "install": {
        "docs": "https://ffmpeg.org/download.html",
        "brew": "ffmpeg",
        "winget": "Gyan.FFmpeg",
        "apt": "ffmpeg"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "libx264",
      "kind": "system-lib",
      "need": "required",
      "for": [
        "skill:learn-style",
        "skill:produce",
        "skill:rotoscope"
      ],
      "detect": {
        "probe": {
          "args": [
            "ffmpeg",
            "-hide_banner",
            "-encoders"
          ],
          "pattern": "\\blibx264\\b"
        }
      },
      "degrade": "Without the libx264 encoder in ffmpeg, /animation:produce and /animation:rotoscope cannot write the MP4.",
      "install": {
        "docs": "https://ffmpeg.org/download.html",
        "brew": "ffmpeg",
        "winget": "Gyan.FFmpeg",
        "apt": "ffmpeg"
      },
      "check": "/harness-ops:prerequisites"
    }
  ]
}
