{
  "session_probe": {
    "run_if_unset_or_true": "GIT_HOOKS_NOTICE_ENABLED"
  },
  "requires": [
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the guardrails hooks cannot launch, so they do nothing.",
      "install": {
        "docs": "https://nodejs.org/en/download"
      }
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:run-guards.sh",
        "hook:workflow-resilience-check.sh"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, guardrails denies Bash and PowerShell calls, and file writes on Windows; it skips its other file checks.",
      "install": {
        "docs": "https://jqlang.org/download/"
      }
    },
    {
      "id": "shfmt",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:run-guards.sh",
        "hook:cloud-shfmt.sh"
      ],
      "detect": {
        "any": [
          "shfmt"
        ],
        "version": {
          "args": [
            "--version"
          ],
          "pattern": "v?([0-9.]+)",
          "min": "3.14.1"
        }
      },
      "degrade": "With shfmt missing, guardrails denies Bash and PowerShell calls, naming the cause; a shfmt older than v3.14.1 may read commands differently.",
      "install": {
        "docs": "https://github.com/mvdan/sh#shfmt"
      }
    },
    {
      "id": "curl",
      "kind": "cli",
      "need": "optional",
      "for": [
        "hook:cloud-shfmt.sh"
      ],
      "detect": {
        "any": [
          "curl"
        ]
      },
      "degrade": "Without curl, a cloud session cannot install shfmt; the reason is recorded and the Bash guards refuse until shfmt is on PATH.",
      "install": {
        "docs": "https://curl.se/download.html"
      }
    }
  ]
}
