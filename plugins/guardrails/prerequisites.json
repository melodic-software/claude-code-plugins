{
  "requires": [
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the guardrails hooks cannot launch, so they do nothing.",
      "install": {
        "docs": "https://nodejs.org/en/download"
      },
      "check": "/guardrails:check"
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:run-guards.sh",
        "hook:workflow-resilience-check.sh"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, the guards that block irreversible operations deny the call, and the other guards skip their work for the session.",
      "install": {
        "docs": "https://jqlang.org/download/"
      },
      "check": "/guardrails:check"
    }
  ]
}
