{
  "schemaVersion": 1,
  "coverage": [
    {
      "hook": "hooks/block-dangerous-git.sh",
      "event": "PreToolUse",
      "matcher": "Bash|PowerShell",
      "decision": "block",
      "families": ["destructive-bash-deny"],
      "patterns": [
        "Bash(git push --force *)",
        "Bash(git push --force)",
        "Bash(git push -f *)",
        "Bash(git push -f)",
        "Bash(git reset --hard *)",
        "Bash(git reset --hard)",
        "Bash(git clean -f *)",
        "Bash(git clean -fd *)"
      ],
      "levers": [
        {
          "kind": "userConfig",
          "name": "block_dangerous_git_enabled",
          "effect": "false switches the guard off"
        },
        {
          "kind": "userConfig",
          "name": "block_dangerous_git_allow",
          "effect": "a comma list of form tokens the guard permits (push-force, push-lease-unsafe, reset-hard, clean-force, checkout-dot, restore-dot, checkout-force)"
        }
      ]
    },
    {
      "hook": "hooks/block-credential-read.sh",
      "event": "PreToolUse",
      "matcher": "Bash|PowerShell",
      "decision": "block",
      "families": [],
      "patterns": [],
      "levers": [
        {
          "kind": "userConfig",
          "name": "block_credential_read_enabled",
          "effect": "false switches the guard off"
        },
        {
          "kind": "userConfig",
          "name": "block_credential_read_allow",
          "effect": "a comma list of family tokens the guard permits (credential-fill, gh-auth-token, env-echo, credential-file-read)"
        }
      ]
    },
    {
      "hook": "hooks/block-fix-request-post.sh",
      "event": "PreToolUse",
      "matcher": "Bash|PowerShell",
      "decision": "block",
      "families": [],
      "patterns": [],
      "levers": [
        {
          "kind": "userConfig",
          "name": "block_fix_request_post_enabled",
          "effect": "false switches the guard off"
        }
      ]
    },
    {
      "hook": "hooks/block-github-post-content.sh",
      "event": "PreToolUse",
      "matcher": "Bash|PowerShell",
      "decision": "block",
      "families": [],
      "patterns": [],
      "levers": [
        {
          "kind": "userConfig",
          "name": "block_github_post_content_enabled",
          "effect": "false switches the guard off"
        },
        {
          "kind": "userConfig",
          "name": "secret_pattern_detection_enabled",
          "effect": "false switches off the secret half"
        },
        {
          "kind": "userConfig",
          "name": "hardcoded_path_check_enabled",
          "effect": "false switches off the machine-path half"
        }
      ]
    }
  ]
}
