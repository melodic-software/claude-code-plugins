{
  "description": "Runs the safety guards: secrets, hardcoded paths and Windows drive-root temp writes on Write and Edit; git hook-bypass, irreversible git operations, shell write-gate bypasses and commit conventions on Bash and PowerShell; recursive deletes aimed at a filesystem root, an empty or bare-variable operand, or a target outside the session's git tree, temp directories and scratchpad, and commands whose output is a credential, on Bash and PowerShell; and verifies CLI flags, skill references and cited paths after a write.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "command -v node >/dev/null 2>&1 || printf '%s\\n' '{\"systemMessage\":\"guardrails: node is not on PATH, so its guards cannot launch and enforce nothing. Install Node.js and restart Claude Code. Run /guardrails:check to verify.\",\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"WARNING: node is not on PATH, so the guards of the guardrails plugin cannot launch and enforce nothing. Tell the user. Run /guardrails:check to verify.\"}}'",
            "timeout": 10,
            "statusMessage": "Checking that node is on PATH..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-guards.sh",
              "secret-pattern-detection.sh",
              "hardcoded-path-check.sh",
              "block-windows-drive-tmp.sh"
            ],
            "timeout": 60,
            "statusMessage": "Checking for secrets, hardcoded paths, and Windows drive-root /tmp writes..."
          }
        ]
      },
      {
        "matcher": "^mcp__(plugin_.+_)?github__(push_files|create_or_update_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-guards.sh",
              "secret-pattern-detection.sh",
              "hardcoded-path-check.sh"
            ],
            "timeout": 60,
            "statusMessage": "Checking content bound for GitHub for secrets and hardcoded paths..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-guards.sh",
              "--lib",
              "lib/powershell/ps-command.sh",
              "--max-substitutions",
              "256",
              "--max-command-len",
              "16384",
              "block-no-verify.sh",
              "block-dangerous-git.sh",
              "block-hook-bypass.sh",
              "flag-commit-pr-skill-bypass.sh",
              "block-noncanonical-commit.sh",
              "block-convention-violation.sh",
              "block-windows-drive-tmp.sh",
              "block-exported-msys-pathconv.sh",
              "block-root-delete-target.sh",
              "block-credential-read.sh"
            ],
            "timeout": 60,
            "statusMessage": "Checking the command against the git, hook-bypass, commit-convention, Windows path, root-delete, and credential-read guards..."
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--require-true",
              "WORKFLOW_RESILIENCE_CHECK_ENABLED",
              "${CLAUDE_PLUGIN_ROOT}/hooks/workflow-resilience-check.sh"
            ],
            "timeout": 10,
            "statusMessage": "Checking workflow resilience..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.md)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-guards.sh",
              "cli-flag-verify.sh",
              "skill-reference-verify.sh",
              "stale-path-verify.sh"
            ],
            "timeout": 30,
            "statusMessage": "Verifying CLI flags, skill references, and cited paths..."
          },
          {
            "type": "command",
            "if": "Edit(*.sh)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-guards.sh",
              "cli-flag-verify.sh",
              "skill-reference-verify.sh",
              "stale-path-verify.sh"
            ],
            "timeout": 30,
            "statusMessage": "Verifying CLI flags, skill references, and cited paths..."
          },
          {
            "type": "command",
            "if": "Edit(*.bash)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-guards.sh",
              "cli-flag-verify.sh",
              "skill-reference-verify.sh",
              "stale-path-verify.sh"
            ],
            "timeout": 30,
            "statusMessage": "Verifying CLI flags, skill references, and cited paths..."
          },
          {
            "type": "command",
            "if": "Edit(*.ps1)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-guards.sh",
              "cli-flag-verify.sh",
              "skill-reference-verify.sh",
              "stale-path-verify.sh"
            ],
            "timeout": 30,
            "statusMessage": "Verifying CLI flags, skill references, and cited paths..."
          },
          {
            "type": "command",
            "if": "Edit(*.psm1)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-guards.sh",
              "cli-flag-verify.sh",
              "skill-reference-verify.sh",
              "stale-path-verify.sh"
            ],
            "timeout": 30,
            "statusMessage": "Verifying CLI flags, skill references, and cited paths..."
          }
        ]
      }
    ]
  }
}
