{
  "description": "Runs the safety guards: secrets, hardcoded paths and Windows drive-root temp writes on Write and Edit; git hook-bypass, irreversible git operations and commit conventions on Bash and PowerShell; and recursive deletes aimed at a filesystem root, an empty or bare-variable operand, or a target outside the session's git tree, temp directories and scratchpad, and commands whose output is a credential, on Bash and PowerShell; and an agent-posted PR-fix lane fix request, on Bash, PowerShell and the GitHub MCP write tools.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.mjs",
              "probe",
              "${CLAUDE_PLUGIN_ROOT}",
              "--run-if-unset-or-true",
              "GIT_HOOKS_NOTICE_ENABLED"
            ],
            "timeout": 10,
            "statusMessage": "Checking the guardrails git hooks..."
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.sh\" node-notice /guardrails:check; ${PPID:+exit}; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.ps1\" node-notice /guardrails:check",
            "timeout": 10,
            "statusMessage": "Checking that node is on PATH..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--fail-closed",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-guards.sh",
              "secret-pattern-detection.sh",
              "hardcoded-path-check.sh",
              "block-windows-drive-tmp.sh"
            ],
            "timeout": 60,
            "statusMessage": "Checking for secrets, hardcoded paths, and Windows drive-root /tmp writes..."
          }
        ]
      },
      {
        "matcher": "^mcp__(plugin_.+_)?github__(push_files|create_or_update_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--fail-closed",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-guards.sh",
              "secret-pattern-detection.sh",
              "hardcoded-path-check.sh"
            ],
            "timeout": 60,
            "statusMessage": "Checking content bound for GitHub for secrets and hardcoded paths..."
          }
        ]
      },
      {
        "matcher": "^mcp__.+__(merge_pull_request|enable_pr_auto_merge)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--fail-closed",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-guards.sh",
              "block-unresolved-pr-merge.sh"
            ],
            "timeout": 60,
            "statusMessage": "Checking the pull request for unresolved review threads and failing checks..."
          }
        ]
      },
      {
        "matcher": "^mcp__(plugin_.+_)?github__(add_issue_comment|update_issue_comment|issue_write|create_issue|update_issue|create_pull_request|update_pull_request|add_comment_to_pending_review|add_reply_to_pull_request_comment|pull_request_review_write|create_pull_request_review|create_and_submit_pull_request_review|submit_pending_pull_request_review|discussion_comment_write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--fail-closed",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-guards.sh",
              "block-fix-request-post.sh"
            ],
            "timeout": 60,
            "statusMessage": "Checking the GitHub comment for the PR-fix lane fix request..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--fail-closed",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-guards.sh",
              "--lib",
              "lib/powershell/ps-command.sh",
              "--max-substitutions",
              "256",
              "--max-command-len",
              "16384",
              "block-no-verify.sh",
              "block-dangerous-git.sh",
              "flag-commit-pr-skill-bypass.sh",
              "block-noncanonical-commit.sh",
              "block-convention-violation.sh",
              "block-windows-drive-tmp.sh",
              "block-exported-msys-pathconv.sh",
              "block-root-delete-target.sh",
              "block-credential-read.sh",
              "block-unresolved-pr-merge.sh",
              "block-fix-request-post.sh"
            ],
            "timeout": 60,
            "statusMessage": "Checking the command against the git, hook-bypass, commit-convention, Windows path, root-delete, credential-read, PR-merge, and fix-request guards..."
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--require-true",
              "WORKFLOW_RESILIENCE_CHECK_ENABLED",
              "${CLAUDE_PLUGIN_ROOT}/hooks/workflow-resilience-check.sh"
            ],
            "timeout": 10,
            "statusMessage": "Checking workflow resilience..."
          }
        ]
      }
    ]
  }
}
