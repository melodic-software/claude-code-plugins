{
  "description": "Runs the safety guards: secrets, hardcoded paths and Windows drive-root temp writes on Write and Edit, and an edit to a file that is not git-ignored in a main checkout on its default branch; git hook-bypass, irreversible git operations and commit conventions on Bash and PowerShell; recursive deletes aimed at a filesystem root, an empty or bare-variable operand, or a target outside the session's git tree, temp directories and scratchpad, and commands whose output is a credential, on Bash and PowerShell; a Bash or PowerShell command that names another identity domain's path, against a machine-local map; a Bash command that opens with cd and then runs git or writes to a relative path; a foreground Bash command that waits with an until loop or --watch; a Monitor or background Bash command that loops, sleeps and polls a pull request; a Bash or PowerShell command that posts a secret or a machine-specific path to GitHub; a pull request or issue body, from Bash or the GitHub MCP tools, that breaks the format its repository declares; a Bash command that turns off auto-merge on a lanes App pull request; and an agent-posted PR-fix lane fix request, on Bash, PowerShell and the GitHub MCP write tools. Asks before a file-editing tool writes a Claude Code settings file, and denies an Artifact publish of an HTML page whose content security policy names a loopback connect-src. The Bash and PowerShell guards also check each command a skill injects as it loads (Claude Code 2.1.332 or later). In a cloud session it installs the pinned shfmt the Bash guards read commands through.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--fail-closed",
              "--require-verdict",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-guards.sh",
              "secret-pattern-detection.sh",
              "hardcoded-path-check.sh",
              "block-windows-drive-tmp.sh",
              "block-main-checkout-edit.sh"
            ],
            "timeout": 60,
            "onFailure": "block",
            "statusMessage": "Checking for secrets, hardcoded paths, Windows drive-root /tmp writes, and edits in a main checkout on its default branch..."
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/settings-write-ask.mjs"],
            "timeout": 30,
            "statusMessage": "Checking whether this write targets a Claude Code settings file..."
          }
        ]
      },
      {
        "matcher": "^mcp__(plugin_.+_)?github__(push_files|create_or_update_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--fail-closed",
              "--require-verdict",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-guards.sh",
              "secret-pattern-detection.sh",
              "hardcoded-path-check.sh"
            ],
            "timeout": 60,
            "onFailure": "block",
            "statusMessage": "Checking content bound for GitHub for secrets and hardcoded paths..."
          }
        ]
      },
      {
        "matcher": "^mcp__.+__(merge_pull_request|enable_pr_auto_merge)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--fail-closed",
              "--require-verdict",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-guards.sh",
              "--lib",
              "lib/powershell/ps-command.sh",
              "merge-guard.sh"
            ],
            "timeout": 60,
            "onFailure": "block",
            "statusMessage": "Checking the pull request for unresolved review threads and failing checks..."
          }
        ]
      },
      {
        "matcher": "^mcp__(plugin_.+_)?github__(add_issue_comment|update_issue_comment|issue_write|create_issue|update_issue|create_pull_request|update_pull_request|add_comment_to_pending_review|add_reply_to_pull_request_comment|pull_request_review_write|create_pull_request_review|create_and_submit_pull_request_review|submit_pending_pull_request_review|discussion_comment_write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--fail-closed",
              "--require-verdict",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-guards.sh",
              "block-fix-request-post.sh",
              "block-body-format-violation.sh"
            ],
            "timeout": 60,
            "onFailure": "block",
            "statusMessage": "Checking the GitHub comment for the PR-fix lane fix request, and a pull request or issue body against its repository's declared format..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--fail-closed",
              "--require-verdict",
              "--bps-seed",
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook-utils.sh",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-guards.sh",
              "--bps-seeded",
              "--lib",
              "lib/powershell/ps-command.sh",
              "--max-substitutions",
              "256",
              "--max-command-len",
              "16384",
              "block-no-verify.sh",
              "block-dangerous-git.sh",
              "flag-commit-pr-skill-bypass.sh",
              "block-noncanonical-commit.sh",
              "block-convention-violation.sh",
              "block-windows-drive-tmp.sh",
              "block-exported-msys-pathconv.sh",
              "block-root-delete-target.sh",
              "block-credential-read.sh",
              "merge-guard.sh",
              "block-lane-pr-disable-auto.sh",
              "block-fix-request-post.sh",
              "block-github-post-content.sh",
              "block-body-format-violation.sh",
              "block-cross-domain.sh",
              "block-cd-prefix.sh",
              "block-foreground-wait.sh",
              "block-pr-poller.sh"
            ],
            "timeout": 60,
            "onFailure": "block",
            "statusMessage": "Checking the command against the git, hook-bypass, commit-convention, Windows path, root-delete, credential-read, PR-merge, lanes-PR auto-merge disable, fix-request, GitHub post content, PR and issue body format, identity-domain, cd-prefix, foreground-wait, and PR-poller guards..."
          }
        ]
      },
      {
        "matcher": "Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--fail-closed",
              "--require-verdict",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-guards.sh",
              "block-pr-poller.sh"
            ],
            "timeout": 10,
            "statusMessage": "Checking the monitor command for a hand-written pull request poller..."
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--require-true",
              "WORKFLOW_RESILIENCE_CHECK_ENABLED",
              "${CLAUDE_PLUGIN_ROOT}/hooks/workflow-resilience-check.sh"
            ],
            "timeout": 10,
            "statusMessage": "Checking workflow resilience..."
          }
        ]
      },
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/connected-page-gate.mjs"],
            "timeout": 10,
            "statusMessage": "Checking the page is not a connected page..."
          }
        ]
      }
    ],
    "PreSkillShellCommand": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--fail-closed",
              "--require-verdict",
              "--bps-seed",
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook-utils.sh",
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-guards.sh",
              "--bps-seeded",
              "--lib",
              "lib/powershell/ps-command.sh",
              "--max-substitutions",
              "256",
              "--max-command-len",
              "16384",
              "block-no-verify.sh",
              "block-dangerous-git.sh",
              "flag-commit-pr-skill-bypass.sh",
              "block-noncanonical-commit.sh",
              "block-convention-violation.sh",
              "block-windows-drive-tmp.sh",
              "block-exported-msys-pathconv.sh",
              "block-root-delete-target.sh",
              "block-credential-read.sh",
              "merge-guard.sh",
              "block-lane-pr-disable-auto.sh",
              "block-fix-request-post.sh",
              "block-github-post-content.sh",
              "block-body-format-violation.sh",
              "block-cross-domain.sh",
              "block-cd-prefix.sh",
              "block-foreground-wait.sh",
              "block-pr-poller.sh"
            ],
            "timeout": 60,
            "onFailure": "block",
            "statusMessage": "Checking the skill's injected command against the same guards as a Bash or PowerShell tool call..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/lib/node-or-skip.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs\" \"${CLAUDE_PLUGIN_ROOT}/hooks/cloud-shfmt.sh\"; ${PPID:+exit}; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/lib/node-or-skip.ps1\" \"${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs\" \"${CLAUDE_PLUGIN_ROOT}/hooks/cloud-shfmt.sh\"",
            "timeout": 90,
            "statusMessage": "Installing shfmt for the Bash guards (cloud sessions only)..."
          }
        ]
      }
    ]
  }
}
