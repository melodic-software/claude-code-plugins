{
  "status-table": [
    {
      "use": "table_header_rule"
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\b(?:Bash|bash)\\b"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\bjq\\b"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\b[Nn]ode(?:\\.js)?(?![\\w.\\-/])"
      }
    }
  ],
  "bash-probe": [
    {
      "use": "command_anywhere"
    },
    "(?:\\bbash(?:\\.exe)?(?:\\\\\\\"|')?(?:\\s|\\\\\\\\\\\\n)+--version\\b|\\$\\{?BASH_VERSI(?:ON|NFO)\\b)"
  ],
  "no-jq-node-reprobe": [
    {
      "use": "command_position_multishell"
    },
    "(?:command\\s+-[vV]\\s+|which\\s+|type\\s+(?:-\\w+\\s+)*|hash\\s+)(?:[^\\s\\\"&;|]+\\s+)*?(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?(?:jq|node)(?![\\w./-])"
  ],
  "verify-ran": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?node(?:\\.exe)?(?:\\\\\\\"|')?(?:\\s|\\\\\\\\\\\\n)+(?:-[^\\s\\\"\\\\]+(?:\\s|\\\\\\\\\\\\n)+)*(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\']|\\\\\\\\)*install\\.mjs(?:\\\\\\\"|')?(?:\\s|\\\\\\\\\\\\n)+verify\\b"
  ],
  "retirements-ran": [
    {
      "use": "command_position_multishell"
    },
    "(?:(?:bash|sh)(?:\\.exe)?(?:\\s+-[^\\s\\\"\\\\]+)*(?:\\s|\\\\\\\\\\\\n)+)?(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?check-retirements\\.sh(?:\\\\\\\"|')?(?![\\w.-])",
    {
      "use": "token_argument"
    },
    "--manifest(?:\\s|\\\\\\\\\\\\n)+(?:\\\\\\\"|')?[^\\s\\\"\\\\;&|]*retirements\\.yaml\\b"
  ],
  "no-install": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "install_command"
    }
  ],
  "no-plugin-cli-write": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "plugin_cli_write"
    }
  ],
  "no-settings-shell-write": [
    "\\\"command\\\":\\\"(?:(?!<<)(?:'[^']*'|[^\\\"\\\\']|\\\\.))*?(?:>{1,2}\\s*|\\btee\\s+(?:-a\\s+)?|\\bsed\\s+-i\\S*\\s+(?:'[^']*'|(?!\\\\n)[^\\\"\\\\;&|']|\\\\[^n\\\"])*?|\\b(?:mv|cp)\\s+(?:-\\S+\\s+)*(?!-)(?:[^\\s;&|<>\\\\]|\\\\.)+\\s+)(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|<>']*/)?(?:\\.claude/plugins/|(?:settings(?:\\.local)?|\\.claude)\\.json(?![\\w.-]))"
  ]
}
