{
  "requires": [
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the desktop-notification hooks cannot launch, so they do nothing.",
      "install": {
        "docs": "https://nodejs.org/en/download"
      },
      "check": "/desktop-notification:check"
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:desktop-notification.sh"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, the desktop-notification hooks skip their work for the session and say so once.",
      "install": {
        "docs": "https://jqlang.org/download/"
      },
      "check": "/desktop-notification:check"
    }
  ]
}
