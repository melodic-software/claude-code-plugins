{
  "description": "Raises a desktop notification when Claude Code needs attention on a permission or idle prompt, and the module forwards each mod toast as a native notification.",
  "modules": [
    "./register.ts"
  ],
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|plugin_notification",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/desktop-notification.sh"
            ],
            "timeout": 30,
            "statusMessage": "Sending desktop notification..."
          }
        ]
      }
    ]
  }
}
