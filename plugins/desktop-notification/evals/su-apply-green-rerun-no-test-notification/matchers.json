{
  "bash-version-probe": [
    {
      "use": "command_position_multishell"
    },
    "(?:(?:(?:echo|printf|test)\\b|\\[\\[?)(?:(?!\\\\n)[^\\\"\\\\;&|]|\\\\.)*?\\$\\{?BASH_VERS|(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?bash(?:\\.exe)?(?:\\s|\\\\\\\\\\\\n)+--version\\b)"
  ],
  "no-test-notification": [
    {
      "use": "command_position_multishell"
    },
    "(?:(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?(?:notify-send|osascript)(?![\\w./-])(?!(?:\\s|\\\\\\\\\\\\n)+--?(?:version|help|v)\\b)|(?:echo|printf)\\b(?:(?!\\\\n)[^\\\"\\\\;&|]|\\\\.)*?(?:\\\\\\\\0?33|\\\\\\\\e|\\\\\\\\x1[bB])\\]9;|(?:(?:bash|sh|node)(?:\\.exe)?(?:\\s+-(?!n\\b)\\S+)*\\s+)?(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?(?:desktop-notification\\.sh|exec-bash\\.mjs))"
  ],
  "no-install": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "install_command"
    }
  ],
  "no-plugin-cli-write": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "plugin_cli_write"
    }
  ],
  "no-settings-shell-write": [
    "\\\"command\\\":\\\"(?:(?!<<)(?:'[^']*'|[^\\\"\\\\']|\\\\.))*?(?:>{1,2}\\s*|\\btee\\s+(?:-a\\s+)?|\\bsed\\s+-i\\S*\\s+(?:'[^']*'|(?!\\\\n)[^\\\"\\\\;&|']|\\\\[^n\\\"])*?|\\b(?:mv|cp)\\s+(?:-\\S+\\s+)*(?:[^\\s;&|<>\\\\]|\\\\.)+\\s+)(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|<>']*/)?(?:\\.claude/plugins/|(?:settings(?:\\.local)?|\\.claude)\\.json(?![\\w.-]))"
  ]
}
