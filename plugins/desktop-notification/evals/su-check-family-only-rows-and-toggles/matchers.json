{
  "notify-send-probe": [
    {
      "use": "command_position_multishell"
    },
    "(?:(?:command\\s+-[vV]\\s+|which\\s+|type\\s+(?:-\\w+\\s+)*|hash\\s+)(?:[^\\s\\\"&;|]+\\s+)*?(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?notify-send(?![\\w./-])|(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?notify-send(?:\\s|\\\\\\\\\\\\n)+--version\\b)"
  ],
  "bash-version-probe": [
    {
      "use": "command_position_multishell"
    },
    "(?:(?:(?:echo|printf|test)\\b|\\[\\[?)(?:(?!\\\\n)[^\\\"\\\\;&|]|\\\\.)*?\\$\\{?BASH_VERS|(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?bash(?:\\.exe)?(?:\\s|\\\\\\\\\\\\n)+--version\\b)"
  ],
  "no-osascript-probe": [
    {
      "use": "command_position_multishell"
    },
    "(?:(?:command\\s+-[vV]\\s+|which\\s+|type\\s+(?:-\\w+\\s+)*|hash\\s+)(?:[^\\s\\\"&;|]+\\s+)*?(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?|(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?)osascript(?![\\w./-])"
  ],
  "no-install": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "install_command"
    }
  ],
  "no-plugin-cli-write": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?claude(?:\\.exe)?(?:\\\\\\\"|')?(?:(?:\\s|\\\\\\\\\\\\n)+-[^\\s\\\"\\\\]+)*(?:\\s|\\\\\\\\\\\\n)+plugins?(?:\\s|\\\\\\\\\\\\n)+(?:install|uninstall|remove|configure|enable|disable|update)\\b(?!\\s+--help\\b)"
  ]
}
