upgrade|freshen))\\b|n(?:\\s|\\\\t|\\\\\\\\\\\\n)+(?:lts|latest)\\b|aria2c(?:\\.(?:exe|cmd|bat))?(?:\\\\\"|')?(?=(?:\\s|\\\\t|\\\\\\\\\\\\n))(?:\\\\\\\\\\\\n|(?!\\\\n)(?:[^\"\\\\&;|]|\\\\.))*?(?:\\s|\\\\t|\\\\\\\\\\\\n)(?:\\\\\"|')?https?://|python[\\d.]*(?:\\.exe)?(?:\\\\\\\"|')?\\s+(?:\\\\\\\"|')?[^\\s\\\"]*pydeps\\.py(?:\\\\\\\"|')?\\s+install\\b|nix(?:-env)?\\s+(?:-i\\b|profile\\s+install|shell|run)|docker\\s+(?:pull|run)\\b|(?:npx|uvx|bunx|pnpx)(?:\\.(?:exe|cmd|bat))?(?:\\\\\"|')?(?:\\s|\\\\t|\\\\\\\\\\\\n)+(?!-{1,2}(?:version|help|v|h)\\b)|Install-(?:Module|PSResource)\\b|(?:pwsh|powershell)(?:\\.(?:exe|cmd|bat))?(?:\\\\\"|')?(?:\\s|\\\\t|\\\\\\\\\\\\n)+(?:(?:[^\"\\\\]|\\\\.)*?(?:[{(;|=&]|\\\\n|(?<![\\w-])-[Cc]\\w*(?:\\s|\\\\t|\\\\\\\\\\\\n)))?(?:\\s|(?:\\\\\"|'))*(?:[\\w.]+\\\\\\\\)?Install-(?:Module|PSResource)\\b|curl(?:\\.(?:exe|cmd|bat))?(?:\\\\\"|')?(?=(?:\\s|\\\\t|\\\\\\\\\\\\n))(?:\\\\\\\\\\\\n|'[^']*'|\\\\\"(?:[^\"\\\\]|\\\\(?!\")[\\s\\S])*\\\\\"|(?!\\\\n)(?:[^\"\\\\&;|\\']|\\\\(?![\"n])[\\s\\S]))*?(?:\\s|\\\\t|\\\\\\\\\\\\n)(?:-[A-Za-z]*[oO]|--output(?:-dir)?\\b|--remote-name(?:-all)?\\b)(?!=?(?:\\s|\\\\t|\\\\\\\\\\\\n)*(?:/dev/null|NUL)\\b)|(?:curl|wget)(?:\\.(?:exe|cmd|bat))?(?:\\\\\"|')?(?=(?:\\s|\\\\t|\\\\\\\\\\\\n))(?:\\\\\\\\\\\\n|\\d>&\\d|[02-9]>>?(?:\\s|\\\\t|\\\\\\\\\\\\n)*[^\\s\"\\\\;&|>]+|'[^']*'|\\\\\"(?:[^\"\\\\]|\\\\(?!\")[\\s\\S])*\\\\\"|\\|(?!\\|)|\\\\(?![\"n])[\\s\\S]|[^\"\\\\&;|'>])*?(?<![02-9&])&?>{1,2}(?!>|&[\\d-])(?!&?(?:\\s|\\\\t|\\\\\\\\\\\\n)*(?:/dev/null|NUL)\\b)|(?:curl|wget)(?:\\.(?:exe|cmd|bat))?(?:\\\\\"|')?(?=(?:\\s|\\\\t|\\\\\\\\\\\\n))(?:\\\\\\\\\\\\n|\\d>&\\d|'[^']*'|\\\\\"(?:[^\"\\\\]|\\\\(?!\")[\\s\\S])*\\\\\"|(?!\\\\n)(?:[^\"\\\\&;\\']|\\\\(?![\"n])[\\s\\S]))*?(?<!\\|)\\|(?!\\|)(?:\\s|\\\\t|\\\\\\\\\\\\n)*(?!(?:head|tail|e?grep|fgrep|rg|jq|yq|sed|awk|cut|sort|uniq|wc|tr|less|more|cat|column)\\b)[^\\s|]|wget(?:\\.(?:exe|cmd|bat))?(?:\\\\\"|')?(?=(?:\\s|\\\\t|\\\\\\\\\\\\n))(?!(?:\\\\\\\\\\\\n|(?!\\\\n)(?:[^\"\\\\&;|