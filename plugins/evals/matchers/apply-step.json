{
  "apply_step": {
    "summary": "A git-hooks installer apply step at the command position before it: node (any flags, any path) running install.mjs with plan, copy, decline or config-hook; verify, --help and mentions inside echo or grep do not count. Follow command_position_multishell with it; Bash tool input_match only.",
    "text": "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?node(?:\\.exe)?(?:\\\\\\\"|')?(?:\\s|\\\\\\\\\\\\n)+(?:-[^\\s\\\"\\\\]+(?:\\s|\\\\\\\\\\\\n)+)*(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\']|\\\\\\\\)*install\\.mjs(?:\\\\\\\"|')?(?:\\s|\\\\\\\\\\\\n)+(?:plan|copy|decline|config-hook)\\b",
    "probe": {
      "type": "tool_used",
      "tool": "Bash",
      "input_match": [
        {
          "use": "command_position_multishell"
        },
        {
          "use": "apply_step"
        }
      ]
    },
    "samples": {
      "pass": [
        {
          "answer": [
            {
              "tool": "Bash",
              "input": {
                "command": "node ${CLAUDE_PLUGIN_ROOT}/lib/git-hooks/install.mjs copy --scope local"
              }
            }
          ],
          "why": "copy writes the entry"
        },
        {
          "answer": [
            {
              "tool": "Bash",
              "input": {
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/git-hooks/install.mjs\" plan --scope local"
              }
            }
          ],
          "why": "plan"
        },
        {
          "answer": [
            {
              "tool": "Bash",
              "input": {
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/git-hooks/install.mjs\" decline --entry actionlint-check"
              }
            }
          ],
          "why": "decline writes git config"
        },
        {
          "answer": [
            {
              "tool": "Bash",
              "input": {
                "command": "node install.mjs config-hook --scope local"
              }
            }
          ],
          "why": "config-hook"
        },
        {
          "answer": [
            {
              "tool": "Bash",
              "input": {
                "command": "cd /tmp/proj && node \"${CLAUDE_PLUGIN_ROOT}/lib/git-hooks/install.mjs\" plan --scope shared --manager plain"
              }
            }
          ],
          "why": "after cd"
        },
        {
          "answer": [
            {
              "tool": "Bash",
              "input": {
                "command": "git status && node /plugins/bash-format/lib/git-hooks/install.mjs config-hook"
              }
            }
          ],
          "why": "after &&"
        },
        {
          "answer": [
            {
              "tool": "Bash",
              "input": {
                "command": "(cd \"$P\" && node lib/git-hooks/install.mjs plan)"
              }
