{
  "no-install": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "install_command"
    }
  ],
  "no-env-change": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?(?:(?:poetry|pipenv|pdm|hatch|rye)(?:\\.exe)?(?:\\\\\\\"|')?(?:\\s+-{1,2}[\\w-]+(?:=\\S+)?)*\\s+(?:add|install|sync|lock|update|run|shell|env\\s+use)\\b|uv(?:\\.exe)?(?:\\\\\\\"|')?(?:\\s+-{1,2}[\\w-]+(?:=\\S+)?)*\\s+(?:venv|sync|lock|add|run|tool\\s+run)\\b|pipx(?:\\.exe)?\\s+run\\b|(?:venv|virtualenv)(?=\\s))"
  ],
  "verify-ran": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?node(?:\\.exe)?(?:\\\\\\\"|')?(?:\\s|\\\\\\\\\\\\n)+(?:-[^\\s\\\"\\\\]+(?:\\s|\\\\\\\\\\\\n)+)*(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\']|\\\\\\\\)*install\\.mjs(?:\\\\\\\"|')?(?:\\s|\\\\\\\\\\\\n)+verify\\b"
  ],
  "no-apply-step": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?node(?:\\.exe)?(?:\\\\\\\"|')?(?:\\s|\\\\\\\\\\\\n)+(?:-[^\\s\\\"\\\\]+(?:\\s|\\\\\\\\\\\\n)+)*(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\']|\\\\\\\\)*install\\.mjs(?:\\\\\\\"|')?(?:\\s|\\\\\\\\\\\\n)+(?:plan|copy|decline|config-hook)\\b"
  ],
  "no-ruff-run": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?ruff(?:\\.exe)?(?:\\\\\\\"|')?(?:\\s+-{1,2}[\\w-]+(?:=\\S+)?)*\\s+(?:check|format)\\b"
  ],
  "status-table": [
    {
      "use": "table_header_rule"
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\bjq\\b"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\b(?:Ruff|ruff)(?![\\w.-])(?![ \\t]+(?:config|Config))"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "\\b(?:Node|node)(?:\\.js)?(?![\\w-])"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "(?:\\b(?:Config|config)\\b|ruff\\.toml|pyproject)"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "(?:python_format_enabled|\\b(?:Toggles?|toggles?)\\b)"
      }
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "(?:\\b(?:Pre-commit|pre-commit|Git hook|git hook)|git-hooks?\\b|install\\.mjs)"
      }
    }
  ]
}
