{
  "no-install": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "install_command"
    }
  ],
  "no-env-change": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?(?:(?:poetry|pipenv|pdm|hatch|rye)(?:\\.exe)?(?:\\\\\\\"|')?(?:\\s+-{1,2}[\\w-]+(?:=\\S+)?)*\\s+(?:add|install|sync|lock|update|run|shell|env\\s+use)\\b|uv(?:\\.exe)?(?:\\\\\\\"|')?(?:\\s+-{1,2}[\\w-]+(?:=\\S+)?)*\\s+(?:venv|sync|lock|add|run|tool\\s+run)\\b|pipx(?:\\.exe)?\\s+run\\b|(?:venv|virtualenv)(?=\\s))"
  ],
  "no-plugin-cli-write": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "plugin_cli_write_with_help"
    }
  ]
}
