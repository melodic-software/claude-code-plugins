{
  "session_probe": {
    "run_if_unset_or_true": "PYTHON_FORMAT_ENABLED"
  },
  "requires": [
    {
      "id": "ruff",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:python-format.sh"
      ],
      "detect": {
        "any": [
          "ruff"
        ],
        "local_bin": [
          ".venv/bin/ruff"
        ]
      },
      "degrade": "Without ruff, the hook cannot format or lint edited Python files.",
      "install": {
        "pip": "pip install ruff",
        "docs": "https://docs.astral.sh/ruff/installation/"
      }
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:python-format.sh"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, the python-format hooks skip their work.",
      "install": {
        "docs": "https://jqlang.org/download/"
      }
    },
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the python-format hooks cannot launch, so they do nothing.",
      "install": {
        "docs": "https://nodejs.org/en/download"
      }
    }
  ]
}
