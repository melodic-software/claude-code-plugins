{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "user-interface concern table",
  "description": "Interface concerns read by /user-interface:design (which spokes to load) and /user-interface:audit (which lanes exist and what each reads). Paths are relative to the plugin root. scripts/lib/concerns-validate.mjs adds the checks a schema cannot state: unique ids, known types, files that exist and routing concerns that exist.",
  "type": "object",
  "required": ["version", "concerns"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "concerns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "types", "triggers", "spokes", "recipes", "routing_concerns", "audit"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "title": {"type": "string", "minLength": 1},
          "types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
          "triggers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "spokes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "read_when"],
              "additionalProperties": false,
              "properties": {
                "path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9./-]*\\.md$"},
                "read_when": {"type": "string", "minLength": 1}
              }
            }
          },
          "recipes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9./-]*\\.md$"}},
          "routing_concerns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
          "audit": {
            "type": "object",
            "required": ["order", "procedure"],
            "additionalProperties": false,
            "properties": {
              "order": {"type": "integer", "minimum": 1},
              "procedure": {"description": "null, or a lane procedure file", "pattern": "^[a-z0-9][a-z0-9./-]*\\.md$"}
            }
          }
        }
      }
    }
  }
}
