{
  "version": 1,
  "concerns": [
    {
      "id": "motion",
      "title": "Motion and animation",
      "types": [
        "web",
        "touch-web",
        "app"
      ],
      "triggers": [
        "animation",
        "motion",
        "transition",
        "easing",
        "duration",
        "spring",
        "gesture",
        "drag",
        "swipe",
        "jank",
        "dropped frames"
      ],
      "spokes": [
        {
          "path": "reference/animation/catalog.md",
          "read_when": "always"
        },
        {
          "path": "reference/animation/behaviors.md",
          "read_when": "a known component moves: modal, popover, menu, toast, tooltip, drawer, accordion"
        },
        {
          "path": "reference/animation/gestures.md",
          "read_when": "drag, swipe or a spring"
        },
        {
          "path": "reference/animation/performance.md",
          "read_when": "an animation drops frames, or the performance sub-mode"
        }
      ],
      "recipes": [],
      "routing_concerns": [
        "animation-authoring",
        "animation-audit"
      ],
      "audit": {
        "order": 4,
        "procedure": "skills/audit/reference/motion.md"
      }
    },
    {
      "id": "component-api",
      "title": "Component API",
      "types": [
        "web",
        "touch-web"
      ],
      "triggers": [
        "component API",
        "props API",
        "component props",
        "what props",
        "prop names",
        "component variants",
        "swap the rendered element",
        "compound components",
        "controlled and uncontrolled",
        "defaultValue",
        "variant prop",
        "asChild",
        "render prop",
        "slot props",
        "forward ref"
      ],
      "spokes": [
        {
          "path": "reference/types/web/component-api.md",
          "read_when": "always"
        },
        {
          "path": "reference/types/web/component-api/implementation.md",
          "read_when": "the component is written in React"
        }
      ],
      "recipes": [],
      "routing_concerns": [
        "component-libraries"
      ],
      "audit": {
        "order": 8,
        "procedure": null
      }
    },
    {
      "id": "web-layout",
      "title": "Layout and spacing",
      "types": [
        "web",
        "touch-web"
      ],
      "triggers": [
        "layout",
        "spacing",
        "hierarchy",
        "visual hierarchy",
        "alignment",
        "whitespace",
        "grid",
        "breakpoints",
        "primary action",
        "z-index",
        "stacking order",
        "density"
      ],
      "spokes": [
        {
          "path": "reference/types/web/layout.md",
          "read_when": "always"
        }
      ],
      "recipes": [
        "skills/write-css/reference/layout.md",
        "skills/write-css/reference/spacing-and-shape.md",
        "skills/write-css/reference/foundations.md"
      ],
      "routing_concerns": [],
      "audit": {
        "order": 5,
        "procedure": null
      }
    },
    {
      "id": "typography",
      "title": "Typography",
      "types": [
        "web",
        "touch-web"
      ],
      "triggers": [
        "typography",
        "typeface",
        "font pairing",
        "font files",
        "type scale",
        "line height",
        "letter spacing",
        "line length",
        "text wrapping",
        "truncation",
        "underline",
        "variable font"
      ],
      "spokes": [
        {
          "path": "reference/types/web/typography.md",
          "read_when": "always"
        },
        {
          "path": "reference/types/web/typography/typefaces-and-formats.md",
          "read_when": "a typeface is chosen, paired or swapped, or font files are added or loaded"
        },
        {
          "path": "reference/types/web/typography/font-capabilities.md",
          "read_when": "a variable font, font weights, OpenType features, numerals, small caps or superscripts are set"
        },
        {
          "path": "reference/types/web/typography/scale-and-rhythm.md",
          "read_when": "a type scale, text units, line height, paragraph spacing, letter spacing or text-box trimming is set"
        },
        {
          "path": "reference/types/web/typography/line-behavior.md",
          "read_when": "line length, wrapping, truncation, text alignment, casing, typographic characters, language or direction is set or reviewed"
        },
        {
          "path": "reference/types/web/typography/details-and-floors.md",
          "read_when": "underlines, text selection, placeholders, carets, font smoothing, decorative text or minimum text sizes are set or reviewed"
        },
        {
          "path": "reference/types/web/typography/tailwind.md",
          "read_when": "detect reports Tailwind"
        }
      ],
      "recipes": [
        "skills/write-css/reference/foundations.md",
        "skills/write-css/reference/text-and-media.md"
      ],
      "routing_concerns": [
        "typography-color"
      ],
      "audit": {
        "order": 6,
        "procedure": null
      }
    },
    {
      "id": "color",
      "title": "Color",
      "types": [
        "web",
        "touch-web"
      ],
      "triggers": [
        "color",
        "palette",
        "oklch",
        "contrast",
        "color scale",
        "tonal ramp",
        "convert hex",
        "gamut",
        "display-p3",
        "chroma",
        "focus ring color",
        "color tokens"
      ],
      "spokes": [
        {
          "path": "reference/types/web/color.md",
          "read_when": "always"
        },
        {
          "path": "reference/types/web/color/building-scales.md",
          "read_when": "building a tonal ramp, a hue family or a dark-mode remap, or auditing a scale for hue drift"
        },
        {
          "path": "reference/types/web/color/contrast.md",
          "read_when": "a contrast number, a failing pair, or text checked in both themes"
        },
        {
          "path": "reference/types/web/color/converting-colors.md",
          "read_when": "rewriting hex, rgb() or hsl() literals as oklch"
        },
        {
          "path": "reference/types/web/color/gamut-and-p3.md",
          "read_when": "high chroma, Display P3, or a browser target without oklch()"
        },
        {
          "path": "reference/types/web/color/tailwind.md",
          "read_when": "detect reports Tailwind"
        }
      ],
      "recipes": [
        "skills/write-css/reference/foundations.md",
        "skills/write-css/reference/interaction.md"
      ],
      "routing_concerns": [
        "typography-color"
      ],
      "audit": {
        "order": 11,
        "procedure": null
      }
    }
  ]
}
