        "what props",
        "prop names",
        "component variants",
        "swap the rendered element",
        "compound components",
        "controlled and uncontrolled",
        "defaultValue",
        "variant prop",
        "asChild",
        "render prop",
        "slot props",
        "forward ref"
      ],
      "spokes": [
        {
          "path": "reference/types/web/component-api.md",
          "read_when": "always"
        },
        {
          "path": "reference/types/web/component-api/implementation.md",
          "read_when": "the component is written in React"
        }
      ],
      "recipes": [],
      "routing_concerns": [
        "component-libraries"
      ],
      "audit": {
        "order": 8,
        "procedure": null
      }
    },
