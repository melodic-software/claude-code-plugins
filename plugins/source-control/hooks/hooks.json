{
  "description": "Gates pull-request and worktree operations: a PR body against the repo's PR-contract linkage gate on both the CLI and the GitHub MCP path, and a `git worktree add` target against the nesting invariant.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.sh\" node-notice /source-control:check; ${PPID:+exit}; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/lib/prerequisites.ps1\" node-notice /source-control:check",
            "timeout": 10,
            "statusMessage": "Checking that node is on PATH..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/pr-body-linkage-gate.sh"
            ],
            "if": "Bash(*pr*create*)",
            "timeout": 15,
            "statusMessage": "Checking PR body against the repo's pr-contract gate..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/pr-body-linkage-gate.sh"
            ],
            "if": "Bash(*pr*new*)",
            "timeout": 15,
            "statusMessage": "Checking PR body against the repo's pr-contract gate..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/pr-body-linkage-gate.sh"
            ],
            "if": "Bash(*pr*edit*)",
            "timeout": 15,
            "statusMessage": "Checking PR body against the repo's pr-contract gate..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/worktree-add-containment-gate.sh"
            ],
            "if": "Bash(*worktree*add*)",
            "timeout": 15,
            "statusMessage": "Checking git worktree add target against the nesting invariant..."
          }
        ]
      },
      {
        "matcher": "^mcp__(plugin_.+_)?github__(create|update)_pull_request$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/pr-linkage-mcp-gate.sh"
            ],
            "timeout": 15,
            "statusMessage": "Checking PR body against the repo's pr-contract gate..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/worktree-add-claim-gate.sh"
            ],
            "if": "Bash(*worktree*add*)",
            "timeout": 15,
            "statusMessage": "Claiming a newly added worktree..."
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "${CLAUDE_PLUGIN_ROOT}/hooks/worktree-create-gate.sh"
            ],
            "timeout": 60,
            "statusMessage": "Placing the worktree at the external root..."
          }
        ]
      }
    ]
  }
}
