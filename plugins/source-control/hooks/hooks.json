{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/pr-body-linkage-gate.sh",
            "timeout": 15,
            "statusMessage": "Checking PR body against the repo's pr-issue-linkage gate..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/worktree-add-containment-gate.sh",
            "timeout": 15,
            "statusMessage": "Checking git worktree add target against the nesting invariant..."
          }
        ]
      },
      {
        "matcher": "^mcp__github__(create|update)_pull_request$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/pr-linkage-mcp-gate.sh",
            "timeout": 15,
            "statusMessage": "Checking PR body against the repo's pr-issue-linkage gate..."
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/worktree-create-gate.sh",
            "timeout": 60,
            "statusMessage": "Placing the worktree at the external root..."
          }
        ]
      }
    ]
  }
}
