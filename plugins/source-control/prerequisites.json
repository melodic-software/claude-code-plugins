{
  "requires": [
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the source-control hooks cannot launch, so they do nothing.",
      "install": {
        "docs": "https://nodejs.org/en/download"
      }
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:pr-body-linkage-gate.sh",
        "hook:pr-linkage-mcp-gate.sh",
        "hook:worktree-add-claim.sh",
        "hook:worktree-add-containment-gate.sh",
        "hook:worktree-create-gate.sh",
        "hook:worktree-remove-gate.sh"
      ],
      "detect": {
        "any": [
          "jq"
        ],
        "version": {
          "args": [
            "--version"
          ],
          "pattern": "jq-([0-9.]+)",
          "min": "1.6"
        }
      },
      "degrade": "Without jq, the source-control hooks skip their work, except worktree-remove-gate.sh, which refuses, so a worktree Claude Code removes stays on disk.",
      "install": {
        "docs": "https://jqlang.org/download/"
      }
    },
    {
      "id": "claude",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:worktree-remove-gate.sh"
      ],
      "detect": {
        "any": [
          "claude"
        ]
      },
      "degrade": "Without the claude CLI on the hooks' PATH, the WorktreeRemove hook cannot reap a worktree's plugin install records, so it refuses and the worktree stays on disk for /source-control:worktree cleanup.",
      "install": {
        "docs": "https://code.claude.com/docs/en/setup"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "python3",
      "kind": "runtime",
      "need": "optional",
      "for": [
        "skill:pull-request"
      ],
      "detect": {
        "any": [
          "python3",
          "python"
        ],
        "version": {
          "args": [
            "--version"
          ],
          "pattern": "Python ([0-9.]+)",
          "min": "3.11"
        },
        "reject_store_alias": true
      },
      "degrade": "Without Python 3.11+, /source-control:pull-request media cannot place reviewer media and stops, a push does not mark a reviewer-media section out of date, and the readiness thread gate holds as unproven; the rest of the skill runs.",
      "install": {
        "docs": "https://www.python.org/downloads/",
        "brew": "python",
        "winget": "Python.Python.3.13",
        "apt": "python3"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "xcrun",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:worktree"
      ],
      "detect": {
        "any": [
          "xcrun"
        ]
      },
      "degrade": "macOS only. Without xcrun, /source-control:worktree cleanup skips the Xcode build-output and unavailable-simulator report; worktree removal is unaffected.",
      "install": {
        "docs": "https://developer.apple.com/xcode/resources/",
        "xcode-select": "xcode-select --install"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "npm",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:worktree",
        "hook:worktree-create-gate.sh"
      ],
      "detect": {
        "any": [
          "npm"
        ]
      },
      "degrade": "Without npm, worktree creation still succeeds but skips npm ci for a package-lock.json and warns; run npm ci in the new worktree yourself.",
      "install": {
        "docs": "https://docs.npmjs.com/downloading-and-installing-node-js-and-npm"
      }
    },
    {
      "id": "shfmt",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:pr-body-linkage-gate.sh",
        "hook:worktree-add-claim.sh",
        "hook:worktree-add-containment-gate.sh"
      ],
      "detect": {
        "any": [
          "shfmt"
        ],
        "version": {
          "args": [
            "--version"
          ],
          "pattern": "v?([0-9.]+)",
          "min": "3.14.1"
        }
      },
      "degrade": "With shfmt missing, pr-body-linkage-gate.sh and worktree-add-containment-gate.sh deny the commands they read, and worktree-add-claim.sh, which runs after the command, leaves it unclaimed; a shfmt older than v3.14.1 may read commands differently.",
      "install": {
        "docs": "https://github.com/mvdan/sh#shfmt"
      }
    }
  ]
}
