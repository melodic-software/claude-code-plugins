{
  "requires": [
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the source-control hooks cannot launch, so they do nothing.",
      "install": {
        "docs": "https://nodejs.org/en/download"
      },
      "check": "/source-control:check"
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:pr-body-linkage-gate.sh",
        "hook:pr-linkage-mcp-gate.sh",
        "hook:worktree-add-claim-gate.sh",
        "hook:worktree-add-containment-gate.sh",
        "hook:worktree-create-gate.sh"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, the source-control hooks skip their work for the session and say so once.",
      "install": {
        "docs": "https://jqlang.org/download/"
      },
      "check": "/source-control:check"
    },
    {
      "id": "xcrun",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:worktree"
      ],
      "detect": {
        "any": [
          "xcrun"
        ]
      },
      "degrade": "macOS only. Without xcrun, /source-control:worktree cleanup skips the Xcode build-output and unavailable-simulator report; worktree removal is unaffected.",
      "install": {
        "docs": "https://developer.apple.com/xcode/resources/",
        "xcode-select": "xcode-select --install"
      },
      "check": "/harness-ops:prerequisites"
    }
  ]
}
