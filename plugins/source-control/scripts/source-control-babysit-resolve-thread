#!/usr/bin/env bash
# Self-locating wrapper for the guarded babysit-prs thread resolver, invoked by
# its ${CLAUDE_PLUGIN_ROOT}/scripts/ path (see "Guarded Mutation Wrappers" in
# skills/babysit-prs/reference/safety.md).
# Adds no capability of its own: the deterministic guards in
# babysit_resolve_thread.py stay the only resolve path.
set -euo pipefail
export PYTHONUTF8=1
here="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
scripts="$here/../skills/babysit-prs/scripts"

# shellcheck source=../skills/babysit-prs/scripts/babysit-python.sh
. "$scripts/babysit-python.sh"
babysit_python "$scripts/babysit_resolve_thread.py" "$@"
