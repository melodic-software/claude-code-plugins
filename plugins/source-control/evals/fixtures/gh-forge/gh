#!/usr/bin/env bash
# Offline stand-in for the GitHub CLI in pull-request eval runs. It serves one pull request from the
# state install.sh wrote (or, under --no-pr, opens it on `pr create`), any extra pull requests in
# extra-prs, the issues in issues/<n>.json, and the REST reads the create phase makes, and never
# reaches a network or the real gh: any command it does not serve
# exits 1 naming itself, so a run cannot touch GitHub through it. `pr merge`, `pr review`, `pr comment`
# and the resolve-thread mutation only append a line to calls.jsonl in the forge state; every other call that
# exits 0 appends a "read" line, so a grader can tell a served call from one the real gh failed.
# `pr update-branch` is refused on
# purpose: the ready phase then takes its documented local-merge fallback, which the graders read.
# shellcheck disable=SC2154 # PR_* come from the state file sourced below
set -uo pipefail

forge="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
state="$forge/state"
origin="$forge/eval-fixture/app.git"
extra="$forge/extra-prs"
[[ -f "$extra" ]] || extra=/dev/null
# shellcheck source=/dev/null
source "$state"

refuse() {
  echo "gh (eval fixture forge): '$*' is not served offline" >&2
  exit 1
}

# Split argv into positionals plus the --json, --jq, --head and --name-only options gh accepts.
json="" jq_expr="" head="" name_only=0 args=()
parse() {
  while (($#)); do
    case "$1" in
      --json)
        json="$2"
        shift
        ;;
      --json=*) json="${1#--json=}" ;;
      -q | --jq)
        jq_expr="$2"
        shift
        ;;
      --jq=*) jq_expr="${1#--jq=}" ;;
      --name-only) name_only=1 ;;
      -H | --head)
        head="${2:-}"
        shift
        ;;
      --head=*) head="${1#--head=}" ;;
      -R | --repo) shift ;;
      -*) ;;
      *) args+=("$1") ;;
    esac
    shift
  done
}

# Print a JSON document cut to the --json fields, then through --jq when given.
emit() {
  local doc="$1"
  if [[ -n "$json" ]]; then
    doc=$(jq -c --arg f "$json" '. as $d | reduce ($f | split(",")[]) as $k ({}; .[$k] = $d[$k])' <<<"$doc")
  fi
  if [[ -n "$jq_expr" ]]; then jq -r "$jq_expr" <<<"$doc"; else jq . <<<"$doc"; fi
}

# The pull request a positional names: its number, #number, URL, or head branch; none means the
# current branch. An extra pull request it names becomes the PR_* the later steps read.
pr_matches() {
  local sel="${1:-$(git branch --show-current 2>/dev/null)}" n h t
  sel="${sel#\#}"
  sel="${sel##*/pull/}"
  [[ -f "$forge/created" && ("$sel" == "$PR_NUMBER" || "$sel" == "$PR_HEAD") ]] && return 0
  while IFS=$'\t' read -r n h t; do
    if [[ "$sel" == "$n" || "$sel" == "$h" ]]; then
      PR_NUMBER="$n" PR_HEAD="$h" PR_TITLE="$t"
      return 0
    fi
  done <"$extra"
  return 1
}

# The extra pull requests' documents; with a head branch, only that branch's.
extra_docs() {
  local n h t
  while IFS=$'\t' read -r n h t; do
    [[ -z "$1" || "$1" == "$h" ]] || continue
    PR_NUMBER="$n" PR_HEAD="$h" PR_TITLE="$t" pr_doc
  done <"$extra"
}

pr_doc() {
  local head_oid base_oid mss=CLEAN
  head_oid=$(git --git-dir="$origin" rev-parse "refs/heads/$PR_HEAD")
  base_oid=$(git --git-dir="$origin" rev-parse "refs/heads/$PR_BASE")
  # GitHub never reads CLEAN with a failing check: a non-required one makes it UNSTABLE.
  jq -e 'any(.[]; .bucket == "fail")' "$forge/checks" >/dev/null && mss=UNSTABLE
  git --git-dir="$origin" merge-base --is-ancestor "$base_oid" "$head_oid" || mss=BEHIND
  jq -n --arg n "$PR_NUMBER" --arg head "$PR_HEAD" --arg base "$PR_BASE" --arg oid "$head_oid" \
    --arg title "$PR_TITLE" --argjson draft "$(cat "$forge/draft")" --arg mss "$mss" \
    --argjson checks "$(jq -c 'map({name, status: "COMPLETED", conclusion: (if .bucket == "fail" then "FAILURE" else "SUCCESS" end), detailsUrl: .link})' "$forge/checks")" '{
      number: ($n | tonumber), title: $title, body: "", state: "OPEN", isDraft: $draft,
      headRefName: $head, headRefOid: $oid, baseRefName: $base,
      url: ("https://github.com/eval-fixture/app/pull/" + $n),
      author: {login: "eval-fixture"}, isCrossRepository: false,
      headRepository: {name: "app"}, headRepositoryOwner: {login: "eval-fixture"},
      mergeable: "MERGEABLE", mergeStateStatus: $mss, reviewDecision: "",
      statusCheckRollup: $checks, reviews: [], comments: [], labels: [], files: []
    }'
}

# Append one line to the call record a grader reads: the command, the PR number and the arguments.
record() {
  local what="$1"
  shift
  recorded=1
  jq -nc --arg c "$what" --arg pr "$PR_NUMBER" '{command: $c, pr: ($pr | tonumber), args: $ARGS.positional}' \
    --args -- "$@" >>"$forge/calls.jsonl"
}

recorded=0 argv=("$@")
trap 'rc=$?; ((rc != 0 || recorded)) || record read "${argv[@]+"${argv[@]}"}" 2>/dev/null; exit "$rc"' EXIT

cmd="${1:-}" sub="${2:-}"
case "$cmd $sub" in
  "pr view")
    shift 2
    parse "$@"
    pr_matches "${args[0]:-}" || {
      echo "no pull requests found for branch \"${args[0]:-$(git branch --show-current)}\"" >&2
      exit 1
    }
    if [[ -z "$json" && -z "$jq_expr" ]]; then
      pr_doc | jq -r '"\(.title) #\(.number)\n\(if .isDraft then "Draft" else "Open" end) • \(.headRefName) into \(.baseRefName)\n\(.url)"'
    else
      emit "$(pr_doc)"
    fi
    ;;
  "pr list")
    shift 2
    parse "$@"
    doc=$(
      if [[ -f "$forge/created" && (-z "$head" || "$head" == "$PR_HEAD") ]]; then pr_doc; fi
      extra_docs "$head"
    )
    doc=$(jq -sc . <<<"$doc")
    if [[ -n "$json" ]]; then
      json_list="$json"
      json=""
      doc=$(jq -c --arg f "$json_list" 'map(. as $d | reduce ($f | split(",")[]) as $k ({}; .[$k] = $d[$k]))' <<<"$doc")
    fi
    emit "$doc"
    ;;
  "pr diff")
    shift 2
    parse "$@"
    pr_matches "${args[0]:-}" || refuse pr diff "$@"
    if ((name_only)); then
      git --git-dir="$origin" diff --name-only "refs/heads/$PR_BASE...refs/heads/$PR_HEAD"
    else
      git --git-dir="$origin" diff "refs/heads/$PR_BASE...refs/heads/$PR_HEAD"
    fi
    ;;
  "pr create")
    shift 2
    [[ -f "$forge/created" ]] && {
      echo "a pull request for branch \"$PR_HEAD\" into branch \"$PR_BASE\" already exists:" >&2
      echo "https://github.com/eval-fixture/app/pull/$PR_NUMBER" >&2
      exit 1
    }
    create_args=("$@")
    is_draft=false new_head="" new_base="$PR_BASE" title="" body_file=""
    while (($#)); do
      case "$1" in
        -d | --draft) is_draft=true ;;
        -H | --head)
          new_head="$2"
          shift
          ;;
        --head=*) new_head="${1#--head=}" ;;
        -B | --base)
          new_base="$2"
          shift
          ;;
        --base=*) new_base="${1#--base=}" ;;
        -t | --title)
          title="$2"
          shift
          ;;
        --title=*) title="${1#--title=}" ;;
        -F | --body-file)
          body_file="$2"
          shift
          ;;
        --body-file=*) body_file="${1#--body-file=}" ;;
        -b | --body)
          printf '%s' "$2" >"$forge/pr-body.md"
          shift
          ;;
        -R | --repo | -r | --reviewer | -a | --assignee | -l | --label | -m | --milestone | -p | --project) shift ;;
        *) ;;
      esac
      shift
    done
    new_head="${new_head:-$(git branch --show-current)}"
    [[ "$new_head" == "$PR_HEAD" && "$new_base" == "$PR_BASE" ]] || refuse pr create --head "$new_head" --base "$new_base"
    [[ -z "$body_file" ]] || cp -- "$body_file" "$forge/pr-body.md" || exit 1
    [[ -n "$title" ]] || title="$PR_TITLE"
    printf 'PR_NUMBER=%q\nPR_HEAD=%q\nPR_BASE=%q\nPR_TITLE=%q\n' "$PR_NUMBER" "$PR_HEAD" "$PR_BASE" "$title" >"$state"
    echo "$is_draft" >"$forge/draft"
    : >"$forge/created"
    record "pr create" "${create_args[@]}"
    echo "https://github.com/eval-fixture/app/pull/$PR_NUMBER"
    ;;
  "issue view")
    shift 2
    parse "$@"
    n="${args[0]:-}"
    n="${n#\#}"
    n="${n##*/issues/}"
    [[ "$n" =~ ^[0-9]+$ && -f "$forge/issues/$n.json" ]] || {
      echo "GraphQL: Could not resolve to an issue or pull request with the number of $n. (repository.issue)" >&2
      exit 1
    }
    emit "$(cat "$forge/issues/$n.json")"
    ;;
  "pr ready")
    shift 2
    parse "$@"
    pr_matches "${args[0]:-}" || refuse pr ready "$@"
    if [[ "$(cat "$forge/draft")" == true ]]; then
      echo false >"$forge/draft"
      echo "✓ Pull request eval-fixture/app#$PR_NUMBER is marked as \"ready for review\""
    else
      echo "! Pull request eval-fixture/app#$PR_NUMBER is already \"ready for review\""
    fi
    ;;
  "pr checks")
    shift 2
    parse "$@"
    pr_matches "${args[0]:-}" || refuse pr checks "$@"
    if [[ "$(jq length "$forge/checks")" == 0 ]]; then
      echo "no checks reported on the '$PR_HEAD' branch" >&2
      exit 1
    fi
    # gh exits 0 on the --json path whatever the checks say; the table exits 8 while checks pend and
    # 1 when one failed, and the stand-in has only the failed case.
    if [[ -n "$json" ]]; then
      doc=$(jq -c --arg f "$json" 'map(. as $d | reduce ($f | split(",")[]) as $k ({}; .[$k] = $d[$k]))' "$forge/checks")
      if [[ -n "$jq_expr" ]]; then jq -r "$jq_expr" <<<"$doc"; else jq . <<<"$doc"; fi
    else
      jq -r '.[] | [.name, .bucket, "1m0s", .link] | @tsv' "$forge/checks"
      jq -e 'any(.[]; .bucket == "fail") | not' "$forge/checks" >/dev/null
    fi
    ;;
  "repo view")
    shift 2
    parse "$@"
    emit '{"name":"app","nameWithOwner":"eval-fixture/app","owner":{"login":"eval-fixture"},"defaultBranchRef":{"name":"main"},"visibility":"PRIVATE","url":"https://github.com/eval-fixture/app"}'
    ;;
  "auth status")
    echo "github.com"
    echo "  ✓ Logged in to github.com account eval-fixture (eval fixture forge)"
    ;;
  "api --hostname")
    # The acting-login read push-branch.sh makes to tell a lane from an operator; an operator login.
    [[ "$*" == *"viewer{login}"* ]] || refuse "$@"
    echo "eval-fixture"
    ;;
  "pr merge")
    shift 2
    parse "$@"
    pr_matches "${args[0]:-}" || refuse pr merge "$@"
    # Recorded for a grader; no ref moves, in the fixture or outside it.
    record "pr merge" "$@"
    echo "✓ Merged pull request eval-fixture/app#$PR_NUMBER"
    ;;
  "pr review")
    shift 2
    parse "$@"
    pr_matches "${args[0]:-}" || refuse pr review "$@"
    record "pr review" "$@"
    echo "✓ Reviewed pull request eval-fixture/app#$PR_NUMBER"
    ;;
  "pr comment")
    shift 2
    parse "$@"
    pr_matches "${args[0]:-}" || refuse pr comment "$@"
    record "pr comment" "$@"
    echo "https://github.com/eval-fixture/app/pull/$PR_NUMBER#issuecomment-1"
    ;;
  "api graphql")
    shift 2
    # parse skips the -f and -F flags and keeps their key=value values in args.
    parse "$@"
    gql=""
    thread_id=""
    for a in "${args[@]}"; do
      case "$a" in
        query=*) gql="${a#query=}" ;;
        id=*) thread_id="${a#id=}" ;;
        *) ;;
      esac
    done
    if [[ "$gql" == *resolveReviewThread* ]]; then
      jq -e --arg id "$thread_id" 'any(.[]; .id == $id)' "$forge/threads" >/dev/null || refuse api graphql "$@"
      record "resolve thread" "$thread_id"
      jq -c --arg id "$thread_id" 'map(if .id == $id then .isResolved = true else . end)' "$forge/threads" >"$forge/threads.new"
      mv "$forge/threads.new" "$forge/threads"
      emit '{"data":{"resolveReviewThread":{"thread":{"isResolved":true}}}}'
    elif [[ "$gql" == *reviewThreads* ]]; then
      emit "$(jq -c '{data: {repository: {pullRequest: {reviewThreads: {pageInfo: {hasNextPage: false, endCursor: null}, nodes: .}}}}}' "$forge/threads")"
    else
      refuse api graphql "$@"
    fi
    ;;
  "api user")
    shift 2
    parse "$@"
    emit '{"login":"eval-fixture","type":"User"}'
    ;;
  "search prs")
    shift 2
    parse "$@"
    doc=$(
      pr_doc
      extra_docs ""
    )
    doc=$(jq -sc 'map(. + {repository: {name: "app", nameWithOwner: "eval-fixture/app"}, state: "open"})' <<<"$doc")
    if [[ -n "$json" ]]; then
      json_list="$json"
      json=""
      doc=$(jq -c --arg f "$json_list" 'map(. as $d | reduce ($f | split(",")[]) as $k ({}; .[$k] = $d[$k]))' <<<"$doc")
    fi
    emit "$doc"
    ;;
  "api "*)
    # REST reads: the repository, an issue and its sub-issues, and a file at a ref. Any method but
    # GET, and any other path, is refused.
    shift
    path="" method=GET
    while (($#)); do
      case "$1" in
        -X | --method)
          method="$2"
          shift
          ;;
        --method=*) method="${1#--method=}" ;;
        -q | --jq)
          jq_expr="$2"
          shift
          ;;
        --jq=*) jq_expr="${1#--jq=}" ;;
        -H | --header) shift ;;
        repos/*) path="$1" ;;
        *) ;;
      esac
      shift
    done
    [[ "$method" == GET ]] || refuse api --method "$method" "$path"
    path="${path/#repos\/\{owner\}\/\{repo\}/repos/eval-fixture/app}"
    ref="$PR_BASE"
    [[ "$path" == *"?ref="* ]] && ref="${path##*\?ref=}" && path="${path%%\?*}"
    not_found() {
      echo "gh: Not Found (HTTP 404)" >&2
      exit 1
    }
    case "$path" in
      repos/eval-fixture/app)
        emit "$(jq -n --arg base "$PR_BASE" '{name: "app", full_name: "eval-fixture/app", owner: {login: "eval-fixture"}, default_branch: $base, private: true, html_url: "https://github.com/eval-fixture/app"}')"
        ;;
      repos/eval-fixture/app/issues/*/sub_issues)
        n="${path#repos/eval-fixture/app/issues/}"
        n="${n%/sub_issues}"
        [[ -f "$forge/issues/$n.json" ]] || not_found
        emit "$(jq -c '[.subIssues.nodes[]? | {number, title, state: (.state | ascii_downcase)}]' "$forge/issues/$n.json")"
        ;;
      repos/eval-fixture/app/issues/*)
        n="${path#repos/eval-fixture/app/issues/}"
        [[ "$n" =~ ^[0-9]+$ && -f "$forge/issues/$n.json" ]] || not_found
        emit "$(jq -c '{number, title, body, state: (.state | ascii_downcase), html_url: .url}' "$forge/issues/$n.json")"
        ;;
      repos/eval-fixture/app/contents/*)
        # Served raw, as with an Accept: application/vnd.github.raw header.
        git --git-dir="$origin" show "refs/heads/$ref:${path#repos/eval-fixture/app/contents/}" 2>/dev/null || not_found
        ;;
      *) refuse api "$path" ;;
    esac
    ;;
  "--version "*) echo "gh version 0.0.0-eval-fixture" ;;
  *) refuse "$@" ;;
esac
