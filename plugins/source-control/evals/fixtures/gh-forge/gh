#!/usr/bin/env bash
# Offline stand-in for the GitHub CLI in pull-request eval runs. It serves one pull request from the
# state install.sh wrote (or, under --no-pr, opens it on `pr create`), any extra pull requests in
# extra-prs, the issues in issues/<n>.json, and the REST reads the create phase and the branch update signals make, and never
# reaches a network or the real gh: any command it does not serve
# exits 1 naming itself, so a run cannot touch GitHub through it. `pr merge`, `pr review`, `pr comment`, `pr edit`,
# a comment edit and the resolve-thread mutation only append a line to calls.jsonl in the forge state; every other call that
# exits 0 appends a "read" line, so a grader can tell a served call from one the real gh failed.
# The forge's branch update (`PUT .../update-branch`) is refused on
# purpose: a `merge` decision in the ready phase then takes its documented local-merge fallback, which the graders read.
# A refused write method is still recorded, as `api <METHOD>`, so a grader can see the attempt, as are
# `pr close`, `pr update-branch`, `issue comment` and `issue edit`.
# reassess-state.sh seeds what the reassess cases need: pr-overlay.json (merged over the first pull request),
# comments.json (its conversation comments), reviews.json (its reviews) and merged-prs.json (pull requests
# already merged into the base). The last `pr comment` body is kept in comment-body.md for a grader.
# shellcheck disable=SC2154 # PR_* come from the state file sourced below
set -uo pipefail

forge="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
state="$forge/state"
origin="$forge/eval-fixture/app.git"
extra="$forge/extra-prs"
overlay="$forge/pr-overlay.json"
comments="$forge/comments.json"
merged="$forge/merged-prs.json"
reviews="$forge/reviews.json"
[[ -f "$extra" ]] || extra=/dev/null
# shellcheck source=/dev/null
source "$state"
primary="$PR_NUMBER"

refuse() {
  echo "gh (eval fixture forge): '$*' is not served offline" >&2
  exit 1
}

# Split argv into positionals plus the --json, --jq, --head, --base, --state, --search, label and --name-only options gh accepts.
json="" jq_expr="" head="" base_filter="" state_filter="" search="" name_only=0 args=() add_labels=()
parse() {
  while (($#)); do
    case "$1" in
      --state)
        state_filter="${2:-}"
        shift
        ;;
      --state=*) state_filter="${1#--state=}" ;;
      -S | --search)
        search="${2:-}"
        shift
        ;;
      --search=*) search="${1#--search=}" ;;
      --add-label)
        add_labels+=("${2:-}")
        shift
        ;;
      --add-label=*) add_labels+=("${1#--add-label=}") ;;
      --remove-label) shift ;;
      --json)
        json="$2"
        shift
        ;;
      --json=*) json="${1#--json=}" ;;
      -q | --jq)
        jq_expr="$2"
        shift
        ;;
      --jq=*) jq_expr="${1#--jq=}" ;;
      --name-only) name_only=1 ;;
      -H | --head)
        head="${2:-}"
        shift
        ;;
      --head=*) head="${1#--head=}" ;;
      -B | --base)
        base_filter="${2:-}"
        shift
        ;;
      --base=*) base_filter="${1#--base=}" ;;
      -R | --repo) shift ;;
      -*) ;;
      *) args+=("$1") ;;
    esac
    shift
  done
}

# Print a JSON document cut to the --json fields, then through --jq when given.
emit() {
  local doc="$1"
  if [[ -n "$json" ]]; then
    doc=$(jq -c --arg f "$json" '. as $d | reduce ($f | split(",")[]) as $k ({}; .[$k] = $d[$k])' <<<"$doc")
  fi
  if [[ -n "$jq_expr" ]]; then jq -r "$jq_expr" <<<"$doc"; else jq . <<<"$doc"; fi
}

# The pull request a positional names: its number, #number, URL, or head branch; none means the
# current branch. An extra pull request it names becomes the PR_* the later steps read.
pr_matches() {
  local sel="${1:-$(git branch --show-current 2>/dev/null)}" n h t
  sel="${sel#\#}"
  sel="${sel##*/pull/}"
  [[ -f "$forge/created" && ("$sel" == "$PR_NUMBER" || "$sel" == "$PR_HEAD") ]] && return 0
  while IFS=$'\t' read -r n h t; do
    if [[ "$sel" == "$n" || "$sel" == "$h" ]]; then
      PR_NUMBER="$n" PR_HEAD="$h" PR_TITLE="$t"
      return 0
    fi
  done <"$extra"
  return 1
}

# The ref the forge holds a pull request's head at: the pull ref once written, else its branch.
head_ref() {
  if git --git-dir="$origin" rev-parse -q --verify "refs/pull/$PR_NUMBER/head" >/dev/null; then
    echo "refs/pull/$PR_NUMBER/head"
  else
    echo "refs/heads/$PR_HEAD"
  fi
}

merged_prs() { if [[ -f "$merged" ]]; then cat "$merged"; else echo '[]'; fi; }

# The merged pull request a selector names, or nothing.
merged_doc() {
  local sel="${1#\#}"
  sel="${sel##*/pull/}"
  [[ "$sel" =~ ^[0-9]+$ ]] || return 0
  merged_prs | jq -c --argjson n "$sel" '.[] | select(.number == $n)'
}

# The extra pull requests' documents; with a head branch, only that branch's.
extra_docs() {
  local n h t
  while IFS=$'\t' read -r n h t; do
    [[ -z "$1" || "$1" == "$h" ]] || continue
    PR_NUMBER="$n" PR_HEAD="$h" PR_TITLE="$t" pr_doc
  done <"$extra"
}

pr_doc() {
  local head_oid base_oid mss=CLEAN doc commits files
  head_oid=$(git --git-dir="$origin" rev-parse "$(head_ref)")
  base_oid=$(git --git-dir="$origin" rev-parse "refs/heads/$PR_BASE")
  # GitHub never reads CLEAN with a failing check: a non-required one makes it UNSTABLE.
  jq -e 'any(.[]; .bucket == "fail")' "$forge/checks" >/dev/null && mss=UNSTABLE
  git --git-dir="$origin" merge-base --is-ancestor "$base_oid" "$head_oid" || mss=BEHIND
  commits=$(git --git-dir="$origin" log --reverse --format='%H%x09%s' "$base_oid..$head_oid" |
    jq -Rsc 'split("\n") | map(select(length > 0) | split("\t") | {oid: .[0], messageHeadline: .[1]})')
  files=$(git --git-dir="$origin" diff --numstat "$base_oid...$head_oid" |
    jq -Rsc 'split("\n") | map(select(length > 0) | split("\t")
      | {path: .[2], additions: (.[0] | tonumber? // 0), deletions: (.[1] | tonumber? // 0)})')
  doc=$(jq -n --arg n "$PR_NUMBER" --arg head "$PR_HEAD" --arg base "$PR_BASE" --arg oid "$head_oid" \
    --arg title "$PR_TITLE" --argjson draft "$(cat "$forge/draft")" --arg mss "$mss" \
    --argjson commits "$commits" --argjson files "$files" \
    --argjson checks "$(jq -c 'map({name, status: "COMPLETED", conclusion: (if .bucket == "fail" then "FAILURE" else "SUCCESS" end), detailsUrl: .link})' "$forge/checks")" '{
      number: ($n | tonumber), title: $title, body: "", state: "OPEN", isDraft: $draft,
      headRefName: $head, headRefOid: $oid, baseRefName: $base,
      url: ("https://github.com/eval-fixture/app/pull/" + $n),
      author: {login: "eval-fixture"}, isCrossRepository: false,
      headRepository: {name: "app"}, headRepositoryOwner: {login: "eval-fixture"},
      mergeable: "MERGEABLE", mergeStateStatus: $mss, reviewDecision: "",
      statusCheckRollup: $checks, reviews: [], comments: [], labels: [], commits: $commits, files: $files
    }')
  if [[ -f "$overlay" && "$PR_NUMBER" == "$primary" ]]; then
    jq --slurpfile o "$overlay" '. * $o[0]' <<<"$doc"
  else
    printf '%s\n' "$doc"
  fi
}

# The pull request as REST serves it. No native stack: GitHub sets `stack` only on a stack member.
rest_pull() {
  local count
  count=$(git --git-dir="$origin" rev-list --count "refs/heads/$PR_BASE..$(head_ref)")
  pr_doc | jq --argjson commits "$count" '{
    number, title, draft: .isDraft, state: "open",
    head: {ref: .headRefName, sha: .headRefOid, repo: {full_name: (.headRepositoryOwner.login + "/" + .headRepository.name)}},
    base: {ref: .baseRefName}, user: {login: .author.login},
    mergeable: (.mergeable == "MERGEABLE"), mergeable_state: (.mergeStateStatus | ascii_downcase),
    commits: $commits, stack: null
  }'
}

# The pull request's commits as REST lists them, each by the pull request's author.
rest_commits() {
  local author
  author=$(pr_doc | jq -r .author.login)
  git --git-dir="$origin" rev-list --reverse --parents "refs/heads/$PR_BASE..$(head_ref)" |
    jq -Rsc --arg author "$author" 'split("\n") | map(select(length > 0) | split(" ")
      | {sha: .[0], parents: (.[1:] | map({sha: .})), author: {login: $author}})'
}

# Append one line to the call record a grader reads: the command, the PR number and the arguments.
record() {
  local what="$1"
  shift
  recorded=1
  jq -nc --arg c "$what" --arg pr "$PR_NUMBER" '{command: $c, pr: ($pr | tonumber), args: $ARGS.positional}' \
    --args -- "$@" >>"$forge/calls.jsonl"
}

recorded=0 argv=("$@")
trap 'rc=$?; ((rc != 0 || recorded)) || record read "${argv[@]+"${argv[@]}"}" 2>/dev/null; exit "$rc"' EXIT

cmd="${1:-}" sub="${2:-}"
case "$cmd $sub" in
  "pr view")
    shift 2
    parse "$@"
    pr_matches "${args[0]:-}" || {
      doc=$(merged_doc "${args[0]:-}")
      [[ -n "$doc" ]] && {
        emit "$doc"
        exit 0
      }
      echo "no pull requests found for branch \"${args[0]:-$(git branch --show-current)}\"" >&2
      exit 1
    }
    if [[ -z "$json" && -z "$jq_expr" ]]; then
      pr_doc | jq -r '"\(.title) #\(.number)\n\(if .isDraft then "Draft" else "Open" end) • \(.headRefName) into \(.baseRefName)\n\(.url)"'
    else
      emit "$(pr_doc)"
    fi
    ;;
  "pr list")
    shift 2
    parse "$@"
    doc=$(
      if [[ -z "$base_filter" || "$base_filter" == "$PR_BASE" ]]; then
        if [[ "$state_filter" != merged ]]; then
          if [[ -f "$forge/created" && (-z "$head" || "$head" == "$PR_HEAD") ]]; then pr_doc; fi
          extra_docs "$head"
        fi
        if [[ -z "$head" && ("$state_filter" == merged || "$state_filter" == all) ]]; then merged_prs | jq -c '.[]'; fi
      fi
    )
    doc=$(jq -sc . <<<"$doc")
    # Only the `<text> in:body` search the reassess same-issue read makes is applied; any other is ignored.
    if [[ "$search" == *" in:body" ]]; then
      doc=$(jq -c --arg term "${search% in:body}" 'map(select((.body // "") | contains($term)))' <<<"$doc")
    fi
    if [[ -n "$json" ]]; then
      json_list="$json"
      json=""
      doc=$(jq -c --arg f "$json_list" 'map(. as $d | reduce ($f | split(",")[]) as $k ({}; .[$k] = $d[$k]))' <<<"$doc")
    fi
    emit "$doc"
    ;;
  "pr diff")
    shift 2
    parse "$@"
    if ! pr_matches "${args[0]:-}"; then
      oid=$(merged_doc "${args[0]:-}" | jq -r .mergeCommit.oid)
      [[ -n "$oid" ]] || refuse pr diff "$@"
      if ((name_only)); then flags=(--name-only); else flags=(); fi
      git --git-dir="$origin" diff "${flags[@]+"${flags[@]}"}" "$oid^" "$oid"
      exit
    fi
    if ((name_only)); then
      git --git-dir="$origin" diff --name-only "refs/heads/$PR_BASE...$(head_ref)"
    else
      git --git-dir="$origin" diff "refs/heads/$PR_BASE...$(head_ref)"
    fi
    ;;
  "pr create")
    shift 2
    [[ -f "$forge/created" ]] && {
      echo "a pull request for branch \"$PR_HEAD\" into branch \"$PR_BASE\" already exists:" >&2
      echo "https://github.com/eval-fixture/app/pull/$PR_NUMBER" >&2
      exit 1
    }
    create_args=("$@")
    is_draft=false new_head="" new_base="$PR_BASE" title="" body_file=""
    while (($#)); do
      case "$1" in
        -d | --draft) is_draft=true ;;
        -H | --head)
          new_head="$2"
          shift
          ;;
        --head=*) new_head="${1#--head=}" ;;
        -B | --base)
          new_base="$2"
          shift
          ;;
        --base=*) new_base="${1#--base=}" ;;
        -t | --title)
          title="$2"
          shift
          ;;
        --title=*) title="${1#--title=}" ;;
        -F | --body-file)
          body_file="$2"
          shift
          ;;
        --body-file=*) body_file="${1#--body-file=}" ;;
        -b | --body)
          printf '%s' "$2" >"$forge/pr-body.md"
          shift
          ;;
        -R | --repo | -r | --reviewer | -a | --assignee | -l | --label | -m | --milestone | -p | --project) shift ;;
        *) ;;
      esac
      shift
    done
    new_head="${new_head:-$(git branch --show-current)}"
    [[ "$new_head" == "$PR_HEAD" && "$new_base" == "$PR_BASE" ]] || refuse pr create --head "$new_head" --base "$new_base"
    [[ -z "$body_file" ]] || cp -- "$body_file" "$forge/pr-body.md" || exit 1
    [[ -n "$title" ]] || title="$PR_TITLE"
    printf 'PR_NUMBER=%q\nPR_HEAD=%q\nPR_BASE=%q\nPR_TITLE=%q\n' "$PR_NUMBER" "$PR_HEAD" "$PR_BASE" "$title" >"$state"
    echo "$is_draft" >"$forge/draft"
    : >"$forge/created"
    record "pr create" "${create_args[@]}"
    echo "https://github.com/eval-fixture/app/pull/$PR_NUMBER"
    ;;
  "issue view")
    shift 2
    parse "$@"
    n="${args[0]:-}"
    n="${n#\#}"
    n="${n##*/issues/}"
    [[ "$n" =~ ^[0-9]+$ && -f "$forge/issues/$n.json" ]] || {
      echo "GraphQL: Could not resolve to an issue or pull request with the number of $n. (repository.issue)" >&2
      exit 1
    }
    emit "$(cat "$forge/issues/$n.json")"
    ;;
  "pr ready")
    shift 2
    parse "$@"
    pr_matches "${args[0]:-}" || refuse pr ready "$@"
    if [[ "$(cat "$forge/draft")" == true ]]; then
      echo false >"$forge/draft"
      echo "✓ Pull request eval-fixture/app#$PR_NUMBER is marked as \"ready for review\""
    else
      echo "! Pull request eval-fixture/app#$PR_NUMBER is already \"ready for review\""
    fi
    ;;
  "pr checks")
    shift 2
    parse "$@"
    pr_matches "${args[0]:-}" || refuse pr checks "$@"
    if [[ "$(jq length "$forge/checks")" == 0 ]]; then
      echo "no checks reported on the '$PR_HEAD' branch" >&2
      exit 1
    fi
    # gh exits 0 on the --json path whatever the checks say; the table exits 8 while checks pend and
    # 1 when one failed, and the stand-in has only the failed case.
    if [[ -n "$json" ]]; then
      doc=$(jq -c --arg f "$json" 'map(. as $d | reduce ($f | split(",")[]) as $k ({}; .[$k] = $d[$k]))' "$forge/checks")
      if [[ -n "$jq_expr" ]]; then jq -r "$jq_expr" <<<"$doc"; else jq . <<<"$doc"; fi
    else
      jq -r '.[] | [.name, .bucket, "1m0s", .link] | @tsv' "$forge/checks"
      jq -e 'any(.[]; .bucket == "fail") | not' "$forge/checks" >/dev/null
    fi
    ;;
  "repo view")
    shift 2
    parse "$@"
    emit '{"name":"app","nameWithOwner":"eval-fixture/app","owner":{"login":"eval-fixture"},"defaultBranchRef":{"name":"main"},"visibility":"PRIVATE","url":"https://github.com/eval-fixture/app","squashMergeAllowed":true,"mergeCommitAllowed":false,"rebaseMergeAllowed":false}'
    ;;
  "auth status")
    echo "github.com"
    echo "  ✓ Logged in to github.com account eval-fixture (eval fixture forge)"
    ;;
  "api --hostname")
    # The acting-login read push-branch.sh makes to tell a lane from an operator; an operator login.
    [[ "$*" == *"viewer{login}"* ]] || refuse "$@"
    echo "eval-fixture"
    ;;
  "pr merge")
    shift 2
    parse "$@"
    pr_matches "${args[0]:-}" || refuse pr merge "$@"
    # Recorded for a grader; no ref moves, in the fixture or outside it.
    record "pr merge" "$@"
    echo "✓ Merged pull request eval-fixture/app#$PR_NUMBER"
    ;;
  "pr review")
    shift 2
    parse "$@"
    pr_matches "${args[0]:-}" || refuse pr review "$@"
    record "pr review" "$@"
    echo "✓ Reviewed pull request eval-fixture/app#$PR_NUMBER"
    ;;
  "pr comment")
    shift 2
    parse "$@"
    pr_matches "${args[0]:-}" || refuse pr comment "$@"
    record "pr comment" "$@"
    while (($#)); do
      case "$1" in
        -F | --body-file) cat -- "${2:-/dev/null}" >"$forge/comment-body.md" ;;
        --body-file=*) cat -- "${1#--body-file=}" >"$forge/comment-body.md" ;;
        -b | --body) printf '%s\n' "${2:-}" >"$forge/comment-body.md" ;;
        --body=*) printf '%s\n' "${1#--body=}" >"$forge/comment-body.md" ;;
        *) ;;
      esac
      shift
    done
    echo "https://github.com/eval-fixture/app/pull/$PR_NUMBER#issuecomment-1"
    ;;
  "pr edit")
    shift 2
    parse "$@"
    pr_matches "${args[0]:-}" || refuse pr edit "$@"
    record "pr edit" "$@"
    for l in "${add_labels[@]+"${add_labels[@]}"}"; do
      [[ -f "$overlay" ]] || echo '{}' >"$overlay"
      jq -c --arg l "$l" '.labels = ((.labels // []) + [{name: $l}])' "$overlay" >"$overlay.new" && mv "$overlay.new" "$overlay"
    done
    echo "https://github.com/eval-fixture/app/pull/$PR_NUMBER"
    ;;
  "label list")
    shift 2
    parse "$@"
    json=""
    emit '[{"name":"do-not-merge"}]'
    ;;
  "api graphql")
    shift 2
    # parse skips the -f and -F flags and keeps their key=value values in args.
    parse "$@"
    gql=""
    thread_id=""
    for a in "${args[@]}"; do
      case "$a" in
        query=*) gql="${a#query=}" ;;
        id=*) thread_id="${a#id=}" ;;
        *) ;;
      esac
    done
    if [[ "$gql" == *resolveReviewThread* ]]; then
      jq -e --arg id "$thread_id" 'any(.[]; .id == $id)' "$forge/threads" >/dev/null || refuse api graphql "$@"
      record "resolve thread" "$thread_id"
      jq -c --arg id "$thread_id" 'map(if .id == $id then .isResolved = true else . end)' "$forge/threads" >"$forge/threads.new"
      mv "$forge/threads.new" "$forge/threads"
      emit '{"data":{"resolveReviewThread":{"thread":{"isResolved":true}}}}'
    elif [[ "$gql" == *reviewThreads* ]]; then
      emit "$(jq -c '{data: {repository: {pullRequest: {reviewThreads: {pageInfo: {hasNextPage: false, endCursor: null}, nodes: .}}}}}' "$forge/threads")"
    elif [[ "$gql" == *isInMergeQueue* ]]; then
      emit '{"data":{"repository":{"pullRequest":{"isInMergeQueue":false}}}}'
    else
      [[ "$gql" != *mutation* ]] || record "api graphql mutation" "$gql"
      refuse api graphql "$@"
    fi
    ;;
  "api user")
    shift 2
    parse "$@"
    emit '{"login":"eval-fixture","type":"User"}'
    ;;
  "search prs")
    shift 2
    parse "$@"
    doc=$(
      pr_doc
      extra_docs ""
    )
    doc=$(jq -sc 'map(. + {repository: {name: "app", nameWithOwner: "eval-fixture/app"}, state: "open"})' <<<"$doc")
    if [[ -n "$json" ]]; then
      json_list="$json"
      json=""
      doc=$(jq -c --arg f "$json_list" 'map(. as $d | reduce ($f | split(",")[]) as $k ({}; .[$k] = $d[$k]))' <<<"$doc")
    fi
    emit "$doc"
    ;;
  "api "*)
    # REST reads: the repository, an issue, its sub-issues and comments, a file at a ref, the commit-to-PR
    # lookup, and the pull request and base facts the branch update signals read. A PATCH of a seeded
    # comment is recorded; any other method but GET, and any other path, is refused.
    # -i prefixes the response with a status line; --slurp wraps a list in one page.
    shift
    path="" method="" include=0 slurp=0 body_field="" fields=0
    while (($#)); do
      case "$1" in
        body=*) body_field="${1#body=}" ;;
        -f | -F | --field | --raw-field | --input | --field=* | --raw-field=* | --input=*) fields=1 ;;
        -X | --method)
          method="$2"
          shift
          ;;
        --method=*) method="${1#--method=}" ;;
        -i | --include) include=1 ;;
        --slurp) slurp=1 ;;
        -q | --jq)
          jq_expr="$2"
          shift
          ;;
        --jq=*) jq_expr="${1#--jq=}" ;;
        -H | --header) shift ;;
        repos/*) path="$1" ;;
        *) ;;
      esac
      shift
    done
    # gh's own default: GET, or POST once a field or body is given.
    if [[ -z "$method" ]]; then if ((fields)); then method=POST; else method=GET; fi; fi
    path="${path/#repos\/\{owner\}\/\{repo\}/repos/eval-fixture/app}"
    ref="$PR_BASE"
    [[ "$path" == *"?ref="* ]] && ref="${path##*\?ref=}"
    path="${path%%\?*}"
    if [[ "$method" == PATCH && "$path" == repos/eval-fixture/app/issues/comments/* ]]; then
      id="${path##*/}"
      if [[ ! -f "$comments" ]] || ! jq -e --argjson id "$id" 'any(.[]; .id == $id)' "$comments" >/dev/null; then
        refuse api --method PATCH "$path"
      fi
      if [[ "$body_field" == @* ]]; then body_text=$(cat -- "${body_field#@}") || exit 1; else body_text="$body_field"; fi
      record "comment edit" "$id" "$body_text"
      emit "$(jq -nc --argjson id "$id" '{id: $id}')"
      exit 0
    fi
    if [[ "$method" != GET ]]; then
      record "api $method" "$path"
      refuse api --method "$method" "$path"
    fi
    not_found() {
      ((include)) && printf 'HTTP/2.0 404 Not Found\r\nContent-Type: application/json\r\n\r\n{"message":"Not Found"}\n'
      echo "gh: Not Found (HTTP 404)" >&2
      exit 1
    }
    # One list as gh prints it: the bare array, or under --slurp an array of pages.
    page() { if ((slurp)); then emit "[$1]"; else emit "$1"; fi; }
    # The pull request number in a path, made the one later reads serve; a pull request the forge
    # does not hold is a 404.
    pull_of() {
      local n="${path#repos/eval-fixture/app/pulls/}"
      n="${n%%/*}"
      if [[ ! "$n" =~ ^[0-9]+$ ]] || ! pr_matches "$n"; then not_found; fi
    }
    case "$path" in
      repos/eval-fixture/app)
        emit "$(jq -n --arg base "$PR_BASE" '{name: "app", full_name: "eval-fixture/app", owner: {login: "eval-fixture"}, default_branch: $base, private: true, html_url: "https://github.com/eval-fixture/app"}')"
        ;;
      repos/eval-fixture/app/issues/*/comments)
        if [[ -f "$comments" ]]; then page "$(cat "$comments")"; else page '[]'; fi
        ;;
      repos/eval-fixture/app/commits/*/pulls)
        sha="${path#repos/eval-fixture/app/commits/}"
        sha="${sha%/pulls}"
        page "$(merged_prs | jq -c --arg sha "$sha" '[.[] | select(any(.commit_shas[]; . as $c | ($c | startswith($sha)) or ($sha | startswith($c))))
          | {number, title, body, state: "closed", merged_at: .mergedAt, base: {ref: .baseRefName}, html_url: .url}]')"
        ;;
      repos/eval-fixture/app/issues/*/sub_issues)
        n="${path#repos/eval-fixture/app/issues/}"
        n="${n%/sub_issues}"
        [[ -f "$forge/issues/$n.json" ]] || not_found
        emit "$(jq -c '[.subIssues.nodes[]? | {number, title, state: (.state | ascii_downcase)}]' "$forge/issues/$n.json")"
        ;;
      repos/eval-fixture/app/issues/*)
        n="${path#repos/eval-fixture/app/issues/}"
        [[ "$n" =~ ^[0-9]+$ && -f "$forge/issues/$n.json" ]] || not_found
