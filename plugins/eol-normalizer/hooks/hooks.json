{
  "description": "Normalizes the line endings of the files a batch of tool calls wrote, once per batch, so a checkout's own EOL policy holds in the working tree.",
  "hooks": {
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--run-if-unset-or-true",
              "EOL_NORMALIZER_ENABLED",
              "--skip-unless-stdin-contains",
              "file_path",
              "${CLAUDE_PLUGIN_ROOT}/hooks/eol-normalizer.sh"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
