{
  "requires": [
    {
      "id": "gh",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:generate"
      ],
      "detect": {
        "any": [
          "gh"
        ]
      },
      "degrade": "Without gh, a generated wizard's GitHub steps report SKIPPED and print the manual instructions instead.",
      "install": {
        "docs": "https://cli.github.com/",
        "brew": "gh",
        "winget": "GitHub.cli",
        "apt": "gh"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "pwsh",
      "kind": "cli",
      "need": "required",
      "for": [
        "skill:unattended"
      ],
      "detect": {
        "any": [
          "pwsh"
        ],
        "version": {
          "args": [
            "--version"
          ],
          "pattern": "PowerShell ([0-9.]+)",
          "min": "7.0"
        }
      },
      "degrade": "Without PowerShell 7, /wizard:unattended cannot dry-run the script it writes, and Windows PowerShell 5.1 does not qualify.",
      "install": {
        "docs": "https://learn.microsoft.com/powershell/scripting/install/installing-powershell",
        "brew": "powershell",
        "winget": "Microsoft.PowerShell"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "node",
      "kind": "cli",
      "need": "optional",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the prerequisites checker cannot run, so a missing tool above goes unreported; the plugin's own skills are unaffected.",
      "install": {
        "docs": "https://nodejs.org/en/download",
        "brew": "node",
        "winget": "OpenJS.NodeJS.LTS",
        "apt": "nodejs"
      },
      "check": "/harness-ops:prerequisites"
    }
  ]
}
