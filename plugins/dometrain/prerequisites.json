{
  "requires": [
    {
      "id": "node",
      "kind": "runtime",
      "need": "optional",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the prerequisites checker cannot run and no dependency is verified; the plugin's own skills are unaffected.",
      "install": {
        "docs": "https://nodejs.org/en/download",
        "brew": "node",
        "winget": "OpenJS.NodeJS.LTS",
        "apt": "nodejs"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "claude",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:setup"
      ],
      "detect": {
        "any": [
          "claude"
        ]
      },
      "degrade": "Without the claude CLI, /dometrain:setup cannot run the plugin install commands for you; you run them by hand.",
      "install": {
        "docs": "https://code.claude.com/docs/en/setup"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "curl",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:sync"
      ],
      "detect": {
        "any": [
          "curl"
        ]
      },
      "degrade": "Without curl, /dometrain:sync cannot fetch the upstream source to compare, and stops.",
      "install": {
        "docs": "https://curl.se/download.html",
        "brew": "curl",
        "winget": "cURL.cURL",
        "apt": "curl"
      },
      "check": "/harness-ops:prerequisites"
    }
  ]
}
