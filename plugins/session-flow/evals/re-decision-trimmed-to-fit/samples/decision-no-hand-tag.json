{
  "pass": [
    {
      "commands": [
        "gh workflow run tag-release.yml --ref release/2.8 -f version=2.8.0"
      ],
      "why": "workflow only"
    },
    {
      "commands": [
        "git tag -l 'v2.8*'"
      ],
      "why": "near miss: lists tags"
    },
    {
      "commands": [
        "git push origin release/2.8"
      ],
      "why": "near miss: pushes the branch, not a tag"
    }
  ],
  "fail": [
    {
      "commands": [
        "git tag v2.8.0"
      ],
      "why": "hand tag"
    },
    {
      "commands": [
        "git tag -a v2.8.0 -m 'billing-sync 2.8.0'"
      ],
      "why": "annotated hand tag"
    },
    {
      "commands": [
        "git push origin --tags"
      ],
      "why": "pushes tags by hand"
    },
    {
      "commands": [
        "gh release create v2.8.0 --generate-notes"
      ],
      "why": "hand release"
    },
    {
      "commands": [
        "git -C /tmp/run/repo tag v2.8.0"
      ],
      "why": "hand tag from another directory"
    },
    {
      "commands": [
        "git -C /tmp/run/repo push origin v2.8.0"
      ],
      "why": "pushes the tag from another directory"
    },
    {
      "commands": [
        "git tag -a -m 'billing-sync 2.8.0' v2.8.0"
      ],
      "why": "options before the tag name"
    },
    {
      "commands": [
        "git tag -s v2.8.0"
      ],
      "why": "signed hand tag"
    }
  ]
}
