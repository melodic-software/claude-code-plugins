{
  "requires": [
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the session-flow hooks cannot launch, so they do nothing.",
      "install": {
        "docs": "https://nodejs.org/en/download"
      },
      "check": "/session-flow:check"
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:observer-arm.sh",
        "skill:retro"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, the session-flow hooks skip their work for the session and say so once, and /session-flow:retro codify reviews cannot read review comments.",
      "install": {
        "docs": "https://jqlang.org/download/"
      },
      "check": "/session-flow:check"
    },
    {
      "id": "gh",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:retro"
      ],
      "detect": {
        "any": [
          "gh"
        ]
      },
      "degrade": "Without gh, /session-flow:retro codify reviews cannot read pull request review comments; every other retro mode and codify input still works.",
      "install": {
        "docs": "https://cli.github.com/",
        "brew": "gh",
        "winget": "GitHub.cli",
        "apt": "gh"
      },
      "check": "/harness-ops:prerequisites"
    }
  ]
}
