{
  "schema": "audit-sessions.canaries/v1",
  "validated_against": "2.1.287",
  "verified": "2026-10-02",
  "recheck": "a Claude Code release that changes the transcript format, or a drift run that reports new or vanished keys",
  "basis": "collect.py census over this machine's 104 sessions (2.1.275-2.1.287): each key below is on every record of its population in 2.1.284, 2.1.285 and 2.1.287, except effort (99.8%) and turn_duration (30-47% of system records); invariant:usage_split counted 16 groups, all in subagents, none in 2.1.287",
  "canaries": [
    {"key": "key_path:assistant:message.id", "record_type": "assistant", "feeds": ["tokens.main", "tokens.sub"]},
    {"key": "usage_key:input_tokens", "record_type": "assistant", "feeds": ["tokens.main", "tokens.sub"]},
    {"key": "usage_key:output_tokens", "record_type": "assistant", "feeds": ["tokens.main", "tokens.sub"]},
    {"key": "usage_key:cache_read_input_tokens", "record_type": "assistant", "feeds": ["tokens.main", "tokens.sub"]},
    {"key": "usage_key:cache_creation_input_tokens", "record_type": "assistant", "feeds": ["tokens.main", "tokens.sub"]},
    {"key": "invariant:usage_split", "record_type": "assistant", "expect": "absent", "feeds": ["tokens.main", "tokens.sub"]},
    {"key": "usage_key:cache_creation.ephemeral_5m_input_tokens", "record_type": "assistant", "feeds": ["cache.write_5m_share"]},
    {"key": "usage_key:cache_creation.ephemeral_1h_input_tokens", "record_type": "assistant", "feeds": ["cache.write_5m_share"]},
    {"key": "key_path:assistant:message.diagnostics", "record_type": "assistant", "feeds": ["cache.missed_input_tokens"]},
    {"key": "system_subtype:turn_duration", "record_type": "system", "feeds": ["time.active_s"]},
    {"key": "key_path:system:durationMs", "record_type": "system", "population": "system_subtype:turn_duration", "feeds": ["time.active_s"]},
    {"key": "key_path:system:hookInfos[].durationMs", "record_type": "system", "population": "system_subtype:stop_hook_summary", "feeds": ["hooks.stop_ms"]},
    {"key": "key_path:user:message.content", "record_type": "user", "feeds": ["human.turns", "tools.interrupts", "context.clear_commands"]}
  ]
}
