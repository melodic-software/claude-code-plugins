{
  "description": "Arms the session observer at session start.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/observer-arm.sh",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Arming session observer..."
          }
        ]
      }
    ]
  }
}
