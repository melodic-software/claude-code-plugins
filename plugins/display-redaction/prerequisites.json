{
  "requires": [
    {
      "id": "claude",
      "kind": "cli",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "claude"
        ],
        "version": {
          "args": [
            "--version"
          ],
          "pattern": "^([0-9.]+)",
          "min": "2.1.287"
        }
      },
      "degrade": "Claude Code older than 2.1.287 is unsupported: the module that masks email addresses and secret-shaped text where Claude Code draws it does not load there, so nothing on screen is masked.",
      "install": {
        "docs": "https://code.claude.com/docs/en/setup#update-claude-code"
      },
      "check": "/harness-ops:prerequisites"
    }
  ]
}
