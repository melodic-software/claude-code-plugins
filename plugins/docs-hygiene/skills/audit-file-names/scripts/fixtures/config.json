{
  "schema": 1,
  "_comment": "The fixture tree's configuration. Deliberately not this marketplace's defaults: the suites prove the scripts read the document rather than a hardcoded value.",
  "file_names": {
    "roots": ["docs"],
    "rule": "lower-kebab",
    "regex": "^[a-z0-9]+([.-][a-z0-9]+)*\\.[a-z0-9]+$",
    "exempt_basenames": ["README.md", "CHANGELOG.md", "INDEX.md"],
    "exempt_paths": ["docs/topics/**"],
    "exempt_extensions": ["py", "sh", "mjs", "js", "ps1"],
    "tiers": [
      {
        "name": "historical",
        "paths": ["docs/adr/**"],
        "forms": "links-and-paths"
      },
      {
        "name": "released",
        "paths": ["**/CHANGELOG.md"],
        "forms": "none"
      }
    ],
    "sweep_exclude": ["docs/topics/**"],
    "sweep_exclude_sites": [],
    "generated": [
      {
        "path": "build/out.json",
        "regenerate": "bash tools/gen.sh .",
        "churn": ["generated_on"]
      }
    ],
    "redirect_map": null
  }
}
