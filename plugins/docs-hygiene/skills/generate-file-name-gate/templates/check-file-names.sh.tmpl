@@SHEBANG@@
# Check that every tracked file under @@ROOTS_HUMAN@@ carries a @@RULE@@ basename.
#
#   @@SCRIPT_PATH@@          discover: list every offender
#   @@SCRIPT_PATH@@ --check  same, explicit form matching the sibling gates
#                            (exit 1 on any offender)
#
# GENERATED by /docs-hygiene:generate-file-name-gate from this repository's
# docs-hygiene configuration. Re-emit it rather than editing it here: that
# configuration is what the audit and realign skills read, and a hand edit in
# this file drifts from them silently.
#
# The rule: a basename matches `@@REGEX@@`. Exempt from it:
#
#   - the basenames @@EXEMPT_BASENAMES_HUMAN@@, conventional spellings tooling
#     and forges look for exactly
#   - the paths @@EXEMPT_PATHS_HUMAN@@
#   - the extensions @@EXEMPT_EXTENSIONS_HUMAN@@, whose casing belongs to the
#     language rather than to this rule
#
# Independently of the regex, no two tracked paths under the roots may differ
# only by case: a case-insensitive checkout (Windows, macOS) writes the second
# over the first.
#
# WHY A GATE AND NOT A RULE. A path-scoped rule file, where one exists, loads
# when a covered file is READ, never when one is created, so a rule alone
# cannot catch a new file. This script can.
#
# Output follows the check-script contract: one `path: reason` finding per
# offender on stderr, the clean-run statement on stdout. Exit: 0 clean, 1 any
# offender, 2 environment or usage (git missing, repo root unresolved, bad
# argument).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" || exit 2
cd "$SCRIPT_DIR/@@ROOT_HOP@@" || exit 2

case "${1:-}" in
'' | --check) ;;
*)
  printf 'usage: %s [--check]\n' "${0##*/}" >&2
  exit 2
  ;;
esac

if ! command -v git >/dev/null 2>&1; then
  printf '@@SCRIPT_STEM@@: git is required to list the tracked files\n' >&2
  exit 2
fi
if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
  printf '@@SCRIPT_STEM@@: not inside a git repository, nothing inspected\n' >&2
  exit 2
fi

NAME_RE='@@REGEX_SQ@@'
# The rule's name and the roots live in variables rather than inside the printf
# FORMAT strings below: a `%` in either would otherwise be read as a conversion
# and eat the arguments that follow it.
RULE_NAME='@@RULE_SQ@@'
ROOTS_PLAIN='@@ROOTS_PLAIN@@'
ROOTS=(@@ROOTS_ARRAY@@)
EXEMPT_BASENAMES=(@@EXEMPT_BASENAMES_ARRAY@@)
EXEMPT_PATHS=(@@EXEMPT_PATHS_ARRAY@@)
EXEMPT_EXTENSIONS=(@@EXEMPT_EXTENSIONS_ARRAY@@)
offenders=()

# One pass for the basename rule. Exemptions are checked in the order the
# header lists them; the regex only sees what nothing exempted. Each is an
# inline loop rather than a function: under `set -e`, a function called in a
# condition silently disables errexit for its whole body, and the three tests
# read the same way in sequence anyway.
while IFS= read -r -d '' path; do
  skip=""
  for _pat in ${EXEMPT_PATHS+"${EXEMPT_PATHS[@]}"}; do
    # Unquoted on purpose: the entry is a glob, and quoting it would compare
    # the pattern as a literal string.
    # shellcheck disable=SC2053
    if [[ "$path" == $_pat ]]; then
      skip=1
      break
    fi
  done
  [[ -n "$skip" ]] && continue
  base="${path##*/}"
  for _name in ${EXEMPT_BASENAMES+"${EXEMPT_BASENAMES[@]}"}; do
    [[ "$base" == "$_name" ]] && skip=1 && break
  done
  [[ -n "$skip" ]] && continue
  ext="${base##*.}"
  for _ext in ${EXEMPT_EXTENSIONS+"${EXEMPT_EXTENSIONS[@]}"}; do
    [[ "$ext" == "$_ext" ]] && skip=1 && break
  done
  [[ -n "$skip" ]] && continue
  if [[ ! "$base" =~ $NAME_RE ]]; then
    offenders+=("$path: basename is not $RULE_NAME (rule: $NAME_RE)")
  fi
done < <(git ls-files -z -- "${ROOTS[@]}")

# One pass for case collisions, over EVERY tracked path under the roots (exempt
# names included: `README.md` beside `readme.md` still collides). Lower-casing
# each path and looking for duplicates finds every pair; each member of a
# colliding group is reported against the group's folded form. The fold goes
# through `tr`, never `${path,,}`: that expansion is Bash 4+, and the checkouts
# this rule protects include stock macOS Bash 3.2.
while IFS= read -r folded; do
  [[ -n "$folded" ]] || continue
  while IFS= read -r -d '' path; do
    if [[ "$(printf '%s' "$path" | tr '[:upper:]' '[:lower:]')" == "$folded" ]]; then
      offenders+=("$path: differs only by case from another tracked path ($folded)")
    fi
  done < <(git ls-files -z -- "${ROOTS[@]}")
done < <(git ls-files -- "${ROOTS[@]}" | tr '[:upper:]' '[:lower:]' | sort | uniq -d)

if ((${#offenders[@]} == 0)); then
  printf '@@SCRIPT_STEM@@: every tracked file under %s is %s.\n' "$ROOTS_PLAIN" "$RULE_NAME"
  exit 0
fi

printf '%s\n' "${offenders[@]}" | sort -u >&2
printf '@@SCRIPT_STEM@@: %d offender(s); rename to %s (see the header of %s).\n' \
  "${#offenders[@]}" "$RULE_NAME" "@@SCRIPT_PATH@@" >&2
exit 1
