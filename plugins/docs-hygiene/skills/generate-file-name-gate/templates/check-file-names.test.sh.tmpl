@@SHEBANG@@
# Self-contained tests for @@SCRIPT_PATH@@, driven against throwaway git
# repositories built in a temp directory.
#
# GENERATED by /docs-hygiene:generate-file-name-gate alongside the checker it
# tests. Re-emit both together: a suite that outlives its checker's rule is a
# green bar over a gate that no longer means what it says.
#
# Fixture git isolation: an inherited GIT_DIR/GIT_WORK_TREE/GIT_CONFIG would
# redirect `git init` / `git config` into the caller's repository.
set -uo pipefail
unset GIT_DIR GIT_WORK_TREE GIT_CONFIG

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SUT="$SCRIPT_DIR/@@SCRIPT_NAME@@"
TEST_TMPDIR="$(mktemp -d)"
trap 'rm -rf "$TEST_TMPDIR"' EXIT

PRIMARY_ROOT='@@PRIMARY_ROOT@@'
# The probe names are chosen at emission against this repository's own rule, not
# hardcoded here: `conforming-name.md` only conforms under a rule that allows a
# hyphen, and a suite that assumed one would fail on its own clean fixture.
PROBE_OK='@@PROBE_OK@@'
PROBE_BAD=(@@PROBE_BAD_ARRAY@@)
FAILED=0
CASES=0

pass() {
  CASES=$((CASES + 1))
  printf 'PASS: %s\n' "$1"
}

fail() {
  CASES=$((CASES + 1))
  FAILED=$((FAILED + 1))
  printf 'FAIL: %s\n  expected: %s\n  actual:   %s\n' "$1" "$2" "$3" >&2
}

assert_eq() {
  if [[ "$2" == "$3" ]]; then pass "$1"; else fail "$1" "$2" "$3"; fi
}

assert_contains() {
  case "$2" in
  *"$3"*) pass "$1" ;;
  *) fail "$1" "contains: $3" "$2" ;;
  esac
}

# new_repo : a tracked tree carrying one conforming file under the primary root
new_repo() {
  d="$TEST_TMPDIR/r-$CASES-$RANDOM"
  mkdir -p "$d/$PRIMARY_ROOT"
  printf '# ok\n' >"$d/$PRIMARY_ROOT/$PROBE_OK"
  git init -q "$d"
  git -C "$d" config user.email fixture@example.invalid
  git -C "$d" config user.name "Fixture"
  git -C "$d" config commit.gpgsign false
  git -C "$d" config core.autocrlf false
  # The checker resolves the repository from its own location, so it is copied
  # into the tree at the path it was emitted to.
  mkdir -p "$d/$(dirname "@@SCRIPT_PATH@@")"
  cp "$SUT" "$d/@@SCRIPT_PATH@@"
  git -C "$d" add -A >/dev/null
  git -C "$d" commit -qm "fixture" >/dev/null
  printf '%s' "$d"
}

# seed <repo> <path> : track a file at <path> and return the repo
seed() {
  mkdir -p "$(dirname "$1/$2")"
  printf '# seeded\n' >"$1/$2"
  git -C "$1" add -A >/dev/null 2>&1
}

# run_gate <repo> : run the emitted checker inside <repo>, capturing the streams
# separately. Prints "<rc>|<stdout>|<stderr>".
run_gate() {
  out="$(bash "$1/@@SCRIPT_PATH@@" --check 2>"$TEST_TMPDIR/err")"
  rc=$?
  printf '%s|%s|%s' "$rc" "$out" "$(cat "$TEST_TMPDIR/err")"
}

# --- a clean tree ------------------------------------------------------------

r="$(new_repo)"
res="$(run_gate "$r")"
assert_eq "a conforming tree exits 0" "0" "${res%%|*}"
rest="${res#*|}"
assert_contains "the clean-run statement goes to stdout" "${rest%%|*}" "every tracked file under"
assert_eq "a clean run writes nothing to stderr" "" "${rest#*|}"

# --- the rule ----------------------------------------------------------------

for bad in "${PROBE_BAD[@]}"; do
  r="$(new_repo)"
  seed "$r" "$PRIMARY_ROOT/$bad"
  res="$(run_gate "$r")"
  assert_eq "$bad is an offender" "1" "${res%%|*}"
  rest="${res#*|}"
  assert_eq "an offending run writes nothing to stdout" "" "${rest%%|*}"
  assert_contains "the finding names the path" "${rest#*|}" "$PRIMARY_ROOT/$bad"
  assert_contains "the finding gives the rule" "${rest#*|}" "rule: "
done

# --- case collisions ---------------------------------------------------------

r="$(new_repo)"
seed "$r" "$PRIMARY_ROOT/$PROBE_OK"
seed "$r" "$PRIMARY_ROOT/$(printf '%s' "$PROBE_OK" | tr '[:lower:]' '[:upper:]')"
res="$(run_gate "$r")"
assert_eq "two paths differing only by case are offenders" "1" "${res%%|*}"
assert_contains "the collision is reported as such" "${res#*|}" "differs only by case"

# --- exemptions --------------------------------------------------------------
#
# Each exemption is seeded with a name the rule WOULD reject, so a case that
# passes proves the exemption carried it rather than the rule accepting it.

EXEMPT_BASENAMES=(@@EXEMPT_BASENAMES_ARRAY@@)
EXEMPT_EXTENSIONS=(@@EXEMPT_EXTENSIONS_ARRAY@@)
EXEMPT_PATH_SEEDS=(@@EXEMPT_PATH_SEEDS_ARRAY@@)

for name in ${EXEMPT_BASENAMES+"${EXEMPT_BASENAMES[@]}"}; do
  r="$(new_repo)"
  seed "$r" "$PRIMARY_ROOT/$name"
  res="$(run_gate "$r")"
  assert_eq "the exempt basename $name is accepted" "0" "${res%%|*}"
done

for ext in ${EXEMPT_EXTENSIONS+"${EXEMPT_EXTENSIONS[@]}"}; do
  r="$(new_repo)"
  seed "$r" "$PRIMARY_ROOT/Exempt_By-EXTENSION.$ext"
  res="$(run_gate "$r")"
  assert_eq "the exempt extension .$ext is accepted" "0" "${res%%|*}"
done

for seedpath in ${EXEMPT_PATH_SEEDS+"${EXEMPT_PATH_SEEDS[@]}"}; do
  r="$(new_repo)"
  seed "$r" "$seedpath"
  res="$(run_gate "$r")"
  assert_eq "the exempt path $seedpath is accepted" "0" "${res%%|*}"
done

# --- the environment contract ------------------------------------------------
#
# BASH is resolved before PATH is replaced: a stubbed PATH would otherwise hide
# the interpreter as well as git, and the case would prove nothing.

BASH_BIN="$(command -v bash)"
r="$(new_repo)"
stub="$TEST_TMPDIR/nogit-$RANDOM"
mkdir -p "$stub"
out="$(PATH="$stub" "$BASH_BIN" "$r/@@SCRIPT_PATH@@" --check 2>&1)"
assert_eq "git missing from PATH exits 2" "2" "$?"
assert_contains "the reason names git" "$out" "git is required"

r="$(new_repo)"
out="$(bash "$r/@@SCRIPT_PATH@@" --nonsense 2>&1)"
assert_eq "an unknown argument exits 2" "2" "$?"
assert_contains "the usage line is printed" "$out" "usage:"

# --- results ------------------------------------------------------------------

printf '\n%d case(s), %d failure(s)\n' "$CASES" "$FAILED"
[[ "$FAILED" -eq 0 ]] || exit 1
