{
  "linter-row-verdict": [
    {
      "use": "table_header_rule"
    },
    {
      "use": "table_verdict_cell",
      "with": {
        "row": "markdownlint-cli2"
      }
    }
  ],
  "liveness-probe": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?markdownlint-cli2(?:\\.(?:exe|cmd))?(?:\\\\\\\"|')?(?![\\w./-])(?:\\s|\\\\\\\\\\\\n)+--help\\b"
  ],
  "no-install": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "install_command"
    }
  ],
  "no-linter-run": [
    {
      "use": "command_position_multishell"
    },
    "(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|=']*/)?markdownlint-cli2(?:\\.(?:exe|cmd))?(?:\\\\\\\"|')?(?![\\w./-])(?!(?:\\s|\\\\\\\\\\\\n)+--help\\b)"
  ],
  "no-apply-step": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "apply_step"
    }
  ],
  "no-plugin-cli-write": [
    {
      "use": "command_position_multishell"
    },
    {
      "use": "plugin_cli_write"
    }
  ],
  "no-config-shell-write": [
    "\"command\":\"(?:(?!<<)(?:'[^']*'|[^\"\\\\']|\\\\.))*?(?:>{1,2}\\s*|\\btee\\s+(?:-a\\s+)?|\\bsed\\s+-i\\S*\\s+(?:'[^']*'|(?!\\\\n)[^\\\"\\\\;&|']|\\\\[^n\\\"])*?)(?:\\\\\\\"|')?(?:[^\\s\\\"\\\\;&|<>']*/)?\\.(?:markdownlint(?:-cli2)?\\.\\w+|gitignore)(?![\\w.-])"
  ]
}
