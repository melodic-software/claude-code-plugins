{
  "remote": {
    "git_url": "https://github.com/melodic-software/claude-code-plugins",
    "ref": "main",
    "config": "plugins/markdown-format/git-hooks/lefthook-remote.yml",
    "aggregate": "lefthook-remote.yml"
  },
  "earlierEntries": [{ "from": "markdown-check", "to": ["format", "lint"] }],
  "ecosystems": ["markdown"],
  "entries": [
    {
      "name": "format",
      "event": "pre-commit",
      "script": "format.sh",
      "tools": ["markdownlint-cli2"],
      "rewrites": true,
      "resolved": true,
      "assets": ["lib/git-hooks/resolve-tool.sh", "git-hooks/adapters.sh", "git-hooks/markdown-gates.sh"]
    },
    {
      "name": "lint",
      "event": "pre-commit",
      "script": "lint.sh",
      "tools": ["markdownlint-cli2"],
      "rewrites": false,
      "resolved": true,
      "assets": ["lib/git-hooks/resolve-tool.sh", "git-hooks/adapters.sh", "git-hooks/markdown-gates.sh"]
    }
  ]
}
