{
  "description": "Rewrites Markdown with markdownlint-cli2 once per batch of tool calls, checks the uncommitted changes when a turn ends; harness-ops reports a missing markdownlint-cli2 or a drifted git-hook entry at session start, from this plugin's prerequisites.json.",
  "hooks": {
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--run-if-unset-or-true",
              "MARKDOWN_FORMAT_ENABLED",
              "--skip-unless-stdin-contains",
              ".md",
              "${CLAUDE_PLUGIN_ROOT}/hooks/markdown-format.sh"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exec-bash.mjs",
              "--run-if-unset-or-true",
              "MARKDOWN_FORMAT_ENABLED",
              "--run-if-unset-or-true",
              "MARKDOWN_FORMAT_END_OF_TURN",
              "${CLAUDE_PLUGIN_ROOT}/hooks/markdown-format.sh",
              "--end-of-turn"
            ],
            "timeout": 30,
            "statusMessage": "Checking Markdown in uncommitted changes..."
          }
        ]
      }
    ]
  }
}
