{
  "session_probe": {
    "run_if_unset_or_true": "MARKDOWN_FORMAT_ENABLED"
  },
  "requires": [
    {
      "id": "markdownlint-cli2",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:markdown-format.sh"
      ],
      "detect": {
        "any": [
          "markdownlint-cli2"
        ],
        "local_bin": [
          "node_modules/.bin/markdownlint-cli2"
        ]
      },
      "when": {
        "config_any": [
          ".markdownlint-cli2.jsonc",
          ".markdownlint-cli2.yaml",
          ".markdownlint-cli2.cjs",
          ".markdownlint-cli2.mjs",
          ".markdownlint.jsonc",
          ".markdownlint.json",
          ".markdownlint.yaml",
          ".markdownlint.yml",
          ".markdownlint.cjs",
          ".markdownlint.mjs"
        ]
      },
      "degrade": "Without markdownlint-cli2, the hook cannot format edited Markdown files.",
      "install": {
        "npm": "npm i -D markdownlint-cli2"
      }
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "required",
      "for": [
        "hook:markdown-format.sh"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, the markdown-format hooks skip their work.",
      "install": {
        "docs": "https://jqlang.org/download/"
      }
    },
    {
      "id": "node",
      "kind": "runtime",
      "need": "required",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the markdown-format hooks cannot launch, so they do nothing.",
      "install": {
        "docs": "https://nodejs.org/en/download"
      }
    }
  ]
}
