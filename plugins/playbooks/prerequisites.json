{
  "requires": [
    {
      "id": "curl",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:boris",
        "skill:skill-authoring",
        "skill:fable-5"
      ],
      "detect": {
        "any": [
          "curl"
        ]
      },
      "degrade": "Without curl, the update scripts cannot fetch the upstream playbook; the vendored copy still loads. fetch-docs.sh records a pointed docs page unread with reason curl-missing, so /playbooks:fable-5 reads it with WebFetch instead.",
      "install": {
        "docs": "https://curl.se/download.html",
        "brew": "curl",
        "winget": "cURL.cURL",
        "apt": "curl"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "jq",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:boris",
        "skill:repo-sweep",
        "skill:fable-5"
      ],
      "detect": {
        "any": [
          "jq"
        ]
      },
      "degrade": "Without jq, the boris update check and the repo-sweep scripts cannot parse their JSON and stop; the playbook text still loads. fetch-docs.sh and docs-cache.sh exit before reading anything, so /playbooks:fable-5 reads a pointed docs page with WebFetch instead.",
      "install": {
        "docs": "https://jqlang.org/download/",
        "brew": "jq",
        "winget": "jqlang.jq",
        "apt": "jq"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "python3",
      "kind": "runtime",
      "need": "optional",
      "for": [
        "skill:fable-5"
      ],
      "detect": {
        "any": [
          "python3",
          "python"
        ],
        "reject_store_alias": true
      },
      "degrade": "Without Python 3, a pointed docs page that serves only HTML cannot be converted and is recorded unread with reason no-python; pages served as markdown read normally.",
      "install": {
        "docs": "https://www.python.org/downloads/",
        "brew": "python",
        "winget": "Python.Python.3.12",
        "apt": "python3"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "gh",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:repo-sweep"
      ],
      "detect": {
        "any": [
          "gh"
        ]
      },
      "degrade": "Without gh, /playbooks:repo-sweep cannot list pull requests or its state and stops; the other playbooks still load.",
      "install": {
        "docs": "https://cli.github.com/",
        "brew": "gh",
        "winget": "GitHub.cli",
        "apt": "gh"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "claude",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:boris"
      ],
      "detect": {
        "any": [
          "claude"
        ]
      },
      "degrade": "Without the claude CLI, the commands the boris playbook quotes cannot be run; the text still loads.",
      "install": {
        "docs": "https://code.claude.com/docs/en/setup"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "yarn",
      "kind": "cli",
      "need": "optional",
      "for": [
        "skill:boris"
      ],
      "detect": {
        "any": [
          "yarn"
        ]
      },
      "degrade": "Without yarn, the boris playbook's example install command cannot be run; nothing else changes.",
      "install": {
        "docs": "https://yarnpkg.com/getting-started/install",
        "brew": "yarn",
        "winget": "Yarn.Yarn"
      },
      "check": "/harness-ops:prerequisites"
    },
    {
      "id": "node",
      "kind": "cli",
      "need": "optional",
      "for": [
        "plugin"
      ],
      "detect": {
        "any": [
          "node"
        ]
      },
      "degrade": "Without node, the prerequisites checker cannot run, so a missing tool above goes unreported; the plugin's own skills are unaffected.",
      "install": {
        "docs": "https://nodejs.org/en/download",
        "brew": "node",
        "winget": "OpenJS.NodeJS.LTS",
        "apt": "nodejs"
      },
      "check": "/harness-ops:prerequisites"
    }
  ]
}
