# Flatten a YAML subset to `dotted.key<TAB>value` records, one per scalar.
#
# SINGLE SOURCE OF TRUTH: lib/yaml-subset.awk at the marketplace repo root.
# Plugin copies are generated by scripts/sync-shared-copies.sh; never edit one.
#
# The subset: block mappings and block sequences by indentation, flow
# sequences and flow mappings closed on the same line, plain and quoted
# scalars, `#` comments (whole-line, or after whitespace). A plain scalar may
# not hold `: ` (a colon then a space or tab); quote such a value. A sequence
# item is keyed by its zero-based index (`lanes.pr-merge.slots.0.activity`).
# An empty value, an empty flow collection and a key with nothing under it
# print nothing. Keys and scalars may be quoted: `''` inside single quotes is
# one quote, and inside double quotes `\"`, `\\`, `\/` and `\t` are unescaped
# while any other `\x` is kept as written. No anchors, aliases, tags, block
# scalars or multi-line flow collections.
#
# The document may sit at a uniform base indent, the leading whitespace of its
# first content line; indentation is spaces. A tab in a line's leading
# whitespace is a parse error, except in the base indent of a -v BLOCK=1 fence,
# which may hold tabs. `---` and `...` markers and `%` directives are skipped;
# CRLF and a leading byte-order mark are accepted.
#
# -v BLOCK=1 reads only the lines inside the first ```yaml config fence (a
# docs convention file); line numbers still name the .md file's own lines.
# On a parse error prints `error<TAB><line><TAB><message>` and exits 1.
# Prints `block<TAB>1` first when BLOCK=1 found a fence.

function fail(msg) {
  print "error\t" NR "\t" msg
  failed = 1
  exit 1
}

function emit(path, val) { print path "\t" val }

function ch() { return substr(FS_S, FP, 1) }

function skipws() { while (FP <= length(FS_S) && ch() ~ /[ \t]/) FP++ }

# Scan the quoted scalar opening at s[start]. On success sets QV to its value
# and QEND to the index after the closing quote, and returns 1; returns 0 when
# the quote is unclosed. `''` inside single quotes is one quote; inside double
# quotes `\"`, `\\`, `\/` and `\t` are unescaped and any other `\x` is kept
# as written.
function qscan(s, start,   q, v, i, n, c, e) {
  q = substr(s, start, 1); v = ""; n = length(s)
  for (i = start + 1; i <= n; i++) {
    c = substr(s, i, 1)
    if (c == q) {
      if (q == "'" && substr(s, i + 1, 1) == "'") { v = v "'"; i++; continue }
      QV = v; QEND = i + 1
      return 1
    }
    if (q == "\"" && c == "\\" && i < n) {
      e = substr(s, i + 1, 1)
      if (e == "\"" || e == "\\" || e == "/") v = v e
      else if (e == "t") v = v "\t"
      else v = v c e
      i++
      continue
    }
    v = v c
  }
  return 0
}

# When s opens with `key:` (plain, or a quoted key), sets KEY and returns the
# index of that colon; otherwise returns 0.
function keyat(s,   c, r) {
  c = substr(s, 1, 1)
  if (c == "\"" || c == "'") {
    if (!qscan(s, 1)) return 0
    KEY = QV
    r = substr(s, QEND)
  } else {
    if (!match(s, /^[A-Za-z0-9_-]+/)) return 0
    KEY = substr(s, 1, RLENGTH)
    r = substr(s, RLENGTH + 1)
  }
  if (!match(r, /^[ \t]*:/)) return 0
  if (KEY == "" || KEY ~ /[.\t]/) fail("a key may not be empty or hold `.` or a tab")
  return length(s) - length(r) + RLENGTH
}

function unsupported(c) {
  if (c ~ /[&*!|>]/) fail("anchors, aliases, tags and block scalars are not part of the subset")
}

# One value inside a flow collection, at FP.
function flow(path,   c, start, end) {
  skipws()
  c = ch()
  if (c == "") fail("unclosed flow collection")
  if (c == "[") { fseq(path); return }
  if (c == "{") { fmap(path); return }
  if (c == "\"" || c == "'") {
    if (!qscan(FS_S, FP)) fail("unclosed quote")
    emit(path, QV)
    FP = QEND
    return
  }
  unsupported(c)
  start = FP
  while (FP <= length(FS_S) && ch() !~ /[],}]/) {
    # ` #` starts a comment, which leaves the collection unclosed.
    if (ch() == "#" && substr(FS_S, FP - 1, 1) ~ /[ \t]/) fail("unclosed flow collection")
    FP++
  }
  c = substr(FS_S, start, FP - start)
  sub(/[ \t]+$/, "", c)
  if (c == "") fail("an empty flow item")
  emit(path, c)
}

function fseq(path,   i, c) {
  FP++
  for (i = 0; ; i++) {
    skipws()
    if (ch() == "]") { FP++; return }
    flow(path "." i)
    skipws()
    c = ch()
    if (c == "]") { FP++; return }
    if (c == "") fail("unclosed flow collection")
    if (c != ",") fail("expected `,` or `]` in a flow sequence")
    FP++
  }
}

function fmap(path,   k, c, start) {
  FP++
  for (;;) {
    skipws()
    c = ch()
    if (c == "}") { FP++; return }
    if (c == "") fail("unclosed flow collection")
    if (c == "\"" || c == "'") {
      if (!qscan(FS_S, FP)) fail("unclosed quote")
      k = QV
      FP = QEND
      skipws()
      if (k == "" || k ~ /[.\t]/) fail("a key may not be empty or hold `.` or a tab")
    } else {
      start = FP
      while (FP <= length(FS_S) && ch() !~ /[:,}]/) FP++
      k = substr(FS_S, start, FP - start)
      sub(/[ \t]+$/, "", k)
      if (k !~ /^[A-Za-z0-9_-]+$/) fail("expected `key: value` in a flow mapping")
    }
    if (ch() != ":") fail("expected `key: value` in a flow mapping")
    FP++
    skipws()
    c = ch()
    if (c != "," && c != "}") flow(path "." k)
    skipws()
    c = ch()
    if (c == "}") { FP++; return }
    if (c == "") fail("unclosed flow collection")
    if (c != ",") fail("expected `,` or `}` in a flow mapping")
    FP++
  }
}

# The value after `key:` or `- `, leading blanks removed. An empty value opens
# a container the next deeper line fills; `seq` says a `- ` item opened it.
function value(path, s, ind, opener,   c, end, rest) {
  if (s == "" || s ~ /^#/) {
    pending = 1; ppath = path; pind = ind; ptype = opener
    return
  }
  c = substr(s, 1, 1)
  if (c == "[" || c == "{") {
    FS_S = s; FP = 1
    flow(path)
    rest = substr(FS_S, FP)
  } else if (c == "\"" || c == "'") {
    if (!qscan(s, 1)) fail("unclosed quote")
    emit(path, QV)
    rest = substr(s, QEND)
  } else {
    unsupported(c)
    sub(/[ \t]+#.*$/, "", s)
    sub(/[ \t]+$/, "", s)
    if (s ~ /:[ \t]/) fail("a plain value may not hold `: `; quote it")
    emit(path, s)
    return
  }
  sub(/^[ \t]+/, "", rest)
  if (rest != "" && rest !~ /^#/) fail("unexpected text after a value")
}

function mapkey(rest, ind,   key, val, path, p) {
  p = keyat(rest)
  if (!p) fail("expected `key: value`")
  key = KEY
  val = substr(rest, p + 1)
  if (val != "" && val !~ /^[ \t]/) fail("expected a space after `" key ":`")
  sub(/^[ \t]+/, "", val)
  path = (paths[n] == "" ? "" : paths[n] ".") key
  value(path, val, ind, "map")
}

BEGIN { n = 0; based = 0; pending = 0; inblock = (BLOCK == 1) ? 0 : 1; seen = 0 }

{
  sub(/\r$/, "")
  if (NR == 1) sub(/^\357\273\277/, "")
  line = $0
  if (BLOCK == 1) {
    if (!inblock) {
      # Any other fenced block is skipped whole, so a prose example of the
      # config block inside a longer outer fence never counts.
      if (other != "") {
        if (line ~ /^`+[ \t]*$/ && match(line, /^`+/) && RLENGTH >= length(other)) other = ""
        next
      }
      if (line ~ /^```yaml[ \t]+config[ \t]*$/) {
        if (seen) fail("a second ```yaml config block (the first opens at line " first "); one file holds one")
        inblock = 1; seen = 1; first = NR; print "block\t1"
      } else if (match(line, /^```+/)) {
        other = substr(line, 1, RLENGTH)
      }
      next
    }
    if (line ~ /^```[ \t]*$/) { inblock = 0; done = 1; next }
  }
  if (line ~ /^[ \t]*(#.*)?$/) next
  if (line ~ /^(---|\.\.\.)([ \t]|$)/ || line ~ /^%/) next

  match(line, /^[ \t]*/)
  if (BLOCK != 1 && substr(line, 1, RLENGTH) ~ /\t/) fail("tab indentation")
  if (!based) { base = substr(line, 1, RLENGTH); based = 1 }
  if (substr(line, 1, length(base)) != base) fail("indentation below the document's base")
  line = substr(line, length(base) + 1)
  if (line ~ /^ *\t/) fail("tab indentation")
  match(line, /^ */)
  ind = RLENGTH
  rest = substr(line, ind + 1)
  dash = (rest ~ /^-( |$)/)

  if (n == 0) {
    if (dash) fail("a root sequence is not part of the subset")
    n = 1; inds[1] = 0; types[1] = "map"; paths[1] = ""
  }
  if (pending) {
    # A mapping key's sequence may sit at the key's own indent.
    if (ind > pind || (ind == pind && dash && ptype == "map")) {
      n++; inds[n] = ind; types[n] = dash ? "seq" : "map"; paths[n] = ppath; cnt[n] = 0
    }
    pending = 0
  }
  while (n > 1 && (ind < inds[n] || (ind == inds[n] && types[n] == "seq" && !dash))) n--
  if (ind != inds[n]) fail("unexpected indentation")

  if (types[n] == "map") { mapkey(rest, ind); next }

  if (!dash) fail("expected a `- ` sequence item")
  path = paths[n] "." cnt[n]
  cnt[n]++
  item = substr(rest, 2)
  match(item, /^ */)
  col = ind + 1 + RLENGTH
  item = substr(item, RLENGTH + 1)
  if (item ~ /^-( |$)/) fail("a sequence nested on one line is not part of the subset")
  p = keyat(item)
  if (p && substr(item, p + 1, 1) ~ /^([ \t])?$/) {
    n++; inds[n] = col; types[n] = "map"; paths[n] = path
    mapkey(item, col)
  } else {
    value(path, item, ind, "seq")
  }
}

END {
  if (failed) exit 1
  if (BLOCK == 1 && inblock && !done) { print "error\t" NR "\tunclosed ```yaml config fence"; exit 1 }
}
