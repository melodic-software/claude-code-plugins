{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "routing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "id": { "type": "string" } }
      }
    },
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["fast", "safe", "strict"] },
        "label": { "type": "string" },
        "limit": { "type": "integer" },
        "verbose": { "type": "boolean" },
        "note": { "type": ["string", "null"] },
        "disable": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locked": { "type": "string" },
        "ceiling": { "type": "integer" },
        "audit": { "type": ["boolean", "string"], "enum": [true, false, "report"] },
        "level": { "type": "string", "enum": ["low", "medium", "high"] },
        "free": { "type": "integer" }
      }
    }
  }
}
